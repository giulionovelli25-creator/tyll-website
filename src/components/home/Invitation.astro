---
// Homepage section 4: the closing invitation, as calm and dark as the opening.
import Logo from '../Logo.astro';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.invite;
---

<section class="invite on-dark" data-dark aria-labelledby="invite-title">
  <div class="invite__waves" aria-hidden="true"></div>
  <div class="wrap invite__inner">
    <Logo mark anim="draw" label="" class="invite__mark" />
    <h2 id="invite-title">{v.title}</h2>
    <p>{v.text}</p>
    <div class="invite__actions">
      <a class="btn btn--solid btn--lg" href={href('solutions', lang)} data-open-solutions data-track="explore_solutions_click" data-track-from="final">
        {d.cta.solutions}
      </a>
      <a class="btn btn--line btn--lg" href={href('book', lang)} data-track="book_call_click" data-track-from="final">{d.cta.book}</a>
    </div>
  </div>
</section>

<style>
  .invite {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: clamp(6rem, 4rem + 8vw, 11rem);
    background: var(--ink);
    color: var(--on-dark);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* The light wave artwork turned into a faint silver line on the dark ground */
  .invite__waves {
    position: absolute;
    inset: 10% -15% -20%;
    z-index: -1;
    background: url('/media/tyll-waves.webp') center / cover no-repeat;
    filter: invert(1) grayscale(1) contrast(2.2) brightness(1.4);
    mix-blend-mode: screen;
    opacity: 0.55;
    -webkit-mask-image: radial-gradient(60% 60% at 50% 60%, #000 30%, transparent);
    mask-image: radial-gradient(60% 60% at 50% 60%, #000 30%, transparent);
    pointer-events: none;
  }

  .invite__inner {
    width: 100%;
    display: grid;
    justify-items: center;
  }

  .invite :global(.invite__mark) {
    width: 44px;
    height: auto;
    margin-bottom: 2rem;
    color: var(--on-dark);
  }

  .invite h2 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem);
    letter-spacing: -0.04em;
  }

  .invite p {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--on-dark-muted);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .invite__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 640px) {
    .invite__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
