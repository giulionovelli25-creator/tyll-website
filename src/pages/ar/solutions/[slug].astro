---
import SolutionPage from '../../../components/pages/SolutionPage.astro';
import LegacyRedirect from '../../../components/LegacyRedirect.astro';
import { solutionKeys, slugOf, legacy, pages, type SolutionKey } from '../../../i18n/routes';

export function getStaticPaths() {
  const live = solutionKeys.map((key) => ({ params: { slug: slugOf(key, 'ar') }, props: { key, to: undefined } }));
  // The pages folded into others in round 3: a small redirect page each, to the row that holds them
  const old = Object.values(legacy).map((x) => ({
    params: { slug: x.from.ar.split('/').filter(Boolean).pop()! },
    props: { key: undefined, to: `${pages[x.to].ar}#${x.anchor}` },
  }));
  return [...live, ...old];
}

const { key, to } = Astro.props as { key?: SolutionKey; to?: string };
---

{to ? <LegacyRedirect to={to} /> : <SolutionPage lang="ar" solution={key!} />}
