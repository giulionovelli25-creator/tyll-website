---
// "Works with your existing systems": a quiet row of the POS systems in src/config/integrations.ts.
// An entry without a logo file shows its name as text until the official logo is added.
import { Image } from 'astro:assets';
import { integrations } from '../../config/integrations';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const v = t(lang).home.works;
---

<section class="works" aria-labelledby="works-title">
  <div class="wrap works__inner">
    <div class="works__copy">
      <h2 id="works-title">{v.title}</h2>
      <p>{v.text}</p>
    </div>
    <ul class="works__logos">
      {
        integrations.map((i) => (
          <li>
            {i.logo ? (
              <Image src={i.logo} alt={i.name} height={32} class="works__logo" />
            ) : (
              <span class="works__name" dir="ltr">
                {i.name}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .works {
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-block: 1px solid var(--line);
    background: #fff;
  }

  .works__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .works h2 {
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .works__copy p {
    margin-top: 0.3rem;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  .works__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Logos sit in one tone so no brand shouts louder than the page */
  .works__logos :global(.works__logo) {
    width: auto;
    height: 28px;
    filter: grayscale(1);
    opacity: 0.75;
  }

  .works__name {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 1.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--cloud);
    color: var(--graphite);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
