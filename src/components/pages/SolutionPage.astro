  }

  /* "Also in …": each feature this page took in is a collapsed row; one open at a time */
  .rows {
    margin-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .more__groups + .rows {
    margin-top: var(--s-5);
  }

  .xrow {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .xrow__h {
