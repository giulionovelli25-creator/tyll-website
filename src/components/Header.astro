---
import Logo from './Logo.astro';
import SolutionIcon from './SolutionIcon.astro';
import { site } from '../config/site';
import { demoHref } from '../config/demo';
import { solutions } from '../content/solutions';
import { t, href, pages, locales, solutionKeys, type Locale, type PageKey, type SolutionKey } from '../i18n';
import { parts } from '../config/parts';
import { isComingSoon } from '../config/products';

interface Props {
  lang: Locale;
  page: PageKey;
  /** Start in the white-on-dark treatment, for pages that open on a dark photo or video. */
  overHero?: boolean;
}

const { lang, page, overHero = false } = Astro.props;
const d = t(lang);
const home = href('home', lang);
const item = (k: SolutionKey) => ({ key: k, s: solutions[k], url: href(k, lang), current: page === k, soon: isComingSoon(k) });
// The menu follows the three parts, so it explains Tyll the same way as the homepage
const groups = parts.map((keys, i) => ({ name: d.home.parts.cards[i].title, items: keys.map(item) }));
const fwd = lang === 'ar' ? '←' : '→';
const inSolutions = page === 'solutions' || (solutionKeys as readonly string[]).includes(page);
---

<header class:list={['header', overHero && 'on-dark']} data-tone={overHero ? 'dark' : 'light'} id="site-header">
  <div class="wrap header__bar">
    <a class="header__logo" href={home} aria-label="Tyll home">
      <Logo label="Tyll" />
    </a>

    <nav class="header__nav" aria-label={d.nav.label}>
      <button
        type="button"
        class:list={['header__trigger', inSolutions && 'is-current']}
        aria-expanded="false"
        aria-controls="solutions-panel"
        id="solutions-trigger"
      >
        {d.nav.solutions}
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <a class="header__link" href={href('how', lang)} aria-current={page === 'how' ? 'page' : undefined}>{d.nav.how}</a>
    </nav>

    <div class="header__end">
      <div class="lang" role="group" aria-label={d.nav.language}>
        {
          locales.map((l) => (
            <a href={pages[page][l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} data-track="language_changed" data-track-to={l}>
              {
                // Arabic is named in Arabic; the other languages by their short code
                l === 'ar' ? (
                  <span class="lang__ar" dir="rtl">{t(l).langName}</span>
                ) : (
                  <>
                    <span aria-hidden="true">{l.toUpperCase()}</span>
                    <span class="visually-hidden">{t(l).langName}</span>
                  </>
                )
              }
            </a>
          ))
        }
      </div>
      {
        site.demoUrl && (
          <a class="btn btn--line btn--sm header__demo" href={demoHref(lang)} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from="header">
            {d.cta.demo}
            <span class="visually-hidden"> {d.cta.newTab}</span>
          </a>
        )
      }
      <a class="btn btn--solid header__book" href={href('book', lang)} data-track="book_demo_click" data-track-from="header">
        {d.cta.book}
      </a>
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="visually-hidden" data-open-label={d.nav.menu} data-close-label={d.nav.close}>{d.nav.menu}</span>
        <span class="burger-lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Desktop: the Solutions panel -->
  <div class="panel" id="solutions-panel" role="region" aria-labelledby="solutions-trigger" hidden>
    <div class="wrap panel__layout">
      <div class="panel__grid">
        {
          groups.map(({ name, items }) => (
            <section class="panel__part">
              <h2 class="panel__head">{name}</h2>
              <ul>
                {items.map(({ key, s, url, current, soon }) => (
                  <li>
                    <a class="panel__item" href={url} aria-current={current ? 'page' : undefined} data-solution={key} data-accent={s.tone}>
                      <span class="panel__icon">
                        <SolutionIcon name={s.icon} />
                      </span>
                      <span class="panel__text">
                        <span class="panel__name">
                          {s.name[lang]}
                          {soon && <span class="badge-soon">{d.cta.comingSoon}</span>}
                          {!soon && <span class="panel__arrow" aria-hidden="true">{fwd}</span>}
                        </span>
                        <span class="panel__desc">{s.menu[lang]}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <div class="panel__foot">
        <a href={href('solutions', lang)} class="panel__all">{d.nav.allSolutions}</a>
        <a href={href('faq', lang)} aria-current={page === 'faq' ? 'page' : undefined}>{d.nav.faq}</a>
      </div>
    </div>
  </div>

  <!-- Mobile: full-screen menu -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="wrap" aria-label={d.nav.label}>
      <div class="mobile-menu__actions">
        <a class="btn btn--solid" href={href('book', lang)} data-track="book_demo_click" data-track-from="menu">{d.cta.book}</a>
        {
          site.demoUrl && (
            <a class="btn btn--line" href={demoHref(lang)} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from="menu">
              {d.cta.demoLong}
              <span class="visually-hidden"> {d.cta.newTab}</span>
            </a>
          )
        }
      </div>
      <details class="mobile-menu__group" open>
        <summary>{d.nav.solutions}</summary>
        <ul>
          {
            groups.map(({ name, items }) => (
              <Fragment>
                <li class="mobile-menu__head">{name}</li>
                {items.map(({ s, url, current, soon }) => (
                  <li>
                    <a href={url} aria-current={current ? 'page' : undefined} data-accent={s.tone}>
                      <SolutionIcon name={s.icon} />
                      <span>{s.name[lang]}</span>
                      {soon && <span class="badge-soon">{d.cta.comingSoon}</span>}
                    </a>
                  </li>
                ))}
              </Fragment>
            ))
          }
          <li class="mobile-menu__faq">
            <a href={href('faq', lang)}>{d.nav.faq}</a>
          </li>
        </ul>
      </details>
      <a class="mobile-menu__how" href={href('how', lang)} aria-current={page === 'how' ? 'page' : undefined}>{d.nav.how}</a>
      <div class="lang mobile-menu__lang" role="group" aria-label={d.nav.language}>
        {
          locales.map((l) => (
            <a href={pages[page][l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} data-track="language_changed" data-track-to={l}>
              {t(l).langName}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--ink);
    background: rgb(var(--paper-rgb) / 0.9);
    -webkit-backdrop-filter: saturate(1.5) blur(16px);
    backdrop-filter: saturate(1.5) blur(16px);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.45s var(--ease),
      color 0.45s var(--ease),
      border-color 0.45s var(--ease);
  }

  .header[data-tone='dark'] {
    color: var(--on-dark);
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Scrolled, but still over the dark opening: a dark frosted bar so text never shows through */
  .header[data-tone='dark'].is-scrolled {
    background: rgb(var(--ink-rgb) / 0.62);
    border-bottom-color: rgb(var(--on-dark-rgb) / 0.08);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    backdrop-filter: saturate(1.4) blur(16px);
  }

  /* While the Solutions panel is open the bar joins it as one light surface */
  .header.is-open {
    color: var(--ink);
    background: var(--paper);
    border-bottom-color: var(--line);
  }

  .header.is-open .btn--solid {
    background: var(--ink);
    color: var(--paper);
  }

  .header.is-open .btn--line {
    border-color: var(--silver);
    color: var(--ink);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    height: var(--header-h);
  }

  .header__logo {
    flex: none;
    display: block;
    border-radius: 6px;
  }

  .header__logo :global(.logo) {
    width: auto;
    height: 26px;
  }

  .header__nav {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.25rem;
  }


  .header__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 42px;
    padding: 0 1rem;
    /* A visible button, so nobody misses the menu */
    border: 1.5px solid currentColor;
    border-radius: var(--pill);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }

  /* How it works: a plain text link beside the Solutions button (9 Nov 2026) */
  .header__link {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 0.85rem;
    margin-inline-start: 0.35rem;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
    text-underline-offset: 6px;
  }

  .header__link:hover,
  .header__link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }

  .header__trigger:hover,
  .header__trigger[aria-expanded='true'] {
    background: rgb(var(--steel-mid-rgb) / 0.14);
  }

  .header__trigger svg {
    width: 12px;
    height: 12px;
    transition: transform 0.3s var(--ease);
  }

  .header__trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .header__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang {
    display: flex;
    gap: 0.75rem;
    margin-inline-end: 0.5rem;
  }

  .lang a {
    font-size: 0.9375rem;
    font-weight: 400;
    text-decoration: none;
  }

  .lang a:not([aria-current]) {
    opacity: 0.64;
  }

  .lang a:hover {
    opacity: 1;
  }

  .lang a[aria-current] {
    font-weight: 400;
  }

  /* A small subset of Noto Sans Arabic with only the letters of العربية, so every page can show the word
     in the brand's Arabic face without loading the full font */
  .lang :global(.lang__ar),
  .mobile-menu__lang a[hreflang='ar'] {
    font-family: 'Tyll Arabic Label', 'Tyll Arabic', var(--font);
    letter-spacing: 0;
  }

  .lang :global(.lang__ar) {
    font-size: 1rem;
  }

  /* The Solutions panel */
  .panel {
    border-top: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 40px 60px -40px rgb(var(--ink-rgb) / 0.35);
    animation: panel-in 0.32s var(--ease);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .panel__layout {
    display: grid;
    grid-template-areas:
      'list'
      'foot';
  }

  .panel__grid {
    grid-area: list;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 1.75rem 0 1.25rem;
  }

  .panel__part ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each column is one of the three parts */
  .panel__head {
    margin: 0 1.1rem 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    color: var(--steel);
    font-family: var(--font);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .panel__item {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }

  .panel__item:hover,
  .panel__item:focus-visible,
  .panel__item[aria-current] {
    background: var(--mist);
  }

  .panel__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(var(--acc-rgb) / 0.16);
    border-radius: 12px;
    background: var(--acc-wash);
    color: var(--acc);
  }

  .panel__icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .panel__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .panel__arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s var(--ease),
      transform 0.25s var(--ease);
  }

  :global([dir='rtl']) .panel__arrow {
    transform: translateX(4px);
  }

  .panel__item:hover .panel__arrow,
  .panel__item:focus-visible .panel__arrow {
    opacity: 1;
    transform: none;
  }

  .panel__desc {
    display: block;
    margin-top: 0.2rem;
    color: var(--steel);
    font-size: 0.9375rem;
    line-height: 1.45;
  }


  .panel__foot {
    grid-area: foot;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.1rem 1.5rem;
    border-top: 1px solid var(--line);
  }

  .panel__foot a {
    font-size: 0.9375rem;
    font-weight: 400;
    text-decoration: none;
  }

  .panel__foot a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .panel__foot .panel__all {
    color: var(--steel);
    font-weight: 400;
  }

  /* Mobile menu */
  .header__burger {
    display: none;
    width: 44px;
    height: 44px;
    margin-inline-end: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .burger-lines,
  .burger-lines::before,
  .burger-lines::after {
    display: block;
    width: 20px;
    height: 1.5px;
    margin: auto;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .burger-lines {
    position: relative;
    background: transparent;
  }

  .burger-lines::before,
  .burger-lines::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger-lines::before {
    transform: translateY(-4px);
  }

  .burger-lines::after {
    transform: translateY(4px);
  }

  [aria-expanded='true'] .burger-lines::before {
    transform: rotate(45deg);
  }

  [aria-expanded='true'] .burger-lines::after {
    transform: rotate(-45deg);
  }

  /* The menu has its own booking button, so the one in the bar steps aside while it is open */
  .header:has(.header__burger[aria-expanded='true']) .header__book {
    visibility: hidden;
  }

  .mobile-menu {
    height: calc(100svh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }

  .mobile-menu nav {
    display: grid;
    gap: 1.75rem;
    padding-block: 1.5rem 2.5rem;
  }

  .mobile-menu__actions {
    display: grid;
    gap: 0.6rem;
  }

  .mobile-menu__group summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.5rem;
    letter-spacing: 0;
    list-style: none;
    cursor: pointer;
  }

  .mobile-menu__group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__group summary::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 300;
    transition: transform 0.3s var(--ease);
  }

  .mobile-menu__group[open] summary::after {
    transform: rotate(45deg);
  }

  .mobile-menu__group ul {
    margin: 0;
    padding: 0.5rem 0 0;
    list-style: none;
  }

  .mobile-menu__head {
    padding: 1rem 0 0.15rem;
    color: var(--steel);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .mobile-menu__group li a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem 0;
    font-size: 1.125rem;
    text-decoration: none;
  }

  /* each solution's icon in its own colour, as in the desktop panel */
  .mobile-menu__group li a :global(svg) {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--acc);
  }

  .mobile-menu__group li a[aria-current] {
    font-weight: 400;
  }

  .mobile-menu__how {
    display: block;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    font-size: 1.5rem;
    text-decoration: none;
  }

  .mobile-menu__faq {
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  .mobile-menu__faq a {
    font-weight: 400;
  }

  .mobile-menu__lang a {
    font-size: 1rem;
  }

  .header:has(.header__burger[aria-expanded='true']) {
    color: var(--ink);
    background: var(--paper);
  }

  .header:has(.header__burger[aria-expanded='true']) .btn--solid {
    background: var(--ink);
    color: var(--paper);
  }

  .header:has(.header__burger[aria-expanded='true']) .btn--line {
    border-color: var(--silver);
    color: var(--ink);
  }

  @media (max-width: 960px) {
    .header__nav,
    .header__demo,
    .header__end > .lang,
    .panel {
      display: none;
    }

    .header__end {
      margin-inline-start: auto;
    }

    .header__burger {
      display: block;
    }
  }

  /* Small phones: the longest labels (Arabic, German) still fit beside the logo and the menu */
  @media (max-width: 430px) {
    .header__bar {
      gap: 0.5rem;
    }

    .header__book {
      padding-inline: 0.8rem;
      font-size: 0.875rem;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const trigger = document.getElementById('solutions-trigger') as HTMLButtonElement;
  const panel = document.getElementById('solutions-panel')!;
  const burger = header.querySelector<HTMLButtonElement>('.header__burger')!;
  const menu = document.getElementById('mobile-menu')!;
  const label = burger.querySelector<HTMLElement>('[data-open-label]')!;

  // White-on-dark while a dark chapter (film, photo, cans section, closing section) sits under the header,
  // light over everything else. Only the strip behind the header counts.
  const darks = [...document.querySelectorAll('[data-dark]')];
  if (darks.length) {
    const under = new Set<Element>();
    const setTone = () => {
      const dark = under.size > 0;
      header.dataset.tone = dark ? 'dark' : 'light';
      header.classList.toggle('on-dark', dark);
    };
    let io: IntersectionObserver | undefined;
    const watch = () => {
      io?.disconnect();
      under.clear();
      const h = header.offsetHeight;
      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? under.add(e.target) : under.delete(e.target)));
          setTone();
        },
        // The top pixel is left out: a dark section ending exactly at the top of the window is not under the header
        { rootMargin: `-1px 0px -${Math.max(0, innerHeight - h)}px 0px` },
      );
      darks.forEach((el) => io!.observe(el));
    };
    watch();
    addEventListener('resize', watch);
  }
  const onScroll = () => header.classList.toggle('is-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ── Solutions panel: click or keyboard; hover on devices with a real pointer ──
  let closeTimer = 0;
  let openTimer = 0;
  const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
  const setPanel = (open: boolean, focusFirst = false) => {
    clearTimeout(closeTimer);
    clearTimeout(openTimer);
    trigger.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    header.classList.toggle('is-open', open);
    if (open && focusFirst) panel.querySelector<HTMLElement>('a')?.focus();
  };
  trigger.addEventListener('click', () => setPanel(!isOpen()));
  trigger.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setPanel(true, true);
    }
  });

  // Arrow keys move between the panel's links
  panel.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    e.preventDefault();
    const links = [...panel.querySelectorAll<HTMLElement>('a')];
    const i = links.indexOf(document.activeElement as HTMLElement);
    links[(i + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length]?.focus();
  });

  // Hover opens after a short pause and closes after a grace period, so moving the pointer
  // diagonally from the trigger into the panel never closes it.
  const hoverable = matchMedia('(hover: hover) and (pointer: fine)');
  const enter = () => {
    if (!hoverable.matches) return;
    clearTimeout(closeTimer);
    if (!isOpen()) openTimer = window.setTimeout(() => setPanel(true), 120);
  };
  const leave = () => {
    if (!hoverable.matches) return;
    clearTimeout(openTimer);
    closeTimer = window.setTimeout(() => setPanel(false), 280);
  };
  [trigger, panel].forEach((el) => {
    el.addEventListener('pointerenter', enter);
    el.addEventListener('pointerleave', leave);
  });

  document.addEventListener('click', (e) => {
    if (isOpen() && !header.contains(e.target as Node)) setPanel(false);
  });
  header.addEventListener('focusout', (e) => {
    const to = e.relatedTarget as Node | null;
    if (isOpen() && to && !panel.contains(to) && to !== trigger) setPanel(false);
  });

  // ── Mobile menu ──
  const setMenu = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    label.textContent = open ? label.dataset.closeLabel! : label.dataset.openLabel!;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLElement>('a, summary')?.focus();
  };
  burger.addEventListener('click', () => setMenu(menu.hidden));
  menu.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setMenu(false);
  });

  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (isOpen()) {
      setPanel(false);
      trigger.focus();
    }
    if (!menu.hidden) {
      setMenu(false);
      burger.focus();
    }
  });
  matchMedia('(min-width: 961px)').addEventListener('change', (e) => e.matches && setMenu(false));
</script>
