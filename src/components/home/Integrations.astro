---
// Straight under the hero (9 Nov 2026), as on the live tyll.ai: "Works with the systems you already run", one line on
// how Tyll connects, then the real logos from src/config/integrations.ts in an endless band.
// The set is drawn twice and the band moves by exactly one set, so the loop has no visible jump. It uses a CSS
// transform only, keeps moving under the pointer and a finger, pauses when focused, and always reads left to right,
// also in Arabic, on phones too. With reduced motion it stands still as a centred, wrapping grid. Logos are never links.
import { logos, logoBox } from '../../config/integrations';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const v = t(lang).home.works;
---

<section class="works" id="integrations" aria-labelledby="works-title">
  <div class="wrap">
    <div class="works__head">
      <h2 id="works-title" class="display">{v.title}</h2>
      <p>{v.text}</p>
    </div>
  </div>

  <div class="band" dir="ltr" tabindex="0" role="group" aria-labelledby="works-title" data-band>
    <div class="band__track">
      {
        [0, 1].map((copy) => (
          <ul class="band__set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {logos.map((l) => {
              const b = logoBox(l);
              return (
                <li class="logo">
                  <img
                    class:list={[l.whiteFile && 'is-white']}
                    src={`/logos/integrations/${l.file}`}
                    alt={copy === 1 ? '' : l.name}
                    style={`--w:${b.width};--h:${b.height};--mt:${b.top};--mr:${b.right};--mb:${b.bottom};--ml:${b.left}`}
                    loading="lazy"
                    decoding="async"
                  />
                  {l.text && <span aria-hidden="true">{l.text}</span>}
                </li>
              );
            })}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .works {
    --logo-scale: 0.8;
    --logo-gap: 3.75rem;
    padding-block: 0 clamp(3rem, 2rem + 3vw, 4.5rem);
    background: var(--page);
    color: var(--ink);
  }

  /* A hairline ties the banner to the hero above it */
  .works__head {
    padding-top: clamp(2.5rem, 1.75rem + 2.5vw, 3.75rem);
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .works h2 {
    font-size: var(--fs-h2);
  }

  .works__head p {
    max-width: 36rem;
    margin: var(--s-2) auto 0;
    color: var(--text-2);
  }

  /* The logos fade in and out at the edges of the band */
  .band {
    overflow: hidden;
    margin-top: var(--s-5);
    padding-block: var(--s-2);
    -webkit-mask-image: linear-gradient(90deg, transparent, var(--black) 12%, var(--black) 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, var(--black) 12%, var(--black) 88%, transparent);
  }

  .band:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .band__track {
    display: flex;
    width: max-content;
    animation: band 84s linear infinite; /* 21 logos at the pace the 9 had at 36 s */
  }

  /* Keeps moving under the pointer; keyboard focus still holds it still */
  .band:focus .band__track {
    animation-play-state: paused;
  }

  @keyframes band {
    to {
      transform: translateX(-50%);
    }
  }

  .band__set {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--logo-gap);
    margin: 0;
    /* The same space after the last logo as between all the others, so the join cannot be seen */
    padding: 0 var(--logo-gap) 0 0;
    list-style: none;
  }

  /* Each logo in its maker's own colours. The files themselves are never altered. */
  .logo {
    display: flex;
    flex: none;
    align-items: center;
    gap: calc(0.7rem * var(--logo-scale));
    height: calc(36px * var(--logo-scale));
  }

  /* Each file is sized so its visible mark, not its empty margin, sets the height. */
  .logo img {
    flex: none;
    width: calc(var(--w) * var(--logo-scale) * 1px);
    max-width: none;
    height: calc(var(--h) * var(--logo-scale) * 1px);
    margin: calc(var(--mt) * var(--logo-scale) * 1px) calc(var(--mr) * var(--logo-scale) * 1px) calc(var(--mb) * var(--logo-scale) * 1px) calc(var(--ml) * var(--logo-scale) * 1px);
  }

  /* The maker only publishes this one in white, so it is darkened here to show on the white band */
  .logo img.is-white {
    filter: brightness(0);
  }

  /* The product name beside a company logo, in the site's own type */
  .logo span {
    color: var(--ink);
    font-size: calc(1.25rem * var(--logo-scale));
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    white-space: nowrap;
  }


  .works__note a {
    text-decoration: underline;
    text-decoration-color: var(--silver);
    text-underline-offset: 4px;
    transition:
      color 0.2s var(--ease),
      text-decoration-color 0.2s var(--ease);
  }

  .works__note a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  @media (max-width: 760px) {
    .works {
      --logo-scale: 0.74;
      --logo-gap: 3rem;
    }

    .band {
      margin-top: var(--s-5);
    }


    @media (max-width: 430px) {
      .works {
        --logo-scale: 0.6;
      }
    }

    @media (max-width: 340px) {
      .works {
        --logo-scale: 0.5;
      }
    }

    /* Phones keep the moving band too: 21 logos would stack too deep as a still grid */
    .works__head p {
      padding-inline: var(--gut);
    }
  }

  /* Reduced motion: a still, centred grid of one set */
  @media (prefers-reduced-motion: reduce) {
    .band {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .band__track {
      width: auto;
      animation: none;
    }

    .band__set {
      flex: 1 1 100%;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--s-4) var(--logo-gap);
      padding: 0 var(--gut);
    }

    .band__set[aria-hidden='true'] {
      display: none;
    }
  }
</style>
