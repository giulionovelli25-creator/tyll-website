---
// The Sustainability page (round 4, 24 Nov 2026, the owner's brief).
// 1. A photo hero at about half the screen, the headline over it, dropping in from slightly above once (600 ms; still
//    with reduced motion).
// 2. The numbers wall: the global figures count up together when the wall comes into view, each with its source.
// 3. "What this means where we work": a sticky column at the start, the country cards passing at the end (Arabic puts
//    the UAE first and has no EU card). Stacked on phones.
// 4. "What hotels got back": a horizontal timeline, year one, year two, overall (stacked on phones).
// 5. Two photo bands, produce arriving and kitchen trimmings, then how Tyll helps and the dark closing band.
// No figure here is a Tyll result. Copy: src/content/sustainability.ts.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SilverWave from '../SilverWave.astro';
import { sustainability } from '../../content/sustainability';
import { solutions } from '../../content/solutions';
import { t, href, type Locale } from '../../i18n';
import heroPhoto from '../../assets/photos/sales-buffet.jpg';
import bandProduce from '../../assets/photos/predictions-delivery.jpg';
import bandWaste from '../../assets/photos/waste-bin.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const c = sustainability[lang];
const waste = d.home.why.cards[0];
const tab = d.cta.newTab;
const fwd = lang === 'ar' ? '←' : '→';
// The wall: the three global figures, then the homepage's 18%
const wall = [...c.wall.stats, { figure: waste.figure, text: waste.title, source: { name: waste.sourceName, url: waste.sourceUrl } }];
// How Tyll helps: a page, or the row on a page that holds a feature
const act = c.act.items.map((it) => {
  const s = solutions[it.page];
  const row = it.row ? s.rows?.find((r) => r.id === it.row) : undefined;
  return { href: href(it.page, lang, row ? `#${row.id}` : ''), name: (row ?? s).name[lang], text: it.text };
});
---

<Base lang={lang} page="sustainability" title={c.metaTitle} description={c.metaDescription} overHero>
  <section class="hero on-dark" data-dark aria-labelledby="sus-title">
    <Picture class="hero__photo" src={heroPhoto} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" decoding="async" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <h1 id="sus-title" class="display">{c.title}</h1>
      <p class="hero__text">{c.text}</p>
    </div>
  </section>

  <div class="sus" data-sus>
    <section class="wall" aria-labelledby="sus-wall" data-wall>
      <div class="wrap">
        <h2 id="sus-wall" class="display sus__title">{c.wall.title}</h2>
        <ul class="wall__grid" role="list">
          {
            wall.map((st) => (
              <li class="wall__stat">
                <p class="figure" data-count data-final={st.figure} dir="auto">
                  {st.figure}
                </p>
                <p class="wall__text">{st.text}</p>
                <p class="source">
                  <a href={st.source.url} target="_blank" rel="noopener">
                    {st.source.name}
                    <span class="visually-hidden"> {tab}</span>
                  </a>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <figure class="band" aria-hidden="true">
      <Picture src={bandProduce} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[768, 1280, 1920]} sizes="100vw" loading="lazy" decoding="async" style="object-position: 50% 45%" />
    </figure>

    <section class="local" aria-labelledby="sus-local">
      <div class="wrap local__grid">
        <div class="local__head">
          <h2 id="sus-local" class="display sus__title">{c.local.title}</h2>
          <p class="local__lead">{c.local.lead}</p>
        </div>
        <div class="local__cards">
          {
            c.local.cards.map((card) => (
              <article class="place" id={`place-${card.id}`} aria-labelledby={`place-${card.id}-name`}>
                <h3 id={`place-${card.id}-name`} class="place__name">{card.place}</h3>
                <ul class="place__stats" role="list">
                  {card.stats.map((st) => (
                    <li>
                      <p class="place__figure" dir="auto">{st.figure}</p>
                      <p class="place__text">{st.text}</p>
                    </li>
                  ))}
                </ul>
                <ul class="place__sources" role="list">
                  {card.sources.map((src) => (
                    <li class="source">
                      <a href={src.url} target="_blank" rel="noopener">
                        {src.name}
                        <span class="visually-hidden"> {tab}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="back" aria-labelledby="sus-back">
      <div class="wrap">
        <h2 id="sus-back" class="display sus__title">{c.back.title}</h2>
        <ol class="timeline" role="list">
          {
            c.back.steps.map((step) => (
              <li class="timeline__step">
                <p class="timeline__when">{step.when}</p>
                {step.stats.map((st) => (
                  <div class="timeline__stat">
                    <p class="timeline__figure" dir="auto">{st.figure}</p>
                    <p class="timeline__text">{st.text}</p>
                  </div>
                ))}
              </li>
            ))
          }
        </ol>
        <div class="back__foot">
          <p class="source">
            <a href={c.back.source.url} target="_blank" rel="noopener">
              {c.back.source.name}
              <span class="visually-hidden"> {tab}</span>
            </a>
          </p>
          <p class="note">{c.note}</p>
        </div>
      </div>
    </section>

    <figure class="band" aria-hidden="true">
      <Picture src={bandWaste} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[768, 1280, 1920]} sizes="100vw" loading="lazy" decoding="async" style="object-position: 50% 28%" />
    </figure>

    <section class="act" aria-labelledby="sus-act">
      <div class="wrap act__grid">
        <div class="act__head">
          <h2 id="sus-act" class="display">{c.act.title}</h2>
          <p class="act__lead">{c.act.lead}</p>
          <p class="act__offer">{c.act.offer}</p>
        </div>
        <ul class="act__list" role="list">
          {
            act.map((it) => (
              <li>
                <a class="act__item" href={it.href}>
                  <span class="act__name">
                    {it.name} <span class="act__go" aria-hidden="true">{fwd}</span>
                  </span>
                  <span class="act__text">{it.text}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <section class="close on-dark" data-dark aria-labelledby="sus-final">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap close__inner">
      <h2 id="sus-final" class="display">{c.close.title}</h2>
      <div class="close__actions">
        <a class="btn btn--line btn--lg" href={href('waste', lang)}>{c.close.waste}</a>
        <a class="btn btn--solid btn--lg" href={href('book', lang)} data-track="book_demo_click" data-track-from="sustainability-final">{d.cta.book}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .sus {
    --g: var(--demo-teal);
    --pad: clamp(112px, 16vh, 200px);
  }

  /* Hero: a photograph at about half the screen under a dark shade, the headline in white over it */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(26rem, 53svh, 42rem);
    padding-block: calc(var(--header-h) + var(--s-5)) var(--s-6);
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark);
  }

  .hero :global(.hero__photo),
  .hero :global(.hero__photo img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-grade);
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(var(--shade-rgb) / 0.86) 0%, rgb(var(--shade-rgb) / 0.55) 55%, rgb(var(--shade-rgb) / 0.45) 100%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* The headline drops in from slightly above, once, as the page opens */
  @media (prefers-reduced-motion: no-preference) {
    .hero__inner {
      animation: sus-drop 600ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }
  }

  @keyframes sus-drop {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }
  }

  .hero h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.7rem + 3.4vw, 4.75rem);
    line-height: 1.04;
    text-shadow: 0 1px 16px rgb(var(--night-rgb) / 0.4);
  }

  .hero__text {
    max-width: 34rem;
    margin: var(--s-3) 0 0;
    color: var(--on-dark-muted);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .sus__title {
    max-width: 20ch;
    margin: 0;
    font-size: var(--fs-h2);
  }

  .figure {
    max-width: none;
    margin: 0;
    color: var(--g);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1.9rem + 2.6vw, 4.5rem);
    font-weight: 300;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .source {
    max-width: 60ch;
    margin: var(--s-3) 0 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .source a {
    display: inline-block;
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    color: var(--steel);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .source a:hover {
    color: var(--ink);
  }

  .note {
    max-width: 60ch;
    margin: 0.5rem 0 0;
    color: var(--graphite);
    font-size: var(--fs-small);
  }

  /* The numbers wall: four figures in a row, two by two on tablets, one under another on phones */
  .wall {
    padding-block: var(--pad);
  }

  .wall__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5) clamp(1.5rem, 0.5rem + 2vw, 3rem);
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .wall__stat {
    padding-top: var(--s-3);
    border-top: 2px solid var(--g);
  }

  .wall__text {
    max-width: 26ch;
    margin: var(--s-2) 0 0;
    color: var(--ink);
    font-size: var(--fs-lead);
    line-height: 1.4;
  }

  /* Where we work: the title stays put at the start while the country cards pass at the end */
  .local {
    padding-block: var(--pad);
    background: var(--page-deep);
  }

  .local__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-5) clamp(2rem, 1rem + 4vw, 6rem);
    align-items: start;
  }

  .local__head {
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
  }

  .local__lead {
    max-width: 30rem;
    margin: var(--s-3) 0 0;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.45;
  }

  .local__cards {
    display: grid;
    gap: var(--s-4);
  }

  .place {
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }

  .place__name {
    margin: 0 0 var(--s-3);
    font-family: var(--font);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: 0;
  }

  .place__stats {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .place__figure {
    margin: 0;
    color: var(--g);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 3rem);
    font-weight: 300;
    line-height: 1.05;
  }

  .place__text {
    max-width: 40ch;
    margin: 0.3rem 0 0;
    color: var(--graphite);
    line-height: 1.45;
  }

  .place__sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .place__sources .source {
    margin: 0;
  }

  /* What hotels got back: three steps on one line, joined by a rule */
  .back {
    padding-block: var(--pad);
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .timeline__step {
    position: relative;
    padding-block-start: var(--s-4);
    padding-inline-end: clamp(1rem, 0.5rem + 2vw, 3rem);
    border-top: 2px solid var(--hair);
  }

  /* each step's dot on the line */
  .timeline__step::before {
    position: absolute;
    top: -7px;
    inset-inline-start: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--g);
    content: '';
  }

  .timeline__when {
    margin: 0 0 var(--s-3);
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .timeline__stat + .timeline__stat {
    margin-top: var(--s-3);
  }

  .timeline__figure {
    margin: 0;
    color: var(--g);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.8rem + 2.4vw, 4rem);
    font-weight: 300;
    line-height: 1;
  }

  .timeline__text {
    max-width: 28ch;
    margin: 0.4rem 0 0;
    color: var(--graphite);
    line-height: 1.45;
  }

  .back__foot {
    margin-top: var(--s-5);
  }

  @media (max-width: 1100px) {
    .wall__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .local__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .local__head {
      position: static;
    }
  }

  @media (max-width: 700px) {
    .wall__grid,
    .timeline {
      grid-template-columns: minmax(0, 1fr);
    }

    .timeline__step {
      padding-block: 0 var(--s-5);
      padding-inline: var(--s-4) 0;
      border-top: 0;
      border-inline-start: 2px solid var(--hair);
    }

    .timeline__step::before {
      top: 0.2rem;
      inset-inline-start: -7px;
    }
  }

  .band {
    height: clamp(16rem, 40vw, 32rem);
    margin: 0;
    overflow: hidden;
  }

  .band :global(picture),
  .band :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-grade);
  }

  /* How Tyll helps */
  .act {
    padding-block: var(--pad);
  }

  .act__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-5) clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .act h2 {
    max-width: 16ch;
    font-size: var(--fs-h2);
  }

  .act__lead {
    max-width: 60ch;
    margin: var(--s-3) 0 0;
    color: var(--graphite);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .act__offer {
    max-width: 60ch;
    margin: var(--s-3) 0 0;
    font-weight: 600;
    line-height: 1.5;
  }

  .act__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .act__item {
    display: block;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .act__list li:last-child .act__item {
    border-bottom: 1px solid var(--line);
  }

  .act__name {
    display: block;
    color: var(--g);
    font-weight: 600;
  }

  .act__go {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .act__item:focus-visible .act__go {
    transform: translateX(4px);
  }

  @media (hover: hover) and (pointer: fine) {
    .act__item:hover .act__go {
      transform: translateX(4px);
    }

    :global([dir='rtl']) .act__item:hover .act__go {
      transform: translateX(-4px);
    }
  }

  :global([dir='rtl']) .act__item:focus-visible .act__go {
    transform: translateX(-4px);
  }

  .act__text {
    display: block;
    max-width: 60ch;
    margin-top: 0.3rem;
    color: var(--graphite);
    line-height: 1.5;
  }

  .close {
    position: relative;
    overflow: hidden;
    padding-block: var(--band-y);
    background: var(--night-1);
    color: var(--text-1);
  }

  .close__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .close h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem);
  }

  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    justify-content: center;
  }

  @media (max-width: 900px) {
    .act__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .close__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  // The numbers wall counts up once, all four figures together, when it comes into view. Each number in a figure
  // keeps its decimals and its separator (1.05, 1,05). With reduced motion, or without JavaScript, the figures simply
  // show. The page scrolls as it always does.
  const wall = document.querySelector<HTMLElement>('[data-wall]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wall && !still && 'IntersectionObserver' in window) {
    const NUM = /\d+(?:[.,]\d+)?/g;
    const figures = [...wall.querySelectorAll<HTMLElement>('[data-count]')];
    const at = (final: string, e: number) =>
      final.replace(NUM, (m) => {
        const sep = m.match(/[.,]/)?.[0];
        const places = sep ? m.split(sep)[1].length : 0;
        const v = (Number(m.replace(',', '.')) * e).toFixed(places);
        return sep ? v.replace('.', sep) : v;
      });
    figures.forEach((el) => (el.textContent = at(el.dataset.final ?? '', 0)));
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / 1200);
          const e = 1 - Math.pow(1 - p, 3);
          figures.forEach((el) => (el.textContent = p < 1 ? at(el.dataset.final ?? '', e) : (el.dataset.final ?? '')));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.35 },
    );
    io.observe(wall.querySelector('.wall__grid')!);
  }
</script>
