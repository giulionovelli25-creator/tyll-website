<style>
  .skyline {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .b,
  .d {
    stroke: var(--accent);
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* solid, so the hero's wave passes behind the buildings and each one reads as one shape: a pale indigo tint of the
     ground it stands on (--sky-ground, the About hero's white by default) */
  .b {
    fill: color-mix(in srgb, var(--accent) 6%, var(--sky-ground, var(--page)));
    stroke-opacity: 0.5;
    stroke-width: 1.25;
  }

  .d {
    fill: none;
    stroke-opacity: 0.32;
    stroke-width: 1;
  }

  /* drawn once on load, one city after another; the faint fill comes in as each outline closes */
  @media (prefers-reduced-motion: no-preference) {
    .b,
    .d {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation-name: draw, solid;
      animation-duration: 2.2s, 0s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1), linear;
      animation-delay: calc(0.3s + var(--c, 0) * 0.35s), calc(2.6s + var(--c, 0) * 0.35s);
      animation-fill-mode: forwards, forwards;
    }

    .b {
      fill-opacity: 0;
      animation-name: draw, fill, solid;
      animation-duration: 2.2s, 1.2s, 0s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1), cubic-bezier(0.22, 1, 0.36, 1), linear;
      animation-delay: calc(0.3s + var(--c, 0) * 0.35s), calc(1.4s + var(--c, 0) * 0.35s), calc(2.6s + var(--c, 0) * 0.35s);
      animation-fill-mode: forwards, forwards, forwards;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* once drawn, plain solid lines again, so no browser can leave one part dashed */
  @keyframes solid {
    to {
      stroke-dasharray: none;
    }
  }

  @keyframes fill {
    to {
      fill-opacity: 1;
    }
  }
</style>
