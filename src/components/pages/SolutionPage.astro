---
// A solution page tells one operational story:
//   1. Opening: the photograph of where it happens, the headline and the demo/booking buttons.
//   2. Context (warm ivory, one centred column): the problem in one sentence and how Tyll helps as three steps,
//      beside a second photograph set into the page with rounded corners. The composition is asymmetric (about
//      58/42) and varies from page to page: the photograph's side, shape and height change.
//   3. The product (charcoal or light stone): one real demo screen, large, explored part by part.
//   4. The outcome and the next step, then the other five solutions as photographs.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SolutionIcon from '../SolutionIcon.astro';
import ProductExplorer from '../ProductExplorer.astro';
import { solutions } from '../../content/solutions';
import { explore } from '../../content/explore';
import { demoLink } from '../../config/demo';
import { t, href, solutionKeys, type Locale, type SolutionKey } from '../../i18n';
import { ribbon } from '../../scripts/wave';

interface Props {
  lang: Locale;
  solution: SolutionKey;
}

const { lang, solution } = Astro.props;
const d = t(lang);
const p = d.solutionPage;
const s = solutions[solution];
const ex = explore[solution];
const name = s.name[lang];
const demo = demoLink(solution);
const others = solutionKeys.filter((k) => k !== solution);
const fill = (text: string) => text.replace('{name}', name);
// Vary the composition so the six pages don't share one silhouette: the photograph's side alternates, and its
// shape and height follow a three-step cycle
const order = solutionKeys.indexOf(solution);
const photoSide = order % 2 === 0 ? 'end' : 'start';
const variant = order % 3;
// The Tyll silver wave, the same flowing ribbon as on the homepage; this frame is also the still one
const wave = ribbon(0.32);
---

<Base lang={lang} page={solution} title={`${name} – Tyll`} description={`${s.headline[lang]} ${s.intro[lang]}`} overHero>
  <!-- 1. Opening -->
  <section class="open on-dark" data-hero aria-labelledby="sol-title">
    <Picture
      src={s.photo}
      alt={s.photoAlt[lang]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[828, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="open__photo"
      style={`object-position:${s.photoFocus}`}
    />
    <div class="open__shade" aria-hidden="true"></div>
    <div class="wrap open__inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={href('solutions', lang)}>{p.breadcrumb}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{name}</span>
      </nav>
      <h1 id="sol-title">{s.headline[lang]}</h1>
      <p class="open__intro">{s.intro[lang]}</p>
      <div class="open__actions">
        {
          demo && (
            <a class="btn btn--solid btn--lg" href={demo} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from={`${solution}-top`}>
              {fill(p.tryNamed)}
              <span class="visually-hidden"> {d.cta.newTab}</span>
            </a>
          )
        }
        <a class:list={['btn btn--lg', demo ? 'btn--line' : 'btn--solid']} href={href('book', lang)} data-track="book_call_click" data-track-from={`${solution}-top`}>
          {d.cta.book}
        </a>
      </div>
    </div>
  </section>

  <!-- 2. The problem and how Tyll helps, beside a photograph of where it happens -->
  <section class:list={['context', `context--photo-${photoSide}`, `context--v${variant}`]} aria-labelledby="sol-problem" data-rise-group>
    <div class="wrap context__grid">
      <div class="context__copy" data-rise>
        <p class="context__label">
          <span class="context__icon" aria-hidden="true"><SolutionIcon name={s.icon} /></span>
          <span id="sol-problem">{p.problemLabel}</span>
        </p>
        <p class="context__problem">{s.problem[lang]}</p>

        <h2 class="context__helps-title">{p.helps}</h2>
        <ol class="helps">
          {
            s.steps.map((st, i) => (
              <li>
                <span class="helps__k">{st.label[lang]}</span>
                <span class="helps__v">{s.helps[lang][i]}</span>
              </li>
            ))
          }
        </ol>
        {
          s.proof && (
            <p class="context__proof">
              {s.proof.text[lang]} <span class="context__proof-note">{s.proof.context[lang]}</span>{' '}
              <a href={s.proof.url} target="_blank" rel="noopener">
                {s.proof.source[lang]}
              </a>
            </p>
          )
        }
      </div>
      <div class="context__photo" data-rise>
        <Picture
          src={s.problemPhoto}
          alt={s.problemPhotoAlt[lang]}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[640, 960, 1280]}
          sizes="(max-width: 900px) 92vw, 40vw"
          loading="lazy"
          decoding="async"
          style={`object-position:${s.problemFocus}`}
        />
      </div>
    </div>
  </section>

  <!-- 3. The product: one real demo screen, explored part by part -->
  <section class:list={['product', `product--${ex.tone}`, ex.tone === 'dark' && 'on-dark']} data-dark={ex.tone === 'dark' ? '' : undefined} aria-labelledby="sol-product">
    <div class="product__wrap">
      <header class="product__head">
        <h2 id="sol-product">{s.walkTitle[lang]}</h2>
        <p>{p.walkIntro}</p>
      </header>
      <ProductExplorer lang={lang} solution={s} explore={ex} id={`ex-${solution}`} />
      {s.note && <p class="product__note">{s.note[lang]}</p>}
    </div>
  </section>

  <!-- 4. What it adds up to, and where to go next -->
  <section class="close" aria-labelledby="sol-final">
    <div class="wrap">
      <div class="cta on-dark">
        <svg class="cta__wave" viewBox="0 0 1440 800" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
          <defs>
            <linearGradient id={`cta-silver-${solution}`} x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#c8cdd4" stop-opacity="0" />
              <stop offset="0.35" stop-color="#c8cdd4" stop-opacity="0.3" />
              <stop offset="0.62" stop-color="#eef0f3" stop-opacity="0.8" />
              <stop offset="0.85" stop-color="#a3a9b2" stop-opacity="0.45" />
              <stop offset="1" stop-color="#c8cdd4" stop-opacity="0.15" />
            </linearGradient>
          </defs>
          <g fill="none" stroke={`url(#cta-silver-${solution})`} stroke-width="1">
            {wave.map((l) => <path d={l.d} opacity={l.opacity} vector-effect="non-scaling-stroke" />)}
          </g>
        </svg>
        <div class="cta__copy">
          <p class="cta__outcome">{ex.outcome[lang]}</p>
          <h2 id="sol-final">{fill(p.finalTitle)}</h2>
          <p class="cta__text">{d.home.invite.note}</p>
          <div class="close__actions">
            {
              demo && (
                <a class="btn btn--solid btn--lg" href={demo} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from={`${solution}-final`}>
                  {fill(p.tryNamed)}
                  <span class="visually-hidden"> {d.cta.newTab}</span>
                </a>
              )
            }
            <a class:list={['btn btn--lg', demo ? 'btn--line' : 'btn--solid']} href={href('book', lang)} data-track="book_call_click" data-track-from={`${solution}-final`}>
              {d.cta.book}
            </a>
          </div>
        </div>
      </div>
    </div>

    <nav class="wrap others" aria-labelledby="sol-others">
      <div class="others__head">
        <h3 id="sol-others">{p.others}</h3>
        <a class="others__all" href={href('solutions', lang)}>{d.cta.allSolutions}</a>
      </div>
      <ul>
        {
          others.map((k) => (
            <li>
              <a href={href(k, lang)}>
                <Picture
                  src={solutions[k].photo}
                  alt=""
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[360, 560]}
                  sizes="(max-width: 700px) 70vw, 230px"
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${solutions[k].photoFocus}`}
                />
                <span class="others__name">{solutions[k].name[lang]}</span>
                <span class="others__menu">{solutions[k].menu[lang]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</Base>

<style>
  /* 1. Opening */
  .open {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* Tall enough for the photograph to set the scene, short enough that the next section shows below it */
    min-height: clamp(520px, 72vh, 760px);
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark);
    isolation: isolate;
  }

  .open :global(picture),
  .open :global(.open__photo),
  .open__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .open :global(picture),
  .open :global(.open__photo) {
    z-index: -2;
  }

  .open :global(.open__photo) {
    object-fit: cover;
  }

  .open__shade {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(14, 15, 17, 0.74) 0%, rgba(14, 15, 17, 0.36) 55%, rgba(14, 15, 17, 0) 100%),
      linear-gradient(0deg, rgba(14, 15, 17, 0.62) 0%, transparent 55%);
  }

  :global([dir='rtl']) .open__shade {
    background:
      linear-gradient(270deg, rgba(14, 15, 17, 0.74) 0%, rgba(14, 15, 17, 0.36) 55%, rgba(14, 15, 17, 0) 100%),
      linear-gradient(0deg, rgba(14, 15, 17, 0.62) 0%, transparent 55%);
  }

  .open__inner {
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(3.5rem, 2rem + 6vh, 7rem);
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
  }

  .crumbs a {
    color: var(--on-dark-muted);
    text-underline-offset: 3px;
  }

  .crumbs a:hover {
    color: var(--on-dark);
  }

  .open h1 {
    max-width: 14ch;
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 6rem);
    font-weight: 380;
    letter-spacing: -0.042em;
    line-height: 1;
  }

  .open__intro {
    max-width: 34rem;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    color: rgba(244, 245, 247, 0.84);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    line-height: 1.5;
  }

  .open__actions,
  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
  }

  /* 2. Context: warm ivory across the page, the content in the centred column. Copy and photograph sit side by
     side with space between them (about 58/42); the photograph keeps its own shape and rounded corners. */
  .context {
    padding-block: clamp(4rem, 2.5rem + 5vw, 7.5rem);
    background: #f5f3ee;
  }

  .context__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 1rem + 3.5vw, 4.5rem);
    align-items: start;
  }

  .context--photo-start .context__copy {
    order: 2;
  }

  /* With the photograph first, the columns swap so the copy keeps the wider one */
  .context--photo-start .context__grid {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .context__photo {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #e8e4dc;
    box-shadow: 0 40px 80px -48px rgba(20, 22, 26, 0.45);
  }

  /* Page-to-page variation: shape, height and proportion */
  .context--v1 .context__grid {
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  }

  .context--v1.context--photo-start .context__grid {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  }

  .context--v1 .context__photo {
    aspect-ratio: 3 / 4;
    margin-top: clamp(2rem, 1rem + 4vw, 5.5rem);
  }

  .context--v2 .context__grid {
    align-items: center;
  }

  .context--v2 .context__photo {
    aspect-ratio: 5 / 6;
  }

  .context__photo :global(picture),
  .context__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .context__photo :global(img) {
    object-fit: cover;
  }

  .context__label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .context__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(20, 22, 26, 0.14);
    border-radius: 12px;
    color: var(--graphite);
  }

  .context__icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .context__problem {
    max-width: 21ch;
    margin-top: 1.25rem;
    color: var(--ink);
    font-size: clamp(1.875rem, 1.3rem + 2.1vw, 3rem);
    font-weight: 380;
    letter-spacing: -0.032em;
    line-height: 1.1;
  }

  .context__helps-title {
    margin-top: clamp(2.5rem, 1.75rem + 2.5vw, 3.75rem);
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  /* How Tyll helps: three steps in order, joined by a fine line, each action above its explanation */
  .helps {
    display: grid;
    gap: 1.6rem;
    max-width: 38rem;
    margin: 1.25rem 0 0;
    padding: 0;
    padding-inline: 1.9rem 0;
    list-style: none;
  }

  .helps li {
    position: relative;
    display: grid;
    gap: 0.3rem;
  }

  /* The step's point on the line */
  .helps li::before {
    content: '';
    position: absolute;
    top: 0.42rem;
    inset-inline-start: -1.9rem;
    width: 9px;
    height: 9px;
    border: 1px solid var(--steel);
    border-radius: 50%;
    background: #f5f3ee;
  }

  /* The line down to the next step */
  .helps li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(0.42rem + 12px);
    bottom: calc(-1.6rem + 0.42rem - 3px);
    inset-inline-start: calc(-1.9rem + 4px);
    width: 1px;
    background: rgba(20, 22, 26, 0.16);
  }

  /* Independent research beside the problem, always with its source */
  .context__proof {
    max-width: 36rem;
    margin-top: 1.5rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--silver);
    color: var(--graphite);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .context__proof-note {
    color: var(--steel);
  }

  .context__proof a {
    color: var(--steel);
    text-underline-offset: 3px;
  }

  .helps__k {
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .helps__v {
    max-width: 34rem;
    color: var(--graphite);
    line-height: 1.55;
  }

  /* A quiet entrance as the section comes into view (only with JavaScript, and never with reduced motion) */
  .context.is-rising [data-rise] {
    opacity: 0;
    translate: 0 18px;
    transition:
      opacity 0.9s var(--ease),
      translate 0.9s var(--ease);
  }

  .context.is-rising [data-rise].is-in {
    opacity: 1;
    translate: none;
  }

  .context.is-rising .context__photo {
    transition-delay: 0.12s;
  }

  /* 3. The product */
  .product {
    padding-block: clamp(4.5rem, 3rem + 5vw, 8rem);
    overflow: hidden;
  }

  .product--dark {
    background:
      radial-gradient(60% 40% at 50% 0%, rgba(255, 255, 255, 0.07), transparent 70%),
      linear-gradient(180deg, #1d1f23 0%, #15171a 100%);
    color: var(--on-dark);
  }

  .product--light {
    background:
      radial-gradient(60% 40% at 50% 0%, rgba(255, 255, 255, 0.7), transparent 70%),
      linear-gradient(180deg, #ecebe7 0%, #e3e2de 100%);
  }

  .product__wrap {
    max-width: calc(1280px + var(--gut) * 2);
    margin-inline: auto;
    padding-inline: var(--gut);
  }

  /* The heading keeps to the page's centred column, like the sections around it */
  .product__head {
    max-width: var(--wrap);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem clamp(2rem, 1rem + 4vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .product__head h2 {
    max-width: 18ch;
    font-size: var(--fs-h2);
  }

  .product__head p {
    max-width: 30rem;
    font-size: var(--fs-small);
    line-height: 1.55;
    opacity: 0.78;
  }

  .product__note {
    max-width: 44rem;
    margin-top: 2rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid currentColor;
    font-size: 0.9375rem;
    line-height: 1.55;
    opacity: 0.7;
  }

  /* 4. Outcome and next step: a charcoal panel with the Tyll silver wave, on a light band that keeps it apart from
     the footer, then the other solutions as a navigation strip */
  .close {
    padding-block: clamp(3.5rem, 2.5rem + 3vw, 5.5rem) clamp(3.5rem, 2.5rem + 3vw, 5rem);
    background: linear-gradient(180deg, #f6f5f2 0%, #efeeea 100%);
  }

  .cta {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(420px, 30vw + 160px, 560px);
    padding: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
    border-radius: 28px;
    background:
      radial-gradient(70% 90% at 100% 100%, rgba(200, 205, 212, 0.12), transparent 70%),
      linear-gradient(135deg, #202226 0%, #15171a 60%, #111315 100%);
    color: var(--on-dark);
    box-shadow: 0 50px 100px -60px rgba(20, 22, 26, 0.55);
    overflow: hidden;
    isolation: isolate;
  }

  /* The wave enters from the lower right and fades out before it reaches the text */
  .cta__wave {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0.9;
    -webkit-mask-image: linear-gradient(90deg, transparent 28%, rgba(0, 0, 0, 0.5) 52%, #000 75%);
    mask-image: linear-gradient(90deg, transparent 28%, rgba(0, 0, 0, 0.5) 52%, #000 75%);
    pointer-events: none;
  }

  :global([dir='rtl']) .cta__wave {
    transform: scaleX(-1);
  }

  .cta__copy {
    max-width: 36rem;
  }

  .cta__outcome {
    max-width: 30rem;
    color: rgba(244, 245, 247, 0.62);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .cta h2 {
    max-width: 16ch;
    margin-top: 1rem;
    font-size: clamp(2.25rem, 1.5rem + 2.8vw, 3.75rem);
    font-weight: 380;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .cta__text {
    max-width: 30rem;
    margin-top: 1.1rem;
    color: var(--on-dark-muted);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .others {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .others__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .others h3 {
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .others__all {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-underline-offset: 4px;
  }

  .others ul {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .others a {
    display: grid;
    gap: 0.3rem;
    color: var(--ink);
    text-decoration: none;
  }

  .others a :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    object-fit: cover;
    transition:
      transform 0.6s var(--ease),
      filter 0.6s var(--ease);
  }

  .others a :global(picture) {
    display: block;
    margin-bottom: 0.6rem;
    border-radius: 12px;
    overflow: hidden;
  }

  .others a:hover :global(img) {
    transform: scale(1.03);
  }

  .others__name {
    font-weight: 500;
  }

  .others a:hover .others__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .others__menu {
    color: var(--steel);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  @media (max-width: 1100px) {
    .others ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .context__grid,
    .context--photo-start .context__grid,
    .context--v1 .context__grid,
    .context--v1.context--photo-start .context__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2.5rem, 2rem + 3vw, 3.5rem);
    }

    .context--photo-start .context__copy {
      order: 0;
    }

    .context__photo,
    .context--v1 .context__photo,
    .context--v2 .context__photo {
      aspect-ratio: 3 / 2;
      margin-top: 0;
    }

    .product__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .others ul {
      display: flex;
      gap: 1rem;
      margin-inline: calc(var(--gut) * -1);
      padding-inline: var(--gut);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .others li {
      flex: 0 0 64%;
      scroll-snap-align: start;
    }

    .context__photo,
    .context--v1 .context__photo,
    .context--v2 .context__photo {
      aspect-ratio: 4 / 3;
      border-radius: 16px;
    }
  }

  @media (max-width: 700px) {
    .open__shade,
    :global([dir='rtl']) .open__shade {
      background: linear-gradient(0deg, rgba(14, 15, 17, 0.82) 0%, rgba(14, 15, 17, 0.5) 55%, rgba(14, 15, 17, 0.28) 100%);
    }
  }

  @media (max-width: 640px) {
    .cta {
      padding-bottom: 8rem;
      border-radius: 20px;
    }

    /* On phones the wave runs along the bottom edge, below the buttons */
    .cta__wave {
      top: auto;
      height: 9rem;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 60%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 60%);
    }

    .open__actions :global(.btn),
    .close__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .others a :global(img) {
      transition: none;
    }
  }
</style>

<script>
  import { ribbon, PERIOD } from '../../scripts/wave';

  // The context section's copy and photograph rise gently into place the first time they are seen
  const group = document.querySelector<HTMLElement>('[data-rise-group]');
  if (group && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    group.classList.add('is-rising');
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }),
      { rootMargin: '0px 0px -12% 0px' },
    );
    group.querySelectorAll('[data-rise]').forEach((el) => io.observe(el));
  }

  // The wave flows like the homepage's: redrawn about 30 times a second, only while on screen, and not at all
  // when reduced motion is asked for (the server-rendered frame stays)
  const svg = document.querySelector<SVGSVGElement>('.cta__wave');
  if (svg) {
    const paths = [...svg.querySelectorAll('path')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let raf = 0;
    let last = 0;
    let t = 0.32 * PERIOD;
    const draw = (now: number) => {
      raf = requestAnimationFrame(draw);
      if (now - last < 33) return;
      t = (t + Math.min(now - last, 100) / 1000) % PERIOD;
      last = now;
      ribbon(t / PERIOD).forEach((l, i) => paths[i]?.setAttribute('d', l.d));
    };
    const sync = () => {
      cancelAnimationFrame(raf);
      if (visible && !reduce.matches) {
        last = performance.now();
        raf = requestAnimationFrame(draw);
      }
    };
    new IntersectionObserver(([e]) => ((visible = e.isIntersecting), sync())).observe(svg);
    reduce.addEventListener('change', sync);
  }
</script>
