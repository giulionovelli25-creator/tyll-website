---
// One step's picture on the How it works page (round 5, 25 Nov 2026, split out of HowItWorksPage.astro so the page can
// show it twice: inline under its step on phones, and in the sticky stage beside the steps on desktops). Drawn in
// HTML and CSS on a photograph of that moment, decorative, with fictional data: the booking card, the free
// purchasing report, three POS systems joined to Tyll read only, and the morning brief.
import { Picture } from 'astro:assets';
import Logo from '../Logo.astro';
import MorningCard from '../MorningCard.astro';
import { t, type Locale } from '../../i18n';
import { logos } from '../../config/integrations';

interface Props {
  lang: Locale;
  i: number;
  title: string;
  photo: { src: ImageMetadata; focus: string };
  /** The stage's copies load eagerly once the stage shows; the inline copies lazily */
  eager?: boolean;
}

const { lang, i, title, photo, eager = false } = Astro.props;
const d = t(lang);
const p = d.howPage;
const chosen = 1; // the booked time
const systems = ['SumUp', 'Oracle MICROS Simphony', 'Lightspeed'].map((name) => logos.find((l) => l.name === name)!);
---

<div class="vis" aria-hidden="true">
    <div class="vis__bg">
      <Picture src={photo.src} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 720, 1040, 1400]} sizes="(max-width: 860px) 92vw, 540px" loading={eager ? 'eager' : 'lazy'} decoding="async" style={`object-position: ${photo.focus}`} />
    </div>
    {i === 0 && (
      <div class="cal">
        <p class="cal__head">
          <svg viewBox="0 0 24 24">
            <rect x="3.5" y="5" width="17" height="15" rx="2.5" />
            <path d="M3.5 10h17M8 3v4M16 3v4" />
          </svg>
          {p.call.title}
        </p>
        <p class="cal__day">{p.call.day}</p>
        <ul class="cal__slots" dir="ltr">
          {p.call.slots.map((slot, k) => (
            <li class:list={[k === chosen && 'is-on']}>{slot}</li>
          ))}
        </ul>
      </div>
    )}
    {i === 1 && (
      <div class="cal rep">
        <p class="cal__head">
          <svg viewBox="0 0 24 24">
            <path d="M7 3.5h7l4 4V20a.5.5 0 0 1-.5.5h-10A.5.5 0 0 1 7 20Z" />
            <path d="M14 3.5V8h4M9.5 12.5h5M9.5 16h5" />
          </svg>
          {title}
        </p>
        <ul class="rep__points">
          {d.home.report.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    )}
    {i === 2 && (
      <div class="pos">
        <ul class="pos__from">
          {systems.map((l) => (
            <li>
              <span class="pos__logo">
                <img src={`/logos/integrations/${l.file}`} alt="" height={Math.round(l.height * 0.75)} width={Math.round(l.height * 0.75 * l.aspect)} loading="lazy" decoding="async" />
                {l.text && <small>{l.text}</small>}
              </span>
            </li>
          ))}
        </ul>
        <div class="pos__lines">
          <svg viewBox="0 0 100 120" preserveAspectRatio="none">
            <path d="M0 20 C50 20 50 60 100 60 M0 60 H100 M0 100 C50 100 50 60 100 60" />
          </svg>
          <span class="pos__pill">
            <span class="pos__dot" />
            {p.readOnly}
          </span>
        </div>
        <div class="pos__tyll">
          <Logo label="" />
        </div>
      </div>
    )}
    {i === 3 && (
      <div class="list">
        <MorningCard lang={lang} link={false} />
      </div>
    )}
  </div>

<style>
  /* The picture, at full size, on a photograph of that moment; a soft shade keeps the white cards clear of it */
  .vis {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 26rem;
    padding: 2.25rem 2rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--night-2);
    box-shadow: var(--shadow-2);
  }

  .vis__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .vis__bg::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(var(--black-rgb) / 0.06), rgb(var(--black-rgb) / 0.32));
    content: '';
  }

  .vis__bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-grade);
  }

  /* Narrower windows and phones: the cards inside are drawn a little smaller */
  @media (max-width: 1100px) {
    .vis {
      min-height: 22rem;
      padding: 1.5rem 1.25rem;
    }

    .vis > :not(.vis__bg) {
      zoom: 0.9;
    }
  }

  /* 1. The booking card */
  .cal {
    width: min(100%, 20rem);
    padding: 1.4rem;
    border: 1px solid var(--sand-300);
    border-radius: 16px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-2);
  }

  .cal__head {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .cal__head svg {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cal__day {
    margin: 1.1rem 0 0;
    color: var(--steel);
    font-size: 0.9375rem;
  }

  .cal__slots {
    display: grid;
    gap: 0.55rem;
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cal__slots li {
    padding: 0.65rem 1rem;
    border: 1px solid var(--sand-600);
    border-radius: 10px;
    font: 500 1rem/1.3 var(--mono);
    text-align: center;
  }

  .cal__slots li.is-on {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  /* 2. The free purchasing report: its three points, each ticked */
  .rep__points {
    display: grid;
    gap: 0.7rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .rep__points li {
    position: relative;
    padding-inline-start: 1.6rem;
    color: var(--graphite);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .rep__points li::before {
    position: absolute;
    top: 0.3em;
    inset-inline-start: 0;
    width: 0.95rem;
    height: 0.55rem;
    /* a tick reads the same in Arabic, so its strokes stay physical; only its place follows the reading direction */
    border-bottom: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
    transform: rotate(-45deg);
    content: '';
  }

  /* 3. Three systems joined to Tyll, read only */
  /* on the photograph, the diagram sits on its own white card */
  .pos {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(4rem, 1fr) auto;
    align-items: stretch;
    width: 100%;
    max-width: 30rem;
    padding: 0.9rem 1.1rem;
    border-radius: 18px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-2);
  }

  .pos__from {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pos__from li {
    display: grid;
    align-items: center;
    padding-block: 0.4rem;
  }

  .pos__logo {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
    min-width: 9.5rem;
    min-height: 3.25rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--sand-300);
    border-radius: 12px;
    background: var(--paper);
    box-shadow: var(--shadow-1);
  }

  /* the makers' own logos, in grey to keep the page black and white */
  .pos__logo img {
    width: auto;
    max-width: 7rem;
    filter: grayscale(1) contrast(1.1);
  }

  .pos__logo small {
    color: var(--steel);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .pos__lines {
    position: relative;
  }

  .pos__lines svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgb(var(--ink-rgb) / 0.4);
    stroke-width: 1.5;
  }

  .pos__lines path {
    vector-effect: non-scaling-stroke;
  }

  :global([dir='rtl']) .pos__lines svg {
    transform: scaleX(-1);
  }

  .pos__pill {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--sand-600);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .pos__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .pos__tyll {
    display: grid;
    place-items: center;
    align-self: center;
    padding: 1.1rem 1.25rem;
    border-radius: 16px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: var(--shadow-2);
  }

  .pos__tyll :global(svg) {
    width: 4.5rem;
    height: auto;
  }

  /* 4. The morning brief */
  .list {
    width: min(100%, 26rem);
  }

  /* Beside the steps on desktops the picture has a fixed height: the morning brief, the tallest card, is drawn a little
     smaller so all of it shows */
  @media (min-width: 1024px) {
    .list {
      zoom: 0.84;
    }
  }

  /* Narrow: the "Read only" label moves under the picture, clear of the logos */
  @media (max-width: 560px) {
    .pos {
      padding-bottom: 2.75rem;
    }

    .pos__lines {
      position: static;
    }

    .pos__pill {
      top: auto;
      bottom: 0;
      transform: translateX(-50%);
    }

    .pos__logo {
      flex-direction: column;
      gap: 0.15rem;
      min-width: 7.5rem;
      min-height: 2.75rem;
      padding: 0.5rem 0.6rem;
    }
  }

  @media (max-width: 420px) {
    .pos {
      grid-template-columns: auto minmax(2rem, 1fr) auto;
    }

    .pos__logo {
      min-width: 0;
    }

    .pos__logo img {
      max-width: 5.5rem;
    }

    .pos__tyll {
      padding: 0.9rem;
    }

    .pos__tyll :global(svg) {
      width: 3.25rem;
    }
  }

  @media (max-width: 860px) {
    .vis {
      min-height: 16rem;
      padding: 1.5rem 1rem;
    }

    .vis > :not(.vis__bg) {
      zoom: 0.92;
    }
  }
</style>
