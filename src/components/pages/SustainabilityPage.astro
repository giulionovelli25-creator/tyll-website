<script>
  const root = document.querySelector<HTMLElement>('[data-sus]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const armed = !!root && !still && 'IntersectionObserver' in window;
  const headerH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;

  // A figure counts up from zero in its own format (1,05 or 1.05, 19 %, 8 to 10%, ~7:1): every number in it moves,
  // except one after a colon (the 1 of ~7:1). The real figure is in the page for screen readers; this copy is hidden.
  const countUp = (el: HTMLElement) => {
    const final = el.dataset.final ?? (el.dataset.final = el.textContent ?? '');
    const parts = [...final.matchAll(/\d+(?:[.,]\d+)?/g)];
    if (!parts.length) return;
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / 800);
      const e = 1 - (1 - t) ** 3;
      let out = '';
      let last = 0;
      for (const m of parts) {
        const raw = m[0];
        const at = m.index ?? 0;
        out += final.slice(last, at);
        if (at > 0 && final[at - 1] === ':') out += raw;
        else {
          const sep = raw.match(/[.,]/)?.[0];
          const decimals = sep ? raw.split(sep)[1].length : 0;
          const value = (parseFloat(raw.replace(',', '.')) * e).toFixed(decimals);
          out += sep === ',' ? value.replace('.', ',') : value;
        }
        last = at + raw.length;
      }
      el.textContent = out + final.slice(last);
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  // Arm the page (parts wait out of view) and let each part rise in once as it comes into view; the bigger picture's
  // figures count up as they arrive
  if (root && armed) {
    root.classList.add('is-armed');
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          e.target.querySelectorAll<HTMLElement>('.fact__big [data-count]').forEach(countUp);
          // when its drawing has finished, it becomes plain solid lines
          setTimeout(() => e.target.classList.add('is-drawn'), 2000);
          io.unobserve(e.target);
        }),
      { threshold: 0.1, rootMargin: '0px 0px -5% 0px' },
    );
    root.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  }

  // The board of four figures. Where the stage fits the screen, it holds still and the scroll through the section
  // brings each figure in turn (a figure every 0.6 screen), its drawing playing once, within a second, the first time
  // it arrives; the line under it shows which of the four. Elsewhere the four stand one under another and each plays
  // once as it comes into view.
  const back = root?.querySelector<HTMLElement>('[data-back]');
  if (back && armed) {
    const stats = [...back.querySelectorAll<HTMLElement>('[data-stat]')];
    const steps = [...back.querySelectorAll<HTMLElement>('.steps li')];
    const track = back.querySelector<HTMLElement>('.back__track')!;
    const inner = back.querySelector<HTMLElement>('.back__inner')!;
    let current = -1;
    // each figure plays once, the first time it arrives; coming back to it, it is simply there, finished
    const play = (el: HTMLElement) => {
      if (el.classList.contains('is-on')) return;
      el.classList.add('is-on');
      el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
    };
    const fits = () => {
      back.classList.add('is-pinned');
      const ok = innerHeight >= 600 && inner.offsetHeight <= innerHeight - headerH() - 24;
      if (!ok) back.classList.remove('is-pinned');
      return ok;
    };
    const show = (n: number) => {
      if (n === current) return;
      current = n;
      stats.forEach((s, i) => {
        s.classList.toggle('is-current', i === n);
        s.classList.toggle('is-past', i < n);
      });
      steps.forEach((s, i) => {
        s.classList.toggle('is-done', i < n);
        s.classList.toggle('is-current', i === n);
      });
      play(stats[n]);
    };
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting || pinned) return;
          play(e.target as HTMLElement);
          io.unobserve(e.target);
        }),
      { threshold: 0.25 },
    );
    let pinned = fits();
    stats[0].classList.add('is-current');
    steps[0]?.classList.add('is-current');
    if (!pinned) stats.forEach((s) => io.observe(s));
    let raf = 0;
    const update = () => {
      raf = 0;
      if (!pinned) return;
      const r = track.getBoundingClientRect();
      // the first figure plays when the board comes into view, not before
      if (current < 0 && r.top > innerHeight * 0.55) return;
      const run = r.height - (innerHeight - headerH());
      const p = Math.min(1, Math.max(0, (headerH() - r.top) / run));
      show(Math.min(stats.length - 1, Math.floor(p * stats.length)));
    };
    addEventListener('scroll', () => (raf ||= requestAnimationFrame(update)), { passive: true });
    addEventListener('resize', () => {
      const was = pinned;
      pinned = fits();
      if (!pinned && was) stats.forEach((s) => s.classList.add('is-on'));
      update();
    });
    update();
  }
</script>
