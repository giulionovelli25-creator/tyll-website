---
// A solution page asks one question beside a photograph of the work it is about, shows the real system answering it
// in a film, gives one number or statement the site already makes, and asks for a demo. Each solution wears the
// colour that feature has in the product (`tone` in solutions.ts, tokens in global.css).
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import DemoFilm from '../DemoFilm.astro';
import SilverWave from '../SilverWave.astro';
import SolutionIcon from '../SolutionIcon.astro';
import { solutions } from '../../content/solutions';
import { explore } from '../../content/explore';
import { demoLink } from '../../config/demo';
import { t, href, solutionKeys, type Locale, type SolutionKey } from '../../i18n';

interface Props {
  lang: Locale;
  solution: SolutionKey;
}

const { lang, solution } = Astro.props;
const d = t(lang);
const p = d.solutionPage;
const s = solutions[solution];
const ex = explore[solution];
const name = s.name[lang];
const demo = demoLink(solution, lang);
const others = solutionKeys.filter((k) => k !== solution);

// One word or phrase of the question in the solution's colour
const headline = s.headline[lang];
const mark = s.mark[lang];
const at = headline.indexOf(mark);
const [before, marked, after] = at < 0 ? [headline, '', ''] : [headline.slice(0, at), mark, headline.slice(at + mark.length)];

// The number or statement after the film. Never new text: a homepage number, a line of the hotel story or a FAQ answer.
const why = d.home.why;
const pr = s.proof;
const number = pr.kind === 'number' ? why.cards[pr.card] : undefined;
const faqItem = pr.kind === 'faq' ? d.faq.groups.flatMap((g) => g.items).find((i) => i.id === pr.id) : undefined;
const say =
  pr.kind === 'story'
    ? { ask: d.home.tour.steps[pr.step].headline, answer: d.home.tour.steps[pr.step].problem }
    : faqItem
      ? { ask: faqItem.q, answer: faqItem.a }
      : undefined;
---

<Base lang={lang} page={solution} title={`${name} | Tyll`} description={`${s.headline[lang]} ${s.intro[lang]}`}>
  <section class="sol" data-accent={s.tone} aria-labelledby="sol-title">
    <SilverWave phase={0.2} class="sol__wave" />
    <div class="wrap sol__head">
      <div class="sol__copy">
        <p class="sol__name"><span class="sol__chip"><SolutionIcon name={s.icon} class="sol__icon" /></span>{name}</p>
        <h1 id="sol-title" class="display">{before}{marked && <span class="sol__mark">{marked}</span>}{after}</h1>
        <p class="sol__intro">{s.intro[lang]}</p>
        <div class="sol__actions">
          <a class="btn btn--solid btn--lg sol__book" href={href('book', lang)} data-track="book_demo_click" data-track-from={`${solution}-hero`}>
            {d.cta.book}
          </a>
          {
            demo && (
              <a class="btn btn--line btn--lg" href={demo} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from={`${solution}-hero`}>
                {t(lang).hero.try}
                <span class="visually-hidden"> {d.cta.newTab}</span>
              </a>
            )
          }
        </div>
      </div>
      <div class="sol__photo">
        <Picture
          src={s.pagePhoto}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 900px) 92vw, 560px"
          alt=""
          loading="eager"
          decoding="async"
          style={`object-position: ${s.pagePhotoFocus}`}
        />
      </div>
    </div>
    <div class="wrap sol__film" id="film">
      <DemoFilm lang={lang} solutionKey={solution} name={name} spots={ex.spots}>
        <section class="see" aria-labelledby="see-title">
          <h2 id="see-title" class="see__title">{p.seeTitle}</h2>
          <ol class="see__list" role="list">
            {
              s.see.map((item, i) => (
                <li class="see__item">
                  <span class="see__num" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3>{item.title[lang]}</h3>
                    <p>{item.text[lang]}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>
      </DemoFilm>
      {(s.note || p.demoEnglish) && <p class="sol__note">{[s.note?.[lang], p.demoEnglish].filter(Boolean).join(' ')}</p>}
    </div>
  </section>

  {
    (number || say) && (
      <section class="proof" data-accent={s.tone} aria-labelledby="proof-title">
        <div class="wrap proof__grid">
          {number && (
            <>
              <div class="proof__lead">
                {number.label && <p class="proof__label">{number.label}</p>}
                <p class="proof__figure" aria-hidden="true">
                  <span dir="ltr">{number.figure}</span>
                </p>
              </div>
              <div class="proof__body">
                <h2 id="proof-title" class="proof__say">
                  <span class="visually-hidden">{number.figure} </span>
                  {number.title}
                </h2>
                <p class="proof__text">{number.text}</p>
                <p class="proof__source">
                  {number.sourceUrl ? (
                    <>
                      {why.source}:{' '}
                      <a href={number.sourceUrl} target="_blank" rel="noopener">
                        {number.sourceName}
                        <span class="visually-hidden"> {d.cta.newTab}</span>
                      </a>
                    </>
                  ) : (
                    number.sourceName
                  )}
                </p>
              </div>
            </>
          )}
          {say && (
            <>
              <div class="proof__lead">
                <h2 id="proof-title" class="proof__ask">{say.ask}</h2>
              </div>
              <div class="proof__body">
                <p class="proof__say">{say.answer}</p>
              </div>
            </>
          )}
        </div>
      </section>
    )
  }

  <section class="close on-dark" data-dark aria-labelledby="sol-final">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap close__inner">
      <h2 id="sol-final" class="display">{d.home.invite.title}</h2>
      <a class="btn btn--solid btn--lg sol__book" href={href('book', lang)} data-track="book_demo_click" data-track-from={`${solution}-final`}>
        {d.cta.book}
      </a>
    </div>
  </section>

  <nav class="wrap others" aria-label={p.others}>
    <ul>
      {others.map((k) => <li><a href={href(k, lang)}>{solutions[k].name[lang]}</a></li>)}
      <li><a class="others__all" href={href('solutions', lang)}>{d.cta.allSolutions}</a></li>
    </ul>
  </nav>
</Base>

<style>
  .sol {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + var(--page-top));
    padding-bottom: var(--section-y);
  }

  .sol__head,
  .sol__film {
    position: relative;
    z-index: 1;
  }

  /* The question at the start, a photograph of the work at the end */
  .sol__head {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  /* A faint still wave behind the question, fading out before the film */
  .sol :global(.sol__wave) {
    height: 62%;
    top: 0;
    opacity: 0.4;
    -webkit-mask-image: linear-gradient(180deg, var(--black) 40%, transparent 100%);
    mask-image: linear-gradient(180deg, var(--black) 40%, transparent 100%);
  }

  /* The solution's name in its own colour, its icon on a faint square of it */
  .sol__name {
    display: inline-flex;
    gap: 0.7rem;
    align-items: center;
    max-width: none;
    margin-bottom: var(--s-3);
    color: var(--acc);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .sol__chip {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(var(--acc-rgb) / 0.16);
    border-radius: 12px;
    background: var(--acc-wash);
  }

  .sol__name :global(.sol__icon) {
    width: 20px;
    height: 20px;
  }

  .sol h1 {
    font-size: clamp(2.375rem, 1.6rem + 2.6vw, 4rem);
    line-height: 1.08;
  }

  .sol__mark {
    color: var(--acc);
  }

  .sol__intro {
    max-width: 34rem;
    margin: var(--s-3) 0 0;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.4;
  }

  .sol__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }

  .sol__book {
    min-height: 60px;
    padding-inline: 2.25rem;
    font-size: 1.1875rem;
  }

  /* The photograph, with a block of the solution's colour set a little behind it */
  .sol__photo {
    --off: clamp(0.75rem, 0.4rem + 1vw, 1.25rem);
    position: relative;
    margin-block-end: var(--off);
    margin-inline-end: var(--off);
  }

  .sol__photo::before {
    position: absolute;
    inset-block: var(--off) calc(var(--off) * -1);
    inset-inline: var(--off) calc(var(--off) * -1);
    border-radius: var(--radius-lg);
    background: var(--acc-soft);
    content: '';
  }

  .sol__photo :global(picture) {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--cloud);
    box-shadow: var(--shadow-2);
  }

  .sol__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: var(--photo-grade);
  }

  .sol__film {
    margin-top: var(--band-y);
  }

  /* What you are about to see: what comes in, what Tyll shows, what you do with it. One row on the tinted block,
     above the screen and as wide as it, so their edges line up. */
  .see {
    position: relative;
    max-width: var(--film-w, 68rem);
    margin: 0 auto var(--s-4);
  }

  .see__title {
    margin: 0 0 var(--s-3);
    color: var(--acc);
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0;
  }

  .see__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .see__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.875rem;
    align-items: start;
    padding: 0.25rem 1.5rem;
  }

  .see__item:first-child {
    padding-inline-start: 0;
  }

  .see__item + .see__item {
    border-inline-start: 1px solid rgb(var(--acc-rgb) / 0.2);
  }

  .see__num {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--acc);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
  }

  .see h3 {
    margin: 0;
    font-family: var(--font);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .see p {
    max-width: none;
    margin: 0.25rem 0 0;
    color: var(--steel);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .sol__note {
    max-width: none;
    margin-top: var(--s-3);
    color: var(--text-3);
    font-size: var(--fs-small);
    text-align: center;
  }

  /* One number or statement the site already makes, on a light grey band: the number or the question at the start,
     what it means at the end */
  .proof {
    padding-block: var(--band-y);
    background: var(--page-deep);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-3) clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .proof__lead {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  .proof__label {
    margin: 0;
    padding: 0.3rem 0.75rem 0.35rem;
    border: 1px solid rgb(var(--acc-rgb) / 0.4);
    border-radius: var(--pill);
    color: var(--acc);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
  }

  .proof__figure {
    max-width: none;
    margin: 0;
    color: var(--acc);
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 2.5rem + 8vw, 9.5rem);
    font-weight: 300;
    line-height: 0.95;
    white-space: nowrap;
  }

  /* the question, under a short rule of the solution's colour */
  .proof__ask {
    margin: 0;
    padding-top: var(--s-3);
    border-top: 2px solid var(--acc);
    color: var(--acc);
    font-family: var(--font);
    font-size: var(--fs-lead);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .proof__say {
    max-width: 24ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 300;
    line-height: 1.15;
  }

  .proof__text {
    max-width: 34rem;
    margin: var(--s-2) 0 0;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.45;
  }

  .proof__source {
    max-width: 34rem;
    margin: var(--s-3) 0 0;
    color: var(--steel);
    font-size: var(--fs-caption);
    line-height: 1.45;
  }

  .proof__source a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .proof__source a:hover {
    text-decoration-thickness: 2px;
  }

  .close {
    position: relative;
    overflow: hidden;
    padding-block: var(--band-y);
    background: var(--night-1);
    color: var(--text-1);
  }

  .close__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .close h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem);
  }

  /* Six links: one row on desktop, three and three on tablets, two by two on phones, so none is left alone on a row */
  .others ul {
    display: grid;
    grid-template-columns: repeat(6, auto);
    justify-content: center;
    justify-items: center;
    gap: 0.5rem var(--s-4);
    margin: 0;
    padding: var(--intro-gap) 0;
    list-style: none;
    text-align: center;
  }

  @media (max-width: 1100px) {
    .others ul {
      grid-template-columns: repeat(3, minmax(0, 13rem));
    }
  }

  @media (max-width: 760px) {
    .others ul {
      grid-template-columns: repeat(2, minmax(0, 13rem));
    }
  }

  .others a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--ink);
    font-size: var(--fs-body);
    text-decoration: none;
  }

  .others a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .others__all {
    color: var(--steel);
  }

  /* Tablets and phones: the question, then the photograph under it */
  @media (max-width: 900px) {
    .sol__head {
      grid-template-columns: minmax(0, 1fr);
    }

    .sol h1 {
      max-width: 20ch;
    }

    .sol__photo :global(img) {
      aspect-ratio: 3 / 2;
    }

    .proof__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .proof__say {
      max-width: 28ch;
    }
  }

  @media (max-width: 820px) {
    .see__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .see__item,
    .see__item:first-child {
      padding: 0.9rem 0;
    }

    .see__item:first-child {
      padding-top: 0;
    }

    .see__item + .see__item {
      border-inline-start: 0;
      border-top: 1px solid rgb(var(--acc-rgb) / 0.2);
    }
  }

  @media (max-width: 640px) {
    .sol__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
