---
// One of the Sustainability page's six charts (round 3, 20 Nov 2026), drawn in plain HTML and CSS in the page's teal.
// Used twice per stat: in the sticky stage on desktop, and above its text on phones and with reduced motion. Each is
// decorative (aria-hidden): the figure, sentence and source beside it carry the meaning. It starts empty only while the
// page runs motion (`.sus-motion` on <html>) and plays once when it gets `.is-in`; otherwise it is drawn final.
import type { SustainabilityCopy } from '../content/sustainability';

interface Props {
  kind: 'bars' | 'grid' | 'target' | 'seven' | 'less' | 'dots';
  c: SustainabilityCopy;
  class?: string;
  i?: number;
}

const { kind, c, class: cls, i } = Astro.props;
---

<div class:list={['chart', `chart--${kind}`, cls]} data-chart={kind} data-i={i} aria-hidden="true" style={kind === 'target' ? `--cut:${c.target.cut / 100}` : undefined}>
  {
    kind === 'bars' && (
      <div class="bars">
        <div>
          <p class="bars__head">
            <span>{c.bars.food}</span>
            <b dir="auto">{c.bars.times[0]}</b>
          </p>
          <div class="bars__track">
            <span class="bars__fill bars__fill--food" />
          </div>
          <p class="bars__value">{c.bars.foodValue}</p>
        </div>
        <div>
          <p class="bars__head">
            <span>{c.bars.aviation}</span>
            <b dir="auto">{c.bars.times[1]}</b>
          </p>
          <div class="bars__track">
            <span class="bars__fill bars__fill--air" />
          </div>
        </div>
      </div>
    )
  }
  {
    kind === 'grid' && (
      <ol class="squares">
        {Array.from({ length: 100 }, (_, n) => (
          <li class:list={[n < 18 && 'on']} style={`--i:${n}`} />
        ))}
      </ol>
    )
  }
  {
    kind === 'target' && (
      <div class="target">
        <div class="target__line">
          <span class="target__tick">{c.target.from}</span>
          <span class="target__tick target__tick--end">{c.target.to}</span>
        </div>
        <div class="target__bar" />
        <div class="target__bar target__bar--goal" />
        <p class="target__cut" dir="ltr">
          −{c.target.figure}
        </p>
      </div>
    )
  }
  {
    kind === 'seven' && (
      <div class="cols">
        <span class="cols__col">
          <b>1</b>
          <span class="cols__bar cols__bar--one" />
        </span>
        <span class="cols__col">
          <b>7</b>
          <span class="cols__bar cols__bar--seven" />
        </span>
      </div>
    )
  }
  {
    kind === 'less' && (
      <div class="shrink">
        <span class="shrink__bar" />
      </div>
    )
  }
  {
    kind === 'dots' && (
      <ol class="dots">
        {Array.from({ length: 10 }, (_, n) => (
          <li class:list={[n < 7 && 'on']} style={`--i:${n}`} />
        ))}
      </ol>
    )
  }
</div>

<style>
  .chart {
    --g: var(--demo-teal);
    --g-rgb: var(--demo-teal-rgb);
    --dur: 1s;
    --out: cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
    max-width: 30rem;
  }

  /* Food loss and waste against aviation */
  .bars {
    display: grid;
    gap: var(--s-4);
  }

  .bars__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: none;
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .bars__head b {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
  }

  .bars__track {
    height: 2.75rem;
  }

  .bars__fill {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0 6px 6px 0;
    background: var(--g);
    transform-origin: left center;
    transform: scaleX(var(--to));
  }

  :global([dir='rtl']) .bars__fill {
    border-radius: 6px 0 0 6px;
    transform-origin: right center;
  }

  .bars__fill--food {
    --to: 1;
  }

  /* the lighter step of the same teal, at least 3:1 against white, and labelled */
  .bars__fill--air {
    --to: 0.2;
    background: rgb(var(--g-rgb) / 0.68);
  }

  .bars__value {
    max-width: none;
    margin: 0.5rem 0 0;
    color: var(--graphite);
    font-size: 0.9375rem;
  }

  /* 18 squares in 100 */
  .squares {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 6px;
    max-width: 22rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .squares li {
    aspect-ratio: 1;
    border: 1px solid rgb(var(--g-rgb) / 0.25);
    border-radius: 3px;
  }

  .squares li.on {
    border-color: var(--g);
    background: var(--g);
  }

  /* The target: the bar shortens by the target */
  .target__line {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--s-3);
    padding-top: 0.9rem;
    border-top: 2px solid var(--ink);
    color: var(--steel);
    font-size: 0.9375rem;
  }

  .target__bar {
    height: 2.25rem;
    border-radius: 6px;
    background: rgb(var(--g-rgb) / 0.35);
  }

  .target__bar--goal {
    margin-top: 0.75rem;
    background: var(--g);
    transform-origin: left center;
    transform: scaleX(calc(1 - var(--cut)));
  }

  :global([dir='rtl']) .target__bar--goal {
    transform-origin: right center;
  }

  .target__cut {
    max-width: none;
    margin: 0.6rem 0 0;
    color: var(--g);
    font-weight: 600;
    text-align: end;
  }

  /* 1 against 7 */
  .cols {
    display: flex;
    gap: 1.25rem;
    align-items: flex-end;
    height: 12rem;
  }

  .cols__col {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 0.3rem;
    width: 3.5rem;
    height: 100%;
  }

  .cols__col b {
    font-size: 0.9375rem;
  }

  .cols__bar {
    width: 100%;
    border-radius: 6px 6px 0 0;
    background: var(--g);
    transform-origin: bottom;
  }

  .cols__bar--one {
    height: calc((100% - 1.6rem) / 7);
    background: rgb(var(--g-rgb) / 0.68);
  }

  .cols__bar--seven {
    height: calc(100% - 1.6rem);
  }

  /* 21% less: the bar gives up a fifth, its old length left as an outline */
  .shrink__bar {
    position: relative;
    display: block;
    width: 100%;
    height: 2.75rem;
    border: 1px dashed rgb(var(--g-rgb) / 0.5);
    border-radius: 6px;
  }

  .shrink__bar::before {
    position: absolute;
    inset: -1px;
    border-radius: 6px;
    background: var(--g);
    transform-origin: left center;
    transform: scaleX(0.79);
    content: '';
  }

  :global([dir='rtl']) .shrink__bar::before {
    transform-origin: right center;
  }

  /* Seven dots in ten */
  .dots {
    display: grid;
    grid-template-columns: repeat(5, 2.25rem);
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dots li {
    aspect-ratio: 1;
    border: 1.5px solid rgb(var(--g-rgb) / 0.4);
    border-radius: 50%;
  }

  .dots li.on {
    border-color: var(--g);
    background: var(--g);
  }

  /* Motion: empty until `.is-in`, then once, ease-out; never under reduced motion (the class is never set) */
  :global(.sus-motion) .chart:not(.is-in) .bars__fill,
  :global(.sus-motion) .chart:not(.is-in) .target__bar--goal,
  :global(.sus-motion) .chart:not(.is-in) .shrink__bar::before {
    transform: scaleX(var(--from, 0));
  }

  :global(.sus-motion) .chart:not(.is-in) .target__bar--goal,
  :global(.sus-motion) .chart:not(.is-in) .shrink__bar::before {
    --from: 1;
  }

  :global(.sus-motion) .chart:not(.is-in) .cols__bar {
    transform: scaleY(0);
  }

  :global(.sus-motion) .chart:not(.is-in) .squares li.on,
  :global(.sus-motion) .chart:not(.is-in) .dots li.on {
    border-color: rgb(var(--g-rgb) / 0.25);
    background: transparent;
  }

  :global(.sus-motion) .bars__fill,
  :global(.sus-motion) .target__bar--goal,
  :global(.sus-motion) .shrink__bar::before,
  :global(.sus-motion) .cols__bar {
    transition: transform var(--dur) var(--out);
  }

  :global(.sus-motion) .bars__fill--air,
  :global(.sus-motion) .cols__bar--seven {
    transition-delay: 0.15s;
  }

  :global(.sus-motion) .squares li.on {
    transition:
      background-color 0.25s var(--out),
      border-color 0.25s var(--out);
    transition-delay: calc(var(--i) * 45ms);
  }

  :global(.sus-motion) .dots li.on {
    transition:
      background-color 0.25s var(--out),
      border-color 0.25s var(--out);
    transition-delay: calc(var(--i) * 110ms);
  }
</style>
