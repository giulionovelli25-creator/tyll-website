---
// Homepage chapter 2: the same information, before and with Tyll, in one short sequence (about 4.6 s).
//   Before Tyll (1 s): four records from four systems (POS, Stock, PMS, Finance) lie apart at different depths.
//     This is also the resting state before the sequence starts.
//   Connection (1.2 s): the records move together; the POS order and the stock count line up side by side, their
//     shared Coca-Cola line marked; the other two follow behind.
//   Tyll appears (0.6 s): the window forms around them and each record settles where it lives in Tyll: the stock
//     count and the POS order become the evidence, the room and the invoice become the other open issues.
//   The intelligence (1.7 s): the Coca-Cola difference is highlighted, then the 8 unexplained cans, then the
//     evidence, then the next step and the person responsible.
// It starts the first time the stage is well in view, pauses when it leaves, resumes when it returns, and holds on
// the final view. It never touches scrolling. One button pauses, resumes or replays. Without JavaScript or with
// reduced motion the final view is shown at once. All data is fictional and matches the Coca-Cola case in the
// simulated Tyll demo.
import Logo from '../Logo.astro';
import SolutionIcon from '../SolutionIcon.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = t(lang).home.problem;
const f = p.frags;
const v = p.view;
const [ownerName, ...roleParts] = v.ownerName.split(/،\s|,\s/);
const ownerRole = roleParts.join(', ');
// "8 cans not explained by sales": the number carries the finding
const [, lineNum = '', lineRest = v.issueLine] = v.issueLine.match(/^(\d+)(.*)$/) ?? [];
---

<section class="story" id="story" aria-labelledby="story-title" data-story>
  <div class="story__light" aria-hidden="true"></div>
  <div class="wrap">
    <header class="story__head">
      <h2 id="story-title">{p.title}</h2>
      <div class="story__intro">
        <p>{p.text}</p>
        <p class="story__note">{p.note}</p>
      </div>
    </header>

    <div class="cine" data-cine data-scene="6" data-state="done" role="group" aria-label={p.stage}>
      <div class="cine__top">
        <ol class="cine__chapters">
          <li class="ch" data-ch="before">
            <span class="ch__k">{p.beforeLabel}</span>
            <span class="ch__m">{p.before}</span>
            <span class="ch__rail" aria-hidden="true"><i></i></span>
          </li>
          <li class="ch" data-ch="after">
            <span class="ch__k"><Logo mark label="" class="ch__tick" />{p.afterLabel}</span>
            <span class="ch__m">{p.after}</span>
            <span class="ch__rail" aria-hidden="true"><i></i></span>
          </li>
        </ol>
        <button type="button" class="cine__ctrl" data-ctrl data-pause={p.pause} data-play={p.play} data-replay={p.replay} hidden>
          <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.75 3.5h2v9h-2zM9.25 3.5h2v9h-2z" fill="currentColor" /></svg>
          <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.25 3.4v9.2L12.5 8z" fill="currentColor" /></svg>
          <svg class="i-replay" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8a4.8 4.8 0 1 0 1.5-3.5M3 2.6v2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="cine__ctrl-label">{p.replay}</span>
        </button>
      </div>

      <div class="cine__stage">
        <!-- Before Tyll: the same records, as each system holds them. Shown only while the sequence runs. -->
        <div class="pieces" aria-hidden="true">
          <div class="piece" data-piece="pos">
            <p class="piece__sys"><i class="mark mark--pos"></i>{f.pos.sys}</p>
            <div class="piece__body">
              <p class="piece__title">{f.pos.title}</p>
              {
                f.pos.rows.map(([k, val]) => (
                  <p class="piece__line">
                    <s class="piece__match">{k}</s>
                    <s dir="ltr">{val}</s>
                  </p>
                ))
              }
              <p class="piece__note">{f.pos.flag}</p>
            </div>
          </div>
          <div class="piece" data-piece="stock">
            <p class="piece__sys"><i class="mark mark--stock"></i>{f.stock.sys}</p>
            <div class="piece__body">
              <p class="piece__title">{f.stock.title}</p>
              <p class="piece__line"><span class="piece__match">{f.stock.head[0]}</span></p>
              <p class="piece__figs">
                <span><small>{f.stock.head[1]}</small><b>{f.stock.vals[1]}</b></span>
                <span><small>{f.stock.head[2]}</small><b>{f.stock.vals[2]}</b></span>
              </p>
            </div>
          </div>
          <div class="piece" data-piece="pms">
            <p class="piece__sys"><i class="mark mark--pms"></i>{f.pms.sys}</p>
            <div class="piece__body">
              <p class="piece__title">{f.pms.title}</p>
              <p class="piece__line"><span class="pill">{f.pms.status}</span></p>
              <p class="piece__note">{f.pms.line}</p>
            </div>
          </div>
          <div class="piece" data-piece="finance">
            <p class="piece__sys"><i class="mark mark--finance"></i>{f.finance.sys}</p>
            <div class="piece__body">
              <p class="piece__title">{f.finance.title}</p>
              <p class="piece__figs">
                {
                  f.finance.rows.map(([k, val]) => (
                    <span>
                      <small>{k}</small>
                      <b>{val}</b>
                    </span>
                  ))
                }
              </p>
            </div>
          </div>
        </div>

        <div class="app">
          <span class="app__shell" aria-hidden="true"></span>

          <div class="app__rail" aria-hidden="true">
            <Logo mark label="" class="app__logo" />
            <span class="app__nav is-on"><SolutionIcon name="stock" /></span>
            <span class="app__nav"><SolutionIcon name="finance" /></span>
            <span class="app__nav"><SolutionIcon name="forecast" /></span>
            <span class="app__nav"><SolutionIcon name="events" /></span>
            <span class="app__nav"><SolutionIcon name="rooms" /></span>
          </div>

          <div class="app__bar">
            <span class="app__brand" aria-hidden="true"><Logo mark label="" class="app__brand-mark" />Tyll</span>
            <span class="app__place">{v.place}</span>
            <span class="app__user" aria-hidden="true"><span class="avatar">SH</span><span class="app__user-name">{ownerName}</span></span>
          </div>

          <div class="app__list">
            <p class="list__head">{v.attention}<span class="count">3</span></p>
            <ul>
              <li class="row row--on">
                <span class="row__marks" aria-hidden="true"><i class="mark mark--pos"></i><i class="mark mark--stock"></i></span>
                <span class="row__title">{v.issue}</span>
                <span class="pill pill--amber">{v.status}</span>
              </li>
              {
                v.tasks.map((task, i) => (
                  <li class="row" data-row={i === 0 ? 'pms' : 'finance'}>
                    <span class="row__marks" aria-hidden="true">
                      <i class={`mark mark--${i === 0 ? 'pms' : 'finance'}`} />
                    </span>
                    <span class="row__title">{task.title}</span>
                    <span class="row__tags">
                      <span class="pill">{task.team}</span>
                      <span class="pill">{task.status}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
            <p class="list__foot" aria-hidden="true">{v.simulated}</p>
          </div>

          <article class="app__detail">
            <div class="d__head">
              <span class="pill pill--amber">{v.status}</span>
              <h3 class="d__title">{v.issue}</h3>
              <p class="d__line">{lineNum && <b class="d__num">{lineNum}</b>}{lineRest}</p>
            </div>

            <p class="d__label d__label--ev">{v.evidenceLabel}</p>
            <div class="d__ev">
              <section class="rec" data-rec="stock" aria-label={f.stock.sys}>
                <p class="rec__sys"><i class="mark mark--stock" aria-hidden="true"></i>{f.stock.sys}</p>
                <p class="rec__title">{f.stock.title}</p>
                <p class="rec__vals">
                  <span>{f.stock.head[1]} <b>{f.stock.vals[1]}</b></span>
                  <span>{f.stock.head[2]} <b>{f.stock.vals[2]}</b></span>
                </p>
                <span class="pill pill--amber">{f.stock.flag}</span>
              </section>
              <section class="rec" data-rec="pos" aria-label={f.pos.sys}>
                <p class="rec__sys"><i class="mark mark--pos" aria-hidden="true"></i>{f.pos.sys}</p>
                <p class="rec__title">{f.pos.title}</p>
                <p class="rec__vals rec__vals--struck">
                  {
                    f.pos.rows.map(([k, val]) => (
                      <>
                        <s>{k}</s>
                        <s dir="ltr">{val}</s>
                      </>
                    ))
                  }
                </p>
                <span class="pill pill--amber">{f.pos.flag}</span>
              </section>
            </div>

            <div class="d__next">
              <p class="d__label">{v.nextLabel}</p>
              <p class="d__next-text">{v.nextText}</p>
              <div class="d__person">
                <span class="avatar" aria-hidden="true">SH</span>
                <span class="d__who">
                  <span class="d__who-k">{v.owner}</span>
                  <span class="d__who-name">{ownerName}<span class="d__who-role">{ownerRole}</span></span>
                </span>
                <span class="pill pill--ink d__assigned">{v.assigned}</span>
              </div>
            </div>

            <p class="d__caution">{v.caution}</p>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── The environment: pearl light, soft architectural shafts, no photograph ── */
  .story {
    position: relative;
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
    background:
      radial-gradient(80% 60% at 50% 0%, #ffffff 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, #f7f7f5 0%, #f0f1f2 55%, #e9ebee 100%);
    overflow: hidden;
    isolation: isolate;
  }

  .story__light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-linear-gradient(
      108deg,
      rgba(255, 255, 255, 0) 0 140px,
      rgba(255, 255, 255, 0.5) 140px 190px,
      rgba(255, 255, 255, 0) 190px 360px
    );
    -webkit-mask-image: radial-gradient(70% 60% at 62% 45%, #000 0%, transparent 75%);
    mask-image: radial-gradient(70% 60% at 62% 45%, #000 0%, transparent 75%);
    opacity: 0.8;
  }

  /* Heading, chapters and stage share one column, so their edges line up */
  .story__head,
  .cine {
    max-width: 1080px;
    margin-inline: auto;
  }

  .story__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
  }

  .story__head h2 {
    max-width: 18ch;
    font-size: var(--fs-h2);
  }

  .story__intro > p:first-child {
    max-width: 34rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .story__note {
    max-width: 30rem;
    margin-top: 1rem;
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /* ── Chapters: Before Tyll → With Tyll, each with a fine progress line ── */
  .cine {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .cine__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .cine__chapters {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 28rem);
    gap: clamp(1.25rem, 0.5rem + 3vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ch {
    display: grid;
    align-content: end;
    gap: 0.3rem;
    color: var(--fog);
  }

  .ch__k {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .ch__k :global(.ch__tick) {
    width: 14px;
    height: auto;
  }

  .ch__m {
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .ch__rail {
    position: relative;
    height: 1px;
    margin-top: 0.7rem;
    background: var(--silver);
    overflow: hidden;
  }

  .ch__rail i {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform-origin: left;
  }

  :global([dir='rtl']) .ch__rail i {
    transform-origin: right;
  }

  /* Final state: "With Tyll" leads; "Before Tyll" stays readable but quiet (the script runs the change) */
  .ch[data-ch='after'] {
    color: var(--ink);
  }

  .ch[data-ch='after'] .ch__k {
    color: var(--steel);
  }

  .ch[data-ch='before'] .ch__rail i {
    background: var(--fog);
  }

  .cine__ctrl {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.45rem;
    height: 40px;
    padding: 0 1rem 0 0.85rem;
    border: 1px solid var(--silver);
    border-radius: var(--pill);
    background: rgba(255, 255, 255, 0.7);
    color: var(--graphite);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease),
      color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }

  .cine__ctrl[hidden] {
    display: none;
  }

  .cine__ctrl:hover {
    border-color: var(--steel);
    background: #fff;
    color: var(--ink);
  }

  .cine__ctrl svg {
    display: none;
    width: 15px;
    height: 15px;
  }

  .cine[data-state='playing'] .i-pause,
  .cine[data-state='paused'] .i-play,
  .cine[data-state='idle'] .i-play,
  .cine[data-state='done'] .i-replay {
    display: block;
  }

  /* ── The stage: the window and, before Tyll, the records it brings together, in the same footprint ── */
  .cine__stage {
    position: relative;
    margin-top: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  /* A soft contact shadow, as if the window rests just above a pale floor */
  .cine__stage::after {
    content: '';
    position: absolute;
    inset: auto 6% -34px;
    z-index: -1;
    height: 60px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(20, 22, 26, 0.16), transparent);
    filter: blur(6px);
  }

  /* ── Before Tyll: each record as its own system shows it ── */
  .pieces {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .piece {
    position: absolute;
    display: grid;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fff;
    color: var(--graphite);
    font-size: 0.875rem;
    line-height: 1.4;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform-origin: 0 0;
    box-shadow:
      0 1px 2px rgba(20, 22, 26, 0.05),
      0 34px 64px -30px rgba(20, 22, 26, 0.34);
  }

  .cine.is-anim .piece {
    visibility: visible;
  }

  .piece__sys {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.6rem 1.05rem;
    border-bottom: 1px solid var(--line);
    background: #fafafa;
    color: var(--steel);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .piece__body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.4rem;
    padding: 0.95rem 1.05rem 1.1rem;
  }

  .piece__title {
    margin: 0;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .piece__line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    margin: 0;
  }

  .piece__line s {
    color: #9b2c2c;
    text-decoration-color: rgba(155, 44, 44, 0.6);
  }

  .piece__match {
    margin-inline: -0.3em;
    padding: 0.05em 0.3em;
    border-radius: 5px;
  }

  .piece__note {
    margin: 0;
    color: var(--steel);
    font-size: 0.8125rem;
  }

  .piece__figs {
    display: flex;
    gap: 2rem;
    margin: 0.15rem 0 0;
  }

  .piece__figs span {
    display: grid;
    gap: 0.1rem;
  }

  .piece__figs small {
    color: var(--steel);
    font-size: 0.75rem;
  }

  .piece__figs b {
    color: var(--ink);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  /* Where each record lies before Tyll: apart, at slightly different angles and depths (the script reads --r, --s) */
  .piece[data-piece='pos'] {
    top: 12%;
    inset-inline-start: 3%;
    width: 37%;
    z-index: 3;
    --r: -1.3deg;
    --s: 1;
  }

  .piece[data-piece='stock'] {
    top: 7%;
    inset-inline-start: 49%;
    width: 39%;
    z-index: 4;
    --r: 1deg;
    --s: 1;
  }

  .piece[data-piece='pms'] {
    top: 57%;
    inset-inline-start: 13%;
    width: 34%;
    z-index: 2;
    --r: 0.8deg;
    --s: 0.96;
  }

  .piece[data-piece='finance'] {
    top: 53%;
    inset-inline-start: 57%;
    width: 36%;
    z-index: 1;
    --r: -0.9deg;
    --s: 0.96;
  }

  .piece[data-piece='pms'],
  .piece[data-piece='finance'] {
    box-shadow:
      0 1px 2px rgba(20, 22, 26, 0.05),
      0 22px 44px -26px rgba(20, 22, 26, 0.26);
  }

  /* While the sequence runs, the window parts arrive one after another; the final view needs no rule */
  .cine.is-anim :is(.row, .rec, .d__head, .d__line, .d__label--ev, .d__next, .d__caution, .d__assigned) {
    will-change: opacity, transform;
  }

  /* ── The Tyll window, faithful to the demo's look: white panels, quiet lines, amber for what needs review ── */
  .app {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 60px minmax(0, 0.82fr) minmax(0, 1.5fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'rail bar bar'
      'rail list detail';
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .app__shell {
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid rgba(200, 205, 212, 0.65);
    border-radius: 22px;
    background: #fff;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 2px 6px rgba(20, 22, 26, 0.04),
      0 50px 100px -50px rgba(20, 22, 26, 0.32);
    transition:
      opacity 1s var(--ease),
      transform 1.3s var(--ease);
  }

  .app__rail {
    grid-area: rail;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 1.1rem 0;
    border-inline-end: 1px solid var(--line);
    border-start-start-radius: 22px;
    border-end-start-radius: 22px;
    background: #fafafa;
    color: var(--fog);
  }

  .app__rail :global(.app__logo) {
    width: 22px;
    height: auto;
    margin-bottom: 0.6rem;
    color: var(--ink);
  }

  .app__nav {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
  }

  .app__nav.is-on {
    background: var(--mist);
    color: var(--ink);
  }

  .app__nav :global(svg) {
    width: 18px;
    height: 18px;
  }

  .app__bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 56px;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .app__brand {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }

  .app__brand :global(.app__brand-mark) {
    width: 18px;
    height: auto;
  }

  .app__place {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    color: var(--graphite);
    font-size: 0.8125rem;
  }

  .app__user {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
    color: var(--graphite);
    font-size: 0.8125rem;
  }

  .avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* The list of what needs attention */
  .app__list {
    grid-area: list;
    display: flex;
    flex-direction: column;
    padding-block: 1.25rem;
    padding-inline: 1.25rem 1rem;
    border-inline-end: 1px solid var(--line);
  }

  .list__foot {
    margin: auto 0 0;
    padding-top: 1.25rem;
    color: var(--fog);
    font-size: 0.75rem;
  }

  .list__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    color: var(--ink);
    font-weight: 500;
  }

  .count {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: var(--pill);
    background: var(--ink);
    color: #fff;
    font-size: 0.75rem;
  }

  .app__list ul {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.35rem 0.6rem;
    padding: 0.8rem 0.85rem;
    border: 1px solid transparent;
    border-radius: 14px;
    color: var(--steel);
  }

  .row:not(.row--on) {
    opacity: 0.72;
  }

  .row__marks {
