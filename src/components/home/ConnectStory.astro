      gap: 0.3rem;
    }

    .row {
      padding: 0.65rem 0.75rem;
    }

    .list__foot {
      display: none;
    }

    .app__detail {
      margin: 0.5rem 1rem 0;
      padding: 1.15rem 0 1.25rem;
      border-top: 1px solid var(--line);
    }

    .piece[data-piece='pos'] {
      top: 5%;
      inset-inline-start: 0;
      width: 48%;
    }

    .piece[data-piece='stock'] {
      top: 8%;
      inset-inline-start: 51%;
      width: 49%;
    }

    .piece[data-piece='pms'] {
      top: 34%;
      inset-inline-start: 4%;
      width: 45%;
    }

    .piece[data-piece='finance'] {
      top: 37%;
      inset-inline-start: 53%;
      width: 46%;
    }
  }

  @media (max-width: 640px) {
    .story__head {
      gap: 1rem;
    }

    .cine__top {
      flex-direction: column;
      align-items: stretch;
    }

    .cine__chapters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .ch__m {
      font-size: 1rem;
    }

    .cine__ctrl {
      align-self: flex-start;
      height: 36px;
    }

    .app__place {
