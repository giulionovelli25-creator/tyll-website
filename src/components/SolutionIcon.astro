---
// Quiet line icons for the six solutions (24px grid, 1.5px stroke, currentColor).
import type { Solution } from '../content/solutions';

interface Props {
  name: Solution['icon'];
  class?: string;
}

const { name, class: className } = Astro.props;
const paths: Record<Solution['icon'], string> = {
  // A bin
  waste: 'M4.5 6.5h15 M9.5 6.5V4h5v2.5 M6.5 6.5l1 14h9l1-14 M10 10.5v6 M14 10.5v6',
  // A crate seen from above
  stock: 'M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9Z M3.5 7.5 12 12l8.5-4.5 M12 12v9',
  // A rising line over a baseline
  forecast: 'M3.5 20.5h17 M4.5 16l5-5 3.5 3.5 6.5-7 M15 7.5h4.5V12',
  // Bars with a trend
  revenue: 'M4 20.5h16 M6.5 20.5V14 M11 20.5V10 M15.5 20.5v-8 M20 6l-5.5 3.5L11 7 5 11',
  // A receipt edge
  finance: 'M6 3.5h12v17l-2-1.3-2 1.3-2-1.3-2 1.3-2-1.3-2 1.3v-17Z M9 8h6 M9 11.5h6 M9 15h3.5',
  // A glass with a level in it
  pour: 'M7 3.5h10l-1 7a4 4 0 0 1-8 0l-1-7Z M7.6 8h8.8 M12 14.5v6 M8.5 20.5h7',
};
---

<svg class={className} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]}></path>
</svg>
