---
// Directly under the hero: the three products Tyll sells today, each linking to its solution page.
import { Picture } from 'astro:assets';
import { solutions } from '../../content/solutions';
import { available } from '../../config/products';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.now;
---

<section class="now" aria-labelledby="now-title">
  <div class="wrap">
    <header class="now__head">
      <p class="now__label"><span class="now__dot" aria-hidden="true"></span>{v.label}</p>
      <h2 id="now-title">{v.title}</h2>
    </header>
    <ul class="now__cards">
      {
        available.map((key) => (
          <li>
            <a class="card" href={href(key, lang)}>
              <span class="card__photo">
                <Picture
                  src={solutions[key].photo}
                  alt=""
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[480, 720, 960]}
                  sizes="(max-width: 860px) calc(100vw - 32px), 400px"
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${solutions[key].photoFocus}`}
                />
              </span>
              <span class="card__body">
                <h3 class="card__title">{solutions[key].name[lang]}</h3>
                <p class="card__text">{v.items[key].text}</p>
                <span class="card__more">
                  {v.more}
                  <span class="card__arrow flip-rtl" aria-hidden="true">→</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .now {
    position: relative;
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
    background:
      radial-gradient(70% 60% at 50% 0%, #ffffff 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, #f7f7f5 0%, #f0f1f2 100%);
  }

  .now__head {
    max-width: 40rem;
  }

  .now__label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  /* A small live dot: these are on sale today */
  .now__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2f8f5b;
    box-shadow: 0 0 0 4px rgba(47, 143, 91, 0.14);
  }

  .now h2 {
    margin-top: 0.75rem;
    font-size: var(--fs-h2);
  }

  .now__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    margin: clamp(2rem, 1.5rem + 2vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(20, 22, 26, 0.07);
    border-radius: var(--radius-lg);
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    box-shadow:
      0 1px 2px rgba(20, 22, 26, 0.04),
      0 24px 48px -30px rgba(20, 22, 26, 0.28);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow:
      0 1px 2px rgba(20, 22, 26, 0.05),
      0 32px 60px -30px rgba(20, 22, 26, 0.36);
  }

  .card__photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--mist);
  }

  .card__photo :global(picture),
  .card__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card__photo :global(img) {
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .card:hover .card__photo :global(img) {
    transform: scale(1.04);
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
  }

  .card__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .card__text {
    margin-top: 0.5rem;
    color: var(--graphite);
    line-height: 1.55;
  }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .card__arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }

  .card:hover .card__arrow {
    transform: translateX(4px);
  }

  :global([dir='rtl']) .card:hover .card__arrow {
    transform: scaleX(-1) translateX(4px);
  }

  @media (max-width: 860px) {
    .now__cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__arrow,
    .card__photo :global(img) {
      transition: none;
    }
  }
</style>
