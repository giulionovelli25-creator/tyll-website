---
// The bar (25 Nov 2026, the owner, after round 5: "back like before"): logo, Solutions (three columns of three: a quiet
// section name, then each page with its tinted icon, title and one grey line), How it works, Sustainability, the
// language dropdown and one Book a demo button (About us added later the same day, at the owner's request). No Hotel groups and no Try the demo in the bar: Hotel groups is in the
// footer. FAQ is only in the footer. The same items, in the same order, in the phone menu.
import Logo from './Logo.astro';
import SolutionIcon from './SolutionIcon.astro';
import { solutions, sections } from '../content/solutions';
import { t, href, pages, locales, solutionKeys, type Locale, type PageKey } from '../i18n';

interface Props {
  lang: Locale;
  page: PageKey;
  /** Start in the white-on-dark treatment, for pages that open on a dark photo or video. */
  overHero?: boolean;
}

const { lang, page, overHero = false } = Astro.props;
const d = t(lang);
const home = href('home', lang);
const fwd = lang === 'ar' ? '←' : '→';
const inSolutions = page === 'solutions' || (solutionKeys as readonly string[]).includes(page);
const groups = sections.map((sec) => ({
  id: sec.id,
  name: sec.name[lang],
  url: href('solutions', lang, `#${sec.id}`),
  tone: solutions[sec.keys[0]].tone,
  items: sec.keys.map((k) => ({ key: k, s: solutions[k], url: href(k, lang), current: page === k })),
}));
---

<header class:list={['header', overHero && 'on-dark']} data-tone={overHero ? 'dark' : 'light'} id="site-header">
  <div class="wrap header__bar">
    <a class="header__logo" href={home} aria-label="Tyll home">
      <Logo label="Tyll" />
    </a>

    <nav class="header__nav" aria-label={d.nav.label}>
      <button
        type="button"
        class:list={['header__trigger', inSolutions && 'is-current']}
        aria-expanded="false"
        aria-controls="solutions-panel"
        id="solutions-trigger"
      >
        {d.nav.solutions}
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <a class="header__link" href={href('how', lang)} aria-current={page === 'how' ? 'page' : undefined}>{d.nav.how}</a>
      <a class="header__link" href={href('sustainability', lang)} aria-current={page === 'sustainability' ? 'page' : undefined}>{d.nav.sustainability}</a>
      <a class="header__link" href={href('about', lang)} aria-current={page === 'about' ? 'page' : undefined}>{d.nav.about}</a>
    </nav>

    <div class="header__end">
      <!-- The languages as a small dropdown: the current one shown, the others one click away -->
      <details class="langdrop" data-langdrop>
        <summary aria-label={d.nav.language}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25" /><path d="M1.75 8h12.5M8 1.75c1.9 2 2.75 4 2.75 6.25S9.9 12.25 8 14.25M8 1.75C6.1 3.75 5.25 5.75 5.25 8S6.1 12.25 8 14.25" /></svg>
          {lang === 'ar' ? <span class="lang__ar" dir="rtl">{d.langName}</span> : <span>{lang.toUpperCase()}</span>}
          <svg class="langdrop__chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
        </summary>
        <ul class="langdrop__menu" role="list">
          {
            locales.map((l) => (
              <li>
                <a href={pages[page][l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} data-track="language_changed" data-track-to={l}>
                  {l === 'ar' ? <span class="lang__ar" dir="rtl">{t(l).langName}</span> : t(l).langName}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a class="btn btn--solid header__book" href={href('book', lang)} data-track="book_demo_click" data-track-from="header">
        {d.cta.book}
      </a>
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="visually-hidden" data-open-label={d.nav.menu} data-close-label={d.nav.close}>{d.nav.menu}</span>
        <span class="burger-lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Desktop: the Solutions panel, one column per section -->
  <div class="panel" id="solutions-panel" role="region" aria-labelledby="solutions-trigger" hidden>
    <div class="wrap panel__layout">
      <div class="panel__grid">
        {
          groups.map((g) => (
            <section class="panel__part" data-accent={g.tone}>
              <h2 class="panel__head">{g.name}</h2>
              <ul>
                {g.items.map(({ key, s, url, current }) => (
                  <li>
                    <a class="panel__item" href={url} aria-current={current ? 'page' : undefined} data-solution={key}>
                      <span class="panel__icon">
                        <SolutionIcon name={s.icon} />
                      </span>
                      <span class="panel__text">
                        <span class="panel__name">{s.name[lang]}</span>
                        <span class="panel__desc">{s.menu[lang]}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <div class="panel__foot">
        <a href={href('solutions', lang)} class="panel__all">{d.nav.allSolutions} {fwd}</a>
      </div>
    </div>
  </div>

  <!-- Phones and tablets: the same items in a full-screen menu -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="wrap" aria-label={d.nav.label}>
      <details class="mobile-menu__group" open>
        <summary>{d.nav.solutions}</summary>
        <ul>
          {
            groups.map((g) => (
              <Fragment>
                <li class="mobile-menu__head">{g.name}</li>
                {g.items.map(({ key, s, url, current }) => (
                  <li>
                    <a href={url} aria-current={current ? 'page' : undefined} data-accent={g.tone} data-solution={key}>
                      <SolutionIcon name={s.icon} />
                      <span>
                        <span class="mobile-menu__name">{s.name[lang]}</span>
                        <span class="mobile-menu__line">{s.menu[lang]}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </Fragment>
            ))
          }
          <li class="mobile-menu__all">
            <a href={href('solutions', lang)}>{d.nav.allSolutions} {fwd}</a>
          </li>
        </ul>
      </details>
      <a class="mobile-menu__how" href={href('how', lang)} aria-current={page === 'how' ? 'page' : undefined}>{d.nav.how}</a>
      <a class="mobile-menu__how" href={href('sustainability', lang)} aria-current={page === 'sustainability' ? 'page' : undefined}>{d.nav.sustainability}</a>
      <a class="mobile-menu__how" href={href('about', lang)} aria-current={page === 'about' ? 'page' : undefined}>{d.nav.about}</a>
      <div class="lang mobile-menu__lang" role="group" aria-label={d.nav.language}>
        {
          locales.map((l) => (
            <a href={pages[page][l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} data-track="language_changed" data-track-to={l}>
              {t(l).langName}
            </a>
          ))
        }
      </div>
      <div class="mobile-menu__actions">
        <a class="btn btn--solid" href={href('book', lang)} data-track="book_demo_click" data-track-from="menu">{d.cta.book}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--ink);
    background: rgb(var(--paper-rgb) / 0.9);
    -webkit-backdrop-filter: saturate(1.5) blur(16px);
    backdrop-filter: saturate(1.5) blur(16px);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.45s var(--ease),
      color 0.45s var(--ease),
      border-color 0.45s var(--ease);
  }

  .header[data-tone='dark'] {
    color: var(--on-dark);
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Scrolled, but still over the dark opening: a dark frosted bar so text never shows through */
  .header[data-tone='dark'].is-scrolled {
    background: rgb(var(--ink-rgb) / 0.62);
    border-bottom-color: rgb(var(--on-dark-rgb) / 0.08);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    backdrop-filter: saturate(1.4) blur(16px);
  }

  /* While the Solutions panel is open the bar joins it as one light surface */
  .header.is-open {
    color: var(--ink);
    background: var(--paper);
    border-bottom-color: var(--line);
  }

  .header.is-open .btn--solid {
    background: var(--ink);
    color: var(--paper);
  }

  .header.is-open .btn--line {
    border-color: var(--silver);
    color: var(--ink);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    height: var(--header-h);
  }

  /* the mark is 26 px tall; the link around it is a full 44 px tap target */
  .header__logo {
    flex: none;
    display: flex;
    align-items: center;
    min-height: 44px;
    border-radius: 6px;
  }

  .header__logo :global(.logo) {
    width: auto;
    height: 26px;
  }

  .header__nav {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.25rem;
  }


  .header__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 42px;
    padding: 0 0.6rem;
    /* plain like the links beside it (20 Nov 2026, the owner: no outline); the arrow says it opens */
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }

  /* How it works: a plain text link beside the Solutions button (9 Nov 2026) */
  .header__link {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 0.6rem;
    margin-inline-start: 0.15rem;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
    text-underline-offset: 6px;
  }

  .header__link:hover,
  .header__link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }

  .header__trigger:hover,
  .header__trigger[aria-expanded='true'] {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
  }

  .header__trigger svg {
    width: 12px;
    height: 12px;
    transition: transform 0.3s var(--ease);
  }

  .header__trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .header__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Languages: one small dropdown (19 Nov 2026, the owner: "make the languages a drop down") */
  .langdrop {
    position: relative;
  }

  .langdrop summary {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    min-height: 40px;
    padding: 0 0.55rem;
    border-radius: var(--pill);
    font-size: 0.9375rem;
    list-style: none;
    cursor: pointer;
  }

  .langdrop summary::-webkit-details-marker {
    display: none;
  }

  .langdrop summary:hover,
  .langdrop[open] summary {
    background: rgb(var(--steel-mid-rgb) / 0.14);
  }

  .langdrop summary svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .langdrop .langdrop__chev {
    width: 11px;
    height: 11px;
    stroke-width: 1.5;
    transition: transform 0.2s var(--ease);
  }

  .langdrop[open] .langdrop__chev {
    transform: rotate(180deg);
  }

  .langdrop__menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    inset-inline-end: 0;
    z-index: 5;
    min-width: 10rem;
    margin: 0;
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    box-shadow: var(--shadow-2);
    color: var(--ink);
    list-style: none;
  }

  .langdrop__menu a {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: 9px;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .langdrop__menu a:hover {
    background: var(--page-deep);
  }

  .langdrop__menu a[aria-current] {
    font-weight: 600;
  }

  /* Try the demo: a quiet text link beside the one Book a demo button */
  /* A small subset of Noto Sans Arabic with only the letters of العربية, so every page can show the word
     in the brand's Arabic face without loading the full font */
  .langdrop :global(.lang__ar),
  .mobile-menu__lang a[hreflang='ar'] {
    font-family: 'Tyll Arabic Label', 'Tyll Arabic', var(--font);
    letter-spacing: 0;
  }

  .langdrop :global(.lang__ar) {
    font-size: 1rem;
  }

  /* The Solutions panel */
  .panel {
    border-top: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 40px 60px -40px rgb(var(--ink-rgb) / 0.35);
    /* a dropdown: quick and decisive (Emil Kowalski's 150 to 250 ms, strong ease-out) */
    animation: panel-in 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .panel__layout {
    display: grid;
    grid-template-areas:
      'list'
      'foot';
  }

  .panel__grid {
    grid-area: list;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 1.75rem 0 1.25rem;
  }

  .panel__part ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each column is one of the demo's three sections; its name links to that section of the Solutions page */
  .panel__head {
    margin: 0 1.1rem 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    color: var(--steel);
    font-family: var(--font);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
  }



  .panel__item {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }

  .panel__item:hover,
  .panel__item:focus-visible,
  .panel__item[aria-current] {
    background: var(--mist);
  }

  .panel__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(var(--acc-rgb) / 0.16);
    border-radius: 12px;
    background: var(--acc-wash);
    color: var(--acc);
  }

  .panel__icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .panel__name {
    display: block;
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .panel__desc {
    display: block;
    margin-top: 0.2rem;
    color: var(--steel);
    font-size: 0.9375rem;
    line-height: 1.45;
  }


  .panel__foot {
    grid-area: foot;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.1rem 1.5rem;
    border-top: 1px solid var(--line);
  }

  .panel__foot a {
    font-size: 0.9375rem;
    font-weight: 400;
    text-decoration: none;
  }

  .panel__foot a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .panel__foot .panel__all {
    color: var(--steel);
    font-weight: 400;
  }

  /* Mobile menu */
  .header__burger {
    display: none;
    width: 44px;
    height: 44px;
    margin-inline-end: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .burger-lines,
  .burger-lines::before,
  .burger-lines::after {
    display: block;
    width: 20px;
    height: 1.5px;
    margin: auto;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .burger-lines {
    position: relative;
    background: transparent;
  }

  .burger-lines::before,
  .burger-lines::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger-lines::before {
    transform: translateY(-4px);
  }

  .burger-lines::after {
    transform: translateY(4px);
  }

  [aria-expanded='true'] .burger-lines::before {
    transform: rotate(45deg);
  }

  [aria-expanded='true'] .burger-lines::after {
    transform: rotate(-45deg);
  }

  /* The menu has its own booking button, so the one in the bar steps aside while it is open */
  .header:has(.header__burger[aria-expanded='true']) .header__book {
    visibility: hidden;
  }

  .mobile-menu {
    height: calc(100svh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }

  .mobile-menu nav {
    display: grid;
    gap: 1.75rem;
    padding-block: 1.5rem 2.5rem;
  }

  .mobile-menu__actions {
    display: grid;
    gap: 0.6rem;
  }

  .mobile-menu__group summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.5rem;
    letter-spacing: 0;
    list-style: none;
    cursor: pointer;
  }

  .mobile-menu__group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__group summary::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 300;
    transition: transform 0.3s var(--ease);
  }

  .mobile-menu__group[open] summary::after {
    transform: rotate(45deg);
  }

  .mobile-menu__group ul {
    margin: 0;
    padding: 0.5rem 0 0;
    list-style: none;
  }

  .mobile-menu__head {
    padding: 1rem 0 0.15rem;
    color: var(--steel);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .mobile-menu__group li a {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding: 0.7rem 0;
    font-size: 1.0625rem;
    text-decoration: none;
  }

  /* each page's icon in its section's tint, as in the desktop panel */
  .mobile-menu__group li a :global(svg) {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--acc);
  }

  .mobile-menu__group li a[aria-current] {
    font-weight: 400;
  }


  .mobile-menu__name {
    display: block;
  }

  .mobile-menu__line {
    display: block;
    margin-top: 0.1rem;
    color: var(--steel);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .mobile-menu__all a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mobile-menu__all.mobile-menu__faq {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .mobile-menu__all {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .mobile-menu__how {
    display: block;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    font-size: 1.5rem;
    text-decoration: none;
  }

  .mobile-menu__lang {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding-top: 1.25rem;
  }

  .mobile-menu__lang a {
    font-size: 1rem;
    text-decoration: none;
  }

  .mobile-menu__lang a:not([aria-current]) {
    opacity: 0.64;
  }

  .header:has(.header__burger[aria-expanded='true']) {
    color: var(--ink);
    background: var(--paper);
  }

  .header:has(.header__burger[aria-expanded='true']) .btn--solid {
    background: var(--ink);
    color: var(--paper);
  }

  .header:has(.header__burger[aria-expanded='true']) .btn--line {
    border-color: var(--silver);
    color: var(--ink);
  }

  /* The bar holds three links, the languages and Book a demo on one line from 1100 px in every language;
     narrower screens use the menu button */
  @media (max-width: 1099px) {
    .header__nav,
    .langdrop,
    .panel {
      display: none;
    }

    .header__end {
      margin-inline-start: auto;
    }

    .header__burger {
      display: block;
    }
  }

  /* Small phones: the longest labels (Arabic, German) still fit beside the logo and the menu */
  @media (max-width: 430px) {
    .header__bar {
      gap: 0.5rem;
    }

    .header__book {
      padding-inline: 0.8rem;
      font-size: 0.875rem;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/header';
</script>
