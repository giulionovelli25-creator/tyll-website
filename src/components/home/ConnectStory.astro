      margin-top: 1.1rem;
    }

    .d__person {
      flex-wrap: wrap;
    }

    .d__who-role {
      display: block;
      margin-inline-start: 0;
    }

    /* Before Tyll on a phone: the four records stacked, each nudged to its own side */
    .piece {
      width: 88% !important;
    }

    .piece[data-piece='pos'] {
      top: 2%;
      inset-inline-start: 0;
    }

    .piece[data-piece='stock'] {
      top: 23%;
      inset-inline-start: 12%;
    }

    .piece[data-piece='pms'] {
      top: 47%;
      inset-inline-start: 3%;
    }

    .piece[data-piece='finance'] {
      top: 68%;
      inset-inline-start: 10%;
    }

    .piece__figs b {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  const cine = document.querySelector<HTMLElement>('[data-cine]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // With reduced motion the final view, already in the page, simply stays
  if (cine && !reduce.matches) {
    const stage = cine.querySelector<HTMLElement>('.cine__stage')!;
    const ctrl = cine.querySelector<HTMLButtonElement>('[data-ctrl]')!;
    const label = ctrl.querySelector<HTMLElement>('.cine__ctrl-label')!;
    const one = (sel: string) => cine.querySelector<HTMLElement>(sel)!;
    const all = (sel: string) => [...cine.querySelectorAll<HTMLElement>(sel)];

    // The sequence, in ms
    const T = { connect: 1000, tyll: 2200, settle: 2800, problem: 2900, gap: 3250, evidence: 3600, next: 3950, end: 4600 };
    // The scene shown in data-scene: 1 before, 2 connection, 3 Tyll, 4 the problem, 5 evidence, 6 next step
    const SCENES: [number, string][] = [[0, '1'], [T.connect, '2'], [T.tyll, '3'], [T.problem, '4'], [T.evidence, '5'], [T.next, '6']];
    const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
    const MOVE = 'cubic-bezier(0.65, 0, 0.35, 1)';

    let anims: Animation[] = [];
    let clock: Animation | null = null;
    let state: 'idle' | 'playing' | 'paused' | 'done' = 'done';
    let autoPaused = false;
    let raf = 0;
    let builtWidth = 0;

    const setState = (s: typeof state) => {
      state = s;
      cine.dataset.state = s;
      label.textContent = s === 'playing' ? ctrl.dataset.pause! : s === 'done' ? ctrl.dataset.replay! : ctrl.dataset.play!;
    };
    const now = () => Number(clock?.currentTime ?? 0);
    const syncScene = () => {
      let s = '1';
      for (const [at, n] of SCENES) if (now() >= at) s = n;
      cine.dataset.scene = s;
    };
    const tick = () => {
      syncScene();
      raf = requestAnimationFrame(tick);
    };

    // A part arrives at `at` ms, from `from` to its own final look (so nothing jumps when the sequence ends)
    const enter = (el: Element, at: number, dur: number, from: Keyframe = { opacity: 0, transform: 'translateY(8px)' }) =>
      anims.push(el.animate([{ ...from, offset: 0 }], { delay: at, duration: dur, easing: EASE, fill: 'backwards' }));

    const cancelAll = () => {
      anims.forEach((a) => a.cancel());
      anims = [];
      clock = null;
    };

    // Measures the final view, then builds every animation of the sequence, paused at the start
    const build = () => {
      cancelAll();
      const css = getComputedStyle(cine);
      const ink = css.getPropertyValue('--ink').trim();
      const fog = css.getPropertyValue('--fog').trim();
      const steel = css.getPropertyValue('--steel').trim();
      const s = stage.getBoundingClientRect();
      builtWidth = s.width;
      const box = (el: HTMLElement) => {
        const r = el.getBoundingClientRect();
        return { x: r.left - s.left, y: r.top - s.top, w: r.width, h: r.height };
      };

      // 1–3 · The records: apart, then together, then each settles where it lives in Tyll
      const pieces = all('[data-piece]');
      const piece = (k: string) => pieces.find((p) => p.dataset.piece === k)!;
      const home: Record<string, HTMLElement> = {
        pos: one('[data-rec="pos"]'),
        stock: one('[data-rec="stock"]'),
        pms: one('[data-row="pms"]'),
        finance: one('[data-row="finance"]'),
      };
      const nat = new Map(pieces.map((p) => [p, { x: p.offsetLeft, y: p.offsetTop, w: p.offsetWidth, h: p.offsetHeight }]));
      const W = s.width;
      const H = s.height;
      const cx = W / 2;
      // On a phone the stage is taller than the screen, so the records meet in its upper part, where the eye is
      const cy = W >= 700 ? H * 0.42 : Math.min(H * 0.3, 360);
      const gap = 14;
      const gather = new Map<HTMLElement, { x: number; y: number; s: number }>();
      // The POS order and the stock count line up in the order they take in Tyll's evidence
      const pair = [piece('stock'), piece('pos')].sort((a, b) => box(home[a.dataset.piece!]).x - box(home[b.dataset.piece!]).x);
      const [a, b] = pair.map((p) => nat.get(p)!);
      if (W >= 700) {
        const gs = Math.min(1, (W * 0.86 - gap) / (a.w + b.w));
        let x = cx - (gs * (a.w + b.w) + gap) / 2;
        pair.forEach((p) => {
          const n = nat.get(p)!;
          gather.set(p, { x, y: cy - (n.h * gs) / 2, s: gs });
          x += n.w * gs + gap;
        });
      } else {
        const gs = Math.min(1, (W * 0.92) / Math.max(a.w, b.w));
        let y = cy - (gs * (a.h + b.h) + gap) / 2;
        pair.forEach((p) => {
          const n = nat.get(p)!;
          gather.set(p, { x: cx - (n.w * gs) / 2, y, s: gs });
          y += n.h * gs + gap;
        });
      }
      // The room and the invoice follow, smaller, just behind the pair
      const pairBottom = Math.max(...pair.map((p) => gather.get(p)!.y + nat.get(p)!.h * gather.get(p)!.s));
      ['pms', 'finance'].forEach((k, i) => {
        const p = piece(k);
        const n = nat.get(p)!;
        const gs = 0.82;
        const x = W >= 700 ? (i === 0 ? cx - n.w * gs - gap / 2 : cx + gap / 2) : cx - (n.w * gs) / 2 + (i === 0 ? -10 : 10);
        gather.set(p, { x, y: pairBottom - n.h * gs + 26 + i * 12, s: gs });
      });

      pieces.forEach((p) => {
        const k = p.dataset.piece!;
        const n = nat.get(p)!;
        const g = gather.get(p)!;
        const d = box(home[k]);
        const pc = getComputedStyle(p);
        const r = pc.getPropertyValue('--r').trim() || '0deg';
        const sc = parseFloat(pc.getPropertyValue('--s')) || 1;
        const lead = k === 'pos' || k === 'stock';
        const at = (x: number, y: number, z: number, rot = '0deg') => `translate(${x - n.x}px, ${y - n.y}px) rotate(${rot}) scale(${z})`;
        const rest = at(n.x, n.y, sc, r);
        const o = (ms: number) => ms / T.end;
        anims.push(
          p.animate(
            [
              { offset: 0, transform: rest, opacity: 1 },
              { offset: o(T.connect), transform: rest, opacity: 1, easing: MOVE },
              { offset: o(T.tyll), transform: at(g.x, g.y, g.s), opacity: lead ? 1 : 0.6, easing: MOVE },
              { offset: o(T.tyll + (lead ? 420 : 250)), opacity: 0 },
              { offset: o(T.settle), transform: at(d.x, d.y, d.w / n.w), opacity: 0 },
              { offset: 1, transform: at(d.x, d.y, d.w / n.w), opacity: 0 },
            ],
            { duration: T.end, fill: 'both' },
          ),
        );
      });
      // The shared Coca-Cola line is marked in both records as they come together
      all('.piece__match').forEach((m) =>
        anims.push(
          m.animate(
            [
              { offset: 0, backgroundColor: 'rgba(251, 241, 220, 0)' },
              { offset: (T.connect + 400) / T.end, backgroundColor: 'rgba(251, 241, 220, 0)' },
              { offset: (T.tyll - 200) / T.end, backgroundColor: '#fbf1dc' },
              { offset: 1, backgroundColor: '#fbf1dc' },
            ],
            { duration: T.end, fill: 'both' },
          ),
        ),
      );

      // Before Tyll, the window's place is only a pale surface; Tyll forms around the records
      anims.push(
        one('.app__shell').animate([{ offset: 0, opacity: 0.45, transform: 'scale(0.985)', boxShadow: 'none' }], {
          delay: T.tyll,
          duration: 600,
          easing: EASE,
          fill: 'backwards',
        }),
      );
      anims.push(stage.animate([{ offset: 0, opacity: 0 }], { pseudoElement: '::after', delay: T.tyll, duration: 600, fill: 'backwards' }));
      enter(one('.app__rail'), T.tyll + 100, 500, { opacity: 0 });
      enter(one('.app__bar'), T.tyll + 100, 500, { opacity: 0 });
      all('.app__list, .app__detail').forEach((el) => enter(el, T.tyll + 100, 500, { borderColor: 'transparent' }));
      enter(one('.list__head'), T.tyll + 200, 450);
      all('.row').forEach((row, i) => enter(row, T.tyll + 280 + i * 90, 450));
      enter(one('.list__foot'), T.settle, 400, { opacity: 0 });

      // 4 · The problem first: the Coca-Cola difference, then the 8 unexplained cans
      enter(one('.row--on'), T.problem, 500, { borderColor: 'transparent', backgroundColor: 'rgba(255, 250, 240, 0)', boxShadow: '0 0 0 0 rgba(236, 217, 176, 0)' });
      enter(one('.d__head'), T.problem + 50, 450);
      enter(one('.d__line'), T.gap, 450, { opacity: 0, transform: 'translateY(6px)' });

      // 5 · Its evidence: the records, already in place but quiet, come forward with what Tyll found in them
      all('.rec').forEach((rec, i) => {
        const lag = i * 150;
        const dur = T.evidence + 450 + lag - T.tyll;
        anims.push(
          rec.animate(
            [
              { offset: 0, opacity: 0 },
              { offset: 250 / dur, opacity: 0, easing: EASE },
              { offset: 600 / dur, opacity: 0.35 },
              { offset: (T.evidence + lag - T.tyll) / dur, opacity: 0.35, easing: EASE },
            ],
            { delay: T.tyll, duration: dur, fill: 'backwards' },
          ),
        );
      });
      enter(one('.d__label--ev'), T.evidence - 100, 400, { opacity: 0 });
      all('.rec .pill').forEach((pill, i) => enter(pill, T.evidence + 250 + i * 150, 400, { opacity: 0, transform: 'scale(0.85)' }));

      // 6 · The next step and who is responsible
      enter(one('.d__next'), T.next, 450);
      enter(one('.d__assigned'), T.next + 300, 400, { opacity: 0, transform: 'scale(0.9)' });
      enter(one('.d__caution'), T.next + 350, 400, { opacity: 0 });

      // The chapters: Before Tyll leads until the window forms, then With Tyll
      const [chB, chA] = all('.ch');
      const turn = T.tyll - 200;
      enter(chB, turn, 500, { color: ink });
      enter(chB.querySelector('.ch__k')!, turn, 500, { color: steel });
      enter(chA, turn, 500, { color: fog });
      enter(chA.querySelector('.ch__k')!, turn, 500, { color: fog });
      const [railB, railA] = all('.ch__rail i');
      anims.push(railB.animate([{ offset: 0, transform: 'scaleX(0)' }], { duration: T.tyll, easing: 'linear', fill: 'backwards' }));
      enter(railB, turn, 500, { backgroundColor: ink });
      anims.push(railA.animate([{ offset: 0, transform: 'scaleX(0)' }], { delay: T.tyll, duration: T.end - T.tyll, easing: 'linear', fill: 'backwards' }));

      // The clock: when it ends, the final view (the page's own) remains
      clock = new Animation(new KeyframeEffect(null, [], { duration: T.end }), document.timeline);
      clock.onfinish = finish;
      clock.play();
      anims.push(clock);
      cine.classList.add('is-anim');
      anims.forEach((x) => x.pause());
    };

    const seek = (t: number) => anims.forEach((x) => (x.currentTime = t));

    const finish = () => {
      cancelAnimationFrame(raf);
      cancelAll();
      cine.classList.remove('is-anim');
      cine.dataset.scene = '6';
      setState('done');
    };

    const play = () => {
      build();
      seek(0);
      anims.forEach((x) => x.play());
      setState('playing');
      tick();
    };

    const pause = () => {
      if (state !== 'playing') return;
      anims.forEach((x) => x.pause());
      cancelAnimationFrame(raf);
      syncScene();
      setState('paused');
    };

    const resume = () => {
      if (state !== 'paused') return;
      anims.forEach((x) => x.play());
      setState('playing');
      tick();
    };

    // The first frame: the records apart, waiting for the stage to come into view
    const ready = () => {
      build();
      seek(0);
      cine.dataset.scene = '1';
      setState('idle');
    };

    // If the layout changes width mid-sequence, measure again and carry on from the same moment
    let resizeFrame = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        if (state === 'done' || Math.abs(stage.getBoundingClientRect().width - builtWidth) < 1) return;
        const t = now();
        const playing = state === 'playing';
        build();
        seek(t);
        if (playing) anims.forEach((x) => x.play());
      });
    }).observe(stage);

    ctrl.addEventListener('click', () => {
      autoPaused = false;
      if (state === 'playing') pause();
      else if (state === 'paused') resume();
      else play();
    });

    // Starts once the stage is well in view; pauses when it leaves, resumes when it is back
    const io = new IntersectionObserver(
      ([entry]) => {
        const visible = entry.intersectionRatio >= 0.3;
        if (state === 'idle' && visible) play();
        else if (state === 'playing' && !entry.isIntersecting) {
          pause();
          autoPaused = true;
        } else if (state === 'paused' && autoPaused && visible) {
          autoPaused = false;
          resume();
        }
      },
      { threshold: [0, 0.3] },
    );

    ready();
    ctrl.hidden = false;
    io.observe(stage);

    // If the visitor asks for reduced motion later, show the final view and stop
    reduce.addEventListener('change', () => {
      if (!reduce.matches) return;
      io.disconnect();
      finish();
      ctrl.hidden = true;
    });
  }
</script>
