---
// Homepage section 4: the closing invitation, as calm and dark as the opening.
import Logo from '../Logo.astro';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.invite;

// The silver wave: fine lines that dip beneath the buttons and rise in a long arc to the right, a quiet echo of
// the Tyll checkmark. Each line slowly changes shape over one 16-second cycle. The frames below are samples of
// smooth periodic motion, and the last frame equals the first, so the loop never restarts visibly.
const LINES = 13;
const FRAMES = 12;
const r = (n: number) => Math.round(n * 10) / 10;
const wave = (i: number, phase: number) => {
  const a = phase * Math.PI * 2;
  const k = i - (LINES - 1) / 2; // -6 … 6, the middle line is the strongest
  const fan = k * (9 + 2.2 * Math.sin(a + i * 0.35)); // the ribbon widens and narrows as it moves
  const dipX = 560 + 46 * Math.sin(a);
  const dipY = 660 + 26 * Math.sin(a + 1.2) + fan * 0.55;
  const startY = 560 + 22 * Math.cos(a + 0.6) + fan * 0.9;
  const riseY = 330 + 34 * Math.sin(a + 2.1) + fan * 1.25;
  const endY = 170 + 28 * Math.cos(a + 0.4) + fan * 1.6;
  return `M -80 ${r(startY)} C 180 ${r(startY + 40)}, ${r(dipX - 260)} ${r(dipY)}, ${r(dipX)} ${r(dipY)} S ${r(1080 + 30 * Math.sin(a + 0.9))} ${r(riseY)}, 1520 ${r(endY)}`;
};
const lines = Array.from({ length: LINES }, (_, i) => {
  const frames = Array.from({ length: FRAMES + 1 }, (_, f) => wave(i, (f % FRAMES) / FRAMES));
  const k = Math.abs(i - (LINES - 1) / 2) / ((LINES - 1) / 2);
  return { d: frames[0], values: frames.join(';'), opacity: r(0.95 - k * 0.65) };
});
---

<section class="invite on-dark" data-dark aria-labelledby="invite-title">
  <div class="invite__light" aria-hidden="true"></div>
  <svg class="invite__waves" viewBox="0 0 1440 800" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="invite-silver" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#c8cdd4" stop-opacity="0" />
        <stop offset="0.22" stop-color="#c8cdd4" stop-opacity="0.35" />
        <stop offset="0.42" stop-color="#eef0f3" stop-opacity="0.85" />
        <stop offset="0.7" stop-color="#a3a9b2" stop-opacity="0.45" />
        <stop offset="1" stop-color="#c8cdd4" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g fill="none" stroke="url(#invite-silver)" stroke-width="1" vector-effect="non-scaling-stroke">
      {
        lines.map((l) => (
          <path d={l.d} opacity={l.opacity} vector-effect="non-scaling-stroke">
            <animate attributeName="d" dur="16s" repeatCount="indefinite" values={l.values} />
          </path>
        ))
      }
    </g>
  </svg>
  <div class="wrap invite__inner">
    <Logo mark anim="draw" label="" class="invite__mark" />
    <h2 id="invite-title">{v.title}</h2>
    <p>{v.text}</p>
    <div class="invite__actions">
      <a class="btn btn--solid btn--lg" href={href('solutions', lang)} data-track="explore_solutions_click" data-track-from="final">
        {d.cta.solutions}
      </a>
      <a class="btn btn--line btn--lg" href={href('book', lang)} data-track="book_call_click" data-track-from="final">{d.cta.book}</a>
    </div>
  </div>
</section>

<style>
  .invite {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: clamp(6rem, 4rem + 8vw, 11rem);
    background: var(--ink);
    color: var(--on-dark);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* A soft pool of light behind the headline */
  .invite__light {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(45% 55% at 50% 42%, rgba(200, 205, 212, 0.13), transparent 70%),
      radial-gradient(80% 60% at 50% 120%, rgba(146, 153, 163, 0.12), transparent 70%);
    pointer-events: none;
  }

  /* The Tyll silver wave, flowing slowly. Its brightest lines pass beneath the buttons; around the paragraph
     the lines fade almost away so the text stays easy to read. */
  .invite__waves {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0.85;
    -webkit-mask-image:
      radial-gradient(34% 9% at 50% 59%, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.18) 55%, #000 100%),
      linear-gradient(0deg, #000 55%, transparent 92%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(34% 9% at 50% 59%, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.18) 55%, #000 100%),
      linear-gradient(0deg, #000 55%, transparent 92%);
    mask-composite: intersect;
    pointer-events: none;
  }

  .invite__inner {
    width: 100%;
    display: grid;
    justify-items: center;
  }

  .invite :global(.invite__mark) {
    width: 44px;
    height: auto;
    margin-bottom: 2rem;
    color: var(--on-dark);
  }

  .invite h2 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem);
    letter-spacing: -0.04em;
  }

  .invite p {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: rgba(244, 245, 247, 0.82);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .invite__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 640px) {
    .invite__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  // The wave only moves while it is on screen, and stays still for visitors who prefer less motion
  const svg = document.querySelector<SVGSVGElement>('.invite__waves');
  if (svg) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    const sync = () => (visible && !reduce.matches ? svg.unpauseAnimations() : svg.pauseAnimations());
    svg.pauseAnimations();
    if (reduce.matches) svg.setCurrentTime(0);
    new IntersectionObserver(([e]) => ((visible = e.isIntersecting), sync())).observe(svg);
    reduce.addEventListener('change', sync);
  }
</script>
