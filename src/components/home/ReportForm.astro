---
// The free purchasing report request. The site has no form backend: like the booking page's email option, the
// request goes out by email. On submit the visitor's email app opens with the details filled in, addressed to
// info@tyll.ai, so they can attach their POS sales export and send it. Nothing is stored on this website.
import { site } from '../../config/site';
import { integrations } from '../../config/integrations';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const v = t(lang).home.report;
const f = v.fields;
---

<form class="report" data-report data-email={site.email} data-subject={v.subject} novalidate>
  <div class="report__grid">
    <label class="field">
      <span>{f.name} <b aria-hidden="true">*</b></span>
      <input name="name" autocomplete="name" required />
    </label>
    <label class="field">
      <span>{f.venue} <b aria-hidden="true">*</b></span>
      <input name="venue" autocomplete="organization" required />
    </label>
    <label class="field">
      <span>{f.role}</span>
      <input name="role" autocomplete="organization-title" />
    </label>
    <label class="field">
      <span>{f.country}</span>
      <input name="country" autocomplete="country-name" />
    </label>
    <label class="field">
      <span>{f.pos}</span>
      <select name="pos">
        <option value="">{f.choose}</option>
        {integrations.map((i) => <option value={i.name}>{i.name}</option>)}
        <option value={f.other}>{f.other}</option>
      </select>
    </label>
    <label class="field">
      <span>{f.email} <b aria-hidden="true">*</b></span>
      <input name="email" type="email" autocomplete="email" required dir="ltr" />
    </label>
    <label class="field">
      <span>{f.phone}</span>
      <input name="phone" type="tel" autocomplete="tel" dir="ltr" />
    </label>
  </div>
  <p class="report__error" role="alert" hidden>{v.error}</p>
  <div class="report__actions">
    <button type="submit" class="btn btn--solid btn--lg">{v.submit}</button>
    <p class="report__how">{v.how}</p>
  </div>
  <p class="report__done" role="status" hidden>{v.done}</p>
</form>

<style>
  .report {
    margin-top: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    text-align: start;
  }

  .report__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field span {
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
  }

  .field b {
    color: var(--on-dark);
    font-weight: 500;
  }

  .field input,
  .field select {
    width: 100%;
    height: 50px;
    padding: 0 1rem;
    border: 1px solid rgba(244, 245, 247, 0.22);
    border-radius: 12px;
    background: rgba(244, 245, 247, 0.06);
    color: var(--on-dark);
    font: inherit;
    font-size: 1rem;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .field select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, rgba(244, 245, 247, 0.7) 50%), linear-gradient(135deg, rgba(244, 245, 247, 0.7) 50%, transparent 50%);
    background-position:
      calc(100% - 20px) 22px,
      calc(100% - 15px) 22px;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }

  :global([dir='rtl']) .field select {
    background-position:
      15px 22px,
      20px 22px;
  }

  .field select option {
    color: var(--ink);
  }

  .field input:hover,
  .field select:hover {
    border-color: rgba(244, 245, 247, 0.4);
  }

  .field input:focus-visible,
  .field select:focus-visible {
    border-color: var(--on-dark);
    background: rgba(244, 245, 247, 0.1);
    outline: none;
  }

  .field input[aria-invalid='true'] {
    border-color: #e8a29a;
  }

  .report__error {
    margin-top: 1rem;
    color: #f2b8b0;
    font-size: var(--fs-small);
  }

  .report__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }

  .report__how,
  .report__done {
    max-width: 30rem;
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .report__done {
    margin-top: 1rem;
    color: var(--on-dark);
  }

  [hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .report__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .report__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-report]').forEach((form) => {
    const error = form.querySelector<HTMLElement>('.report__error')!;
    const done = form.querySelector<HTMLElement>('.report__done')!;
    const labelOf = (el: Element) => el.closest('label')?.querySelector('span')?.firstChild?.textContent?.trim() ?? '';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')];
      let firstBad: HTMLElement | null = null;
      fields.forEach((el) => {
        const bad = !el.checkValidity() || ((el as HTMLInputElement).required && !el.value.trim());
        el.setAttribute('aria-invalid', String(bad));
        if (bad && !firstBad) firstBad = el;
      });
      error.hidden = !firstBad;
      if (firstBad) {
        (firstBad as HTMLElement).focus();
        return;
      }
      // The email the visitor sends: every filled-in field, one per line
      const lines = fields.filter((el) => el.value.trim()).map((el) => `${labelOf(el)}: ${el.value.trim()}`);
      const venue = (form.elements.namedItem('venue') as HTMLInputElement).value.trim();
      const subject = `${form.dataset.subject} – ${venue}`;
      const url = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n') + '\n\n')}`;
      // Only that a request was started is counted: never the details
      document.dispatchEvent(new CustomEvent('tyll:track', { detail: { event: 'report_request_click', location: 'home' } }));
      done.hidden = false;
      window.location.href = url;
    });
  });
</script>
