---
// "/" forwards to the English homepage. The instant refresh and the canonical link tell search engines that
// /en/ is the page to index, so this one needs no robots tag of its own.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Tyll</title>
    <meta http-equiv="refresh" content="0;url=/en/" />
    <link rel="canonical" href="/en/" />
  </head>
  <body><a href="/en/">Tyll</a></body>
</html>
