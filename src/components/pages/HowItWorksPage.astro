---
// How it works. Round 5 (25 Nov 2026, the owner: "cleaner and flow better"): the title beside one photograph, then
// the four steps in one column joined by a line that fills as you read; on desktops a single picture beside them
// stays in the middle of the screen and changes to each step's picture (HowVisual.astro: the booking card, the free
// purchasing report, three POS systems joined to Tyll read only, the morning brief, each on a photograph of that
// moment). The step being read is in full ink, the others dimmed. No scroll snapping, no zigzag, no alternating bands
// (all three before round 5). Then three reassurances, where Tyll comes from, and the dark closing band. Copy: `howPage`.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SilverWave from '../SilverWave.astro';
import HowVisual from './HowVisual.astro';
import { t, href, type Locale } from '../../i18n';
import heroPhoto from '../../assets/photos/events-banquet.jpg';
import callPhoto from '../../assets/photos/book-lobby.jpg';
import shelfPhoto from '../../assets/photos/how-count-jars.jpg';
import passPhoto from '../../assets/photos/problem/problem-stock.jpg';
import deskPhoto from '../../assets/photos/problem/problem-finance.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const p = d.howPage;
// The photograph behind each step's picture, and the part of it to keep in view
const stepPhotos: { src: ImageMetadata; focus: string }[] = [
  { src: callPhoto, focus: '45% 55%' },
  { src: shelfPhoto, focus: '60% 55%' },
  { src: passPhoto, focus: '60% 30%' },
  { src: deskPhoto, focus: '62% 40%' },
];
---

<Base lang={lang} page="how" title={d.meta.howTitle} description={d.meta.howDescription}>
  <div class="how-top">
    <SilverWave phase={0.7} />
    <div class="wrap how-top__grid">
      <header class="intro">
        <h1>{p.h1}</h1>
        <p class="intro__sub">{p.sub}</p>
        <a class="btn btn--solid btn--lg" href={href('book', lang)} data-track="book_demo_click" data-track-from="how">{d.cta.book}</a>
      </header>
      <div class="how-top__photo">
        <Picture src={heroPhoto} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 720, 960, 1280]} sizes="(max-width: 900px) 90vw, 620px" loading="eager" decoding="async" />
      </div>
    </div>
  </div>

  <section class="flow" aria-labelledby="steps-title" data-flow>
    <h2 id="steps-title" class="visually-hidden">{p.eyebrow}</h2>
    <div class="wrap flow__grid">
      <ol class="flow__steps" role="list">
        {
          p.steps.map(([title, text], i) => (
            <li class:list={['fstep', i === 0 && 'is-on']} data-step={i}>
              <span class="fstep__num" aria-hidden="true">
                {i + 1}
              </span>
              <div class="fstep__text">
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
              <div class="fstep__inline">
                <HowVisual lang={lang} i={i} title={title} photo={stepPhotos[i]} />
              </div>
            </li>
          ))
        }
      </ol>
      <div class="flow__stage" aria-hidden="true">
        {
          p.steps.map(([title], i) => (
            <div class:list={['flow__frame', i === 0 && 'is-on']} data-frame={i}>
              <HowVisual lang={lang} i={i} title={title} photo={stepPhotos[i]} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="assure" aria-label={p.eyebrow}>
    <ul class="wrap assure__list">
      {
        p.strip.map((item, i) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {i === 0 && (
                <>
                  <path d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12s-3.5 6.5-9.5 6.5S2.5 12 2.5 12Z" />
                  <circle cx="12" cy="12" r="3" />
                </>
              )}
              {i === 1 && <path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0ZM12 17v4" />}
              {i === 2 && (
                <>
                  <circle cx="12" cy="12" r="9" />
                  <path d="M15.5 8.6a4.4 4.4 0 1 0 0 6.8M7.5 10.6h6M7.5 13.4h6" />
                </>
              )}
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Where Tyll comes from lives on About us (the owner, 25 Nov 2026: no repeat here, only the way there) -->
  <p class="wrap origin">
    <a href={href('about', lang)}>{p.story.title} {lang === 'ar' ? '←' : '→'}</a>
  </p>

  <section class="final" aria-labelledby="final-title">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap final__inner">
      <h2 id="final-title">{p.final}</h2>
      <div class="final__actions">
        <a class="btn btn--lg final__book" href={href('book', lang)} data-track="book_demo_click" data-track-from="how-final">{d.cta.book}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // The step being read is the one crossing the middle of the screen: it is drawn in full ink and its picture shows in
  // the stage; the line beside the numbers fills as far as the reader has come. Desktops only, and only with
  // JavaScript: without it the steps keep their pictures under them.
  const flow = document.querySelector<HTMLElement>('[data-flow]');
  if (flow && 'IntersectionObserver' in window) {
    const steps = [...flow.querySelectorAll<HTMLElement>('[data-step]')];
    const frames = [...flow.querySelectorAll<HTMLElement>('[data-frame]')];
    const list = flow.querySelector<HTMLElement>('.flow__steps')!;
    flow.dataset.ready = '';
    const show = (i: number) => {
      steps.forEach((s, k) => s.classList.toggle('is-on', k === i));
      frames.forEach((f, k) => f.classList.toggle('is-on', k === i));
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) show(Number((e.target as HTMLElement).dataset.step));
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    steps.forEach((s) => io.observe(s));
    let queued = false;
    const fill = () => {
      queued = false;
      const r = list.getBoundingClientRect();
      const mid = innerHeight / 2;
      const p = Math.min(Math.max((mid - r.top) / r.height, 0), 1);
      flow.style.setProperty('--p', p.toFixed(3));
    };
    fill();
    addEventListener('scroll', () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(fill);
      }
    }, { passive: true });
    addEventListener('resize', fill);
  }
</script>

<style>
  /* The banner, as on the Solutions page */
  .how-top {
    position: relative;
    overflow: hidden;
  }

  .how-top > :global(*:not(.wave)) {
    position: relative;
    z-index: 1;
  }

  /* The title beside one large photograph, in the manner of the FAQ's contact card: rounded, lightly graded */
  .how-top__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--s-4) clamp(2rem, 1rem + 3vw, 4rem);
    align-items: center;
    padding-top: calc(var(--header-h) + var(--page-top));
    padding-bottom: var(--intro-gap);
  }

  .how-top__photo {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2);
  }

  .how-top__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 72% 50%;
    filter: var(--photo-grade);
  }

  h1 {
    max-width: 28ch;
    margin: 0;
    color: var(--ink);
    font-size: var(--fs-display);
    line-height: 1.08;
  }

  .intro__sub {
    max-width: 36rem;
    margin: 1.1rem 0 var(--s-3);
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  /* The four steps (round 5, 25 Nov 2026, the owner: "cleaner and flow better"). One calm column of steps joined by a
     line that fills as you read; on desktops one picture stays beside them and changes to each step's picture as you
     reach it, the step being read in full ink and the others dimmed. No snapping, no zigzag, no alternating bands.
     Without JavaScript, and on tablets and phones, each step shows its picture under it. */
  .flow {
    --p: 1;
    padding-block: var(--intro-gap) var(--section-y);
    background: var(--paper);
  }

  .flow__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .flow__steps {
    position: relative;
    display: grid;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The line down the numbers, filled in ink as far as the reader has come */
  .flow__steps::before,
  .flow__steps::after {
    position: absolute;
    top: 1.375rem;
    bottom: 1.375rem;
    inset-inline-start: calc(1.375rem - 1px);
    width: 2px;
    background: var(--sand-600);
    content: '';
  }

  .flow__steps::after {
    bottom: auto;
    height: calc(var(--p) * (100% - 2.75rem));
    background: var(--ink);
  }

  .fstep {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: var(--s-2) var(--s-3);
  }

  .fstep__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .fstep__text {
    align-self: center;
    transition: opacity 0.35s var(--ease);
  }

  .fstep h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.625rem, 1.3rem + 1.1vw, 2.375rem);
    font-weight: 300;
    line-height: 1.12;
  }

  .fstep p {
    max-width: 30rem;
    margin: 0.6rem 0 0;
    color: var(--text-2);
    font-size: clamp(1.0625rem, 0.95rem + 0.3vw, 1.1875rem);
    line-height: 1.55;
  }

  .fstep__inline {
    grid-column: 2;
    max-width: 34rem;
  }

  .flow__stage {
    display: none;
  }

  /* Desktops with JavaScript: the steps on the start side, each about two thirds of a screen tall; the stage on the
     end side stays in the middle of the screen while they pass */
  @media (min-width: 1024px) {
    .flow[data-ready] .flow__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--s-6);
    }

    .flow[data-ready] .flow__steps {
      gap: 0;
    }

    .flow[data-ready] .fstep {
      min-height: 62svh;
      align-content: center;
    }

    .flow[data-ready] .flow__steps::before,
    .flow[data-ready] .flow__steps::after {
      top: 31svh;
      bottom: calc(31svh);
    }

    .flow[data-ready] .flow__steps::after {
      bottom: auto;
      height: calc(var(--p) * (100% - 62svh));
    }

    .flow[data-ready] .fstep__num {
      align-self: center;
    }

    .flow[data-ready] .fstep:not(.is-on) .fstep__num {
      background: var(--paper);
      color: var(--ink);
    }

    .flow[data-ready] .fstep:not(.is-on) .fstep__text {
      opacity: 0.35;
    }

    .flow[data-ready] .fstep__inline {
      display: none;
    }

    .flow[data-ready] .flow__stage {
      position: sticky;
      top: calc(var(--header-h) + (100svh - var(--header-h) - var(--stage-h)) / 2);
      --stage-h: min(40rem, 78svh);
      display: block;
      align-self: start;
      height: var(--stage-h);
      margin-block: calc(31svh - var(--stage-h) / 2);
    }

    .flow__frame {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translateY(12px) scale(0.985);
      transition:
        opacity 0.45s var(--ease),
        transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .flow__frame.is-on {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fstep__num,
    .fstep__text,
    .flow__frame {
      transition: none;
    }
  }

  /* Three reassurances */
  .assure svg {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .assure {
    padding-block: var(--intro-gap);
    border-top: 1px solid var(--line);
    background: var(--page); /* white, never a tint (26 Nov 2026, the owner) */
    color: var(--ink);
  }

  .assure__list {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 1.25rem clamp(1.5rem, 5vw, 4rem);
    justify-content: center;
    margin-block: 0;
    list-style: none;
  }

  .assure li {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  /* The closing band */
  .origin {
    margin: 0;
    padding-block: var(--band-y);
    text-align: center;
  }

  .origin a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.875rem);
    font-weight: 300;
    text-decoration: underline;
    text-decoration-color: var(--sand-600);
    text-underline-offset: 6px;
  }

  .origin a:hover {
    text-decoration-color: currentColor;
  }

  .final {
    position: relative;
    overflow: hidden;
    padding-block: var(--band-y);
    background: var(--night-1);
    color: var(--on-dark);
  }

  .final__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: center;
    justify-content: space-between;
  }

  .final h2 {
    max-width: 18ch;
    margin: 0;
    color: var(--on-dark);
    font-size: var(--fs-h2);
  }

  .final__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .final__book,
  .final__book:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .final__book:hover {
    background: var(--mist);
  }



  /* Tablets and phones: one column, the line and the numbers down the start edge */
  /* The title over the photograph */
  @media (max-width: 900px) {
    .how-top__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .how-top__photo :global(img) {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 860px) {
    .assure__list {
      grid-template-columns: minmax(0, 1fr);
      justify-content: start;
    }
  }
</style>
