    display: grid;
    gap: 0.5rem;
  }

  .xrow__clip {
    display: block;
    width: 100%;
    aspect-ratio: 1440 / 900;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--page-deep);
  }

  @media (max-width: 760px) {
    .xrow__body,
    .xrow__body--film {
      grid-template-columns: minmax(0, 1fr);
      padding-inline-start: 0;
    }

    .xrow__clip {
      width: auto;
      max-width: 100%;
      height: min(56svh, 30rem);
      aspect-ratio: 390 / 844;
    }
  }
</style>

<script>
  // The rows under "Also in …": one open at a time; a row's film loads only when it opens; an address that ends in a
  // row's #id (the old pages redirect here) opens that row.
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  const phone = matchMedia('(max-width: 700px)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const setRow = (row: HTMLElement, open: boolean) => {
    const head = row.querySelector<HTMLButtonElement>('.xrow__head')!;
    const panel = row.querySelector<HTMLElement>('.xrow__panel')!;
    const clip = row.querySelector<HTMLVideoElement>('video');
    head.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (!clip) return;
    if (open) {
      if (!clip.getAttribute('src')) {
        clip.poster = (phone.matches ? clip.dataset.phonePoster : clip.dataset.deskPoster)!;
        clip.src = (phone.matches ? clip.dataset.phone : clip.dataset.desk)!;
      }
      if (!still.matches) clip.play().catch(() => {});
    } else clip.pause();
  };
  const openOnly = (row: HTMLElement | undefined) => rows.forEach((r) => setRow(r, r === row));
  rows.forEach((row) =>
    row.querySelector('.xrow__head')!.addEventListener('click', () => {
      const isOpen = row.querySelector('.xrow__head')!.getAttribute('aria-expanded') === 'true';
      openOnly(isOpen ? undefined : row);
    }),
  );
  const fromHash = () => {
    const row = rows.find((r) => `#${r.id}` === location.hash);
    if (!row) return;
    openOnly(row);
    requestAnimationFrame(() => row.scrollIntoView({ block: 'start' }));
  };
  fromHash();
  addEventListener('hashchange', fromHash);
</script>
