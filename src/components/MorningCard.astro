---
// The morning brief, as one example card (the demo's fictional data, as the footer says), in the demo's own order: what
// Grand Hotel Lumière lost yesterday and on what, yesterday's revenue and the flags still open, the three things to do
// today, each with its amount where it has one, then the last 30 days, lost against saved, and a link. Used as step 4 of the
// How it works page (its link drawn as plain text because the picture there is decorative). Copy: `hero.card`.
import { href } from '../i18n/routes';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  float?: boolean;
  link?: boolean;
}

const { lang, float = false, link = true } = Astro.props;
const h = t(lang).hero;
const cta = h.card.cta.replace(/\s*[→←]\s*$/, '');
const arrow = lang === 'ar' ? '←' : '→';
---

<figure class:list={['morning', float && 'is-float']}>
  <figcaption class="morning__title">{h.card.title}</figcaption>
  <p class="morning__sum">
    <span>{h.card.lost}</span>
    <b dir="ltr">{h.card.total}</b>
  </p>
  <p class="morning__split">{h.card.split}</p>
  <ul class="morning__day" role="list">
    {h.card.yesterday.map((line) => <li>{line}</li>)}
  </ul>
  <p class="morning__todo">{h.card.todo}</p>
  <ol class="morning__rows">
    {
      h.card.rows.map(([what, detail, amount], i) => (
        <li>
          <span class="morning__icon" aria-hidden="true">{i + 1}</span>
          <span class="morning__what">
            <b>{what}</b>
            <span>{detail}</span>
          </span>
          <span class="morning__money">{amount && <b dir="ltr">{amount}</b>}</span>
        </li>
      ))
    }
  </ol>
  <p class="morning__month">{h.card.month}</p>
  {
    link ? (
      <a class="morning__cta" href={href('finance', lang)}>
        {cta} <span aria-hidden="true">{arrow}</span>
      </a>
    ) : (
      <span class="morning__cta">
        {cta} <span aria-hidden="true">{arrow}</span>
      </span>
    )
  }
</figure>

<style>
  .morning {
    margin: 0;
    padding: 1.5rem 1.5rem 1.25rem;
    border-radius: 22px;
    background: var(--paper);
    color: var(--ink);
    box-shadow:
      0 1px 3px rgb(var(--ink-rgb) / 0.06),
      0 36px 64px -32px rgb(var(--ink-rgb) / 0.38);
  }

  .morning.is-float {
    animation: float 7s ease-in-out infinite alternate;
  }

  @keyframes float {
    to {
      transform: translateY(-10px);
    }
  }

  .morning__title {
    color: var(--steel);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .morning__sum {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    margin: 0.45rem 0 0;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 300;
    line-height: 1.2;
  }

  .morning__sum b {
    color: var(--ink);
    font-weight: 400;
  }

  .morning__split {
    max-width: none;
    margin: 0.3rem 0 0;
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .morning__day {
    display: grid;
    gap: 0.2rem;
    margin: 0.7rem 0 0;
    padding: 0.7rem 0 0;
    border-top: 1px solid rgb(var(--ink-rgb) / 0.08);
    color: var(--graphite);
    font-size: 0.8125rem;
    line-height: 1.4;
    list-style: none;
  }

  .morning__month {
    max-width: none;
    margin: 0.2rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid rgb(var(--ink-rgb) / 0.08);
    color: var(--graphite);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .morning__todo {
    max-width: none;
    margin: 1.1rem 0 0;
    color: var(--steel);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .morning__rows {
    display: grid;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .morning__rows li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.8rem 0;
    border-top: 1px solid rgb(var(--ink-rgb) / 0.08);
  }

  .morning__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    background: var(--mist);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .morning__icon svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .morning__what,
  .morning__money {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .morning__what b {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .morning__what span {
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .morning__money {
    justify-items: end;
    text-align: end;
  }

  .morning__money b {
    color: var(--ink);
    font-weight: 600;
  }

  .morning__money span {
    color: var(--steel);
    font: 400 0.6875rem/1.3 var(--mono);
    white-space: nowrap;
  }

  .morning__cta {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.8rem;
    background: var(--mist);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .morning__cta:hover {
    background: rgb(var(--ink-rgb) / 0.08);
  }

  @media (max-width: 560px) {
    .morning {
      padding: 1.15rem 1.1rem 1rem;
    }

    .morning__rows li {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: 0.65rem;
    }

    .morning__icon {
      width: 2rem;
      height: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .morning.is-float {
      animation: none;
    }
  }
</style>
