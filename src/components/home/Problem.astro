---
import Logo from '../Logo.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang).problem;
---

<section class="problem" id="problem" aria-labelledby="problem-title">
  <div class="wrap">
    <header class="problem__head">
      <h2 id="problem-title">{d.title}</h2>
      <p>{d.intro}</p>
    </header>

    <div class="compare">
      <div class="compare__col compare__col--without">
        <h3>{d.without}</h3>
        <ul>
          {
            d.withoutItems.map((item) => (
              <li>
                <span class="dash" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="compare__col compare__col--with" data-check-group="sequence">
        <h3>{d.with}</h3>
        <ul>
          {
            d.withItems.map((item) => (
              <li>
                <Logo mark anim="draw" label="" class="tick" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="problem__note">{d.note}</p>

    <aside class="evidence" aria-labelledby="evidence-title">
      <div class="evidence__head">
        <h3 id="evidence-title">{d.evidenceTitle}</h3>
        <p>{d.evidenceNote}</p>
      </div>
      <dl class="evidence__list">
        {
          d.evidence.map((e) => (
            <div class="evidence__item">
              <dt>{e.figure}</dt>
              <dd>
                <p class="evidence__text">{e.text}</p>
                <p class="evidence__context">{e.context}</p>
                <p class="evidence__source">
                  {d.source}:{' '}
                  <a href={e.url} target="_blank" rel="noopener">
                    {e.source}
                  </a>
                </p>
              </dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>

<style>
  .problem {
    padding-block: var(--section-y);
    background: var(--paper);
  }

  .problem__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
  }

  .problem__head h2 {
    font-size: var(--fs-h2);
    max-width: 16ch;
  }

  .problem__head p {
    max-width: 34rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .compare__col {
    padding: clamp(1.5rem, 1.1rem + 1.5vw, 2.5rem);
    border-radius: var(--radius-lg);
  }

  .compare__col--without {
    background: var(--cloud);
    color: var(--steel);
  }

  .compare__col--with {
    border: 1px solid var(--line);
    box-shadow: 0 1px 0 var(--line), 0 24px 48px -32px rgba(20, 22, 26, 0.18);
  }

  .compare h3 {
    margin-bottom: 1.5rem;
    color: var(--ink);
    font-size: var(--fs-h3);
  }

  .compare__col--without h3 {
    color: var(--steel);
  }

  .compare ul {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .compare li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .dash {
    flex: none;
    width: 14px;
    height: 1.5px;
    background: var(--silver);
    transform: translateY(-0.3em);
  }

  .compare li :global(.tick) {
    flex: none;
    width: 18px;
    height: auto;
    color: var(--ink);
    transform: translateY(0.12em);
  }

  .problem__note {
    margin-top: 1.25rem;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  .evidence {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: 2rem 4rem;
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .evidence__head h3 {
    font-size: 1.0625rem;
  }

  .evidence__head p {
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .evidence__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;
    margin: 0;
  }

  .evidence__item dt {
    color: var(--graphite);
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .evidence__item dd {
    margin: 0.9rem 0 0;
  }

  .evidence__text {
    font-size: 0.9875rem;
    line-height: 1.5;
  }

  .evidence__context,
  .evidence__source {
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .evidence__source a {
    text-underline-offset: 3px;
    text-decoration-color: var(--silver);
  }

  .evidence__source a:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 860px) {
    .problem__head,
    .evidence {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .compare,
    .evidence__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
