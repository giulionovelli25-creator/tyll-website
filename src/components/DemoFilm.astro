---
// A short film of the real demo doing the job, recorded from the demo itself. It plays by itself while on screen, and
// the chapter beside it says what is happening. A chapter can be chosen to jump to that moment. Each language has its
// own recording. The demo is desktop only (the owner, 24 Nov 2026), so phones get the same desktop recording, never
// the demo in a phone layout.
// It is shown as a screen, not as a page of the demo: in a browser frame that hangs out of
// a block tinted in the solution's own colour. Whatever the page puts in the slot sits on that block, above the screen.
import film from '../content/film.json';
import { site } from '../config/site';
import { t, type Locale } from '../i18n';
import type { SolutionKey } from '../i18n/routes';

/** A chapter of the film: what is on screen from that moment (since 20 Nov 2026 the page's three "What you are about
    to see" steps, so the two always agree) */
type Spot = { label: Record<Locale, string>; text?: Record<Locale, string> };

interface Props {
  lang: Locale;
  solutionKey: SolutionKey;
  name: string;
  spots: Spot[];
  /** Fit mode (solution pages, round 4): no tinted block, and on desktops the screen takes its width from the
      window's height, so the film and its three steps fit under the header without scrolling */
  fit?: boolean;
}

const { lang, solutionKey, name, spots, fit = false } = Astro.props;
const d = t(lang);
// Chapter times from the recording (film.json, written by the recorder); even thirds until a film is recorded
const fallback = { marks: [0, 5, 10], dur: 15 };
const desk = (film as Record<string, Record<string, { desk: typeof fallback }>>)[lang]?.[solutionKey]?.desk ?? fallback;
const base = `/media/film/${lang}/${solutionKey}`;
// the address shown in the frame is the demo's real one
const host = site.demoUrl ? new URL(site.demoUrl).host : '';
---

<div class:list={['film', fit && 'film--fit']} data-film data-desk={JSON.stringify(desk)}>
  <div class="film__stage">
    <slot />
    <figure class="film__frame">
      <div class="film__chrome" dir="ltr" aria-hidden="true">
        <span class="film__dots"><i></i><i></i><i></i></span>
        {host && <span class="film__url">{host}</span>}
      </div>
      <div class="film__screen" dir="ltr">
        <video muted loop playsinline controls preload="none" poster={`${base}-desk.jpg`} aria-label={name}>
          <source src={`${base}-desk.mp4`} type="video/mp4" />
        </video>
      </div>
    </figure>
  </div>
  <div class="film__bar-row">
    <ol class="film__chapters">
      {
        spots.map((s, i) => (
          <li class:list={['film__chapter', i === 0 && 'is-on']} data-chapter={i}>
            <button type="button" aria-current={i === 0 ? 'step' : undefined}>
              <span class="film__bar" aria-hidden="true"><i></i></span>
              <span class="film__label">{s.label[lang]}</span>
            </button>
            {s.text && <p class="film__text">{s.text[lang]}</p>}
          </li>
        ))
      }
    </ol>
    <button class="film__toggle" type="button" aria-pressed="false" data-pause={d.hero.pause} data-play={d.hero.play} hidden>
      <span class="visually-hidden">{d.hero.pause}</span>
      <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.25v10H4.5zM9.25 3h2.25v10H9.25z" fill="currentColor"></path></svg>
      <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor"></path></svg>
    </button>
  </div>
</div>

<style>
  .film {
    --film-w: 68rem;
    --hang: clamp(2.5rem, 1rem + 6vw, 6rem);
    display: grid;
    gap: var(--s-3);
  }

  /* The tinted block, as wide as the page's column. The screen is narrower and hangs out of its lower edge. */
  .film__stage {
    position: relative;
    padding: clamp(1.5rem, 0.75rem + 2.4vw, 3rem) clamp(1rem, 0.25rem + 3vw, 3.5rem) 0;
  }

  .film__stage::before {
    position: absolute;
    inset: 0 0 var(--hang);
    border: 1px solid rgb(var(--acc-rgb) / 0.12);
    border-radius: var(--radius-lg);
    background: var(--acc-wash);
    content: '';
  }

  .film__frame {
    position: relative;
    max-width: var(--film-w);
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid rgb(var(--ink-rgb) / 0.14);
    border-radius: var(--radius-md);
    background: var(--paper);
    box-shadow: var(--shadow-3);
  }

  /* the browser's bar: three dots and the demo's address */
  .film__chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--sand-100);
  }

  .film__dots {
    display: flex;
    gap: 0.4rem;
  }

  .film__dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--sand-600);
  }

  .film__url {
    min-width: min(18rem, 46vw);
    padding: 0.2rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    background: var(--paper);
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
  }

  .film__screen {
    background: var(--mist);
  }

  .film video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 900;
  }

  /* the caption below is placed against the whole row (chapters and the pause button), so it centres under the film */
  .film__bar-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--s-2);
    width: 100%;
    max-width: var(--film-w);
    margin-inline: auto;
  }

  .film__chapters {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0 0 3.25rem;
    list-style: none;
  }

  .film__chapter button {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    min-height: 44px;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: var(--text-3);
    font: inherit;
    font-size: var(--fs-small);
    text-align: start;
    cursor: pointer;
    transition: color 0.25s var(--ease);
  }

  .film__chapter.is-on button,
  .film__chapter button:hover {
    color: var(--ink);
  }

  .film__chapter.is-on .film__label {
    font-weight: 600;
  }

  .film__bar {
    display: block;
    height: 3px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--hair);
  }

  .film__bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--acc);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  :global([dir='rtl']) .film__bar i {
    transform-origin: right;
  }

  /* The current chapter's one line sits under the whole row. Without JavaScript each stays under its own label. */
  .film__text {
    margin-top: 0.25rem;
    font-size: var(--fs-small);
    line-height: 1.35;
  }

  .film.is-ready .film__text {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    margin: 0;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    max-width: none;
    text-align: center;
  }

  .film.is-ready .film__chapter:not(.is-on) .film__text {
    display: none;
  }

  .film__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--hair);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .film__toggle[hidden] {
    display: none;
  }

  .film__toggle svg {
    width: 14px;
    height: 14px;
  }

  .film__toggle .i-play,
  .film__toggle[aria-pressed='true'] .i-pause {
    display: none;
  }

  .film__toggle[aria-pressed='true'] .i-play {
    display: block;
  }

  /* Fit mode: the screen's height is the window's height under the header, less the steps under it (--labels-h) and
     32 px of air; the width follows from the recording's 16:10 and the browser bar above it (--chrome-h) */
  .film--fit {
    --labels-h: 6rem;
    --chrome-h: 2.25rem;
    --film-w: min(100%, calc((100svh - var(--header-h) - var(--labels-h) - 32px - var(--chrome-h)) * 1.6));
    gap: 0.75rem;
  }

  .film--fit .film__stage {
    padding: 0;
  }

  .film--fit .film__stage::before {
    display: none;
  }

  .film--fit .film__frame {
    width: var(--film-w);
  }

  .film--fit .film__chapters {
    padding-bottom: 2.5rem;
  }

  .film--fit.is-ready .film__text {
    color: var(--steel);
    font-size: 1rem;
    line-height: 1.4;
  }

  /* Phones: the same desktop recording in its browser frame, full width, with a shorter bar above it */
  @media (max-width: 700px) {
    .film {
      --hang: 2.5rem;
    }

    .film__chrome {
      padding: 0.4rem 0.6rem;
    }

    .film__url {
      min-width: 0;
      font-size: 0.75rem;
    }

    .film__chapters {
      padding-bottom: 4rem;
    }

    .film--fit {
      --film-w: 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-film]').forEach((film) => {
    const video = film.querySelector('video')!;
    const toggle = film.querySelector<HTMLButtonElement>('.film__toggle')!;
    const label = toggle.querySelector('.visually-hidden')!;
    const chapters = [...film.querySelectorAll<HTMLElement>('[data-chapter]')];
    // `end`, where set, cuts a film short: it loops back to the start there (the stock film stops before its count)
    const timing = () => JSON.parse(film.dataset.desk!) as { marks: number[]; dur: number; end?: number };
    // With reduced motion the film waits to be played
    let userPaused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let onScreen = false;

    video.controls = false;
    film.classList.add('is-ready');
    toggle.hidden = false;

    const sync = () => {
      toggle.setAttribute('aria-pressed', String(video.paused));
      label.textContent = video.paused ? toggle.dataset.play! : toggle.dataset.pause!;
    };
    const play = () => {
      if (video.preload === 'none') video.preload = 'auto';
      video.play().catch(sync);
    };
    const paint = () => {
      const { marks, dur } = timing();
      const now = video.currentTime;
      let active = 0;
      marks.forEach((m, i) => {
        if (now >= m) active = i;
      });
      chapters.forEach((c, i) => {
        const on = i === active;
        c.classList.toggle('is-on', on);
        const end = marks[i + 1] ?? dur;
        const part = now >= end ? 1 : now <= marks[i] ? 0 : (now - marks[i]) / (end - marks[i]);
        c.querySelector<HTMLElement>('.film__bar i')!.style.setProperty('--p', String(i < active ? 1 : part));
        const button = c.querySelector('button')!;
        if (on) button.setAttribute('aria-current', 'step');
        else button.removeAttribute('aria-current');
      });
    };
    const tick = () => {
      paint();
      if (!video.paused) requestAnimationFrame(tick);
    };

    video.addEventListener('play', () => {
      sync();
      requestAnimationFrame(tick);
    });
    video.addEventListener('pause', sync);
    video.addEventListener('timeupdate', () => {
      const { end } = timing();
      // timeupdate arrives about every quarter second, so turn back a little early and never show the cut part
      if (end && video.currentTime >= end - 0.3) video.currentTime = 0;
    });
    video.addEventListener('seeked', paint);
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) video.pause();
      else play();
    });
    chapters.forEach((c, i) =>
      c.querySelector('button')!.addEventListener('click', () => {
        if (video.preload === 'none') video.preload = 'auto';
        video.currentTime = timing().marks[i] + 0.05;
        userPaused = false;
        play();
        paint();
      }),
    );

    new IntersectionObserver(
      ([e]) => {
        onScreen = e.isIntersecting;
        if (onScreen && !userPaused) play();
        else if (!onScreen && !video.paused) video.pause();
      },
      { threshold: 0.35 },
    ).observe(video);
    sync();
  });
</script>
