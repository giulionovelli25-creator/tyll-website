---
// The solutions overview: six large photo tiles. Reached from "All solutions" in the menu and from every
// "Explore Solutions" button; the Solutions dropdown in the header stays the quick way to one solution.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageIntro from '../PageIntro.astro';
import SolutionIcon from '../SolutionIcon.astro';
import { solutions } from '../../content/solutions';
import { t, href, solutionKeys, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<Base lang={lang} page="solutions" title={d.meta.solutionsTitle} description={d.meta.solutionsDescription}>
  <PageIntro title={d.solutionPage.indexTitle} intro={d.solutionPage.indexIntro} />
  <section class="wrap tiles-wrap" aria-label={d.nav.solutions}>
    <ul class="tiles">
      {
        solutionKeys.map((k) => {
          const s = solutions[k];
          return (
            <li>
              <a class="tile on-dark" href={href(k, lang)}>
                <Picture
                  src={s.photo}
                  alt=""
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[480, 720, 1080]}
                  sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1100px) 45vw, 380px"
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${s.photoFocus}`}
                />
                <span class="tile__shade" aria-hidden="true" />
                <span class="tile__body">
                  <SolutionIcon name={s.icon} />
                  <span class="tile__name">{s.name[lang]}</span>
                  <span class="tile__desc">{s.menu[lang]}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="tiles__faq"><a href={href('faq', lang)}>{d.nav.faq}</a></p>
  </section>
</Base>

<style>
  .tiles-wrap {
    padding-bottom: var(--section-y);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--on-dark);
    text-decoration: none;
    isolation: isolate;
  }

  .tile :global(picture),
  .tile :global(img),
  .tile__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tile :global(picture),
  .tile :global(img) {
    z-index: -2;
  }

  .tile :global(img) {
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .tile:hover :global(img) {
    transform: scale(1.04);
  }

  .tile__shade {
    z-index: -1;
    background: linear-gradient(0deg, rgba(14, 15, 17, 0.88) 0%, rgba(14, 15, 17, 0.35) 55%, rgba(14, 15, 17, 0.15) 100%);
  }

  .tile__body {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.4rem;
    padding: 1.5rem;
  }

  .tile__body :global(svg) {
    width: 24px;
    height: 24px;
    margin-bottom: 0.4rem;
    opacity: 0.8;
  }

  .tile__name {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .tile__desc {
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .tiles__faq {
    margin-top: 2rem;
  }

  .tiles__faq a {
    font-weight: 500;
    text-underline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }

    .tile {
      aspect-ratio: 16 / 11;
    }
  }
</style>
