---
// Homepage chapter 3: one sourced finding (how many systems a typical hotel runs) beside one bright photograph.
// Industry research, never a Tyll result.
// Side by side, so the photo keeps its natural colour instead of being darkened behind text.
import { Picture } from 'astro:assets';
import reception from '../../assets/photos/why-reception.jpg';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const w = t(lang).home.why;
// The figure counts up when it first comes into view; the suffix (the "+") stays where it is
const [, count = w.figure, suffix = ''] = w.figure.match(/^(\d+)(.*)$/) ?? [];
---

<section class="why" aria-labelledby="why-title">
  <div class="why__photo">
    <Picture
      src={reception}
      alt={w.photoAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 860px) 100vw, 50vw"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="why__panel">
    <div class="why__inner">
      <h2 id="why-title">{w.title}</h2>
      <figure class="why__figure">
        <p class="why__number" aria-hidden="true"><bdi dir="ltr"><span data-count={count}>{count}</span>{suffix}</bdi></p>
        <figcaption>
          <p class="why__text"><span class="visually-hidden">{w.figure}: </span>{w.text}</p>
          <p class="why__context">{w.context}</p>
          <p class="why__source">
            {w.source}:{' '}
            <a href={w.sourceUrl} target="_blank" rel="noopener">{w.sourceName}</a>
          </p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .why {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: clamp(600px, 100svh, 980px);
    background: var(--cloud);
  }

  .why__photo {
    position: relative;
    overflow: hidden;
  }

  .why__photo :global(picture),
  .why__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .why__photo :global(img) {
    object-fit: cover;
    object-position: 52% 50%;
  }

  /* The text side: warm silver-white, with the Tyll wave as a whisper in the corner */
  .why__panel {
    position: relative;
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 2rem) var(--gut) var(--section-y);
    background:
      radial-gradient(90% 70% at 100% 100%, rgba(200, 205, 212, 0.35), transparent 70%),
      linear-gradient(180deg, #fbfbfc 0%, #f1f2f4 100%);
    overflow: hidden;
    isolation: isolate;
  }

  .why__panel::before {
    content: '';
    position: absolute;
    inset: 35% -30% -20% 20%;
    z-index: -1;
    background: url('/media/tyll-waves.webp') center / cover no-repeat;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(closest-side, #000 30%, transparent);
    mask-image: radial-gradient(closest-side, #000 30%, transparent);
  }

  .why__inner {
    max-width: 34rem;
  }

  .why h2 {
    max-width: 15ch;
    font-size: var(--fs-h2);
  }

  .why__figure {
    margin: clamp(2rem, 1.5rem + 2vw, 3.5rem) 0 0;
  }

  /* The one bold number on the homepage */
  .why__number {
    color: var(--ink);
    font-size: clamp(6rem, 3rem + 9vw, 11rem);
    font-weight: 200;
    letter-spacing: -0.06em;
    line-height: 0.82;
  }

  .why figcaption {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--silver);
  }

  .why__text {
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .why__context,
  .why__source {
    margin-top: 0.75rem;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  .why__source a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  @media (max-width: 860px) {
    .why {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .why__photo {
      aspect-ratio: 4 / 3;
    }

    .why__panel {
      padding-top: var(--section-y);
    }
  }
</style>

<script>
  // Counts the figure up from 1 the first time it comes into view (about 0.9 s, easing out), once per visit.
  // While counting, the number keeps the width of its final value, so the "+" beside it never moves.
  // With reduced motion, or without JavaScript, the final figure simply shows.
  const el = document.querySelector<HTMLElement>('.why__number [data-count]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const target = Number(el.dataset.count);
    // Measured with the final value in place (and again when counting starts, once the web font has loaded)
    const hold = () => {
      el.removeAttribute('style');
      el.textContent = String(target);
      const width = el.getBoundingClientRect().width;
      Object.assign(el.style, { display: 'inline-block', width: `${width}px`, textAlign: 'right' });
    };
    hold();
    el.textContent = '1';
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        hold();
        el.textContent = '1';
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / 900);
          const eased = 1 - (1 - p) ** 3;
          el.textContent = String(Math.max(1, Math.round(1 + eased * (target - 1))));
          if (p < 1) requestAnimationFrame(step);
          else el.removeAttribute('style');
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.6 },
    );
    io.observe(el);
  }
</script>
