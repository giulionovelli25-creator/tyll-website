---
import { Picture } from 'astro:assets';
import { site } from '../../config/site';
import { t, href, type Locale } from '../../i18n';
import stock from '../../assets/demo/preview-stock.png';
import forecast from '../../assets/demo/preview-forecast.png';
import rooms from '../../assets/demo/preview-rooms.png';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang).solutions;
const previews = [stock, forecast, rooms];
// The demo keeps the requested page through sign-in (/login?next=…), so these real routes are safe deep links.
const demoLink = (path: string) => (site.demoUrl ? new URL(path, site.demoUrl).href : undefined);
---

<section class="solutions" id="solutions" aria-labelledby="solutions-title">
  <div class="wrap">
    <header class="solutions__head">
      <h2 id="solutions-title">{d.title}</h2>
      <p>{d.intro}</p>
    </header>

    <ul class="cats">
      {
        d.categories.map((c, i) => (
          <li class="cat">
            <div class="cat__preview">
              <Picture
                src={previews[i]}
                alt={c.alt}
                formats={['avif', 'webp']}
                  fallbackFormat="webp"
                widths={[480, 720, 1080]}
                sizes="(max-width: 860px) calc(100vw - 32px), 380px"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="cat__body">
              <h3>{c.name}</h3>
              <p>{c.text}</p>
              <details class="cat__more">
                <summary>{d.examples}</summary>
                <ul>
                  {c.examples.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </details>
              {demoLink(c.path) && (
                <a class="cat__link" href={demoLink(c.path)} data-track="demo_click" data-track-from={`solutions-${i + 1}`}>
                  {d.explore}
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="notes">
      <div class="note" id="integrations">
        <h3>{d.integrationsTitle}</h3>
        <p>{d.integrationsText}</p>
        <p class="note__detail">{d.integrationsDetail}</p>
      </div>
      <div class="note" id="security">
        <h3>{d.securityTitle}</h3>
        <p>{d.securityText}</p>
        <a class="note__link" href={href('faq', lang, '#data')}>{d.securityLink}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .solutions {
    padding-block: var(--section-y);
    background: var(--paper);
  }

  .solutions__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
  }

  .solutions__head h2 {
    font-size: var(--fs-h2);
    max-width: 17ch;
  }

  .solutions__head p {
    max-width: 30rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .cats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .cat {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* The product shown on a soft silver plate, cropped to the top of the screen */
  .cat__preview {
    position: relative;
    aspect-ratio: 4 / 3;
    padding: 1.25rem 0 0 1.25rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--mist), #e7eaee);
    overflow: hidden;
  }

  .cat__preview :global(img) {
    width: 100%;
    height: auto;
    min-width: 560px;
    border-radius: 10px 0 0 0;
    box-shadow:
      0 0 0 1px rgba(20, 22, 26, 0.06),
      0 18px 40px -24px rgba(20, 22, 26, 0.35);
  }

  .cat__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem 0.25rem 0;
  }

  .cat h3 {
    font-size: 1.375rem;
    font-weight: 450;
    letter-spacing: -0.02em;
  }

  .cat__body > p {
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: 0.9875rem;
    line-height: 1.5;
  }

  .cat__more {
    margin-top: 1rem;
    width: 100%;
    border-top: 1px solid var(--line);
  }

  .cat__more summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .cat__more summary::-webkit-details-marker {
    display: none;
  }

  .cat__more summary::after {
    content: '';
    width: 9px;
    height: 9px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.3s var(--ease);
  }

  .cat__more[open] summary::after {
    transform: translateY(2px) rotate(-135deg);
  }

  .cat__more ul {
    display: grid;
    gap: 0.4rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    color: var(--graphite);
    font-size: 0.9375rem;
  }

  .cat__more li::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 1.5px;
    margin-right: 0.7rem;
    background: var(--silver);
    vertical-align: middle;
  }

  .cat__link {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .cat__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
    overflow: hidden;
  }

  .note {
    padding: clamp(1.5rem, 1.1rem + 1.5vw, 2.5rem);
    background: var(--cloud);
  }

  .note h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .note p {
    max-width: 34rem;
    margin-top: 0.9rem;
    color: var(--graphite);
    line-height: 1.6;
  }

  .note .note__detail {
    color: var(--steel);
    font-size: 0.9375rem;
  }

  .note__link {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .note__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 860px) {
    .solutions__head,
    .notes {
      grid-template-columns: minmax(0, 1fr);
    }

    .cats {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }

    .cat__preview {
      aspect-ratio: 16 / 10;
    }
  }
</style>
