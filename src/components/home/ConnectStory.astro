---
// Homepage chapter 2: a short, directed product sequence on a pearl stage (about 9.5 s).
//   1. Before Tyll: records from separate systems float apart: a POS order and a stock count, with two quieter
//      records (PMS, Finance) further back.
//   2. With Tyll: the Tyll window rises and the two records glide into it, where they become the evidence.
//   3. The issue they explain becomes prominent: the Coca-Cola difference at The Terrace.
//   4. The outcome: the next step and who is responsible, assigned.
//   5. A calm final product view that stays on screen.
// It starts when the stage is well in view, pauses when it leaves and resumes when it returns. It never touches
// scrolling. One button pauses, resumes or replays. Without JavaScript or with reduced motion, the final view is
// shown at once. The final view is ordinary, readable HTML in all four languages. All data is fictional and
// matches the Coca-Cola case in the simulated Tyll demo.
import Logo from '../Logo.astro';
import SolutionIcon from '../SolutionIcon.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = t(lang).home.problem;
const f = p.frags;
const v = p.view;
const [ownerName, ...roleParts] = v.ownerName.split(/،\s|,\s/);
const ownerRole = roleParts.join(', ');
---

<section class="story" id="story" aria-labelledby="story-title" data-story>
  <div class="story__light" aria-hidden="true"></div>
  <div class="wrap">
    <header class="story__head">
      <h2 id="story-title">{p.title}</h2>
      <div class="story__intro">
        <p>{p.text}</p>
        <p class="story__note">{p.note}</p>
      </div>
    </header>

    <div class="cine" data-cine data-scene="5" data-state="done" role="group" aria-label={p.stage}>
      <div class="cine__top">
        <ol class="cine__chapters">
          <li class="ch" data-ch="before">
            <span class="ch__k">{p.beforeLabel}</span>
            <span class="ch__m">{p.before}</span>
            <span class="ch__rail" aria-hidden="true"><i></i></span>
          </li>
          <li class="ch" data-ch="after">
            <span class="ch__k"><Logo mark label="" class="ch__tick" />{p.afterLabel}</span>
            <span class="ch__m">{p.after}</span>
            <span class="ch__rail" aria-hidden="true"><i></i></span>
          </li>
        </ol>
        <button type="button" class="cine__ctrl" data-ctrl data-pause={p.pause} data-play={p.play} data-replay={p.replay} hidden>
          <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.75 3.5h2v9h-2zM9.25 3.5h2v9h-2z" fill="currentColor" /></svg>
          <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.25 3.4v9.2L12.5 8z" fill="currentColor" /></svg>
          <svg class="i-replay" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8a4.8 4.8 0 1 0 1.5-3.5M3 2.6v2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="cine__ctrl-label">{p.replay}</span>
        </button>
      </div>

      <div class="cine__stage">
        <!-- Where the two records float before Tyll gathers them -->
        <span class="cine__anchor" data-anchor="pos" aria-hidden="true"></span>
        <span class="cine__anchor" data-anchor="stock" aria-hidden="true"></span>
        <!-- Two quieter records from other systems, further back -->
        <span class="chip" data-chip="pms" aria-hidden="true"><i class="mark mark--pms"></i><b>{f.pms.sys}</b>{f.pms.line}</span>
        <span class="chip" data-chip="finance" aria-hidden="true">
          <i class="mark mark--finance"></i><b>{f.finance.sys}</b>{f.finance.rows.map(([k, val]) => `${k} ${val}`).join(' · ')}
        </span>

        <div class="app">
          <span class="app__shell" aria-hidden="true"></span>

          <div class="app__rail" aria-hidden="true">
            <Logo mark label="" class="app__logo" />
            <span class="app__nav is-on"><SolutionIcon name="stock" /></span>
            <span class="app__nav"><SolutionIcon name="finance" /></span>
            <span class="app__nav"><SolutionIcon name="forecast" /></span>
            <span class="app__nav"><SolutionIcon name="events" /></span>
            <span class="app__nav"><SolutionIcon name="rooms" /></span>
          </div>

          <div class="app__bar">
            <span class="app__brand" aria-hidden="true"><Logo mark label="" class="app__brand-mark" />Tyll</span>
            <span class="app__place">{v.place}</span>
            <span class="app__user" aria-hidden="true"><span class="avatar">SH</span><span class="app__user-name">{ownerName}</span></span>
          </div>

          <div class="app__list">
            <p class="list__head">{v.attention}<span class="count">3</span></p>
            <ul>
              <li class="row row--on">
                <span class="row__marks" aria-hidden="true"><i class="mark mark--pos"></i><i class="mark mark--stock"></i></span>
                <span class="row__title">{v.issue}</span>
                <span class="pill pill--amber">{v.status}</span>
              </li>
              {
                v.tasks.map((task, i) => (
                  <li class="row" data-row={i === 0 ? 'pms' : 'finance'}>
                    <span class="row__marks" aria-hidden="true">
                      <i class={`mark mark--${i === 0 ? 'pms' : 'finance'}`} />
                    </span>
                    <span class="row__title">{task.title}</span>
                    <span class="row__tags">
                      <span class="pill">{task.team}</span>
                      <span class="pill">{task.status}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
            <p class="list__foot" aria-hidden="true">{v.simulated}</p>
          </div>

          <article class="app__detail">
            <div class="d__head">
              <span class="pill pill--amber">{v.status}</span>
              <h3 class="d__title">{v.issue}</h3>
              <p class="d__line">{v.issueLine}</p>
            </div>

            <p class="d__label">{v.evidenceLabel}</p>
            <div class="d__ev">
              <section class="rec" data-rec="stock" aria-label={f.stock.sys}>
                <p class="rec__sys"><i class="mark mark--stock" aria-hidden="true"></i>{f.stock.sys}</p>
                <p class="rec__title">{f.stock.title}</p>
                <p class="rec__vals">
                  <span>{f.stock.head[1]} <b>{f.stock.vals[1]}</b></span>
                  <span>{f.stock.head[2]} <b>{f.stock.vals[2]}</b></span>
                </p>
                <span class="pill pill--amber">{f.stock.flag}</span>
              </section>
              <section class="rec" data-rec="pos" aria-label={f.pos.sys}>
                <p class="rec__sys"><i class="mark mark--pos" aria-hidden="true"></i>{f.pos.sys}</p>
                <p class="rec__title">{f.pos.title}</p>
                <p class="rec__vals rec__vals--struck">
                  {
                    f.pos.rows.map(([k, val]) => (
                      <>
                        <s>{k}</s>
                        <s dir="ltr">{val}</s>
                      </>
                    ))
                  }
                </p>
                <span class="pill pill--amber">{f.pos.flag}</span>
              </section>
            </div>

            <div class="d__next">
              <p class="d__label">{v.nextLabel}</p>
              <p class="d__next-text">{v.nextText}</p>
              <div class="d__person">
                <span class="avatar" aria-hidden="true">SH</span>
                <span class="d__who">
                  <span class="d__who-k">{v.owner}</span>
                  <span class="d__who-name">{ownerName}<span class="d__who-role">{ownerRole}</span></span>
                </span>
                <span class="pill pill--ink d__assigned">{v.assigned}</span>
              </div>
            </div>

            <p class="d__caution">{v.caution}</p>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── The environment: pearl light, soft architectural shafts, no photograph ── */
  .story {
    position: relative;
    padding-block: var(--section-y) calc(var(--section-y) * 0.9);
    background:
      radial-gradient(80% 60% at 50% 0%, #ffffff 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, #f7f7f5 0%, #f0f1f2 55%, #e9ebee 100%);
    overflow: hidden;
    isolation: isolate;
  }

  .story__light {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-linear-gradient(
      108deg,
      rgba(255, 255, 255, 0) 0 140px,
      rgba(255, 255, 255, 0.5) 140px 190px,
      rgba(255, 255, 255, 0) 190px 360px
    );
    -webkit-mask-image: radial-gradient(70% 60% at 62% 45%, #000 0%, transparent 75%);
    mask-image: radial-gradient(70% 60% at 62% 45%, #000 0%, transparent 75%);
    opacity: 0.8;
  }

  .story__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 1rem + 4vw, 6rem);
    align-items: end;
  }

  .story__head h2 {
    max-width: 13ch;
    font-size: var(--fs-h2);
  }

  .story__intro > p:first-child {
    max-width: 34rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .story__note {
    max-width: 30rem;
    margin-top: 1rem;
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /* ── Chapters: Before Tyll → With Tyll, each with a fine progress line ── */
  .cine {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .cine__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1080px;
    margin-inline: auto;
  }

  .cine__chapters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 22rem));
    gap: clamp(1.25rem, 0.5rem + 3vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ch {
    display: grid;
    gap: 0.3rem;
    color: var(--fog);
    transition: color 0.6s var(--ease);
  }

  .ch__k {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .ch__k :global(.ch__tick) {
    width: 14px;
    height: auto;
  }

  .ch__m {
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .ch__rail {
    position: relative;
    height: 1px;
    margin-top: 0.7rem;
    background: var(--silver);
    overflow: hidden;
  }

  .ch__rail i {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(1);
  }

  :global([dir='rtl']) .ch__rail i {
    transform-origin: right;
  }

  /* Final state: "With Tyll" leads; "Before Tyll" stays readable but quiet */
  .cine .ch[data-ch='after'] {
    color: var(--ink);
  }

  .cine .ch[data-ch='after'] .ch__k {
    color: var(--steel);
  }

  .cine .ch[data-ch='before'] .ch__rail i {
    background: var(--fog);
  }

  .cine[data-scene='0'] .ch[data-ch='before'],
  .cine[data-scene='1'] .ch[data-ch='before'] {
    color: var(--ink);
  }

  .cine[data-scene='0'] .ch[data-ch='before'] .ch__k,
  .cine[data-scene='1'] .ch[data-ch='before'] .ch__k {
    color: var(--steel);
  }

  .cine[data-scene='0'] .ch[data-ch='before'] .ch__rail i,
  .cine[data-scene='1'] .ch[data-ch='before'] .ch__rail i {
    background: var(--ink);
  }

  .cine[data-scene='0'] .ch[data-ch='after'],
  .cine[data-scene='1'] .ch[data-ch='after'],
  .cine[data-scene='0'] .ch[data-ch='after'] .ch__k,
  .cine[data-scene='1'] .ch[data-ch='after'] .ch__k {
    color: var(--fog);
  }

  /* While playing, each line fills over its chapter's time */
  .cine.is-timed .ch__rail i {
    transform: scaleX(0);
    animation: ch-fill linear forwards;
  }

  .cine.is-timed .ch[data-ch='before'] .ch__rail i {
    animation-duration: 2.6s;
  }

  .cine.is-timed .ch[data-ch='after'] .ch__rail i {
    animation-duration: 6.8s;
    animation-delay: 2.6s;
  }

  .cine[data-state='paused'] .ch__rail i {
    animation-play-state: paused;
  }

  @keyframes ch-fill {
    to {
      transform: scaleX(1);
    }
  }

  .cine__ctrl {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.45rem;
    height: 40px;
    padding: 0 1rem 0 0.85rem;
    border: 1px solid var(--silver);
    border-radius: var(--pill);
    background: rgba(255, 255, 255, 0.7);
    color: var(--graphite);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease),
      color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }

  .cine__ctrl[hidden] {
    display: none;
  }

  .cine__ctrl:hover {
    border-color: var(--steel);
    background: #fff;
    color: var(--ink);
  }

  .cine__ctrl svg {
    display: none;
    width: 15px;
    height: 15px;
  }

  .cine[data-state='playing'] .i-pause,
  .cine[data-state='paused'] .i-play,
  .cine[data-state='idle'] .i-play,
  .cine[data-state='done'] .i-replay {
    display: block;
  }

  /* ── The stage ── */
  .cine__stage {
    position: relative;
    max-width: 1080px;
    margin: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem) auto 0;
  }

  /* A soft contact shadow, as if the window rests just above a pale floor */
  .cine__stage::after {
    content: '';
    position: absolute;
    inset: auto 6% -34px;
    z-index: -1;
    height: 60px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(20, 22, 26, 0.16), transparent);
    filter: blur(6px);
    transition: opacity 0.9s var(--ease);
  }

  .cine__anchor {
    position: absolute;
    width: 340px;
    height: 1px;
    pointer-events: none;
    visibility: hidden;
  }

  .cine__anchor[data-anchor='pos'] {
    top: 16%;
    inset-inline-start: 2%;
  }

  .cine__anchor[data-anchor='stock'] {
    top: 44%;
    inset-inline-end: 3%;
  }

  .chip {
    position: absolute;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid rgba(200, 205, 212, 0.7);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--steel);
    font-size: 0.8125rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform-origin: left top;
    filter: blur(0.4px);
    transition:
      opacity 0.9s var(--ease),
      transform 1.3s var(--ease);
  }

  .chip b {
    color: var(--graphite);
    font-weight: 600;
  }

  .chip[data-chip='pms'] {
    top: 6%;
    inset-inline-start: 40%;
  }

  .chip[data-chip='finance'] {
    top: 76%;
    inset-inline-start: 24%;
  }

  /* ── The Tyll window, faithful to the demo's look: white panels, quiet lines, amber for what needs review ── */
  .app {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 60px minmax(0, 0.82fr) minmax(0, 1.5fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'rail bar bar'
      'rail list detail';
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .app__shell {
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid rgba(200, 205, 212, 0.65);
    border-radius: 22px;
    background: #fff;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 2px 6px rgba(20, 22, 26, 0.04),
      0 50px 100px -50px rgba(20, 22, 26, 0.32);
    transition:
      opacity 1s var(--ease),
      transform 1.3s var(--ease);
  }

  .app__rail {
    grid-area: rail;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 1.1rem 0;
    border-inline-end: 1px solid var(--line);
    border-start-start-radius: 22px;
    border-end-start-radius: 22px;
    background: #fafafa;
    color: var(--fog);
  }

  .app__rail :global(.app__logo) {
    width: 22px;
    height: auto;
    margin-bottom: 0.6rem;
    color: var(--ink);
  }

  .app__nav {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
  }

  .app__nav.is-on {
    background: var(--mist);
    color: var(--ink);
  }

  .app__nav :global(svg) {
    width: 18px;
    height: 18px;
  }

  .app__bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 56px;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .app__brand {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }

  .app__brand :global(.app__brand-mark) {
    width: 18px;
    height: auto;
  }

  .app__place {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    color: var(--graphite);
    font-size: 0.8125rem;
  }

  .app__user {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
    color: var(--graphite);
    font-size: 0.8125rem;
  }

  .avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* The list of what needs attention */
  .app__list {
    grid-area: list;
    display: flex;
    flex-direction: column;
    padding-block: 1.25rem;
    padding-inline: 1.25rem 1rem;
    border-inline-end: 1px solid var(--line);
  }

  .list__foot {
    margin: auto 0 0;
    padding-top: 1.25rem;
    color: var(--fog);
    font-size: 0.75rem;
  }

  .list__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    color: var(--ink);
    font-weight: 500;
  }

  .count {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: var(--pill);
    background: var(--ink);
    color: #fff;
    font-size: 0.75rem;
  }

  .app__list ul {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.35rem 0.6rem;
    padding: 0.8rem 0.85rem;
    border: 1px solid transparent;
    border-radius: 14px;
    color: var(--steel);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease),
      border-color 0.6s var(--ease),
      background-color 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }

  .row__marks {
    display: inline-flex;
    gap: 3px;
    padding-top: 0.3rem;
  }

  .row__title {
    color: var(--graphite);
    font-weight: 450;
  }

  .row > .pill,
  .row__tags {
    grid-column: 2;
    justify-self: start;
  }

  .row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .row--on {
    border-color: #ecd9b0;
    background: #fffaf0;
    box-shadow: 0 0 0 4px rgba(236, 217, 176, 0.35);
  }

  .row--on .row__title {
    color: var(--ink);
    font-weight: 500;
  }

  /* The issue, opened */
  .app__detail {
    grid-area: detail;
    padding: 1.5rem 1.75rem 1.6rem;
  }

  .d__title {
    margin-top: 0.75rem;
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .d__line {
    margin-top: 0.3rem;
    color: var(--graphite);
    font-size: 0.9375rem;
  }

  .d__label {
    margin: 1.4rem 0 0.6rem;
    color: var(--steel);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .d__ev {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .rec {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.3rem;
    padding: 0.85rem 0.95rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
    transform-origin: 0 0;
    transition:
      opacity 0.8s var(--ease),
      transform 1.3s var(--ease),
      box-shadow 1.1s var(--ease),
      background-color 1s var(--ease);
  }

  .rec__sys {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: var(--steel);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .rec__title {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
  }

  .rec__vals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    margin: 0;
    color: var(--graphite);
  }

  .rec__vals b {
    color: var(--ink);
    font-weight: 600;
  }

  .rec__vals--struck s {
    color: #9b2c2c;
    text-decoration-color: rgba(155, 44, 44, 0.6);
  }

  .rec .pill {
    margin-top: 0.2rem;
  }

  .d__next {
    margin-top: 1rem;
    padding: 0.95rem 1.05rem 1.05rem;
    border-radius: 14px;
    background: var(--cloud);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .d__next .d__label {
    margin: 0;
  }

  .d__next-text {
    margin-top: 0.25rem;
    color: var(--ink);
    font-size: 0.9375rem;
  }

  .d__person {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.85rem;
  }

  .d__who {
    display: grid;
    min-width: 0;
  }

  .d__who-k {
    color: var(--steel);
    font-size: 0.75rem;
  }

  .d__who-name {
    color: var(--ink);
    font-weight: 500;
  }

  .d__who-role {
    margin-inline-start: 0.4rem;
    color: var(--steel);
    font-weight: 400;
  }

  .d__assigned {
    margin-inline-start: auto;
  }

  .d__caution {
    margin-top: 0.9rem;
    color: var(--steel);
    font-size: 0.8125rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    color: var(--graphite);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .pill--amber {
    border-color: #f1dfb8;
    background: #fbf1dc;
    color: #7a5310;
  }

  .pill--ink {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }

  /* System marks, the same shapes the demo uses for each source */
  .mark {
    display: inline-block;
    flex: none;
    width: 8px;
    height: 8px;
    border: 1.5px solid currentColor;
  }

  .mark--pos {
    border-radius: 2px;
  }

  .mark--stock {
    border-radius: 50%;
  }

  .mark--pms {
    transform: rotate(45deg) scale(0.85);
  }

  .mark--finance {
    border-radius: 2px 50% 50% 2px;
  }

  /* ── Scenes. Everything above is the final view; these rules hold parts back until their scene. ── */
  .cine.is-instant *,
  .cine.is-instant {
    transition: none !important;
  }

  /* The window and its parts wait for scene 2 */
  .cine[data-scene='0'] .app__shell,
  .cine[data-scene='1'] .app__shell {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
  }

  .cine[data-scene='0'] .cine__stage::after,
  .cine[data-scene='1'] .cine__stage::after {
    opacity: 0;
  }

  .app__rail,
  .app__bar,
  .list__head,
  .d__head,
  .d__label,
  .d__next,
  .d__caution {
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
  }

  .cine[data-scene='0'] :is(.app__rail, .app__bar, .list__foot),
  .cine[data-scene='1'] :is(.app__rail, .app__bar, .list__foot) {
    opacity: 0;
  }

  .app__list,
  .app__detail {
    transition: border-color 0.8s var(--ease);
  }

  .cine:is([data-scene='0'], [data-scene='1']) :is(.app__list, .app__detail) {
    border-color: transparent;
  }

  .cine:is([data-scene='0'], [data-scene='1'], [data-scene='2']) :is(.list__head, .row, .d__head, .d__next, .d__caution) {
    opacity: 0;
    transform: translateY(10px);
  }

  .cine:is([data-scene='0'], [data-scene='1']) .d__head ~ .d__label {
    opacity: 0;
  }

  .cine[data-scene='3'] :is(.d__next, .d__caution) {
    opacity: 0;
    transform: translateY(10px);
  }

  .cine[data-scene='4'] .d__caution {
    opacity: 0;
  }

  .cine[data-scene='3'] .row {
    transition-delay: calc(var(--n, 0) * 120ms);
  }

  .row:nth-child(2) {
    --n: 1;
  }

  .row:nth-child(3) {
    --n: 2;
  }

  /* The issue row lights up a beat after it appears */
  .cine:is([data-scene='0'], [data-scene='1'], [data-scene='2']) .row--on {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .cine[data-scene='3'] .row--on {
    transition-delay: 0s, 0s, 0.5s, 0.5s, 0.5s;
  }

  .cine:is([data-scene='0'], [data-scene='1'], [data-scene='2'], [data-scene='3']) .d__assigned {
    opacity: 0;
    transform: scale(0.9);
  }

  .d__assigned {
    transition:
      opacity 0.6s var(--ease) 0.9s,
      transform 0.6s var(--ease) 0.9s;
  }

  /* The records: floating apart in scene 1 (positions are set by the script), resting in the window afterwards */
  .cine[data-scene='0'] .rec {
    opacity: 0;
  }

  .cine:is([data-scene='0'], [data-scene='1']) .rec {
    box-shadow:
      0 1px 2px rgba(20, 22, 26, 0.05),
      0 30px 60px -28px rgba(20, 22, 26, 0.3);
  }

  .cine[data-scene='1'] .rec[data-rec='pos'] {
    transition-delay: 0.25s;
  }

  .cine[data-scene='1'] .chip {
    opacity: 0.9;
  }

  .cine[data-scene='1'] .chip[data-chip='finance'] {
    transition-delay: 0.45s;
  }

  .cine[data-scene='1'] .chip[data-chip='pms'] {
    transition-delay: 0.6s;
  }

  @media (max-width: 1000px) {
    .story__head {
      grid-template-columns: minmax(0, 1fr);
    }

    .app {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'bar'
        'list'
        'detail';
    }

    .app__rail {
      display: none;
    }

    .app__brand {
      display: inline-flex;
    }

    .app__list {
      padding: 1rem 1rem 0.5rem;
      border-inline-end: 0;
    }

    .app__list ul {
      gap: 0.3rem;
    }

    .row {
      padding: 0.65rem 0.75rem;
    }

    .app__detail {
      margin: 0.5rem 1rem 0;
      padding: 1.15rem 0 1.25rem;
      border-top: 1px solid var(--line);
    }

    .cine__anchor {
      width: min(340px, 74%);
    }

    .cine__anchor[data-anchor='pos'] {
      top: 6%;
      inset-inline-start: 0;
    }

    .cine__anchor[data-anchor='stock'] {
      top: 30%;
      inset-inline-end: 0;
    }

    .chip[data-chip='pms'] {
      top: 56%;
      inset-inline-start: 6%;
    }

    .chip[data-chip='finance'] {
      top: 66%;
      inset-inline-start: 12%;
    }
  }

  @media (max-width: 640px) {
    .cine__top {
      flex-direction: column;
      align-items: stretch;
    }

    .cine__chapters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .ch__m {
      font-size: 1rem;
    }

    .cine__ctrl {
      align-self: flex-start;
      height: 36px;
    }

    .app__place {
      font-size: 0.75rem;
    }

    .app__user-name {
      display: none;
    }

    .d__ev {
      grid-template-columns: minmax(0, 1fr);
    }

    .app__list {
      padding-bottom: 0;
    }

    .app__list ul,
    .list__foot {
      display: none;
    }

    .list__head {
      margin: 0;
    }

    .app__detail {
      margin-top: 0.85rem;
      padding-top: 1rem;
    }

    .d__title {
      font-size: 1.25rem;
    }

    .d__label {
      margin-top: 1.1rem;
    }

    .d__person {
      flex-wrap: wrap;
    }

    .d__who-role {
      display: block;
      margin-inline-start: 0;
    }

    .chip {
      max-width: 80%;
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cine *,
    .cine {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const cine = document.querySelector<HTMLElement>('[data-cine]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // With reduced motion the final view, already in the page, simply stays
  if (cine && !reduce.matches) {
    const stage = cine.querySelector<HTMLElement>('.cine__stage')!;
    const ctrl = cine.querySelector<HTMLButtonElement>('[data-ctrl]')!;
    const label = ctrl.querySelector<HTMLElement>('.cine__ctrl-label')!;
    const recs = [...cine.querySelectorAll<HTMLElement>('[data-rec]')];
    const chips = [...cine.querySelectorAll<HTMLElement>('[data-chip]')];
    const anchor = (name: string) => cine.querySelector<HTMLElement>(`[data-anchor="${name}"]`)!;

    // Scene start times (ms) and the moment the final view is complete
    const TIMES: [number, number][] = [
      [0, 1],
      [2600, 2],
      [4300, 3],
      [6200, 4],
      [8200, 5],
    ];
    const END = 9400;

    let scene = 5;
    let state: 'idle' | 'playing' | 'paused' | 'done' = 'done';
    let elapsed = 0;
    let startedAt = 0;
    let timers: number[] = [];
    let autoPaused = false;

    const setState = (s: typeof state) => {
      state = s;
      cine.dataset.state = s;
      label.textContent = s === 'playing' ? ctrl.dataset.pause! : s === 'done' ? ctrl.dataset.replay! : ctrl.dataset.play!;
    };

    // Puts the two records where they float before Tyll, measured from their resting place in the window
    const scatter = () => {
      recs.forEach((r) => (r.style.transform = 'none'));
      recs.forEach((r) => {
        const from = r.getBoundingClientRect();
        const to = anchor(r.dataset.rec!).getBoundingClientRect();
        const s = to.width / from.width;
        r.style.transform = `translate(${to.left - from.left}px, ${to.top - from.top}px) scale(${s})`;
      });
      chips.forEach((c) => (c.style.transform = ''));
    };

    // The quieter records slide toward the list rows they become, and fade as the rows appear
    const gatherChips = () => {
      chips.forEach((c) => {
        const row = [cine.querySelector<HTMLElement>(`[data-row="${c.dataset.chip}"]`), cine.querySelector<HTMLElement>('.list__head')].find(
          (el) => el && el.offsetParent,
        );
        if (!row) return;
        c.style.transform = '';
        const from = c.getBoundingClientRect();
        const to = row.getBoundingClientRect();
        c.style.transform = `translate(${to.left - from.left}px, ${to.top - from.top}px) scale(0.9)`;
      });
    };

    const show = (n: number) => {
      scene = n;
      if (n === 2) {
        recs.forEach((r) => (r.style.transform = ''));
        gatherChips();
      }
      cine.dataset.scene = String(n);
    };

    const clear = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    const schedule = () => {
      clear();
      startedAt = performance.now() - elapsed;
      for (const [at, n] of TIMES) if (at >= elapsed && n > scene) timers.push(window.setTimeout(() => show(n), at - elapsed));
      timers.push(
        window.setTimeout(() => {
          cine.classList.remove('is-timed');
          setState('done');
        }, END - elapsed),
      );
      setState('playing');
    };

    // Back to the first frame without any transition
    const reset = () => {
      clear();
      elapsed = 0;
      cine.classList.add('is-instant');
      cine.classList.remove('is-timed');
      scene = 0;
      cine.dataset.scene = '0';
      scatter();
      void cine.offsetWidth;
      cine.classList.remove('is-instant');
    };

    const play = () => {
      reset();
      cine.classList.add('is-timed');
      // The records appear on the next frame, so their entrance is animated
      requestAnimationFrame(() => {
        show(1);
        schedule();
      });
    };

    const pause = () => {
      if (state !== 'playing') return;
      clear();
      elapsed = performance.now() - startedAt;
      setState('paused');
    };

    const resume = () => {
      if (state === 'paused') schedule();
    };

    // Keep the floating positions right if the window is resized before the records have gathered
    const ro = new ResizeObserver(() => {
      if (scene > 1) return;
      cine.classList.add('is-instant');
      scatter();
      void cine.offsetWidth;
      cine.classList.remove('is-instant');
    });
    ro.observe(stage);

    ctrl.addEventListener('click', () => {
      autoPaused = false;
      if (state === 'playing') pause();
      else if (state === 'paused') resume();
      else play();
    });

    // Starts once the stage is well in view; pauses when it leaves, resumes when it is back
    const io = new IntersectionObserver(
      ([entry]) => {
        const visible = entry.intersectionRatio >= 0.3;
        if (state === 'idle' && visible) play();
        else if (state === 'playing' && !entry.isIntersecting) {
          pause();
          autoPaused = true;
        } else if (state === 'paused' && autoPaused && visible) {
          autoPaused = false;
          resume();
        }
      },
      { threshold: [0, 0.3] },
    );

    // Ready: show the first frame and wait for the stage to come into view
    reset();
    setState('idle');
    ctrl.hidden = false;
    io.observe(stage);

    // If the visitor asks for reduced motion later, show the final view and stop
    reduce.addEventListener('change', () => {
      if (!reduce.matches) return;
      clear();
      io.disconnect();
      ro.disconnect();
      recs.forEach((r) => (r.style.transform = ''));
      chips.forEach((c) => (c.style.transform = ''));
      cine.classList.remove('is-timed');
      show(5);
      setState('done');
      ctrl.hidden = true;
    });
  }
</script>
