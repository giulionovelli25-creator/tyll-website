---
// The homepage's closing call to action, one of its two deliberately dark sections: the free purchasing report request,
// which the hero's "Get your free report" link scrolls to (#report).
import Logo from '../Logo.astro';
import ReportForm from './ReportForm.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.report;

// The silver wave: one ribbon of fine lines that moves as a single formation, like a slow ocean swell or silver
// fabric. Every line follows the same shape and the same travelling motion; the lines are only offset from each
// other, like threads in one ribbon. The shape dips beneath the buttons and rises in a long arc to the right (a
// quiet echo of the Tyll check). The motion repeats every 16 seconds, so the loop never restarts visibly.
// The first frame is drawn here for visitors without JavaScript or with reduced motion; the script animates it.
import { ribbon } from '../../scripts/wave';

const frame = ribbon(0);
---

<section class="invite on-dark" id="report" data-dark aria-labelledby="invite-title">
  <div class="invite__light" aria-hidden="true"></div>
  <svg class="invite__waves" viewBox="0 0 1440 800" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="invite-silver" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="var(--silver)" stop-opacity="0" />
        <stop offset="0.22" stop-color="var(--silver)" stop-opacity="0.35" />
        <stop offset="0.42" stop-color="var(--silver-light)" stop-opacity="0.85" />
        <stop offset="0.7" stop-color="var(--silver-deep)" stop-opacity="0.45" />
        <stop offset="1" stop-color="var(--silver)" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g fill="none" stroke="url(#invite-silver)" stroke-width="1">
      {frame.map((l) => <path d={l.d} opacity={l.opacity} vector-effect="non-scaling-stroke" />)}
    </g>
  </svg>
  <div class="wrap invite__inner">
    <div class="invite__main">
      <Logo mark anim="draw" label="" class="invite__mark" />
      <h2 id="invite-title" class="display">{v.title}</h2>
      <p>{v.text}</p>
      <div class="invite__form">
        <ReportForm lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .invite {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: var(--section-y);
    background: linear-gradient(180deg, var(--night-1) 0%, var(--night-0) 100%);
    color: var(--text-1);
    overflow: hidden;
    isolation: isolate;
  }

  /* A soft pool of light behind the headline */
  .invite__light {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(45% 55% at 50% 42%, rgb(var(--silver-rgb) / 0.13), transparent 70%),
      radial-gradient(80% 60% at 50% 120%, rgb(var(--fog-rgb) / 0.12), transparent 70%);
    pointer-events: none;
  }

  /* The Tyll silver wave, flowing slowly. Its brightest lines pass beneath the buttons; around the paragraph
     the lines fade almost away so the text stays easy to read. */
  .invite__waves {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0.85;
    -webkit-mask-image:
      radial-gradient(34% 9% at 50% 59%, rgb(var(--black-rgb) / 0.18) 0%, rgb(var(--black-rgb) / 0.18) 55%, var(--black) 100%),
      linear-gradient(0deg, var(--black) 55%, transparent 92%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(34% 9% at 50% 59%, rgb(var(--black-rgb) / 0.18) 0%, rgb(var(--black-rgb) / 0.18) 55%, var(--black) 100%),
      linear-gradient(0deg, var(--black) 55%, transparent 92%);
    mask-composite: intersect;
    pointer-events: none;
  }

  /* One centred column; the form opens to a comfortable reading width */
  .invite__inner {
    width: 100%;
    max-width: calc(46rem + var(--gut) * 2);
    text-align: center;
  }

  .invite__main {
    display: grid;
    justify-items: center;
  }

  .invite :global(.invite__mark) {
    width: 40px;
    height: auto;
    margin-bottom: 1.5rem;
    color: var(--on-dark);
  }

  .invite h2 {
    font-size: var(--fs-display);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .invite__main > p {
    max-width: var(--measure);
    margin-top: 1.25rem;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .invite__form {
    width: 100%;
    margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }
</style>

<script>
  import { ribbon, PERIOD } from '../../scripts/wave';

  // Redraw the ribbon about 30 times a second, only while it is on screen and only when motion is welcome
  const svg = document.querySelector<SVGSVGElement>('.invite__waves');
  if (svg) {
    const paths = [...svg.querySelectorAll('path')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let raf = 0;
    let last = 0;
    let t = 0;
    const draw = (now: number) => {
      raf = requestAnimationFrame(draw);
      if (now - last < 33) return;
      t = (t + Math.min(now - last, 100) / 1000) % PERIOD;
      last = now;
      ribbon(t / PERIOD).forEach((l, i) => paths[i]?.setAttribute('d', l.d));
    };
    const sync = () => {
      cancelAnimationFrame(raf);
      if (visible && !reduce.matches) {
        last = performance.now();
        raf = requestAnimationFrame(draw);
      }
    };
    new IntersectionObserver(([e]) => ((visible = e.isIntersecting), sync())).observe(svg);
    reduce.addEventListener('change', sync);
  }
</script>
