---
// Homepage chapter 2: hotel systems → Tyll → a clear next step.
// Left, the hotel's existing systems, each holding a piece of the picture. Thin silver paths carry that
// information into the Tyll overview in the centre, which shows what needs attention across departments. On the
// right, the one issue that matters most: its evidence from POS and Stock, who is responsible and what to review
// next. When the section comes into view the sequence plays once (about four seconds) and then stays still; a
// small button replays it. Without JavaScript or with reduced motion the finished picture is shown at once.
// All data is fictional and matches the simulated Tyll demo.
import Logo from '../Logo.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = t(lang).home.problem;
const f = p.frags;
const v = p.view;
const fwd = lang === 'ar' ? '←' : '→';

// The rows in the Tyll overview, and which systems feed each of them
const rows = [
  { id: 'issue', marks: ['pos', 'stock'], title: v.issue, team: '', status: v.status, focus: true },
  { id: 'room', marks: ['pms'], title: v.tasks[0].title, team: v.tasks[0].team, status: v.tasks[0].status, focus: false },
  { id: 'invoice', marks: ['finance'], title: v.tasks[1].title, team: v.tasks[1].team, status: v.tasks[1].status, focus: false },
];
---

<section class="story" id="story" aria-labelledby="story-title" data-story>
  <div class="wrap">
    <header class="story__head">
      <h2 id="story-title">{p.title}</h2>
      <div class="story__intro">
        <p>{p.text}</p>
        <p class="story__note">{p.note}</p>
      </div>
    </header>

    <div class="flow" data-flow data-stage="done">
      <svg class="flow__paths" aria-hidden="true"></svg>

      <!-- 1. The hotel's systems: separate places, each with part of the story -->
      <div class="flow__col flow__col--systems">
        <p class="flow__caption">
          <span class="flow__kicker">{p.beforeLabel}</span>
          <span class="flow__msg">{p.before}</span>
        </p>
        <ul class="systems" aria-label={p.before}>
          <li class="sys" data-src="pos" style="--i:0">
            <span class="sys__name"><i class="mark mark--pos" aria-hidden="true"></i>{f.pos.sys}</span>
            <span class="sys__title">{f.pos.title}</span>
            <span class="sys__data"><s>{f.pos.rows[0][0]}</s><s>{f.pos.rows[0][1]}</s></span>
            <span class="sys__flag sys__flag--amber">{f.pos.flag}</span>
          </li>
          <li class="sys" data-src="stock" style="--i:1">
            <span class="sys__name"><i class="mark mark--stock" aria-hidden="true"></i>{f.stock.sys}</span>
            <span class="sys__title">{f.stock.title}</span>
            <span class="sys__data">
              <span>{f.stock.head[1]} <b>{f.stock.vals[1]}</b></span>
              <span>{f.stock.head[2]} <b>{f.stock.vals[2]}</b></span>
            </span>
            <span class="sys__flag sys__flag--amber">{f.stock.flag}</span>
          </li>
          <li class="sys" data-src="pms" style="--i:2">
            <span class="sys__name"><i class="mark mark--pms" aria-hidden="true"></i>{f.pms.sys}</span>
            <span class="sys__title">{f.pms.title}</span>
            <span class="sys__data"><span class="sys__chip">{f.pms.status}</span><span>{f.pms.line}</span></span>
          </li>
          <li class="sys" data-src="finance" style="--i:3">
            <span class="sys__name"><i class="mark mark--finance" aria-hidden="true"></i>{f.finance.sys}</span>
            <span class="sys__title">{f.finance.title}</span>
            <span class="sys__data">
              <span>{f.finance.rows[0][0]} <b>{f.finance.rows[0][1]}</b></span>
              <span>{f.finance.rows[1][0]} <b>{f.finance.rows[1][1]}</b></span>
            </span>
          </li>
        </ul>
      </div>

      <!-- 2. Tyll: the important things from every department, in one overview -->
      <div class="flow__col flow__col--tyll">
        <p class="flow__caption flow__caption--after">
          <span class="flow__kicker"><Logo mark label="" class="flow__tick" />{p.afterLabel}</span>
          <span class="flow__msg">{p.after}</span>
        </p>
        <div class="tyll" role="group" aria-label="Tyll">
          <div class="tyll__bar">
            <Logo mark label="" class="tyll__mark" />
            <span>Tyll</span>
            <span class="tyll__place">{v.place}</span>
          </div>
          <p class="tyll__heading">{v.attention} <span>{rows.length}</span></p>
          <ul class="tyll__rows">
            {
              rows.map((r, i) => (
                <li class:list={['row', r.focus && 'row--focus']} data-row={r.id} style={`--i:${i}`}>
                  <span class="row__marks" aria-hidden="true">
                    {r.marks.map((m) => (
                      <i class={`mark mark--${m}`} />
                    ))}
                  </span>
                  <span class="row__title">{r.title}</span>
                  <span class="row__meta">
                    {r.team && <span class="row__team">{r.team}</span>}
                    <span class:list={['row__status', r.focus && 'row__status--amber']}>{r.status}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- 3. What the manager can do: one issue, its evidence, the person responsible and the next step -->
      <div class="flow__col flow__col--next">
        <article class="next" aria-labelledby="flow-issue">
          <span class="next__status">{v.status}</span>
          <h3 id="flow-issue">{v.issue}</h3>
          <p class="next__line">{v.issueLine}</p>
          <ul class="next__evidence">
            <li style="--i:0">
              <span class="next__src"><i class="mark mark--stock" aria-hidden="true"></i>{f.stock.sys}</span>
              <span>{v.evidence[0]}</span>
            </li>
            <li style="--i:1">
              <span class="next__src"><i class="mark mark--pos" aria-hidden="true"></i>{f.pos.sys}</span>
              <span>{v.evidence[1]}</span>
            </li>
          </ul>
          <div class="next__foot">
            <p class="next__owner"><span>{v.owner}</span>{v.ownerName}</p>
            <span class="next__action">{v.next} {fwd}</span>
          </div>
          <p class="next__caution">{v.caution}</p>
        </article>
      </div>

      <button type="button" class="flow__replay" data-replay hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8a4.8 4.8 0 1 0 1.5-3.5M3 2.6v2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {p.replay}
      </button>
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: var(--section-y);
    background: var(--paper);
  }

  /* Headline on one side, the explanation and the disclaimer on the other */
  .story__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 1rem + 4vw, 6rem);
    align-items: end;
  }

  .story__head h2 {
    max-width: 13ch;
    font-size: var(--fs-h2);
  }

  .story__intro > p:first-child {
    max-width: 34rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .story__note {
    max-width: 30rem;
    margin-top: 1rem;
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /* ── The stage: a deep charcoal surface on which the white interfaces sit like real screens ── */
  .flow {
    --gap: clamp(3rem, 1rem + 5vw, 6.5rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.2fr) minmax(0, 1fr);
    column-gap: var(--gap);
    align-items: center;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding: clamp(2rem, 1.25rem + 2.5vw, 3.5rem) clamp(1.5rem, 0.75rem + 2.5vw, 3.25rem) clamp(3.25rem, 2.5rem + 2.5vw, 4.5rem);
    border-radius: 28px;
    background:
      radial-gradient(70% 90% at 50% 45%, rgba(200, 205, 212, 0.12), transparent 70%),
      linear-gradient(160deg, #1d2025 0%, #14161a 55%, #101114 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 60px 120px -60px rgba(20, 22, 26, 0.55);
    color: var(--on-dark);
    isolation: isolate;
  }

  .flow__paths {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .flow__paths :global(.path) {
    fill: none;
    stroke: rgba(200, 205, 212, 0.38);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .flow__paths :global(.pulse) {
    fill: none;
    stroke: url(#flow-pulse);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0;
  }

  .flow__col {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    align-content: center;
  }

  .flow__caption {
    display: grid;
    gap: 0.3rem;
    margin: 0;
  }

  .flow__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fog);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .flow__kicker :global(.flow__tick) {
    width: 16px;
    height: auto;
    color: var(--on-dark);
  }

  .flow__msg {
    color: var(--on-dark);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  /* Small shape markers, one per system, carried into the overview so the source of each item stays visible */
  .mark {
    display: inline-block;
    flex: none;
    width: 8px;
    height: 8px;
    border: 1.5px solid currentColor;
  }

  .mark--pos {
    border-radius: 2px;
  }

  .mark--stock {
    border-radius: 50%;
  }

  .mark--pms {
    transform: rotate(45deg) scale(0.9);
  }

  .mark--finance {
    border-radius: 2px 50% 50% 2px;
  }

  /* 1. Systems */
  .systems {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sys {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 1rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 18px 36px -24px rgba(0, 0, 0, 0.6);
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  /* A little unevenness: separate systems, not a tidy list */
  .sys:nth-child(2) {
    margin-inline-start: 1.25rem;
  }

  .sys:nth-child(3) {
    margin-inline-start: 0.4rem;
  }

  .sys:nth-child(4) {
    margin-inline-start: 1.6rem;
  }

  .sys__name {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--steel);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sys__name .mark {
    color: var(--graphite);
  }

  .sys__title {
    font-weight: 500;
  }

  .sys__data {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }

  .sys__data s {
    color: var(--steel);
    text-decoration-color: rgba(176, 53, 43, 0.7);
  }

  .sys__data b {
    color: var(--ink);
    font-weight: 600;
  }

  .sys__chip,
  .row__status,
  .row__team {
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .sys__flag {
    justify-self: start;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
  }

  .sys__flag--amber,
  .row__status--amber,
  .next__status {
    border-color: transparent;
    background: #fbf2df;
    color: #7a4b08;
  }

  /* 2. The Tyll overview */
  .tyll {
    border-radius: 20px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 40px 80px -36px rgba(0, 0, 0, 0.75),
      0 0 120px -30px rgba(200, 205, 212, 0.18);
    color: var(--ink);
    overflow: hidden;
  }

  .tyll__bar {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .tyll :global(.tyll__mark) {
    width: 17px;
    height: auto;
  }

  .tyll__place {
    margin-inline-start: auto;
    color: var(--steel);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .tyll__heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.15rem 0.6rem;
    color: var(--graphite);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .tyll__heading span {
    display: grid;
    place-items: center;
    min-width: 21px;
    height: 21px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
  }

  .tyll__rows {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0 0.75rem 0.9rem;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'marks title'
      '. meta';
    gap: 0.35rem 0.7rem;
    padding: 0.75rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 0.9375rem;
    transition:
      background-color 0.6s var(--ease),
      border-color 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }

  .row + .row {
    border-top-color: var(--line);
    border-radius: 0 0 12px 12px;
  }

  .row__marks {
    grid-area: marks;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-top: 0.35rem;
    color: var(--graphite);
  }

  .row__title {
    grid-area: title;
    font-weight: 500;
  }

  .row__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--steel);
  }

  /* The issue that needs attention first */
  .row--focus {
    border-color: #e3c98f;
    background: linear-gradient(180deg, #fffcf5, #fff);
    box-shadow: 0 0 0 4px rgba(227, 201, 143, 0.18);
  }

  /* 3. The next step */
  .next {
    display: grid;
    gap: 0.55rem;
    padding: 1.2rem 1.25rem 1.15rem;
    border-radius: 20px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 40px 80px -40px rgba(0, 0, 0, 0.75);
    color: var(--ink);
  }

  .next__status {
    justify-self: start;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .next h3 {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .next__line {
    color: var(--graphite);
    font-size: 0.9375rem;
  }

  .next__evidence {
    display: grid;
    gap: 0.5rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .next__evidence li {
    display: grid;
    gap: 0.25rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--graphite);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .next__src {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--steel);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .next__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin-top: 0.35rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .next__owner {
    font-size: 0.875rem;
  }

  .next__owner span {
    display: block;
    color: var(--steel);
    font-size: 0.75rem;
  }

  .next__action {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .next__caution {
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .flow__replay {
    position: absolute;
    inset-inline-end: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    bottom: clamp(0.9rem, 0.6rem + 1vw, 1.4rem);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0 0.85rem;
    border: 1px solid rgba(244, 245, 247, 0.2);
    border-radius: 999px;
    background: transparent;
    color: var(--on-dark-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .flow__replay[hidden] {
    display: none;
  }

  .flow__replay:hover {
    border-color: rgba(244, 245, 247, 0.5);
    color: var(--on-dark);
  }

  .flow__replay svg {
    width: 14px;
    height: 14px;
  }

  /* ── The sequence. data-stage moves 0 → 1 → 2 → 3 → 4 (or is "done" from the start) ──
     1 systems appear · 2 information travels to Tyll · 3 the overview fills · 4 the next step comes forward */
  .flow .sys,
  .flow .tyll,
  .flow .row,
  .flow .next,
  .flow .next__evidence li,
  .flow .next__foot,
  .flow .next__caution,
  .flow .flow__caption {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease),
      background-color 0.6s var(--ease),
      border-color 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }

  .flow[data-stage='0'] .sys,
  .flow[data-stage='0'] .flow__col--systems .flow__caption {
    opacity: 0;
    transform: translateY(10px);
  }

  .flow:is([data-stage='0'], [data-stage='1']) .tyll,
  .flow:is([data-stage='0'], [data-stage='1']) .flow__caption--after {
    opacity: 0;
    transform: scale(0.97);
  }

  .flow:is([data-stage='0'], [data-stage='1'], [data-stage='2']) .row {
    opacity: 0;
    transform: translateY(6px);
  }

  .flow:is([data-stage='0'], [data-stage='1'], [data-stage='2'], [data-stage='3']) .row--focus {
    border-color: transparent;
    background: #fff;
    box-shadow: none;
  }

  .flow:is([data-stage='0'], [data-stage='1'], [data-stage='2'], [data-stage='3']) :is(.next, .next__evidence li, .next__foot, .next__caution) {
    opacity: 0;
    transform: translateX(var(--from, 14px));
  }

  :global([dir='rtl']) .flow {
    --from: -14px;
  }

  /* Staggering, so each step reads in turn */
  .flow .sys {
    transition-delay: calc(var(--i) * 120ms);
  }

  .flow .tyll {
    transition-delay: 0.35s;
  }

  .flow .row {
    transition-delay: calc(var(--i) * 180ms);
  }

  .flow .next__evidence li {
    transition-delay: calc(0.15s + var(--i) * 140ms);
  }

  .flow .next__foot {
    transition-delay: 0.45s;
  }

  .flow .next__caution {
    transition-delay: 0.6s;
  }

  .flow[data-reset] *,
  .flow[data-reset] :global(*) {
    transition: none !important;
  }

  /* Measuring the paths: cards at their final positions for that instant */
  .flow[data-measure] :is(.sys, .tyll, .row, .next, .next__evidence li, .next__foot, .next__caution, .flow__caption) {
    transform: none !important;
  }

  /* Paths draw in stage 2 and stay; one soft light travels along each once */
  .flow__paths :global(.path) {
    stroke-dasharray: var(--len) var(--len);
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.1s var(--ease);
    transition-delay: calc(var(--i) * 140ms);
  }

  .flow:is([data-stage='0'], [data-stage='1']) :global(.path) {
    stroke-dashoffset: var(--len);
  }

  .flow:is([data-stage='0'], [data-stage='1'], [data-stage='2'], [data-stage='3']) :global(.path--next) {
    stroke-dashoffset: var(--len);
  }

  .flow[data-stage='2'] :global(.pulse:not(.pulse--next)),
  .flow[data-stage='4'] :global(.pulse--next) {
    animation: flow-pulse 1.5s var(--ease) both;
    animation-delay: calc(0.25s + var(--i) * 140ms);
  }

  @keyframes flow-pulse {
    0% {
      opacity: 0;
      stroke-dashoffset: 40;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      stroke-dashoffset: calc(var(--len) * -1);
    }
  }

  /* ── Narrow screens: a vertical sequence. Systems, then Tyll, then the next step ── */
  @media (max-width: 1000px) {
    .story__head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .flow {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 3.5rem;
      padding-bottom: 4.5rem;
    }

    .systems {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }

    .sys:nth-child(n) {
      margin-inline-start: 0;
    }

    .flow__col--next {
      margin-top: -1rem;
    }
  }

  @media (max-width: 560px) {
    .flow {
      padding-inline: 1rem;
      border-radius: 22px;
    }

    .sys {
      padding: 0.7rem 0.75rem 0.75rem;
      font-size: 0.8125rem;
    }

    .sys__data {
      gap: 0.2rem 0.6rem;
    }

    .flow__replay {
      inset-inline-end: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__paths :global(.pulse) {
      display: none;
    }
  }
</style>

<script>
  // Draw the silver paths between the actual positions of the cards, then play the sequence once when the
  // section comes into view. Everything is still afterwards; the replay button runs it again.
  const flow = document.querySelector<HTMLElement>('[data-flow]');

  if (flow) {
    const svg = flow.querySelector<SVGSVGElement>('.flow__paths')!;
    const tyll = flow.querySelector<HTMLElement>('.tyll')!;
    const next = flow.querySelector<HTMLElement>('.next')!;
    const replay = flow.querySelector<HTMLButtonElement>('[data-replay]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const NS = 'http://www.w3.org/2000/svg';
    // Which overview row each system feeds
    const feeds: Record<string, string> = { pos: 'issue', stock: 'issue', pms: 'room', finance: 'invoice' };

    const draw = () => {
      flow.setAttribute('data-reset', '');
      flow.setAttribute('data-measure', '');
      const box = flow.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      const rel = (r: DOMRect) => ({ l: r.left - box.left, r: r.right - box.left, t: r.top - box.top, b: r.bottom - box.top, cx: r.left - box.left + r.width / 2, cy: r.top - box.top + r.height / 2 });
      const t = rel(tyll.getBoundingClientRect());
      const n = rel(next.getBoundingClientRect());
      const rtl = document.documentElement.dir === 'rtl';
      const stacked = t.t > rel(flow.querySelector('.sys')!.getBoundingClientRect()).b; // narrow layout: one column
      const items: { d: string; next?: boolean }[] = [];
      const curve = (x1: number, y1: number, x2: number, y2: number, vertical: boolean) =>
        vertical
          ? `M ${x1} ${y1} C ${x1} ${(y1 + y2) / 2}, ${x2} ${(y1 + y2) / 2}, ${x2} ${y2}`
          : `M ${x1} ${y1} C ${(x1 + x2) / 2} ${y1}, ${(x1 + x2) / 2} ${y2}, ${x2} ${y2}`;

      flow.querySelectorAll<HTMLElement>('[data-src]').forEach((card, _i, all) => {
        const c = rel(card.getBoundingClientRect());
        const row = rel(flow.querySelector<HTMLElement>(`[data-row="${feeds[card.dataset.src!]}"]`)!.getBoundingClientRect());
        if (stacked) {
          // Phones: every path leaves from the bottom of the systems grid (two per column), so no line crosses
          // a card, and they gather into the top of the Tyll overview
          const grid = rel(flow.querySelector('.systems')!.getBoundingClientRect());
          const x1 = c.cx + (c.t < grid.t + 4 ? -10 : 10);
          const cap = rel(flow.querySelector('.flow__caption--after')!.getBoundingClientRect());
          // End points in the same left-to-right order as the start points, gathered toward the centre
          const starts = [...all].map((el) => { const r = rel(el.getBoundingClientRect()); return r.cx + (r.t < grid.t + 4 ? -10 : 10); }).sort((a, b) => a - b);
          const x2 = t.cx + (starts.indexOf(x1) - (all.length - 1) / 2) * 22;
          items.push({ d: curve(x1, grid.b + 6, x2, cap.t - 10, true) });
        } else {
          const x1 = rtl ? c.l - 6 : c.r + 6;
          const x2 = rtl ? t.r + 6 : t.l - 6;
          items.push({ d: curve(x1, c.cy, x2, row.cy, false) });
        }
      });
      // From the issue in the overview to the next step
      const issue = rel(flow.querySelector<HTMLElement>('[data-row="issue"]')!.getBoundingClientRect());
      flow.removeAttribute('data-measure');
      void flow.offsetWidth;
      flow.removeAttribute('data-reset');
      items.push({
        d: stacked
          ? curve(t.cx, t.b + 6, n.cx, n.t - 6, true)
          : curve(rtl ? t.l - 6 : t.r + 6, issue.cy, rtl ? n.r + 6 : n.l - 6, n.t + 48, false),
        next: true,
      });

      svg.replaceChildren();
      const defs = document.createElementNS(NS, 'defs');
      defs.innerHTML =
        '<linearGradient id="flow-pulse" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset="0.6" stop-color="#fff" stop-opacity="0.9"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>';
      svg.append(defs);
      items.forEach((it, i) => {
        for (const cls of ['path', 'pulse']) {
          const el = document.createElementNS(NS, 'path');
          el.setAttribute('d', it.d);
          el.setAttribute('class', `${cls}${it.next ? ` ${cls}--next` : ''}`);
          svg.append(el);
          const len = (el as SVGPathElement).getTotalLength();
          el.style.setProperty('--len', String(Math.ceil(len)));
          el.style.setProperty('--i', String(it.next ? 0 : i));
          if (cls === 'pulse') el.style.strokeDasharray = `40 ${Math.ceil(len) + 40}`;
        }
      });
    };

    let timers: number[] = [];
    const play = () => {
      timers.forEach(clearTimeout);
      // Jump back to the start without animating, then step through the four stages
      flow.setAttribute('data-reset', '');
      flow.dataset.stage = '0';
      void flow.offsetWidth;
      flow.removeAttribute('data-reset');
      timers = [
        window.setTimeout(() => (flow.dataset.stage = '1'), 80),
        window.setTimeout(() => (flow.dataset.stage = '2'), 900),
        window.setTimeout(() => (flow.dataset.stage = '3'), 2000),
        window.setTimeout(() => (flow.dataset.stage = '4'), 3000),
      ];
    };

    draw();
    addEventListener('resize', draw);
    document.fonts?.ready.then(draw);

    if (!reduce.matches) {
      flow.dataset.stage = '0';
      replay.hidden = false;
      replay.addEventListener('click', play);
      new IntersectionObserver(
        ([e], io) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          play();
        },
        { threshold: 0.35 },
      ).observe(flow);
    }
  }
</script>
