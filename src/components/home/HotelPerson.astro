---
// One person in the hotel drawing: a flat figure about 7 heads tall with a head, neck, shoulders, two jointed arms, two
// jointed legs, feet and the clothes of their role. Drawn at 100 units tall with the feet at 0, then scaled.
// `stand` faces us; every other pose is seen from the side and looks to the right unless `flip` is set.
// `walk` swings the legs and arms in a two step gait while the story has the class that allows it.
// A slot holds whatever the person carries, in the same 100 unit space, in front of the hands.
type Role = 'doorman' | 'bellhop' | 'chef' | 'bartender' | 'driver' | 'staff' | 'waiter' | 'guest' | 'man' | 'woman';
type Pose = 'stand' | 'side' | 'carry' | 'phone' | 'push' | 'reach';

interface Props {
  x: number;
  foot: number;
  h: number;
  role: Role;
  pose?: Pose;
  walk?: boolean;
  flip?: boolean;
  class?: string;
}

const { x, foot, h, role, pose = 'side', walk = false, flip = false, class: className } = Astro.props;
const s = h / 100;
const n = (v: number) => +v.toFixed(2);

// Clothes, all from the tokens
const LOOK = {
  doorman: { top: 'graphite', legs: 'graphite', shoe: 'ink', hem: -28, flare: 11, rolled: false },
  bellhop: { top: 'amber-700', legs: 'graphite', shoe: 'ink', hem: -47, flare: 8, rolled: false },
  chef: { top: 'paper', legs: 'steel', shoe: 'ink', hem: -48, flare: 8, rolled: false },
  bartender: { top: 'paper', legs: 'ink', shoe: 'ink', hem: -48, flare: 8, rolled: true },
  driver: { top: 'steel', legs: 'graphite', shoe: 'ink', hem: -48, flare: 8, rolled: false },
  staff: { top: 'silver', legs: 'graphite', shoe: 'ink', hem: -48, flare: 8, rolled: true },
  waiter: { top: 'paper', legs: 'ink', shoe: 'ink', hem: -48, flare: 8, rolled: false },
  guest: { top: 'stone-3', legs: 'graphite', shoe: 'ink', hem: -24, flare: 11, rolled: false },
  man: { top: 'graphite', legs: 'graphite', shoe: 'ink', hem: -46, flare: 8, rolled: false },
  woman: { top: 'amber-700', legs: 'skin', shoe: 'ink', hem: -22, flare: 13, rolled: false },
}[role];

const front = pose === 'stand';
const hipX = front ? 4 : 1;
const shoulderX = front ? 11 : 1.5;
const skin = role === 'man' || role === 'chef' ? 'skin-2' : 'skin';

// Upper arm and forearm, as points from the shoulder, for each pose. The second arm hangs naturally.
const ARMS: Record<Pose, [number, number, number, number]> = {
  stand: [1, 15, 1.5, 30],
  side: [1, 15, 3, 30],
  carry: [6, 14, 20, 15],
  phone: [5, 14, 15, 5],
  push: [9, 13, 22, 11],
  reach: [7, -14, 11, -30],
};
const [ax, ay, hx, hy] = ARMS[pose];
const hair = role === 'woman' ? 'long' : 'short';
// Shoulders to hem, with a slight waist
const sw = front ? 11 : 8.5;
const torso = `M${-sw} -81Q${-sw} -84 ${-sw + 3} -84H${sw - 3}Q${sw} -84 ${sw} -81L${n(sw * 0.8)} -58L${LOOK.flare} ${LOOK.hem}H${-LOOK.flare}L${n(-sw * 0.8)} -58Z`;
const outlined = LOOK.top === 'paper';
---

<g class:list={['p', { 'p-walk': walk }, className]} transform={`translate(${x} ${foot}) scale(${flip ? -s : s} ${s})`}>
  <g class="p-body">
    <!-- The far leg and arm, a shade darker -->
    <g transform={`translate(${-hipX} -50)`}>
      <g class="p-thigh p-thigh--b">
        <path d="M0 0L0 23" stroke={`var(--${LOOK.legs})`} stroke-width="7.5" stroke-linecap="round" fill="none" opacity="0.82"></path>
        <g transform="translate(0 23)">
          <g class="p-shin p-shin--b">
            <path d="M0 0L0 23" stroke={`var(--${LOOK.legs})`} stroke-width="6.5" stroke-linecap="round" fill="none" opacity="0.82"></path>
            <path d="M-3.4 22h9q3.4 0 4.2 4.6h-13.2Z" fill={`var(--${LOOK.shoe})`}></path>
          </g>
        </g>
      </g>
    </g>
    <g transform={`translate(${-shoulderX} -80)`}>
      <g class="p-arm p-arm--b">
        <path d="M0 0L1 15L3 30" stroke={LOOK.rolled ? `var(--${skin})` : `var(--${LOOK.top})`} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.85"></path>
        <circle cx="3.4" cy="32.5" r="2.7" fill={`var(--${skin})`}></circle>
      </g>
    </g>

    <!-- Neck, head and hair -->
    <rect x="-2.3" y="-88.5" width="4.6" height="6" fill={`var(--${skin})`}></rect>
    <ellipse cx="0.6" cy="-93" rx="5.7" ry="7" fill={`var(--${skin})`}></ellipse>
    {
      hair === 'long' ? (
        <path d="M-6 -93a6.3 7.8 0 0 1 12.6 -2q-6 -1.5 -8.5 2l-.5 13q-3.6 -2 -3.6 -13Z" fill="var(--ink)" />
      ) : (
        <path d="M-5.2 -91a5.9 7 0 0 1 11.6 -4q-5 -1 -7.6 1q-1.6 1 -1.6 4Z" fill="var(--graphite)" />
      )
    }

    <!-- The near leg goes under the clothes -->
    <g transform={`translate(${hipX} -50)`}>
      <g class="p-thigh p-thigh--f">
        <path d="M0 0L0 23" stroke={`var(--${LOOK.legs})`} stroke-width="7.5" stroke-linecap="round" fill="none"></path>
        <g transform="translate(0 23)">
          <g class="p-shin p-shin--f">
            <path d="M0 0L0 23" stroke={`var(--${LOOK.legs})`} stroke-width="6.5" stroke-linecap="round" fill="none"></path>
            <path d="M-3.4 22h9q3.4 0 4.2 4.6h-13.2Z" fill={`var(--${LOOK.shoe})`}></path>
          </g>
        </g>
      </g>
    </g>

    <!-- Clothes -->
    <path d={torso} fill={`var(--${LOOK.top})`} stroke={outlined ? 'var(--graphite)' : 'none'} stroke-width="0.9" stroke-linejoin="round"></path>
    {role === 'chef' && <path d="M-7 -60H7L9 -24H-9Z" fill="var(--paper)" stroke="var(--graphite)" stroke-width="0.9" />}
    {role === 'chef' && <path d="M-2 -83V-60M2 -83V-60M-3.2 -76h1M-3.2 -70h1M2.4 -76h1M2.4 -70h1" stroke="var(--graphite)" stroke-width="0.8" fill="none" />}
    {(role === 'bartender' || role === 'waiter') && <path d="M-7.6 -82L-2 -82L0 -72L2 -82H7.6L6.6 -56H-6.6Z" fill="var(--ink)" />}
    {role === 'bartender' && <path d="M-8 -56H8L9 -26H-9Z" fill="var(--ink)" />}
    {role === 'staff' && <path d="M-6.8 -74H6.8L9 -30H-9Z" fill="var(--graphite)" />}
    {role === 'staff' && <path d="M-5 -74L-3 -84M5 -74L3 -84" stroke="var(--graphite)" stroke-width="1.6" />}
    {role === 'driver' && <path d="M-7.6 -60H7.6L7.6 -48H-7.6Z" fill="var(--graphite)" />}
    {role === 'doorman' && <path d="M0 -84V-28M-4 -72h2M-4 -62h2M-4 -52h2M2 -72h2M2 -62h2M2 -52h2" stroke="var(--amber-300)" stroke-width="1.2" fill="none" />}
    {role === 'doorman' && <path d="M-11 -82h5M6 -82h5" stroke="var(--amber-300)" stroke-width="2" />}
    {role === 'bellhop' && <path d="M0 -84V-47M-2.6 -76h1.2M-2.6 -68h1.2M-2.6 -60h1.2M1.4 -76h1.2M1.4 -68h1.2M1.4 -60h1.2" stroke="var(--amber-300)" stroke-width="1" fill="none" />}
    {role === 'man' && <path d="M-3 -84L0 -72L3 -84Z" fill="var(--paper)" />}
    {role === 'guest' && <path d="M-3 -84L0 -74L3 -84Z" fill="var(--steel)" />}

    <!-- Hats -->
    {role === 'chef' && <path d="M-5.6 -97.5h11.2l1.6 -9.6q-1 -3.6 -4.6 -2.6q-3.4 -3 -6.4 0q-3.8 -.8 -4.4 2.6Z" fill="var(--paper)" stroke="var(--graphite)" stroke-width="0.9" stroke-linejoin="round" />}
    {role === 'doorman' && <path d="M-6.8 -97.5q0 -6.5 7.4 -6.5t7.4 6.5ZM-6 -98h13.2v1.8H-6ZM5 -97.6h5.6v1.6H5Z" fill="var(--ink)" />}
    {role === 'bellhop' && <path d="M-5 -98.5v-5h11v5Z" fill="var(--amber-700)" stroke="var(--amber-300)" stroke-width="0.7" />}
    {role === 'driver' && <path d="M-6 -96.5q0 -7 6.6 -7t6.6 7ZM5 -97.5h6.4v1.6H5Z" fill="var(--steel)" />}

    <!-- The near arm, with what it holds -->
    <g transform={`translate(${shoulderX} -80)`}>
      <g class="p-arm p-arm--f">
        <path d={`M0 0L${ax} ${ay}`} stroke={`var(--${LOOK.top})`} stroke-width="5.4" stroke-linecap="round" fill="none"></path>
        <path d={`M${ax} ${ay}L${hx} ${hy}`} stroke={LOOK.rolled ? `var(--${skin})` : `var(--${LOOK.top})`} stroke-width="4.8" stroke-linecap="round" fill="none"></path>
        {outlined && !LOOK.rolled && <path d={`M0 0L${ax} ${ay}L${hx} ${hy}`} stroke="var(--graphite)" stroke-width="0.5" fill="none" transform="translate(2.6 0)" />}
        <circle cx={hx + (hx - ax) * 0.1} cy={hy + (hy - ay) * 0.1} r="2.8" fill={`var(--${skin})`}></circle>
        {pose === 'phone' && <rect x={hx - 1} y={hy - 8} width="4.6" height="8.6" rx="0.8" fill="var(--ink)"></rect>}
      </g>
    </g>
    <slot />
  </g>
</g>

<style>
  /* Two steps per second or so: the thighs swing, the shins bend on the way through, the arms counter swing, the body lifts */
  :global(.hs.is-alive) .p-walk .p-thigh--f,
  :global(.hs.is-delivering) .p-walk .p-thigh--f {
    animation: p-thigh 1s linear infinite;
  }

  :global(.hs.is-alive) .p-walk .p-thigh--b,
  :global(.hs.is-delivering) .p-walk .p-thigh--b {
    animation: p-thigh 1s linear -0.5s infinite;
  }

  :global(.hs.is-alive) .p-walk .p-shin--f,
  :global(.hs.is-delivering) .p-walk .p-shin--f {
    animation: p-shin 1s linear infinite;
  }

  :global(.hs.is-alive) .p-walk .p-shin--b,
  :global(.hs.is-delivering) .p-walk .p-shin--b {
    animation: p-shin 1s linear -0.5s infinite;
  }

  :global(.hs.is-alive) .p-walk .p-arm--f,
  :global(.hs.is-delivering) .p-walk .p-arm--f {
    animation: p-arm 1s ease-in-out -0.5s infinite;
  }

  :global(.hs.is-alive) .p-walk .p-arm--b,
  :global(.hs.is-delivering) .p-walk .p-arm--b {
    animation: p-arm 1s ease-in-out infinite;
  }

  :global(.hs.is-alive) .p-walk > .p-body,
  :global(.hs.is-delivering) .p-walk > .p-body {
    animation: p-bob 0.5s ease-in-out infinite alternate;
  }

  :global(.hs.is-paused) .p * {
    animation-play-state: paused;
  }

  @keyframes p-thigh {
    0%, 100% { transform: rotate(-24deg); }
    50% { transform: rotate(22deg); }
  }

  @keyframes p-shin {
    0% { transform: rotate(4deg); }
    25% { transform: rotate(6deg); }
    50% { transform: rotate(8deg); }
    72% { transform: rotate(46deg); }
    100% { transform: rotate(4deg); }
  }

  @keyframes p-arm {
    0%, 100% { transform: rotate(-20deg); }
    50% { transform: rotate(20deg); }
  }

  @keyframes p-bob {
    from { transform: translateY(0); }
    to { transform: translateY(-1.6px); }
  }
</style>
