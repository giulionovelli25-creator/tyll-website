---
// Privacy policy. Sections for optional services (analytics, Meta Pixel, Calendly, social links) appear only
// when that service is configured, so the text always matches what the site actually loads.
import Base from '../../layouts/Base.astro';
import LegalShell from './LegalShell.astro';
import Missing from './Missing.astro';
import { legal, legalMissing } from '../../config/legal';
import { site } from '../../config/site';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const de = lang === 'de';
const L = (en: string, deText: string) => (de ? deText : en);
const incomplete = legalMissing().length > 0;
const analytics = site.analytics.provider && site.analytics.id ? site.analytics.provider : undefined;
const pixel = Boolean(site.metaPixelId);
const consentNeeded = Boolean(analytics || pixel);
const social = [site.social.linkedin && 'LinkedIn', site.social.instagram && 'Instagram'].filter(Boolean) as string[];
---

<Base lang={lang} page="privacy" title={d.meta.privacyTitle} description={d.meta.privacyDescription} noindex={incomplete}>
  <LegalShell lang={lang} title={L('Privacy policy', 'Datenschutzerklärung')}>
    <p>
      {
        L(
          'This policy explains which personal data is processed when you visit the Tyll website, why, and what rights you have. It covers this website only. The interactive Tyll demo is a separate application with its own information.',
          'Diese Erklärung beschreibt, welche personenbezogenen Daten beim Besuch der Tyll-Website verarbeitet werden, zu welchem Zweck und welche Rechte Sie haben. Sie gilt nur für diese Website. Die interaktive Tyll-Demo ist eine eigene Anwendung mit eigenen Hinweisen.',
        )
      }
    </p>

    <h2 id="controller">{L('Who is responsible', 'Verantwortlicher')}</h2>
    <p>{L('The controller under Art. 4(7) GDPR is:', 'Verantwortlicher im Sinne von Art. 4 Nr. 7 DSGVO ist:')}</p>
    <address>
      {legal.operator ?? <Missing label={L('Missing: operator name', 'Fehlt: Name des Anbieters')} />}
      <br />
      {legal.address ? legal.address.map((l) => <>{l}<br /></>) : <Missing label={L('Missing: postal address', 'Fehlt: Anschrift')} />}
      <br />
      {L('Email', 'E-Mail')}: <a href={`mailto:${legal.email}`}>{legal.email}</a>
    </address>

    <h2 id="bases">{L('Legal bases', 'Rechtsgrundlagen')}</h2>
    <p>{L('Depending on the purpose, we process personal data on these legal bases:', 'Je nach Zweck verarbeiten wir personenbezogene Daten auf folgenden Rechtsgrundlagen:')}</p>
    <ul>
      <li>{L('Art. 6(1)(a) GDPR: your consent, which you can withdraw at any time with effect for the future.', 'Art. 6 Abs. 1 lit. a DSGVO: Ihre Einwilligung, die Sie jederzeit mit Wirkung für die Zukunft widerrufen können.')}</li>
      <li>{L('Art. 6(1)(b) GDPR: steps taken at your request before a possible contract, such as arranging a call.', 'Art. 6 Abs. 1 lit. b DSGVO: vorvertragliche Maßnahmen auf Ihre Anfrage, etwa die Vereinbarung eines Gesprächs.')}</li>
      <li>{L('Art. 6(1)(c) GDPR: legal obligations, such as retention duties under commercial and tax law.', 'Art. 6 Abs. 1 lit. c DSGVO: rechtliche Pflichten, etwa handels- und steuerrechtliche Aufbewahrungspflichten.')}</li>
      <li>{L('Art. 6(1)(f) GDPR: our legitimate interest in running a secure and reliable website and answering enquiries.', 'Art. 6 Abs. 1 lit. f DSGVO: unser berechtigtes Interesse an einem sicheren, stabilen Betrieb der Website und an der Beantwortung von Anfragen.')}</li>
    </ul>
    <p>
      {
        L(
          'Storing information on your device or reading it from there is governed additionally by § 25 TDDDG (German Telecommunications Digital Services Data Protection Act): it requires your consent unless it is strictly necessary for a service you have requested.',
          'Für das Speichern von Informationen auf Ihrem Endgerät und den Zugriff darauf gilt zusätzlich § 25 TDDDG: Es erfordert Ihre Einwilligung, sofern es nicht für einen von Ihnen gewünschten Dienst unbedingt erforderlich ist.',
        )
      }
    </p>

    <h2 id="hosting">{L('Hosting and server log files', 'Hosting und Server-Logfiles')}</h2>
    <p>
      {L('This website is hosted by ', 'Diese Website wird gehostet von ')}
      {legal.hosting.name ?? <Missing label={L('Missing: hosting provider', 'Fehlt: Hosting-Anbieter')} />}
      {legal.hosting.address && `, ${legal.hosting.address}`}
      {
        L(
          ', which processes data on our behalf under a data processing agreement (Art. 28 GDPR). Content is delivered through a worldwide network, so servers in the USA may be involved. Transfers to the USA are based on the EU-U.S. Data Privacy Framework (Art. 45 GDPR), in which the provider participates, and on standard contractual clauses (Art. 46(2)(c) GDPR).',
          ', der die Daten in unserem Auftrag auf Grundlage eines Auftragsverarbeitungsvertrags (Art. 28 DSGVO) verarbeitet. Die Auslieferung erfolgt über ein weltweites Netzwerk, sodass auch Server in den USA beteiligt sein können. Übermittlungen in die USA stützen sich auf das EU-US Data Privacy Framework (Art. 45 DSGVO), an dem der Anbieter teilnimmt, sowie auf Standardvertragsklauseln (Art. 46 Abs. 2 lit. c DSGVO).',
        )
      }
      {!legal.hosting.confirmed && <> <Missing label={L('To confirm: hosting and data processing agreement for this site', 'Zu bestätigen: Hosting und Auftragsverarbeitungsvertrag für diese Website')} /></>}
    </p>
    <p>
      {
        L(
          'Each time a page is requested, the server automatically records technical data: IP address, date and time, the page requested, the referring page, and browser and operating system information. We use this only to deliver the website and keep it secure (Art. 6(1)(f) GDPR). The log files are kept only as long as the hosting provider needs them for these purposes.',
          'Bei jedem Seitenabruf speichert der Server automatisch technische Daten: IP-Adresse, Datum und Uhrzeit, die aufgerufene Seite, die verweisende Seite sowie Angaben zu Browser und Betriebssystem. Wir nutzen diese Daten nur, um die Website auszuliefern und abzusichern (Art. 6 Abs. 1 lit. f DSGVO). Die Logfiles werden nur so lange gespeichert, wie der Hosting-Anbieter sie für diese Zwecke benötigt.',
        )
      }
    </p>

    <h2 id="assets">{L('Fonts, images and video', 'Schriften, Bilder und Video')}</h2>
    <p>
      {
        L(
          'Fonts, images and the video on this website are served from our own hosting. Loading a page does not connect your browser to font services, video platforms or other third parties.',
          'Schriften, Bilder und das Video auf dieser Website werden von unserem eigenen Hosting ausgeliefert. Beim Laden einer Seite verbindet sich Ihr Browser nicht mit Schriftdiensten, Videoplattformen oder anderen Dritten.',
        )
      }
    </p>

    <h2 id="cookies">{L('Cookies and your consent choices', 'Cookies und Ihre Einwilligung')}</h2>
    {
      consentNeeded ? (
        <>
          <p>
            {L(
              'The services in the sections below that need your consent only start after you allow them in our cookie banner. You can accept or reject them with one click each, or choose individually under “Preferences”. You can change your choice at any time under “Cookie preferences” at the bottom of every page.',
              'Die einwilligungspflichtigen Dienste in den folgenden Abschnitten starten erst, nachdem Sie sie in unserem Cookie-Banner erlaubt haben. Sie können sie mit je einem Klick annehmen oder ablehnen oder unter „Einstellungen“ einzeln auswählen und Ihre Wahl jederzeit unter „Cookie-Einstellungen“ am Ende jeder Seite ändern.',
            )}
          </p>
          <p>
            {L(
              'Your choice itself is saved in your browser’s local storage under the name “tyll-consent”, together with the date, so we don’t ask again on every page. This is strictly necessary to respect your choice (§ 25(2) TDDDG). We ask again after twelve months.',
              'Ihre Wahl selbst wird mit Datum im lokalen Speicher Ihres Browsers unter dem Namen „tyll-consent“ gespeichert, damit wir nicht auf jeder Seite erneut fragen. Das ist unbedingt erforderlich, um Ihre Wahl zu beachten (§ 25 Abs. 2 TDDDG). Nach zwölf Monaten fragen wir erneut.',
            )}
          </p>
        </>
      ) : (
        <p>
          {L(
            'This website currently sets no cookies and uses no analytics or advertising services, so there is nothing to consent to when you browse it. If we add such a service, we will update this policy and ask for your consent before it starts.',
            'Diese Website setzt derzeit keine Cookies und nutzt keine Analyse- oder Werbedienste; beim Surfen gibt es daher nichts einzuwilligen. Sollten wir einen solchen Dienst ergänzen, passen wir diese Erklärung an und fragen vor dem Start nach Ihrer Einwilligung.',
          )}
        </p>
      )
    }

    {
      analytics === 'plausible' && (
        <>
          <h2 id="analytics">{L('Website statistics (Plausible Analytics)', 'Website-Statistik (Plausible Analytics)')}</h2>
          <p>
            {L(
              'With your consent (Art. 6(1)(a) GDPR, § 25(1) TDDDG), we use Plausible Analytics from Plausible Insights OÜ, Västriku tn 2, 50403 Tartu, Estonia, to understand how the website is used, for example how often the booking and demo buttons are clicked. Plausible works without cookies and processes data in the EU. Your IP address is used only to produce a daily changing anonymous identifier and is not stored. We do not send names, email addresses or other personal details to Plausible.',
              'Mit Ihrer Einwilligung (Art. 6 Abs. 1 lit. a DSGVO, § 25 Abs. 1 TDDDG) nutzen wir Plausible Analytics der Plausible Insights OÜ, Västriku tn 2, 50403 Tartu, Estland, um zu verstehen, wie die Website genutzt wird, etwa wie oft die Buchungs- und Demo-Schaltflächen angeklickt werden. Plausible arbeitet ohne Cookies und verarbeitet Daten in der EU. Ihre IP-Adresse wird nur zur Bildung einer täglich wechselnden anonymen Kennung verwendet und nicht gespeichert. Namen, E-Mail-Adressen oder andere persönliche Angaben übermitteln wir nicht an Plausible.',
            )}
          </p>
        </>
      )
    }
    {
      analytics === 'ga4' && (
        <>
          <h2 id="analytics">{L('Website statistics (Google Analytics 4)', 'Website-Statistik (Google Analytics 4)')}</h2>
          <p>
            {L(
              'With your consent (Art. 6(1)(a) GDPR, § 25(1) TDDDG), we use Google Analytics 4 from Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Ireland, to understand how the website is used, for example how often the booking and demo buttons are clicked. Google Analytics sets cookies (such as “_ga”) and processes usage data, including a shortened IP address. Data may be transferred to Google LLC in the USA; this is based on the EU-U.S. Data Privacy Framework (Art. 45 GDPR). We do not send names, email addresses or other personal details to Google.',
              'Mit Ihrer Einwilligung (Art. 6 Abs. 1 lit. a DSGVO, § 25 Abs. 1 TDDDG) nutzen wir Google Analytics 4 der Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Irland, um zu verstehen, wie die Website genutzt wird, etwa wie oft die Buchungs- und Demo-Schaltflächen angeklickt werden. Google Analytics setzt Cookies (etwa „_ga“) und verarbeitet Nutzungsdaten einschließlich einer gekürzten IP-Adresse. Daten können an Google LLC in den USA übermittelt werden; Grundlage ist das EU-US Data Privacy Framework (Art. 45 DSGVO). Namen, E-Mail-Adressen oder andere persönliche Angaben übermitteln wir nicht an Google.',
            )}
          </p>
        </>
      )
    }

    {
      pixel && (
        <>
          <h2 id="meta-pixel">{L('Meta Pixel', 'Meta Pixel')}</h2>
          <p>
            {L(
              'With your consent to marketing (Art. 6(1)(a) GDPR, § 25(1) TDDDG), we use the Meta Pixel from Meta Platforms Ireland Limited, Merrion Road, Dublin 4, D04 X2K5, Ireland, to measure the effect of our advertising on Facebook and Instagram and to show relevant ads. The pixel sets cookies and sends Meta information about your visit, such as the pages viewed and whether you clicked to book a call. If you are logged in to a Meta service, Meta can link this to your account. We and Meta are jointly responsible for collecting and transmitting this data (Art. 26 GDPR); Meta is responsible for any further processing. Data may be transferred to the USA on the basis of the EU-U.S. Data Privacy Framework.',
              'Mit Ihrer Einwilligung in Marketing (Art. 6 Abs. 1 lit. a DSGVO, § 25 Abs. 1 TDDDG) nutzen wir das Meta Pixel der Meta Platforms Ireland Limited, Merrion Road, Dublin 4, D04 X2K5, Irland, um die Wirkung unserer Werbung auf Facebook und Instagram zu messen und relevante Anzeigen zu zeigen. Das Pixel setzt Cookies und übermittelt Meta Informationen über Ihren Besuch, etwa die aufgerufenen Seiten und ob Sie auf „Gespräch buchen“ geklickt haben. Sind Sie bei einem Meta-Dienst angemeldet, kann Meta dies Ihrem Konto zuordnen. Für die Erhebung und Übermittlung sind wir und Meta gemeinsam verantwortlich (Art. 26 DSGVO); für die weitere Verarbeitung ist Meta verantwortlich. Daten können auf Grundlage des EU-US Data Privacy Framework in die USA übermittelt werden.',
            )}
          </p>
        </>
      )
    }

    <h2 id="calendly">{L('Booking a call (Calendly)', 'Terminbuchung (Calendly)')}</h2>
    {
      site.calendlyUrl ? (
        <>
          <p>
            {L(
              'Our booking calendar is provided by Calendly, LLC, 115 E Main St, Ste A1B, Buford, GA 30518, USA. It is not loaded automatically: only when you click “Open the booking calendar” does your browser connect to Calendly (Art. 6(1)(a) GDPR, § 25(1) TDDDG). Calendly may then set cookies and receives technical data such as your IP address.',
              'Unser Buchungskalender wird von Calendly, LLC, 115 E Main St, Ste A1B, Buford, GA 30518, USA, bereitgestellt. Er wird nicht automatisch geladen: Erst wenn Sie auf „Buchungskalender öffnen“ klicken, verbindet sich Ihr Browser mit Calendly (Art. 6 Abs. 1 lit. a DSGVO, § 25 Abs. 1 TDDDG). Calendly kann dann Cookies setzen und erhält technische Daten wie Ihre IP-Adresse.',
            )}
          </p>
          <p>
            {L(
              'If you book a call, Calendly processes the details you enter, such as your name, email address, hotel or company and your answers, together with the chosen time, so that we can hold the call (Art. 6(1)(b) GDPR). Calendly participates in the EU-U.S. Data Privacy Framework, which is the basis for the transfer to the USA (Art. 45 GDPR).',
              'Wenn Sie einen Termin buchen, verarbeitet Calendly Ihre Eingaben – etwa Name, E-Mail-Adresse, Hotel oder Unternehmen und Ihre Antworten – zusammen mit dem gewählten Zeitpunkt, damit wir das Gespräch führen können (Art. 6 Abs. 1 lit. b DSGVO). Calendly nimmt am EU-US Data Privacy Framework teil; dies ist die Grundlage für die Übermittlung in die USA (Art. 45 DSGVO).',
            )}
          </p>
        </>
      ) : (
        <p>
          {L(
            'Online booking is not active at the moment. You can arrange a call by email instead; see “Contacting us by email” below.',
            'Die Online-Buchung ist derzeit nicht aktiv. Sie können ein Gespräch stattdessen per E-Mail vereinbaren; siehe „Kontakt per E-Mail“ unten.',
          )}
        </p>
      )
    }

    <h2 id="email">{L('Contacting us by email', 'Kontakt per E-Mail')}</h2>
    <p>
      {
        L(
          'If you email us, we process your email address and the content of your message to answer your enquiry (Art. 6(1)(b) or (f) GDPR).',
          'Wenn Sie uns per E-Mail schreiben, verarbeiten wir Ihre E-Mail-Adresse und den Inhalt Ihrer Nachricht, um Ihre Anfrage zu beantworten (Art. 6 Abs. 1 lit. b oder f DSGVO).',
        )
      }
    </p>
    <p>
      {L('Retention: ', 'Speicherdauer: ')}
      {legal.enquiryRetention ? legal.enquiryRetention[lang] : <Missing label={L('Missing: how long enquiries and booking details are kept', 'Fehlt: Speicherdauer für Anfragen und Termindaten')} />}
    </p>

    {
      social.length > 0 && (
        <>
          <h2 id="social">{L('Links to our social media profiles', 'Links zu unseren Social-Media-Profilen')}</h2>
          <p>
            {L(
              `Our footer links to our profiles on ${social.join(' and ')}. These are plain links: nothing is loaded from these networks until you click one. After that, the respective network’s privacy policy applies.`,
              `Im Fußbereich verlinken wir auf unsere Profile bei ${social.join(' und ')}. Es handelt sich um einfache Links: Von diesen Netzwerken wird nichts geladen, bevor Sie darauf klicken. Danach gilt die Datenschutzerklärung des jeweiligen Netzwerks.`,
            )}
          </p>
        </>
      )
    }

    {
      site.demoUrl && (
        <>
          <h2 id="demo">{L('The interactive demo', 'Die interaktive Demo')}</h2>
          <p>
            {L(
              'The “Explore demo” buttons open our interactive demo, a separate application. It uses fictional demo accounts and data; please do not enter real personal or hotel information there. The demo’s own privacy information applies.',
              'Die Schaltflächen „Demo ansehen“ öffnen unsere interaktive Demo, eine eigene Anwendung. Sie arbeitet mit fiktiven Demo-Konten und -Daten; bitte geben Sie dort keine echten personenbezogenen Daten oder Hoteldaten ein. Es gelten die Datenschutzhinweise der Demo.',
            )}
          </p>
        </>
      )
    }

    <h2 id="rights">{L('Your rights', 'Ihre Rechte')}</h2>
    <p>{L('Under the GDPR you have the right to:', 'Nach der DSGVO haben Sie das Recht auf:')}</p>
    <ul>
      <li>{L('access your personal data (Art. 15)', 'Auskunft über Ihre personenbezogenen Daten (Art. 15)')}</li>
      <li>{L('have it corrected (Art. 16) or deleted (Art. 17)', 'Berichtigung (Art. 16) oder Löschung (Art. 17)')}</li>
      <li>{L('restrict its processing (Art. 18)', 'Einschränkung der Verarbeitung (Art. 18)')}</li>
      <li>{L('receive it in a portable format (Art. 20)', 'Datenübertragbarkeit (Art. 20)')}</li>
      <li>{L('object to processing based on legitimate interests (Art. 21)', 'Widerspruch gegen Verarbeitungen auf Grundlage berechtigter Interessen (Art. 21)')}</li>
      <li>{L('withdraw consent at any time with effect for the future (Art. 7(3))', 'Widerruf einer Einwilligung jederzeit mit Wirkung für die Zukunft (Art. 7 Abs. 3)')}</li>
    </ul>
    <p>
      {L('To exercise these rights, email ', 'Um diese Rechte auszuüben, schreiben Sie an ')}
      <a href={`mailto:${legal.email}`}>{legal.email}</a>.
      {
        L(
          ' You can also lodge a complaint with a data protection supervisory authority, in particular in the EU member state where you live or work, or where you believe an infringement took place (Art. 77 GDPR).',
          ' Außerdem können Sie sich bei einer Datenschutz-Aufsichtsbehörde beschweren, insbesondere in dem EU-Mitgliedstaat Ihres Aufenthaltsorts, Ihres Arbeitsplatzes oder des mutmaßlichen Verstoßes (Art. 77 DSGVO).',
        )
      }
    </p>

    <h2 id="changes">{L('Changes to this policy', 'Änderungen dieser Erklärung')}</h2>
    <p>
      {
        L(
          'We update this policy when the website or the services it uses change. The date at the top shows the current version.',
          'Wir passen diese Erklärung an, wenn sich die Website oder die genutzten Dienste ändern. Das Datum oben zeigt die aktuelle Fassung.',
        )
      }
    </p>
  </LegalShell>
</Base>
