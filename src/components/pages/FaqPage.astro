---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import lounge from '../../assets/photos/faq-lounge.jpg';
import PageIntro from '../PageIntro.astro';
import { site } from '../../config/site';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const f = d.faq;
// Answers that depend on the public demo being online use their alternative text until it is.
const answer = (i: (typeof f.items)[number]) => (!site.demoUrl && i.aNoDemo ? i.aNoDemo : i.a);

// FAQPage structured data, built from exactly the questions and answers shown on the page.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: f.items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: answer(i).join(' ') },
  })),
};
---

<Base lang={lang} page="faq" title={d.meta.faqTitle} description={d.meta.faqDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <PageIntro title={f.title} intro={f.intro} />

  <section class="wrap faq" aria-label={f.title}>
    <div class="faq__list">
      {
        f.items.map((i) => (
          <details id={i.id} class="faq__item">
            <summary>
              <h2>{i.q}</h2>
            </summary>
            <div class="faq__answer">
              {answer(i).map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>

    <aside class="faq__side">
      <Picture
        src={lounge}
        alt=""
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 760]}
        sizes="(max-width: 860px) calc(100vw - 32px), 380px"
        loading="lazy"
        decoding="async"
        class="faq__photo"
      />
      <div class="faq__more">
      <h2>{f.more}</h2>
      <p>{f.moreText}</p>
      <div class="faq__actions">
        <a class="btn btn--solid" href={href('book', lang)} data-track="book_call_click" data-track-from="faq">{d.cta.book}</a>
        <a class="btn btn--line" href={`mailto:${site.email}`} data-track="email_click">{site.email}</a>
      </div>
      </div>
    </aside>
  </section>
</Base>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 3rem 5rem;
    align-items: start;
    padding-bottom: var(--section-y);
  }

  .faq__list {
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 0;
    list-style: none;
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-3px) rotate(45deg);
    transition: transform 0.3s var(--ease);
  }

  .faq__item[open] summary::after {
    transform: translateY(3px) rotate(-135deg);
  }

  .faq__item h2 {
    font-size: 1.1875rem;
    font-weight: 450;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .faq__answer {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    padding-bottom: 1.5rem;
    color: var(--graphite);
    line-height: 1.65;
  }

  /* A silver wave behind the title area, and a warm photograph above the contact card */
  :global(main:has(.faq))::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline-end: 0;
    width: min(900px, 70vw);
    height: 520px;
    background: url('/media/tyll-waves.webp') center / cover no-repeat;
    opacity: 0.7;
    -webkit-mask-image: linear-gradient(200deg, #000 20%, transparent 75%);
    mask-image: linear-gradient(200deg, #000 20%, transparent 75%);
    pointer-events: none;
    z-index: -1;
  }

  :global([dir='rtl'] main:has(.faq))::before {
    -webkit-mask-image: linear-gradient(160deg, #000 20%, transparent 75%);
    mask-image: linear-gradient(160deg, #000 20%, transparent 75%);
  }

  :global(main:has(.faq)) {
    position: relative;
    isolation: isolate;
  }

  .faq__side {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--cloud);
    overflow: hidden;
  }

  .faq__side :global(.faq__photo) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    object-fit: cover;
    object-position: 55% 55%;
  }

  .faq__more {
    padding: 1.75rem 2rem 2rem;
  }

  .faq__more h2 {
    font-size: var(--fs-h3);
    font-weight: 500;
  }

  .faq__more p {
    margin-top: 0.6rem;
    color: var(--steel);
  }

  .faq__actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }

    .faq__side {
      position: static;
    }
  }
</style>

<script>
  // Opening a question is counted (once per question per page view), if statistics are allowed
  document.querySelectorAll<HTMLDetailsElement>('.faq__item').forEach((el) => {
    let counted = false;
    el.addEventListener('toggle', () => {
      if (!el.open || counted) return;
      counted = true;
      document.dispatchEvent(new CustomEvent('tyll:track', { detail: { event: 'faq_opened', question: el.id } }));
    });
  });

  // A link to /faq/#question opens that answer.
  const open = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  open();
  addEventListener('hashchange', open);
</script>
