    translate: 0 8px;
  }

  /* the chain: its line draws and its steps arrive one after another */
  :global(.sus.is-armed) .flow:not(.is-in)::before {
    transform: scaleX(0);
  }

  :global(.sus.is-armed) .flow:not(.is-in) .flow__node {
    opacity: 0;
    scale: 0.6;
  }

  @media (max-width: 700px) {
    :global(.sus.is-armed) .flow:not(.is-in)::before {
      transform: scaleY(0);
    }
  }

  /* the board: a figure's drawing starts empty and plays when the script marks the figure .is-on */
  :global(.sus.is-armed) .stat:not(.is-on) .split__still,
  :global(.sus.is-armed) .stat:not(.is-on) .split__cut,
  :global(.sus.is-armed) .stat:not(.is-on) .ratio__bar {
    transform: scaleX(0);
    transition: none;
  }

