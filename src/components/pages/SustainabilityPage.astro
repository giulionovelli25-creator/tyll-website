---
// The Sustainability page (round 5, 25 Nov 2026, the owner's brief). About four screens on a desktop, each section
// shaped differently and each with one moment of motion at most:
// 1. Hero: the photograph fills the screen under the header, the headline and its line in the lower third over a dark
//    gradient (white text, AA contrast), rising into place once in 600 ms.
// 2. One sentence of the world's numbers, set large on a dark band; it lights up word by word as it scrolls in, each
//    figure counting up with a silver underline, and five plates under it lose the fifth to the bin. The real figures
//    are in the HTML; only an aria-hidden copy counts, so search engines, previews and screen readers always get the
//    final numbers.
// 3. The calculator (SusCalculator.astro), with the EU's 2030 target under it (the UAE's on the Arabic page).
// 4. What hotels got back from cutting food waste (25 Nov 2026, the owner's brief): industry research, said at the
//    top; the 21% waste cut on its own, then the return on the hotels' own programs as three figures side by side,
//    with no line or circles, since they are not a sequence. Stacked on phones.
// 5. (The three cities moved to the About page on 25 Nov 2026, the owner: they belong with our story.)
// 6. Where Tyll helps: three cards, each with its solution page's film, loaded only when it scrolls into view.
// 7. The dark closing band.
// Under reduced motion nothing moves; without JavaScript everything shows in its final state. Copy:
// src/content/sustainability.ts. No figure here is a Tyll result.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SilverWave from '../SilverWave.astro';
import SusCalculator from './SusCalculator.astro';
import { sustainability } from '../../content/sustainability';
import { solutions } from '../../content/solutions';
import { t, href, type Locale } from '../../i18n';
import heroPhoto from '../../assets/photos/sales-buffet.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const c = sustainability[lang];
const tab = d.cta.newTab;
const fwd = lang === 'ar' ? '←' : '→';
// The sentence, split into plain text and {figures}
const parts = c.sentence.text.split(/(\{[^}]+\})/).filter(Boolean).map((p) => (p.startsWith('{') ? { fig: p.slice(1, -1) } : { text: p }));
// Each figure's place in the sentence: the second one is "about one fifth", which sends the fifth plate to the bin
const figs = parts.flatMap((p) => ('fig' in p ? [p.fig] : []));
const figIndex = (f: string) => figs.indexOf(f);
const act = c.act.items.map((it) => ({ ...it, s: solutions[it.page] }));
---

<Base lang={lang} page="sustainability" title={c.metaTitle} description={c.metaDescription} overHero>
  <section class="hero on-dark" data-dark aria-labelledby="sus-title">
    <Picture class="hero__photo" src={heroPhoto} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" decoding="async" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <h1 id="sus-title" class="display">{c.title}</h1>
      <p class="hero__text">{c.text}</p>
    </div>
  </section>

  <section class="line on-dark" data-dark aria-label={c.sentence.source.name} data-line>
    <div class="wrap">
      <p class="line__text">
        {
          parts.map((p) =>
            'fig' in p ? (
              <strong class="line__fig w" data-fig={figIndex(p.fig)}>
                <span class="visually-hidden">{p.fig}</span>
                <span aria-hidden="true" data-count>{p.fig}</span>
              </strong>
            ) : (
              p.text.split(/(\s+)/).map((w) => (/^\s+$/.test(w) || !w ? w : <span class="w">{w}</span>))
            ),
          )
        }
      </p>
      <!-- Five plates, one of them going in the bin: "about one fifth" as a picture -->
      <svg class="line__plates" viewBox="0 0 400 72" aria-hidden="true">
        {
          [0, 1, 2, 3, 4].map((i) => (
            <g class:list={['plate', i === 4 && 'plate--bin']} transform={`translate(${40 + i * 80} 36)`}>
              <circle r="30" />
              <circle class="plate__well" r="19" />
            </g>
          ))
        }
      </svg>
      <p class="source line__source">
        <a href={c.sentence.source.url} target="_blank" rel="noopener">
          {c.sentence.source.name}
          <span class="visually-hidden"> {tab}</span>
        </a>
      </p>
    </div>
  </section>

  <SusCalculator lang={lang} />

  <!-- What hotels got back: industry research, not Tyll's. The waste cut stands alone; the return on the hotels' own
       programs sits beside it as three figures, with nothing joining them, since they are not steps in a sequence. -->
  <section class="back" aria-labelledby="sus-back">
    <div class="wrap">
      <h2 id="sus-back" class="display sus__title">{c.back.title}</h2>
      <p class="back__sub">{c.back.sub}</p>
      <div class="back__lead">
        <p class="back__figure back__figure--lead" dir="ltr">{c.back.lead.figure}</p>
        <p class="back__text">{c.back.lead.text}</p>
      </div>
      <div class="back__returns">
        <h3 class="back__label">{c.back.returnsLabel}</h3>
        <ul class="back__list" role="list">
          {
            c.back.returns.map((r) => (
              <li>
                <p class="back__figure" dir="ltr">{r.figure}</p>
                <p class="back__text">{r.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="source back__source">
        <a href={c.back.source.url} target="_blank" rel="noopener">
          {c.back.source.name}
          <span class="visually-hidden"> {tab}</span>
        </a>
      </p>
    </div>
  </section>

  <section class="act" aria-labelledby="sus-act">
    <div class="wrap">
      <h2 id="sus-act" class="display sus__title">{c.act.title}</h2>
      <ul class="act__list" role="list">
        {
          act.map((it) => (
            <li>
              <a class="act__card" href={href(it.page, lang)} data-accent={it.s.tone}>
                <video
                  class="act__clip"
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"
                  tabindex="-1"
                  poster={`/media/film/${lang}/${it.page}-desk.jpg`}
                  data-src={`/media/film/${lang}/${it.page}-desk.mp4`}
                  data-clip
                />
                <span class="act__name">
                  {it.s.name[lang]} <span class="act__go" aria-hidden="true">{fwd}</span>
                </span>
                <span class="act__text">{it.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="act__offer">{c.act.offer}</p>
    </div>
  </section>

  <section class="close on-dark" data-dark aria-labelledby="sus-final">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap close__inner">
      <h2 id="sus-final" class="display">{c.close.title}</h2>
      <div class="close__actions">
        <a class="btn btn--line btn--lg" href={href('waste', lang)}>{c.close.waste}</a>
        <a class="btn btn--solid btn--lg" href={href('book', lang)} data-track="book_demo_click" data-track-from="sustainability-final">{d.cta.book}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* 1. The hero fills the screen under the header; the words sit in its lower third */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--s-5)) clamp(3rem, 12svh, 8rem);
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark);
  }

  .hero :global(.hero__photo),
  .hero :global(.hero__photo img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    filter: var(--photo-grade);
  }

  /* Light at the top so the photograph reads, deep behind the words */
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(var(--shade-rgb) / 0.45) 0%, rgb(var(--shade-rgb) / 0) 22%),
      linear-gradient(to top, rgb(var(--shade-rgb) / 0.9) 0%, rgb(var(--shade-rgb) / 0.72) 32%, rgb(var(--shade-rgb) / 0.12) 68%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* Rises into place once, fully visible throughout: it moves, it never fades */
  @media (prefers-reduced-motion: no-preference) {
    .hero__inner {
      animation: sus-rise 600ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }
  }

  @keyframes sus-rise {
    from {
      transform: translateY(18px);
    }
  }

  .hero h1 {
    max-width: 16ch;
    color: rgb(var(--on-dark-rgb));
    font-size: clamp(2.5rem, 1.7rem + 3.4vw, 4.75rem);
    line-height: 1.04;
    text-shadow: 0 1px 18px rgb(var(--night-rgb) / 0.5);
  }

  .hero__text {
    max-width: 34rem;
    margin: var(--s-3) 0 0;
    color: rgb(var(--on-dark-rgb) / 0.92);
    font-size: var(--fs-lead);
    line-height: 1.5;
    text-shadow: 0 1px 14px rgb(var(--night-rgb) / 0.5);
  }

  .sus__title {
    max-width: 30ch;
    margin: 0;
    font-size: var(--fs-h2);
  }

  .source {
    max-width: none;
    margin: 0;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  .source a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--sand-600);
    text-underline-offset: 3px;
  }

  .source a:hover {
    color: var(--ink);
  }

  /* 2. One sentence on a dark band, set like a headline. As it scrolls up the screen its words light up one by one;
     each figure counts up and is underlined in silver as it lights; at "one fifth" the last of five plates goes in
     the bin. [data-reveal] is set by the script only when motion is allowed, so without it everything simply shows. */
  .line {
    padding-block: var(--band-y);
    background: var(--night-1);
    color: rgb(var(--on-dark-rgb));
  }

  .line__text {
    max-width: 34ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.1rem + 2.2vw, 3.25rem);
    font-weight: 300;
    line-height: 1.22;
    text-wrap: pretty;
  }

  .line[data-reveal] .w {
    opacity: 0.26;
    transition: opacity 0.45s var(--ease);
  }

  .line[data-reveal] .w.is-on {
    opacity: 1;
  }

  .line__fig {
    position: relative;
    font-weight: 400;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
  }

  /* The silver line under a figure: drawn from the start edge as the figure lights */
  .line__fig::after {
    position: absolute;
    inset-inline: 0;
    bottom: -0.06em;
    height: 2px;
    background: linear-gradient(90deg, var(--silver-deep), var(--silver-light), var(--silver));
    transform-origin: left center;
    content: '';
  }

  :global([dir='rtl']) .line__fig::after {
    transform-origin: right center;
  }

  .line[data-reveal] .line__fig::after {
    transform: scaleX(0);
    transition: transform 0.7s cubic-bezier(0.23, 1, 0.32, 1) 0.1s;
  }

  .line[data-reveal] .line__fig.is-on::after {
    transform: scaleX(1);
  }

  /* The plates, seen from above: silver rims; the fifth turns to a dashed outline and drops, as if cleared away */
  .line__plates {
    display: block;
    width: clamp(15rem, 10rem + 18vw, 25rem);
    height: auto;
    margin-top: var(--s-4);
    overflow: visible;
    fill: none;
    stroke: var(--silver);
    stroke-width: 1.5;
  }

  .line__plates :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .plate .plate__well {
    stroke: rgb(var(--on-dark-rgb) / 0.35);
  }

  .plate--bin {
    stroke-dasharray: 3 5;
    opacity: 0.45;
    translate: 0 10px;
    transition:
      opacity 0.6s var(--ease),
      translate 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .line[data-reveal]:not(.is-fifth) .plate--bin {
    stroke-dasharray: none;
    opacity: 1;
    translate: 0 0;
  }

  .line__source {
    margin-top: var(--s-3);
    color: rgb(var(--on-dark-rgb) / 0.7);
  }

  .line__source a:hover {
    color: rgb(var(--on-dark-rgb));
  }

  .line__source a {
    text-decoration-color: rgb(var(--on-dark-rgb) / 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .plate--bin {
      transition: none;
    }
  }

  /* 4. What hotels got back: the waste cut on its own, then the return on their programs, three figures side by side */
  .back {
    padding-block: var(--band-y);
  }

  .back__sub {
    max-width: 46rem;
    margin: var(--s-2) 0 0;
    color: var(--ink);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .back__lead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem var(--s-4);
    margin-top: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--line);
  }

  .back__figure {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.8rem + 2vw, 3.75rem);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 300;
    line-height: 1;
  }

  .back__figure--lead {
    font-size: clamp(3.5rem, 2.2rem + 4.4vw, 6.5rem);
  }

  .back__text {
    margin: 0.5rem 0 0;
    color: var(--graphite);
    line-height: 1.45;
  }

  .back__lead .back__text {
    max-width: 26ch;
    margin: 0;
    font-size: var(--fs-lead);
  }

  .back__returns {
    margin-top: var(--s-4);
  }

  .back__label {
    margin: 0;
    color: var(--ink);
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .back__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .back__list .back__text {
    max-width: 24ch;
  }

  :global([dir='rtl']) .back__figure {
    text-align: right;
  }

  .back__source {
    margin-top: var(--s-4);
  }

  /* 6. Where Tyll helps: three cards with the solution pages' films */
  .act {
    padding-block: 0 var(--band-y);
  }

  .act__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .act__card {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding-bottom: var(--s-2);
    color: var(--ink);
    text-decoration: none;
  }

  .act__clip {
    width: 100%;
    aspect-ratio: 16 / 10;
    margin-bottom: 0.5rem;
    border: 1px solid var(--sand-300);
    border-radius: var(--radius-md);
    background: var(--page-deep);
    object-fit: cover;
    object-position: 0 0;
  }

  .act__name {
    color: var(--acc);
    font-weight: 600;
  }

  .act__go {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  .act__card:hover .act__go {
    transform: translateX(3px);
  }

  :global([dir='rtl']) .act__card:hover .act__go {
    transform: translateX(-3px);
  }

  .act__text {
    color: var(--graphite);
  }

  .act__offer {
    max-width: 60ch;
    margin: var(--s-4) 0 0;
    color: var(--ink);
  }

  /* 7. The dark close */
  .close {
    position: relative;
    overflow: hidden;
    padding-block: var(--band-y);
    background: var(--night-1);
    color: var(--text-1);
  }

  .close__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .close h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem);
  }

  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    justify-content: center;
  }

  @media (max-width: 900px) {
    .act__list {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Phones and tablets: the waste cut full width, then the three returns stacked */
    .back__list {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }
  }

  @media (max-width: 600px) {
    .close__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .act__go {
      transition: none;
    }
  }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NUM = /\d+(?:[.,]\d+)?/g;

  // 2. The sentence lights up word by word as it moves up the screen (from when its top is near the bottom of the
  //    screen until its end is a little below the middle). Lit words stay lit. A figure counts up once, when it lights;
  //    only its aria-hidden copy changes, keeping decimals and separator (1.05, 1,05). At the second figure ("one
  //    fifth") the fifth plate goes in the bin. A reader who lands with the line already passed sees it all at once.
  const line = document.querySelector<HTMLElement>('[data-line]');
  if (line && !still) {
    const text = line.querySelector<HTMLElement>('.line__text')!;
    const words = [...line.querySelectorAll<HTMLElement>('.w')];
    const count = (el: HTMLElement) => {
      const final = el.textContent ?? '';
      if (!/\d/.test(final)) return;
      const start = performance.now();
      const step = (now: number) => {
        const k = Math.min((now - start) / 900, 1);
        const e = 1 - Math.pow(1 - k, 3);
        el.textContent = final.replace(NUM, (m) => {
          const sep = m.includes(',') ? ',' : '.';
          const dec = (m.split(/[.,]/)[1] ?? '').length;
          return (parseFloat(m.replace(',', '.')) * e).toFixed(dec).replace('.', sep);
        });
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    let lit = 0;
    const light = (n: number, animate: boolean) => {
      for (; lit < n; lit++) {
        const w = words[lit];
        w.classList.add('is-on');
        if (w.dataset.fig !== undefined) {
          if (animate) count(w.querySelector<HTMLElement>('[data-count]')!);
          if (Number(w.dataset.fig) >= 1) line.classList.add('is-fifth');
        }
      }
    };
    const progress = () => {
      const r = text.getBoundingClientRect();
      const vh = innerHeight;
      return Math.min(Math.max((vh * 0.88 - r.top) / (vh * 0.88 - vh * 0.5 + r.height), 0), 1);
    };
    const p0 = progress();
    if (p0 < 1) {
      line.dataset.reveal = '';
      light(Math.round(p0 * words.length), false);
      let queued = false;
      const tick = () => {
        queued = false;
        light(Math.round(progress() * words.length), true);
        if (lit >= words.length) removeEventListener('scroll', onScroll);
      };
      const onScroll = () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(tick);
        }
      };
      addEventListener('scroll', onScroll, { passive: true });
    } else line.classList.add('is-fifth');
  } else line?.classList.add('is-fifth');

  // 6. Each card's film loads only when it comes into view, and pauses when it leaves. Reduced motion keeps the poster.
  const clips = [...document.querySelectorAll<HTMLVideoElement>('[data-clip]')];
  if (clips.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (!v.src && v.dataset.src) v.src = v.dataset.src;
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.35 },
    );
    clips.forEach((v) => io.observe(v));
  }
</script>
