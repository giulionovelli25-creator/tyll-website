---
// The homepage's closing section, as calm and dark as the opening: the free purchasing report request, which the
// hero's "Get your free report" button scrolls to (#report).
import Logo from '../Logo.astro';
import ReportForm from './ReportForm.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.report;

// The silver wave: one ribbon of fine lines that moves as a single formation, like a slow ocean swell or silver
// fabric. Every line follows the same shape and the same travelling motion; the lines are only offset from each
// other, like threads in one ribbon. The shape dips beneath the buttons and rises in a long arc to the right (a
// quiet echo of the Tyll check). The motion repeats every 16 seconds, so the loop never restarts visibly.
// The first frame is drawn here for visitors without JavaScript or with reduced motion; the script animates it.
import { ribbon } from '../../scripts/wave';

const frame = ribbon(0);
---

<section class="invite on-dark" id="report" data-dark aria-labelledby="invite-title">
  <div class="invite__light" aria-hidden="true"></div>
  <svg class="invite__waves" viewBox="0 0 1440 800" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="invite-silver" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#c8cdd4" stop-opacity="0" />
        <stop offset="0.22" stop-color="#c8cdd4" stop-opacity="0.35" />
        <stop offset="0.42" stop-color="#eef0f3" stop-opacity="0.85" />
        <stop offset="0.7" stop-color="#a3a9b2" stop-opacity="0.45" />
        <stop offset="1" stop-color="#c8cdd4" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g fill="none" stroke="url(#invite-silver)" stroke-width="1">
      {frame.map((l) => <path d={l.d} opacity={l.opacity} vector-effect="non-scaling-stroke" />)}
    </g>
  </svg>
  <div class="wrap invite__inner">
    <div class="invite__main">
      <Logo mark anim="draw" label="" class="invite__mark" />
      <h2 id="invite-title">{v.title}</h2>
      <p>{v.text}</p>
      <div class="invite__form">
        <ReportForm lang={lang} />
      </div>
    </div>

    <!-- What the visitor gets: an example of the report itself (fictional data) -->
    <figure class="sample" aria-label={v.sample.title}>
      <figcaption class="sample__head">
        <span class="sample__title">{v.sample.title}</span>
        <span class="sample__tag">{v.sample.tag}</span>
      </figcaption>
      <table>
        <thead>
          <tr>{v.sample.head.map((h) => <th scope="col">{h}</th>)}</tr>
        </thead>
        <tbody>
          {
            v.sample.rows.map(([name, week, stock, buy]) => (
              <tr>
                <td>{name}</td>
                <td>{week}</td>
                <td>{stock}</td>
                <td class:list={['sample__buy', buy === 0 && 'is-none']}>{buy === 0 ? '–' : buy}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="sample__flag">{v.sample.missing}</p>
    </figure>
  </div>
</section>

<style>
  .invite {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: clamp(6rem, 4rem + 8vw, 11rem);
    background: var(--ink);
    color: var(--on-dark);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* A soft pool of light behind the headline */
  .invite__light {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(45% 55% at 50% 42%, rgba(200, 205, 212, 0.13), transparent 70%),
      radial-gradient(80% 60% at 50% 120%, rgba(146, 153, 163, 0.12), transparent 70%);
    pointer-events: none;
  }

  /* The Tyll silver wave, flowing slowly. Its brightest lines pass beneath the buttons; around the paragraph
     the lines fade almost away so the text stays easy to read. */
  .invite__waves {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0.85;
    -webkit-mask-image:
      radial-gradient(34% 9% at 50% 59%, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.18) 55%, #000 100%),
      linear-gradient(0deg, #000 55%, transparent 92%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(34% 9% at 50% 59%, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.18) 55%, #000 100%),
      linear-gradient(0deg, #000 55%, transparent 92%);
    mask-composite: intersect;
    pointer-events: none;
  }

  .invite__inner {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
    text-align: start;
  }

  .invite :global(.invite__mark) {
    width: 40px;
    height: auto;
    margin-bottom: 1.5rem;
    color: var(--on-dark);
  }

  .invite h2 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.75rem);
    letter-spacing: -0.04em;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .invite__main > p {
    max-width: 32rem;
    margin-top: 1.25rem;
    color: rgba(244, 245, 247, 0.82);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .invite__form {
    width: 100%;
    margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }

  /* The example report: a sheet of paper resting on the dark, slightly turned */
  .sample {
    margin: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--radius-lg);
    background: #fff;
    color: var(--ink);
    box-shadow:
      0 2px 6px rgba(0, 0, 0, 0.2),
      0 50px 90px -40px rgba(0, 0, 0, 0.8);
    transform: rotate(1.2deg);
  }

  :global([dir='rtl']) .sample {
    transform: rotate(-1.2deg);
  }

  .sample__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .sample__title {
    font-size: 1.0625rem;
    font-weight: 550;
    letter-spacing: -0.015em;
  }

  .sample__tag {
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    color: var(--steel);
    font-size: 0.75rem;
  }

  .sample table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .sample th {
    padding: 0.5rem 0.4rem 0.5rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--steel);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.25;
    text-align: end;
    vertical-align: bottom;
  }

  .sample td {
    padding: 0.62rem 0.4rem 0.62rem 0;
    border-bottom: 1px solid var(--mist);
    color: var(--graphite);
    text-align: end;
  }

  .sample th:first-child,
  .sample td:first-child {
    color: var(--ink);
    text-align: start;
  }

  .sample th:first-child {
    color: var(--steel);
  }

  .sample th:last-child,
  .sample td:last-child {
    padding-inline-end: 0;
  }

  .sample__buy {
    color: var(--ink) !important;
    font-weight: 650;
  }

  .sample__buy.is-none {
    color: var(--fog) !important;
    font-weight: 400;
  }

  .sample__flag {
    margin: 0.9rem 0 0;
    padding: 0.55rem 0.8rem;
    border: 1px solid #f1dfb8;
    border-radius: 10px;
    background: #fbf1dc;
    color: #7a5310;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .invite__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .sample,
    :global([dir='rtl']) .sample {
      transform: none;
    }
  }
</style>

<script>
  import { ribbon, PERIOD } from '../../scripts/wave';

  // Redraw the ribbon about 30 times a second, only while it is on screen and only when motion is welcome
  const svg = document.querySelector<SVGSVGElement>('.invite__waves');
  if (svg) {
    const paths = [...svg.querySelectorAll('path')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let raf = 0;
    let last = 0;
    let t = 0;
    const draw = (now: number) => {
      raf = requestAnimationFrame(draw);
      if (now - last < 33) return;
      t = (t + Math.min(now - last, 100) / 1000) % PERIOD;
      last = now;
      ribbon(t / PERIOD).forEach((l, i) => paths[i]?.setAttribute('d', l.d));
    };
    const sync = () => {
      cancelAnimationFrame(raf);
      if (visible && !reduce.matches) {
        last = performance.now();
        raf = requestAnimationFrame(draw);
      }
    };
    new IntersectionObserver(([e]) => ((visible = e.isIntersecting), sync())).observe(svg);
    reduce.addEventListener('change', sync);
  }
</script>
