      bottom: calc(var(--pad) + var(--node) / 2);
      inset-inline: calc(1.25rem + var(--node) / 2 - 1px) auto;
      width: 2px;
      height: auto;
      transform-origin: center top;
    }

    :global([dir='rtl']) .flow::before {
