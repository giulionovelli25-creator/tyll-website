    }

    .flow__step {
      grid-template-columns: var(--node) minmax(0, 1fr);
      justify-items: start;
      align-items: center;
      gap: 1rem;
      padding: 0;
      text-align: start;
    }
  }

  /* 3. The bigger picture: three figures side by side under hairlines, stacked on phones */
  .world {
    padding-block: var(--section);
    background: var(--night-1);
    color: var(--on-dark);
  }

  .facts {
