---
// The Sustainability page, to the owner's design canvas (26 Nov 2026) and its second, exact brief (27 Nov 2026),
// reworked the same evening at the owner's request (no calculator or year buttons, no paragraph of figures, more motion):
// 1. Hero on the forest night: a mono label, the headline on two lines, one line, See what waste costs you and Book a
//    demo, the tree on the other side sitting on the hero's bottom edge, the site's wave in light green along the bottom.
// 2. White: the greenest kilo is the one you never buy; three solution pages, each with a line drawing standing on its
//    column's rule; the chain from buying less to lower costs as four joined steps on the pale green wash.
// 3. Night: the bigger picture as three figures (UNEP), each with a drawing (a globe, five leaves with one dashed, a
//    cloud), counting up as they arrive.
// 4. Pale green wash: what cutting waste paid back in 42 hotels (WRI and WRAP), four figures on one white board, each
//    with its drawing (the split bar, the leaves, the leaves again, the spent and got back bars). Where the board fits
//    the screen it holds still while the scroll brings each figure in turn (sticky, never scroll-jacking); elsewhere,
//    and without JavaScript, the four stand one under another.
// 5. The forest night close with the wave. The footer is night here too (this page only; the footer itself is shared).
// Motion: the hero rises in on load and the tree fades in (CSS); below it parts rise in once on scroll, the drawings
// draw themselves, the chain's steps arrive in order and figures count up, each within about a second. None of it under
// reduced motion. Copy, figures and sources: src/content/sustainability.ts. No figure on this page is a Tyll result.
import Base from '../../layouts/Base.astro';
import SilverWave from '../SilverWave.astro';
import Tree from '../SustainabilityTree.astro';
import { sustainability } from '../../content/sustainability';
import { solutions } from '../../content/solutions';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const c = sustainability[lang];
const b = c.back;
const tab = d.cta.newTab;
// "Book a demo" without its arrow, for the hero's outline button
const bookPlain = d.cta.book.replace(/\s*[→←]\s*$/, '');
// The headline holds two lines (one sentence each) on tablets and desktops in every language: its size is capped by
// the column's width divided by the longer sentence's length in ems (about 0.46 em a letter, 0.4 in Arabic)
const h1Fit = Math.max(...c.hero.title.map((line) => line.length)) * (lang === 'ar' ? 0.4 : 0.46);
// One leaf, drawn on a 24 x 24 grid, for the five leaves and the payback leaves
const leaf = 'M4 20C4 10 10 4 20 4c0 10-6 16-16 16z';
// A circle or ellipse as a path, so that every line of a drawing can draw itself (pathLength 1)
const ring = (cx: number, cy: number, r: number, ry = r) => `M${cx - r} ${cy}a${r} ${ry} 0 1 0 ${2 * r} 0a${r} ${ry} 0 1 0 ${-2 * r} 0`;
// The drawings, in one line style: `ink` is an outline with a pale fill, `line` a plain line, `thin` a lighter detail
type Stroke = [kind: 'ink' | 'line' | 'thin', d: string];
// The three tools (120 x 96, standing on y 95): a bin with a broken plate going in and a phone tapped twice; a jar
// with a date tag and a clock; a crate of produce under a rising line
const toolArt: Record<'waste' | 'expiry' | 'forecasting', Stroke[]> = {
  waste: [
    ['ink', 'M28 50H68L64 95H32Z'],
    ['ink', 'M24 44H72V50H24Z'],
    ['line', 'M42 44V40H54V44'],
    ['thin', 'M40 58V88M48 58V88M56 58V88'],
    ['ink', 'M36 26L46 22L50 30L41 33Z'],
    ['ink', 'M53 19L61 23L56 30Z'],
    ['thin', 'M43 11V17M58 8V13'],
    ['ink', 'M88 52H112A3 3 0 0 1 115 55V92A3 3 0 0 1 112 95H88A3 3 0 0 1 85 92V55A3 3 0 0 1 88 52Z'],
    ['thin', 'M90 60H110M90 66H103'],
    ['line', ring(100, 81, 3)],
    ['thin', ring(100, 81, 7)],
  ],
  expiry: [
    ['ink', 'M38 30H74V40H38Z'],
    ['thin', 'M38 35H74'],
    ['ink', 'M34 46Q34 40 40 40H72Q78 40 78 46V90Q78 95 72 95H40Q34 95 34 90Z'],
    ['thin', 'M34 60H78M34 78H78'],
    ['thin', 'M74 35Q86 36 88 46'],
    ['ink', 'M82 46H104V61H82Z'],
    ['thin', 'M88 51H100M88 56H96'],
    ['ink', ring(104, 84, 10)],
    ['line', 'M104 84V78M104 84L108 87'],
  ],
  forecasting: [
    ['ink', ring(41, 62, 6)],
    ['ink', ring(53, 60, 7)],
    ['ink', ring(66, 62, 6)],
    ['ink', ring(78, 61, 6)],
    ['ink', 'M30 66H90V95H30Z'],
    ['thin', 'M30 76H90M30 86H90'],
    ['line', 'M28 44L46 36L60 40L84 18'],
    ['line', 'M77 18H84V25'],
    ['ink', ring(46, 36, 2)],
    ['ink', ring(60, 40, 2)],
  ],
};
// The bigger picture (72 x 64): a globe for the tonnes, a cloud over rising lines for the emissions
const worldArt: Record<'globe' | 'cloud', Stroke[]> = {
  globe: [
    ['ink', ring(36, 32, 24)],
    ['thin', ring(36, 32, 24, 8)],
    ['thin', ring(36, 32, 10, 24)],
    ['thin', 'M15 20Q36 27 57 20M15 44Q36 37 57 44'],
  ],
  cloud: [
    ['ink', 'M20 36H52A9 9 0 0 0 53 18A13 13 0 0 0 28 15A10.5 10.5 0 0 0 20 36Z'],
    ['thin', 'M27 60Q30 55 27 50Q24 45 27 41M36 62Q39 57 36 52Q33 47 36 42M45 60Q48 55 45 50Q42 45 45 41'],
  ],
};
// The chain's four steps (24 x 24): a basket, a bin, a cloud, a stack of coins
const flowArt = [
  'M4 10H20L18 19.5A1 1 0 0 1 17 20H7A1 1 0 0 1 6 19.5ZM8 10L11 4M16 10L13 4M10 13.5V16.5M14 13.5V16.5',
  'M5 7H19M9.5 7V4.5H14.5V7M6.5 7L7.5 20H16.5L17.5 7M10.5 11V16M13.5 11V16',
  'M7 19H16.5A4 4 0 0 0 17.1 11.05A6 6 0 0 0 5.5 12.5A3.3 3.3 0 0 0 7 19Z',
  'M5 8C5 6.6 8.1 5.5 12 5.5S19 6.6 19 8S15.9 10.5 12 10.5S5 9.4 5 8ZM5 8V12C5 13.4 8.1 14.5 12 14.5S19 13.4 19 12V8M5 12V16C5 17.4 8.1 18.5 12 18.5S19 17.4 19 16V12',
];
---

<Base lang={lang} page="sustainability" title={c.metaTitle} description={c.metaDescription} overHero>
  <div class="sus" data-sus>
    <section class="hero on-dark" data-dark aria-labelledby="sus-title">
      <SilverWave phase={0.2} move stroke="var(--sage-mist)" opacity={0.45} />
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="label rise" style="--i:0">{c.hero.label}</p>
          <h1 id="sus-title" class="display rise" style={`--i:1;--h1-fit:${h1Fit.toFixed(2)}`}><span>{c.hero.title[0]}</span> <span>{c.hero.title[1]}</span></h1>
          <p class="hero__text rise" style="--i:2">{c.hero.text}</p>
          <div class="actions rise" style="--i:3">
            <a class="btn btn--solid btn--lg" href={href('waste', lang)}>{c.hero.cta}</a>
            <a class="btn btn--line btn--lg" href={href('book', lang)} data-track="book_demo_click" data-track-from="sustainability-hero">{bookPlain}</a>
          </div>
        </div>
        <div class="hero__tree">
          <Tree />
        </div>
      </div>
    </section>

    <!-- How Tyll makes a hotel more sustainable: three solution pages, each with its drawing standing on the column's
         rule, then the chain from buying less to lower costs as four joined steps -->
    <section class="less" aria-labelledby="sus-less">
      <div class="wrap">
        <div class="head">
          <h2 id="sus-less" class="display h2">{c.less.title}</h2>
          <p class="head__text">{c.less.text}</p>
        </div>
        <ul class="cols" role="list">
          {
            c.less.items.map((it, i) => (
              <li class="col reveal" style={`--i:${i}`}>
                <div class="col__art" aria-hidden="true">
                  <svg class="art" viewBox="0 0 120 96" focusable="false">
                    {toolArt[it.page].map(([kind, path], n) => (
                      <path class={kind} d={path} pathLength="1" style={`--n:${n}`} />
                    ))}
                  </svg>
                </div>
                <a class="col__link" href={href(it.page, lang)}>
                  {solutions[it.page].name[lang]} <span class="flip-rtl" aria-hidden="true">→</span>
                </a>
                <p class="col__text">{it.text}</p>
              </li>
            ))
          }
        </ul>
        <ol class="flow reveal" aria-label={c.less.chainLabel}>
          {
            c.less.chain.map((step, i) => (
              <li class="flow__step" style={`--i:${i}`}>
                <span class="flow__node" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d={flowArt[i]} />
                  </svg>
                </span>
                <span class="flow__label">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- The bigger picture: UNEP's three figures, each with its drawing, counting up as they arrive -->
    <section class="world on-dark" data-dark aria-labelledby="sus-world">
      <div class="wrap">
        <h2 id="sus-world" class="label">{c.world.label}</h2>
        <ul class="facts" role="list">
          {
            c.world.facts.map((f, i) => (
              <li class="fact reveal" style={`--i:${i}`}>
                <div class="fact__art" aria-hidden="true">
                  {i === 1 ? (
                    <div class="leaves">
                      {[0, 1, 2, 3, 4].map((k) => (
                        <svg class:list={['leaf', k === 4 && 'leaf--out']} style={`--k:${k}`} viewBox="0 0 24 24" aria-hidden="true">
                          <path d={leaf} />
                          {k < 4 && <path class="leaf__vein" d="M4 20L14 10" />}
                        </svg>
                      ))}
                    </div>
                  ) : (
                    <svg class="art" viewBox="0 0 72 64" focusable="false">
                      {worldArt[i === 0 ? 'globe' : 'cloud'].map(([kind, path], n) => (
                        <path class={kind} d={path} pathLength="1" style={`--n:${n}`} />
                      ))}
                    </svg>
                  )}
                </div>
                <p class="fact__big">
                  <span class="visually-hidden">{f.unit ? `${f.big} ${f.unit}` : f.big}</span>
                  <span aria-hidden="true"><span data-count>{f.big}</span>{f.unit && <span class="fact__unit"> {f.unit}</span>}</span>
                </p>
                <p class="fact__text">{f.text}</p>
              </li>
            ))
          }
        </ul>
        <div class="world__foot">
          <a class="world__source" href={c.world.source.url} target="_blank" rel="noopener">
            {c.world.source.name}<span class="visually-hidden"> {tab}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- What hotels got back: industry research, never Tyll's. Four figures on one board; on screens tall enough the
         board holds still while the page's scroll brings each figure in turn, with its drawing -->
    <section class="back" aria-labelledby="sus-back" data-back>
      <div class="back__track">
        <div class="back__stage">
          <div class="wrap back__inner">
            <div class="head head--back">
              <h2 id="sus-back" class="display h2">{b.title}</h2>
              <p class="head__text">{b.sub}</p>
            </div>
            <div class="board">
              <ol class="stats" role="list">
                <li class="stat" data-stat>
                  <div class="stat__copy">
                    <h3 class="label label--card">{b.cut.label}</h3>
                    <p class="stat__big">
                      <span class="visually-hidden">{b.cut.figure}</span><span aria-hidden="true" dir="ltr" data-count>{b.cut.figure}</span>
                    </p>
                    <p class="stat__text">{b.cut.text}</p>
                  </div>
                  <div class="stat__art">
                    <div class="split">
                      <div class="split__bar" role="img" aria-label={b.cut.bar}>
                        <span class="split__still"></span>
                        <span class="split__cut"></span>
                      </div>
                      <p class="split__legend" aria-hidden="true"><span>{b.cut.still}</span><span class="split__word">{b.cut.cut}</span></p>
                    </div>
                  </div>
                </li>
                {
                  [b.one, b.two].map((y, i) => (
                    <li class="stat" data-stat>
                      <div class="stat__copy">
                        <h3 class="label label--card">{y.label}</h3>
                        <p class="stat__big">
                          <span class="visually-hidden">{y.figure}</span><span aria-hidden="true" dir="ltr" data-count>{y.figure}</span>
                        </p>
                        <p class="stat__text">{y.text}</p>
                      </div>
                      <div class="stat__art">
                        <div class="dots" role="img" aria-label={y.leaves}>
                          {Array.from({ length: 20 }, (_, k) => k).map((k) => {
                            const on = k < (i === 0 ? 14 : 19);
                            const was = i === 1 && k < 14;
                            return (
                              <svg class:list={['dot', on && 'dot--on', on && !was && 'dot--new']} style={`--n:${was ? 0 : i === 0 ? k : k - 14}`} viewBox="0 0 24 24" aria-hidden="true">
                                <path d={leaf} />
                              </svg>
                            );
                          })}
                        </div>
                      </div>
                    </li>
                  ))
                }
                <li class="stat" data-stat>
                  <div class="stat__copy">
                    <h3 class="label label--card">{b.three.label}</h3>
                    <p class="stat__big">
                      <span class="visually-hidden">{b.three.figure}</span><span aria-hidden="true" dir="ltr" data-count>{b.three.figure}</span>
                    </p>
                    <p class="stat__text">{b.three.text}</p>
                  </div>
                  <div class="stat__art">
                    <div class="ratio">
                      <div class="ratio__row">
                        <span class="ratio__label">{b.three.spent}</span>
                        <span class="ratio__track"><span class="ratio__bar ratio__bar--spent"></span></span>
                        <span class="ratio__val" dir="ltr">1</span>
                      </div>
                      <div class="ratio__row">
                        <span class="ratio__label">{b.three.got}</span>
                        <span class="ratio__track"><span class="ratio__bar ratio__bar--got"></span></span>
                        <span class="ratio__val ratio__val--got" dir="ltr">~7</span>
                      </div>
                    </div>
                  </div>
                </li>
              </ol>
              <div class="board__foot">
                <ol class="steps" aria-hidden="true">
                  {
                    b.steps.map((s) => (
                      <li>
                        <span class="steps__bar"></span>
                        {s}
                      </li>
                    ))
                  }
                </ol>
                <a class="back__source" href={b.source.url} target="_blank" rel="noopener">
                  {b.source.name}<span class="visually-hidden"> {tab}</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="close on-dark" data-dark aria-labelledby="sus-final">
      <SilverWave phase={0.4} move stroke="var(--sage-light)" opacity={0.8} />
      <div class="wrap close__inner">
        <svg class="close__sprout" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 36V24" />
          <path d="M20 27c-6 0-9-4-9-9 6 0 9 3 9 9z" />
          <path d="M20 25c0-6 4-9 9-9 0 5-3 9-9 9z" />
        </svg>
        <h2 id="sus-final" class="display h2">{c.close.title}</h2>
        <p class="close__text">{c.close.text}</p>
        <div class="actions actions--center">
          <a class="btn btn--solid btn--lg" href={href('waste', lang)}>{c.close.waste}</a>
          <a class="btn btn--line btn--lg" href={href('book', lang)} data-track="book_demo_click" data-track-from="sustainability-final">{d.cta.book}</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .sus {
    --rise: cubic-bezier(0.22, 1, 0.36, 1);
    --section: clamp(4rem, 8vw, 7.5rem);
    --dark-muted: rgb(var(--on-dark-rgb) / 0.74);
  }

  /* Small labels: IBM Plex Mono in capitals (Arabic has no capitals and Plex has no Arabic, so plain body type there) */
  .label {
    margin: 0;
    color: var(--steel);
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .on-dark .label {
    color: var(--sage);
  }

  :global([dir='rtl']) .label {
    font-family: var(--font);
    font-size: 0.9375rem;
    letter-spacing: 0;
  }

  .h2 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 300;
    line-height: 1.12;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }

  .actions--center {
    justify-content: center;
  }

  /* outline buttons on dark: a quieter border than the site's default */
  .on-dark .actions :global(.btn--line) {
    border-color: rgb(var(--on-dark-rgb) / 0.32);
  }

  /* 1. The hero */
  /* the hero fills the first screen exactly (the header lies over it): the words in the middle of what is left, the tree
     on its bottom edge */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow: hidden;
    padding-top: calc(var(--header-h) + var(--section));
    background: var(--forest-night);
    color: var(--on-dark);
  }

  /* the words get the wider column, so each sentence of the headline holds one line */
  .hero__grid {
    position: relative;
    z-index: 1;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: end;
  }

  .hero__copy {
    align-self: center;
    container-type: inline-size;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    padding-bottom: var(--section);
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.625rem, 5vw, 4.5rem);
    font-weight: 300;
    line-height: 1.04;
  }

  .hero h1 span {
    display: block;
  }

  @media (min-width: 600px) {
    .hero h1 {
      font-size: min(clamp(2.625rem, 5vw, 4.5rem), calc(100cqi / var(--h1-fit)));
    }

    .hero h1 span {
      white-space: nowrap;
    }
  }

  .hero__text {
    max-width: 29rem;
    margin: 0;
    color: var(--dark-muted);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .hero__tree {
    justify-self: center;
    width: 100%;
    max-width: 520px;
    animation: fade 1.2s var(--rise) both;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      align-content: space-between;
      gap: 1rem;
    }

    .hero__copy {
      align-self: start;
      padding-bottom: 0;
    }

    .hero__tree {
      max-width: 380px;
    }
  }

  /* 2. The greenest kilo */
  .less {
    padding-block: var(--section);
    background: var(--paper);
    color: var(--ink);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .head h2 {
    max-width: 38rem;
  }

  .head__text {
    max-width: 26rem;
    margin: 0;
    color: var(--steel);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .col {
    display: grid;
    align-content: start;
  }

  /* each tool's drawing stands on its column's rule, as the About page's skyline stands on its line */
  .col__art {
    display: flex;
    align-items: flex-end;
    height: 8.5rem;
    border-bottom: 1px solid var(--ink);
  }

  .col__art svg {
    width: auto;
    height: 7.5rem;
    overflow: visible;
  }

  .col__link {
    justify-self: start;
    display: inline-flex;
    gap: 0.35em;
    align-items: center;
    min-height: 44px;
    margin-top: 1rem;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }

  /* (the arrow is a box of its own, so the global flip for Arabic can turn it) */
  .col__link .flip-rtl {
    display: inline-block;
    transition: translate 0.25s var(--rise);
  }

  .col__link:hover {
    color: var(--teal-hover);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .col__link:hover .flip-rtl {
    translate: 4px 0;
  }

  :global([dir='rtl']) .col__link:hover .flip-rtl {
    translate: -4px 0;
  }

  .col__text {
    margin: 0.25rem 0 0;
    color: var(--steel);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.75rem;
    }
  }

  /* The drawings: one line, teal on the light sections and sage on the night, with a pale fill. They draw themselves
     once as they come into view (pathLength 1, so one dash is the whole line). */
  .art path {
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .art .ink {
    fill: var(--demo-teal-wash);
    stroke: var(--demo-teal);
    stroke-width: 1.5;
  }

  .art .line {
    fill: none;
    stroke: var(--demo-teal);
    stroke-width: 1.5;
  }

  .art .thin {
    fill: none;
    stroke: var(--demo-teal);
    stroke-opacity: 0.5;
    stroke-width: 1;
  }

  .on-dark .art .ink {
    fill: color-mix(in srgb, var(--sage) 14%, transparent);
    stroke: var(--sage);
  }

  .on-dark .art .line,
  .on-dark .art .thin {
    stroke: var(--sage);
  }

  /* The chain: four steps joined by one line, the last one filled. The line draws itself and the steps arrive one
     after another, all within about a second. A column on phones. */
  .flow {
    --node: 56px;
    --pad: 2rem;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(3rem, 2.5rem + 2vw, 4.5rem) 0 0;
    padding: var(--pad) 0;
    border-radius: var(--radius-lg);
    background: var(--demo-teal-wash);
    list-style: none;
  }

  .flow::before {
    position: absolute;
    top: calc(var(--pad) + var(--node) / 2 - 1px);
    inset-inline: 12.5%;
    height: 2px;
    background: var(--demo-teal);
    opacity: 0.35;
    content: '';
    transform-origin: left center;
