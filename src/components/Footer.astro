---
import Logo from './Logo.astro';
import { site } from '../config/site';
import { solutions } from '../content/solutions';
import { t, href, pages, locales, solutionKeys, type Locale, type PageKey } from '../i18n';

interface Props {
  lang: Locale;
  page: PageKey;
}

const { lang, page } = Astro.props;
const d = t(lang);
const home = href('home', lang);
const year = new Date().getFullYear();
// "Book a Demo →": the arrow is set apart so it can move on hover
const [, bookText = d.cta.book, bookArrow = ''] = d.cta.book.match(/^(.*?)\s*([→←])$/) ?? [];
// The tagline breaks only between its sentences
const taglineParts = d.footer.tagline.split(/(?<=\.)\s+/);
---

<footer class="footer on-dark" data-dark>
  <div class="wrap footer__top">
    <div class="footer__brand">
      <a href={home} class="footer__logo" aria-label="Tyll – home">
        <Logo anim="loop" label="Tyll" />
      </a>
      <p>{taglineParts.map((part, i) => <><span class="footer__phrase">{part}</span>{i < taglineParts.length - 1 && ' '}</>)}</p>
      {
        site.social.linkedin && (
          <a class="footer__social" href={site.social.linkedin} target="_blank" rel="noopener" data-track="linkedin_click">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            {d.footer.linkedin}
            <span class="visually-hidden"> {d.cta.newTab}</span>
          </a>
        )
      }
    </div>

    <nav class="footer__cols" aria-label="Footer">
      <div>
        <h2>{d.footer.solutions}</h2>
        <ul>
          {solutionKeys.map((k) => <li><a href={href(k, lang)}>{solutions[k].name[lang]}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>{d.footer.contact}</h2>
        <ul>
          <li>
            <a class="footer__book" href={href('book', lang)} data-track="book_call_click" data-track-from="footer">
              <span class="footer__book-text">{bookText}</span>{bookArrow && <span class="footer__arrow" aria-hidden="true">{bookArrow}</span>}
            </a>
          </li>
          {
            site.demoUrl && (
              <li>
                <a href={site.demoUrl} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from="footer">
                  {d.cta.demo}<span class="visually-hidden"> {d.cta.newTab}</span>
                </a>
              </li>
            )
          }
          <li><a href={href('faq', lang)}>{d.nav.faqShort}</a></li>
          <li><a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a></li>
          {site.social.instagram && <li><a href={site.social.instagram} rel="noopener" target="_blank">Instagram<span class="visually-hidden"> {d.cta.newTab}</span></a></li>}
        </ul>
      </div>
      <div>
        <h2>{d.footer.company}</h2>
        <ul>
          <li><a href={href('legal', lang)}>{d.footer.legal}</a></li>
          <li><a href={href('privacy', lang)}>{d.footer.privacy}</a></li>
          <li><button type="button" class="footer__linkbtn" data-consent-open>{d.footer.cookies}</button></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="wrap footer__base">
    <p>© {year} {d.footer.rights}. {d.footer.demoNote}</p>
    <div class="footer__lang" role="group" aria-label={d.nav.language}>
      {
        locales.map((l) => (
          <a href={pages[page][l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} data-track="language_changed" data-track-to={l}>
            {t(l).langName}
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(244, 245, 247, 0.1);
    background: var(--ink);
    color: var(--on-dark);
    /* While the cookie banner is showing, the footer gets room so nothing sits under the banner */
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) calc(2rem + var(--consent-space, 0px));
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer__logo {
    display: inline-block;
    border-radius: 6px;
  }

  .footer__logo :global(.logo) {
    height: 34px;
    width: auto;
  }

  .footer__brand p {
    margin-top: 1.25rem;
    max-width: 28ch;
    color: var(--on-dark-muted);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .footer__phrase {
    white-space: nowrap;
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer h2 {
    margin-bottom: 1rem;
    color: var(--fog);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .footer ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    color: var(--on-dark);
    font-size: 0.9375rem;
    text-decoration: none;
    opacity: 0.86;
  }

  .footer__linkbtn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--on-dark);
    font: inherit;
    font-size: 0.9375rem;
    text-align: start;
    opacity: 0.86;
    cursor: pointer;
  }

  .footer__linkbtn:hover,
  .footer a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* The one call to action in the footer: full white, a little heavier, its arrow moving on hover */
  .footer a.footer__book {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-weight: 500;
    opacity: 1;
  }

  /* Only the words are underlined on hover, so the arrow moves cleanly */
  .footer a.footer__book:hover {
    text-decoration: none;
  }

  .footer__book:hover .footer__book-text {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer__arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }

  .footer__book:hover .footer__arrow,
  .footer__book:focus-visible .footer__arrow {
    transform: translateX(4px);
  }

  :global([dir='rtl']) .footer__book:hover .footer__arrow,
  :global([dir='rtl']) .footer__book:focus-visible .footer__arrow {
    transform: translateX(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__arrow {
      transition: none;
    }
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(244, 245, 247, 0.12);
    color: var(--fog);
    font-size: var(--fs-small);
  }

  .footer__lang {
    display: flex;
    gap: 1.25rem;
  }

  .footer__lang a {
    font-size: var(--fs-small);
  }

  .footer__lang a[hreflang='ar'] {
    font-family: 'Tyll Arabic Label', 'Tyll Arabic', var(--font);
    letter-spacing: 0;
  }

  .footer__lang a:not([aria-current]) {
    opacity: 0.6;
  }

  @media (max-width: 820px) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
