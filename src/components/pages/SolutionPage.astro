---
// A solution page tells one operational story:
//   1. Opening: the photograph of where it happens, the headline and the demo/booking buttons.
//   2. Context (warm ivory): the problem in one sentence, how Tyll helps in three short lines, and a second
//      photograph that bleeds to the edge; the side alternates from page to page.
//   3. The product (charcoal or light stone): one real demo screen, large, explored part by part.
//   4. The outcome and the next step, then the other five solutions as photographs.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SolutionIcon from '../SolutionIcon.astro';
import ProductExplorer from '../ProductExplorer.astro';
import { solutions } from '../../content/solutions';
import { explore } from '../../content/explore';
import { demoLink } from '../../config/demo';
import { t, href, solutionKeys, type Locale, type SolutionKey } from '../../i18n';

interface Props {
  lang: Locale;
  solution: SolutionKey;
}

const { lang, solution } = Astro.props;
const d = t(lang);
const p = d.solutionPage;
const s = solutions[solution];
const ex = explore[solution];
const name = s.name[lang];
const demo = demoLink(solution);
const others = solutionKeys.filter((k) => k !== solution);
const fill = (text: string) => text.replace('{name}', name);
// Alternate the photograph's side so the six pages don't share one silhouette
const photoSide = solutionKeys.indexOf(solution) % 2 === 0 ? 'end' : 'start';
---

<Base lang={lang} page={solution} title={`${name} – Tyll`} description={`${s.headline[lang]} ${s.intro[lang]}`} overHero>
  <!-- 1. Opening -->
  <section class="open on-dark" data-hero aria-labelledby="sol-title">
    <Picture
      src={s.photo}
      alt={s.photoAlt[lang]}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[828, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="open__photo"
      style={`object-position:${s.photoFocus}`}
    />
    <div class="open__shade" aria-hidden="true"></div>
    <div class="wrap open__inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={href('solutions', lang)}>{p.breadcrumb}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{name}</span>
      </nav>
      <h1 id="sol-title">{s.headline[lang]}</h1>
      <p class="open__intro">{s.intro[lang]}</p>
      <div class="open__actions">
        {
          demo && (
            <a class="btn btn--solid btn--lg" href={demo} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from={`${solution}-top`}>
              {fill(p.tryNamed)}
              <span class="visually-hidden"> {d.cta.newTab}</span>
            </a>
          )
        }
        <a class:list={['btn btn--lg', demo ? 'btn--line' : 'btn--solid']} href={href('book', lang)} data-track="book_call_click" data-track-from={`${solution}-top`}>
          {d.cta.book}
        </a>
      </div>
    </div>
  </section>

  <!-- 2. The problem and how Tyll helps, beside a photograph of where it happens -->
  <section class:list={['context', `context--photo-${photoSide}`]} aria-labelledby="sol-problem">
    <div class="context__copy">
      <p class="context__label">
        <span class="context__icon" aria-hidden="true"><SolutionIcon name={s.icon} /></span>
        <span id="sol-problem">{p.problemLabel}</span>
      </p>
      <p class="context__problem">{s.problem[lang]}</p>

      <h2 class="context__helps-title">{p.helps}</h2>
      <ul class="helps">
        {
          s.steps.map((st, i) => (
            <li>
              <span class="helps__k">{st.label[lang]}</span>
              <span class="helps__v">{s.helps[lang][i]}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="context__photo">
      <Picture
        src={s.problemPhoto}
        alt={s.problemPhotoAlt[lang]}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 900px) 100vw, 46vw"
        loading="lazy"
        decoding="async"
        style={`object-position:${s.problemFocus}`}
      />
    </div>
  </section>

  <!-- 3. The product: one real demo screen, explored part by part -->
  <section class:list={['product', `product--${ex.tone}`, ex.tone === 'dark' && 'on-dark']} data-dark={ex.tone === 'dark' ? '' : undefined} aria-labelledby="sol-product">
    <div class="product__wrap">
      <header class="product__head">
        <h2 id="sol-product">{s.walkTitle[lang]}</h2>
        <p>{p.exploreHint} {p.walkIntro}</p>
      </header>
      <ProductExplorer lang={lang} solution={s} explore={ex} id={`ex-${solution}`} />
      {s.note && <p class="product__note">{s.note[lang]}</p>}
    </div>
  </section>

  <!-- 4. What it adds up to, and where to go next -->
  <section class="close" aria-labelledby="sol-final">
    <div class="wrap close__inner">
      <h2 id="sol-final" class="close__outcome">{ex.outcome[lang]}</h2>
      <div class="close__side">
        <p>{demo ? p.finalText : p.finalTextNoDemo}</p>
        <div class="close__actions">
          {
            demo && (
              <a class="btn btn--solid btn--lg" href={demo} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from={`${solution}-final`}>
                {fill(p.tryNamed)}
                <span class="visually-hidden"> {d.cta.newTab}</span>
              </a>
            )
          }
          <a class:list={['btn btn--lg', demo ? 'btn--line' : 'btn--solid']} href={href('book', lang)} data-track="book_call_click" data-track-from={`${solution}-final`}>
            {d.cta.book}
          </a>
        </div>
      </div>
    </div>

    <nav class="wrap others" aria-labelledby="sol-others">
      <div class="others__head">
        <h3 id="sol-others">{p.others}</h3>
        <a class="others__all" href={href('solutions', lang)}>{d.cta.allSolutions}</a>
      </div>
      <ul>
        {
          others.map((k) => (
            <li>
              <a href={href(k, lang)}>
                <Picture
                  src={solutions[k].photo}
                  alt=""
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[360, 560]}
                  sizes="(max-width: 700px) 70vw, 230px"
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${solutions[k].photoFocus}`}
                />
                <span class="others__name">{solutions[k].name[lang]}</span>
                <span class="others__menu">{solutions[k].menu[lang]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</Base>

<style>
  /* 1. Opening */
  .open {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(560px, 82vh, 880px);
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark);
    isolation: isolate;
  }

  .open :global(picture),
  .open :global(.open__photo),
  .open__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .open :global(picture),
  .open :global(.open__photo) {
    z-index: -2;
  }

  .open :global(.open__photo) {
    object-fit: cover;
  }

  .open__shade {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(14, 15, 17, 0.74) 0%, rgba(14, 15, 17, 0.36) 55%, rgba(14, 15, 17, 0) 100%),
      linear-gradient(0deg, rgba(14, 15, 17, 0.62) 0%, transparent 55%);
  }

  :global([dir='rtl']) .open__shade {
    background:
      linear-gradient(270deg, rgba(14, 15, 17, 0.74) 0%, rgba(14, 15, 17, 0.36) 55%, rgba(14, 15, 17, 0) 100%),
      linear-gradient(0deg, rgba(14, 15, 17, 0.62) 0%, transparent 55%);
  }

  .open__inner {
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(3.5rem, 2rem + 6vh, 7rem);
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
  }

  .crumbs a {
    color: var(--on-dark-muted);
    text-underline-offset: 3px;
  }

  .crumbs a:hover {
    color: var(--on-dark);
  }

  .open h1 {
    max-width: 14ch;
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 6rem);
    font-weight: 380;
    letter-spacing: -0.042em;
    line-height: 1;
  }

  .open__intro {
    max-width: 34rem;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    color: rgba(244, 245, 247, 0.84);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    line-height: 1.5;
  }

  .open__actions,
  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
  }

  /* 2. Context: warm ivory, the copy aligned to the page grid, the photograph running to the edge */
  .context {
    --edge: calc(max(0px, (100vw - var(--wrap)) / 2) + var(--gut));
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: stretch;
    background: #f5f3ee;
  }

  .context__copy {
    padding-block: clamp(4.5rem, 3rem + 5vw, 8rem);
    padding-inline: var(--edge) clamp(2rem, 1rem + 4vw, 6rem);
  }

  .context--photo-start .context__copy {
    order: 2;
    padding-inline: clamp(2rem, 1rem + 4vw, 6rem) var(--edge);
  }

  .context__photo {
    position: relative;
    min-height: 100%;
  }

  .context__photo :global(picture),
  .context__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .context__photo :global(img) {
    object-fit: cover;
  }

  .context__label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .context__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(20, 22, 26, 0.14);
    border-radius: 12px;
    color: var(--graphite);
  }

  .context__icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .context__problem {
    max-width: 22ch;
    margin-top: 1.25rem;
    color: var(--ink);
    font-size: clamp(1.875rem, 1.3rem + 2.2vw, 3.125rem);
    font-weight: 380;
    letter-spacing: -0.032em;
    line-height: 1.1;
  }

  .context__helps-title {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .helps {
    display: grid;
    max-width: 36rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .helps li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1.1rem;
    border-top: 1px solid rgba(20, 22, 26, 0.12);
  }

  .helps__k {
    color: var(--ink);
    font-weight: 500;
  }

  .helps__v {
    color: var(--graphite);
    line-height: 1.55;
  }

  /* 3. The product */
  .product {
    padding-block: clamp(4.5rem, 3rem + 5vw, 8rem);
    overflow: hidden;
  }

  .product--dark {
    background:
      radial-gradient(60% 40% at 50% 0%, rgba(255, 255, 255, 0.07), transparent 70%),
      linear-gradient(180deg, #1d1f23 0%, #15171a 100%);
    color: var(--on-dark);
  }

  .product--light {
    background:
      radial-gradient(60% 40% at 50% 0%, rgba(255, 255, 255, 0.7), transparent 70%),
      linear-gradient(180deg, #ecebe7 0%, #e3e2de 100%);
  }

  .product__wrap {
    max-width: calc(1280px + var(--gut) * 2);
    margin-inline: auto;
    padding-inline: var(--gut);
  }

  .product__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem clamp(2rem, 1rem + 4vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .product__head h2 {
    max-width: 18ch;
    font-size: var(--fs-h2);
  }

  .product__head p {
    max-width: 30rem;
    font-size: var(--fs-small);
    line-height: 1.55;
    opacity: 0.78;
  }

  .product__note {
    max-width: 44rem;
    margin-top: 2rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid currentColor;
    font-size: 0.9375rem;
    line-height: 1.55;
    opacity: 0.7;
  }

  /* 4. Outcome and next step */
  .close {
    padding-block: clamp(5rem, 3.5rem + 5vw, 8.5rem) clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    background: #fafaf9;
  }

  .close__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 1rem + 5vw, 7rem);
    align-items: end;
  }

  .close__outcome {
    max-width: 24ch;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.875rem);
    font-weight: 380;
    letter-spacing: -0.034em;
    line-height: 1.08;
  }

  .close__side > p {
    max-width: 30rem;
    color: var(--graphite);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .others {
    margin-top: clamp(4rem, 3rem + 4vw, 6.5rem);
  }

  .others__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .others h3 {
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .others__all {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-underline-offset: 4px;
  }

  .others ul {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .others a {
    display: grid;
    gap: 0.3rem;
    color: var(--ink);
    text-decoration: none;
  }

  .others a :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    object-fit: cover;
    transition:
      transform 0.6s var(--ease),
      filter 0.6s var(--ease);
  }

  .others a :global(picture) {
    display: block;
    margin-bottom: 0.6rem;
    border-radius: 12px;
    overflow: hidden;
  }

  .others a:hover :global(img) {
    transform: scale(1.03);
  }

  .others__name {
    font-weight: 500;
  }

  .others a:hover .others__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .others__menu {
    color: var(--steel);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  @media (max-width: 1100px) {
    .others ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .context {
      grid-template-columns: minmax(0, 1fr);
    }

    .context__copy,
    .context--photo-start .context__copy {
      order: 0;
      padding-inline: var(--gut);
    }

    .context__photo {
      aspect-ratio: 4 / 3;
    }

    .product__head,
    .close__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .others ul {
      display: flex;
      gap: 1rem;
      margin-inline: calc(var(--gut) * -1);
      padding-inline: var(--gut);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .others li {
      flex: 0 0 64%;
      scroll-snap-align: start;
    }

    .helps li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .open__shade,
    :global([dir='rtl']) .open__shade {
      background: linear-gradient(0deg, rgba(14, 15, 17, 0.82) 0%, rgba(14, 15, 17, 0.5) 55%, rgba(14, 15, 17, 0.28) 100%);
    }
  }

  @media (max-width: 640px) {
    .open__actions :global(.btn),
    .close__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .others a :global(img) {
      transition: none;
    }
  }
</style>
