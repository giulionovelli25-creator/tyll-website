---
// How Tyll fits into a hotel, in three steps, over a still silver wave. Used on the homepage and every solution page.
import SilverWave from './SilverWave.astro';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const v = t(lang).how;
---

<section class="how" aria-labelledby="how-title">
  <SilverWave phase={0.55} class="how__wave" />
  <div class="wrap how__inner">
    <h2 id="how-title" class="display">{v.title}</h2>
    <ol class="how__steps">
      {
        v.steps.map(([label, text], i) => (
          <li>
            <span class="how__num" aria-hidden="true">{i + 1}</span>
            <h3>{label}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-y);
    background: var(--paper);
  }

  .how__wave {
    top: auto;
    height: 70%;
  }

  .how__inner {
    position: relative;
    z-index: 1;
  }

  .how h2 {
    font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem);
    text-align: center;
  }

  .how__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .how__num {
    display: block;
    color: var(--silver-deep);
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 300;
    line-height: 1;
  }

  .how h3 {
    margin-top: var(--s-2);
    font-size: 1.375rem;
    font-weight: 600;
    font-family: var(--font);
  }

  .how p {
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    .how__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }
  }
</style>
