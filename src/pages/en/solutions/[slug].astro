---
import SolutionPage from '../../../components/pages/SolutionPage.astro';
import { solutionKeys, slugOf, type SolutionKey } from '../../../i18n/routes';

export function getStaticPaths() {
  return solutionKeys.map((key) => ({ params: { slug: slugOf(key, 'en') }, props: { key } }));
}

const { key } = Astro.props as { key: SolutionKey };
---

<SolutionPage lang="en" solution={key} />
