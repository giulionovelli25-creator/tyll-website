---
// How Tyll fits into a hotel, in three steps, over a still silver wave. Used on the homepage and every solution page.
import SilverWave from './SilverWave.astro';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const v = t(lang).how;
---

<section class="how" aria-labelledby="how-title">
  <SilverWave phase={0.55} class="how__wave" />
  <div class="wrap how__inner">
    <h2 id="how-title" class="display">{v.title}</h2>
    <ol class="how__steps">
      {
        v.steps.map(([label, text], i) => (
          <li>
            <span class="how__num" aria-hidden="true">{i + 1}</span>
            <h3>{label}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-y) var(--s-6);
    background: var(--paper);
  }

  .how__wave {
    top: auto;
    height: 80%;
  }

  .how__inner {
    position: relative;
    z-index: 1;
  }

  .how h2 {
    font-size: var(--fs-h2);
    text-align: center;
  }

  .how__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    max-width: 64rem;
    margin: var(--s-6) auto 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .how__steps li {
    position: relative;
  }

  /* One fine line runs from each number to the next */
  .how__steps li + li::before {
    position: absolute;
    top: 28px;
    inset-inline-end: calc(50% + 40px);
    width: calc(100% + var(--s-4) - 80px);
    height: 1px;
    background: var(--silver);
    content: '';
  }

  .how__num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 auto;
    border: 1px solid var(--silver);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 300;
    line-height: 1;
  }

  .how h3 {
    margin-top: var(--s-3);
    font-family: var(--font);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .how p {
    max-width: 22rem;
    margin: 0.5rem auto 0;
    color: var(--steel);
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    .how__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }

    .how__steps li + li::before {
      top: calc(var(--s-5) * -1);
      inset-inline-start: 50%;
      width: 1px;
      height: calc(var(--s-5) - 8px);
    }
  }
</style>
