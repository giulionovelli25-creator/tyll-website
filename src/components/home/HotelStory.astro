<script>
  document.querySelectorAll<HTMLElement>('[data-hs]').forEach((root) => {
    const head = root.querySelector<HTMLElement>('[data-hs-head]')!;
    const stage = root.querySelector<HTMLElement>('[data-hs-stage]')!;
    const stepsBox = root.querySelector<HTMLElement>('[data-hs-steps]')!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-hs-step]')];
    const firstText = steps[0].firstElementChild as HTMLElement;
    const dots = [...root.querySelectorAll<HTMLElement>('[data-hs-dot]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    // A step's text pins at `pin`. The step counts as the current one once the next text is on its way up.
    let pin = 0;
    let stepH = 1;
    let tops: number[] = [];
    let heights: number[] = [];
    let lead = 0.12;
    const measure = () => {
      root.style.setProperty('--hs-head', `${head.offsetHeight}px`);
      root.style.setProperty('--hs-stage', `${stage.offsetHeight}px`);
      pin = parseFloat(getComputedStyle(firstText).top) || 0;
      stepH = steps[0].offsetHeight || 1;
      const start = stepsBox.getBoundingClientRect().top;
      tops = steps.map((step) => step.getBoundingClientRect().top - start);
      heights = steps.map((step) => step.offsetHeight);
      lead = Math.max(0.08, Math.min(0.2, (firstText.offsetHeight * 0.35) / stepH));
    };
    const position = () => {
      // Steps can differ in length, so each one counts as 1 however long it is. The last runs on at the normal rate.
      const y = pin - stepsBox.getBoundingClientRect().top;
      if (y <= 0) return y / stepH + lead;
      let i = steps.length - 1;
      while (i > 0 && y < tops[i]) i--;
      return i + (y - tops[i]) / (i === steps.length - 1 ? stepH : heights[i]) + lead;
    };

    const setActive = (b: number) => {
      const active = Math.max(0, Math.min(steps.length - 1, Math.floor(b)));
      steps.forEach((step, i) => step.classList.toggle('is-active', i === active));
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-on', i === active);
        dot.classList.toggle('is-done', i < active);
      });
    };

    measure();

    // Reduced motion: the finished hotel stays as it is. The text still follows the scroll.
    if (reduce.matches) {
      const follow = () => setActive(position());
      addEventListener('scroll', follow, { passive: true });
      addEventListener('resize', () => {
        measure();
        follow();
      });
      follow();
      return;
    }

    type Piece = {
      el: SVGElement;
      b: number;
      d: number;
      x: number;
      y: number;
      r: number;
      s: number | null;
      ob: number | null;
      od: number;
      ox: number;
      oy: number;
      draw: boolean;
      drift: number;
      t: number;
      o: number;
      v: number;
    };
    const pieces: Piece[] = [...root.querySelectorAll<SVGElement>('[data-b]')].map((el, i) => {
      const num = (name: string, fallback = 0) => {
        const value = el.getAttribute(`data-${name}`);
        return value === null ? fallback : Number(value);
      };
      return {
        el,
        b: num('b'),
        d: num('d', 0.1),
        x: num('x'),
        y: num('y'),
        r: num('r'),
        s: el.hasAttribute('data-s') ? num('s') : null,
        ob: el.hasAttribute('data-ob') ? num('ob') : null,
        od: num('od', 0.1),
        ox: num('ox'),
        oy: num('oy'),
        draw: el.hasAttribute('data-draw'),
        // The transactions stay restless until they are dealt with
        drift: el.classList.contains('c-slip') ? (i * 13) % 9 : -1,
        t: -1,
        o: -1,
        v: NaN,
      };
    });
    const cards = [...root.querySelectorAll<HTMLElement>('[data-hs-card]')].map((el) => ({ el, on: Number(el.dataset.hsCard) }));
    const zones = [...root.querySelectorAll<HTMLElement>('[data-hs-zone]')].map((el) => ({ el, range: el.dataset.hsZone!.split(',').map(Number) }));
    const hub = root.querySelector<HTMLElement>('[data-hs-hub]')!;
    const notes = root.querySelector<HTMLElement>('[data-hs-notes]')!;
    const camera = root.querySelector<SVGElement>('[data-hs-camera]')!;
    const far = root.querySelector<SVGElement>('[data-hs-far]')!;
    const near = root.querySelector<SVGElement>('[data-hs-near]')!;

    const clamp = (v: number) => Math.max(0, Math.min(1, v));
    const easeOut = (v: number) => 1 - (1 - v) ** 3;
    const SETTLE = 3;

    const place = (p: Piece, b: number) => {
      const t = clamp((b - p.b) / p.d);
      const o = p.ob === null ? 1 : 1 - clamp((b - p.ob) / p.od);
      const shown = p.s === null ? 1 : clamp((b - p.s) / 0.15);
      // A restless piece changes with every scroll until it arrives; anything else only inside its windows
      if (t === p.t && o === p.o && shown === p.v && !(p.drift >= 0 && t === 0)) return;
      p.t = t;
      p.o = o;
      p.v = shown;
      const { style } = p.el;
      if (p.draw) {
        style.strokeDashoffset = String(1 - easeOut(t));
        style.visibility = t === 0 ? 'hidden' : 'visible';
        return;
      }
      const moves = p.x !== 0 || p.y !== 0;
      // Moves in, passes its place by a few pixels, and settles back: no bounce
      const arrive = easeOut(Math.min(1, t / 0.8));
      const settle = moves ? (t < 0.8 ? arrive * SETTLE : SETTLE * (1 - (t - 0.8) / 0.2)) : 0;
      const rest = 1 - arrive;
      const wander = p.drift >= 0 ? (b + 0.8) * rest : 0;
      const x = p.x * rest - Math.sign(p.x) * settle + p.ox * (1 - o) + (p.drift >= 0 ? (p.drift - 4) * 9 * wander : 0);
      const y = p.y * rest - Math.sign(p.y) * settle + p.oy * (1 - o) + (p.drift >= 0 ? (((p.drift * 7) % 9) - 4) * 7 * wander : 0);
      const r = p.r * rest + (p.drift >= 0 ? (p.drift - 4) * 8 * wander : 0);
      const opacity = (p.s !== null ? shown : moves ? Math.min(1, t * 3) : easeOut(t)) * o;
      style.visibility = opacity === 0 ? 'hidden' : 'visible';
      style.opacity = String(opacity);
      style.transform = x === 0 && y === 0 && r === 0 ? '' : `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)${r ? ` rotate(${r.toFixed(1)}deg)` : ''}`;
    };

    // The camera goes in to the storeroom and to the bar and comes back out; the stylesheet eases each move over a second
    const SHOTS = [
      { from: 1.02, to: 1.62, cx: 225, cy: 662, z: 4 },
      { from: 2.02, to: 2.9, cx: 815, cy: 668, z: 2.9 },
    ];
    let aimed = '';
    const aim = (b: number) => {
      // The bar stays in view until the delivery has finished, unless the reader has moved on to the last step
      const busy = b >= 2.9 && b < 2.97 && performance.now() - deliveryStart < DONE + 300;
      const shot = SHOTS.find((one) => b >= one.from && (b < one.to || (busy && one.from === 2.02)));
      const transform = shot ? `translate(${500 - shot.cx * shot.z}px, ${430 - shot.cy * shot.z}px) scale(${shot.z})` : 'translate(0px, 0px) scale(1)';
      root.classList.toggle('is-zoom', Boolean(shot));
      if (transform !== aimed) camera.style.transform = aimed = transform;
    };

    // The delivery and the bar run together on one clock. All times in milliseconds of a 16 second cycle.
    const CYCLE = 16000;
    const part = (name: string) => root.querySelector<SVGElement>(`[data-dl="${name}"]`)!;
    const at = (ms: number) => ms / CYCLE;
    const OUT = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
    const IN = 'cubic-bezier(0.55, 0, 0.85, 0.4)';
    const TRIP = 2400;
    const FIRST = 1500;
    const TRIPS = 3;
    const LAST_IN = FIRST + (TRIPS - 1) * TRIP + 1100;
    const DONE = FIRST + TRIPS * TRIP;
    const barItems = [...root.querySelectorAll<SVGElement>('[data-dl-item]')];
    const STOCK_END = LAST_IN + 300;
    const placedAt = (i: number) => FIRST + (i * (STOCK_END - FIRST)) / (barItems.length - 1 || 1);
    const RESET = DONE + 2400;
    type Frames = Keyframe[];
    const timeline = (): [Element, Frames][] => {
      const list: [Element, Frames][] = [];
      list.push([
        part('van'),
        [
          { transform: 'translateX(260px)', offset: 0, easing: OUT },
          { transform: 'translateX(0px)', offset: at(1000) },
          { transform: 'translateX(0px)', offset: at(DONE + 700), easing: IN },
          { transform: 'translateX(260px)', offset: at(DONE + 2200) },
          { transform: 'translateX(260px)', offset: 1 },
        ],
      ]);
      list.push([
        part('door'),
        [
          { transform: 'scaleX(0)', offset: 0 },
          { transform: 'scaleX(0)', offset: at(900), easing: OUT },
          { transform: 'scaleX(1)', offset: at(1300) },
          { transform: 'scaleX(1)', offset: at(DONE + 150), easing: OUT },
          { transform: 'scaleX(0)', offset: at(DONE + 600) },
          { transform: 'scaleX(0)', offset: 1 },
        ],
      ]);
      list.push([
        part('shutter'),
        [
          { transform: 'scaleY(1)', offset: 0 },
          { transform: 'scaleY(1)', offset: at(700), easing: OUT },
          { transform: 'scaleY(0.12)', offset: at(1300) },
          { transform: 'scaleY(0.12)', offset: at(DONE + 300), easing: OUT },
          { transform: 'scaleY(1)', offset: at(DONE + 1100) },
          { transform: 'scaleY(1)', offset: 1 },
        ],
      ]);
      // The driver, the carrying and empty handed figures, and each box in turn
      const walker: Keyframe[] = [{ transform: 'translate(12px, 0px)', opacity: 0, offset: 0 }, { transform: 'translate(12px, 0px)', opacity: 0, offset: at(FIRST - 200) }];
      const carrying: Keyframe[] = [{ opacity: 1, offset: 0 }];
      const empty: Keyframe[] = [{ opacity: 0, offset: 0 }];
      for (let k = 0; k < TRIPS; k++) {
        const t = FIRST + k * TRIP;
        walker.push({ transform: 'translate(0px, 0px)', opacity: 1, offset: at(t) });
        walker.push({ transform: 'translate(-35px, -8px)', opacity: 1, offset: at(t + 1000) });
        walker.push({ transform: 'translate(-37px, -10px)', opacity: 0, offset: at(t + 1100) });
        walker.push({ transform: 'translate(-37px, -10px)', opacity: 0, offset: at(t + 1200) });
        walker.push({ transform: 'translate(-35px, -8px)', opacity: 1, offset: at(t + 1350) });
        carrying.push({ opacity: 1, offset: at(t + 1150) }, { opacity: 0, offset: at(t + 1151) }, { opacity: 0, offset: at(t + TRIP - 1) }, { opacity: 1, offset: at(t + TRIP) });
        empty.push({ opacity: 0, offset: at(t + 1150) }, { opacity: 1, offset: at(t + 1151) }, { opacity: 1, offset: at(t + TRIP - 1) }, { opacity: 0, offset: at(t + TRIP) });
        const box: Keyframe[] = [{ opacity: 0, offset: 0 }];
        if (k > 0) box.push({ opacity: 0, offset: at(t - 1) });
        box.push({ opacity: 1, offset: at(t) }, { opacity: 1, offset: at(t + 1150) }, { opacity: 0, offset: at(t + 1151) }, { opacity: 0, offset: 1 });
        list.push([part(`box${k}`), box]);
      }
      walker.push({ transform: 'translate(0px, 0px)', opacity: 1, offset: at(DONE) });
      walker.push({ transform: 'translate(12px, 0px)', opacity: 0, offset: at(DONE + 250) });
      walker.push({ transform: 'translate(12px, 0px)', opacity: 0, offset: 1 });
      carrying.push({ opacity: 0, offset: 1 });
      empty.push({ opacity: 0, offset: 1 });
      list.push([part('driver'), walker], [part('carrying'), carrying], [part('empty'), empty]);
      // The back bar fills left to right, each piece with a small settle, and quietly empties while no van is here
      barItems.forEach((el, i) => {
        const t = placedAt(i);
        list.push([
          el,
          [
            { opacity: 0, transform: 'translateY(-4px)', offset: 0 },
            { opacity: 0, transform: 'translateY(-4px)', offset: at(t - 1) },
            { opacity: 1, transform: 'translateY(-4px)', offset: at(t), easing: OUT },
            { opacity: 1, transform: 'translateY(0px)', offset: at(t + 260) },
            { opacity: 1, transform: 'translateY(0px)', offset: at(RESET) },
            { opacity: 0, transform: 'translateY(0px)', offset: at(RESET + 500) },
            { opacity: 0, transform: 'translateY(-4px)', offset: 1 },
          ],
        ]);
      });
      // The bartender works along the shelves, an arm going up for each piece, then polishes a glass
      const firstRowEnd = placedAt(6);
      const barman = part('barman');
      list.push([
        barman.querySelector('.p')!.firstElementChild!,
        [
          { transform: 'translateX(0px)', offset: 0 },
          { transform: 'translateX(0px)', offset: at(FIRST - 300) },
          { transform: 'translateX(72px)', offset: at(firstRowEnd) },
          { transform: 'translateX(0px)', offset: at(firstRowEnd + 500) },
          { transform: 'translateX(72px)', offset: at(STOCK_END) },
          { transform: 'translateX(30px)', offset: at(STOCK_END + 700) },
          { transform: 'translateX(30px)', offset: at(RESET + 300) },
          { transform: 'translateX(0px)', offset: at(RESET + 1000) },
          { transform: 'translateX(0px)', offset: 1 },
        ],
      ]);
      const arm: Keyframe[] = [{ transform: 'rotate(0deg)', offset: 0 }];
      barItems.forEach((_, i) => {
        const t = placedAt(i);
        arm.push({ transform: 'rotate(0deg)', offset: at(t - 230) }, { transform: i < 7 ? 'rotate(-150deg)' : 'rotate(-115deg)', offset: at(t) }, { transform: 'rotate(0deg)', offset: at(t + 220) });
      });
      const POLISH = STOCK_END + 800;
      arm.push({ transform: 'rotate(-58deg)', offset: at(POLISH) });
      for (let m = POLISH + 300; m < RESET; m += 300) arm.push({ transform: `rotate(${(m - POLISH) % 600 < 300 ? -46 : -58}deg)`, offset: at(m) });
      arm.push({ transform: 'rotate(0deg)', offset: at(RESET + 200) }, { transform: 'rotate(0deg)', offset: 1 });
      list.push([barman.querySelector('.p-arm--f')!, arm]);
      list.push([
        part('polish'),
        [
          { opacity: 0, offset: 0 },
          { opacity: 0, offset: at(POLISH - 100) },
          { opacity: 1, offset: at(POLISH) },
          { opacity: 1, offset: at(RESET) },
          { opacity: 0, offset: at(RESET + 150) },
          { opacity: 0, offset: 1 },
        ],
      ]);
      return list;
    };
    let delivery: Animation[] = [];
    let deliveryStart = 0;
    const setDelivery = (on: boolean) => {
      if (on === delivery.length > 0) return;
      root.classList.toggle('is-delivering', on);
      if (on) deliveryStart = performance.now();
      if (on) setTimeout(() => { lastB = NaN; onScroll(); }, DONE + 350);
      if (on) delivery = timeline().map(([el, frames]) => el.animate(frames, { duration: CYCLE, iterations: Infinity, fill: 'both' }));
      else {
        delivery.forEach((one) => one.cancel());
        delivery = [];
      }
    };

    let lastB = NaN;
    const render = () => {
      const b = position();
      if (b === lastB) return;
      lastB = b;
      setActive(b);
      steps.forEach((step, i) => step.classList.toggle('is-fixed', i === steps.length - 1 || b >= i + (i === 2 ? 0.1 : 0.3)));
      for (const p of pieces) place(p, b);
      for (const card of cards) card.el.classList.toggle('is-on', b >= card.on);
      for (const zone of zones) zone.el.classList.toggle('is-on', b >= zone.range[0] && b < zone.range[1]);
      hub.classList.toggle('is-on', b >= 0.76);
      root.classList.toggle('is-dusk', b >= 3.3);
      root.classList.toggle('is-alive', b >= 3.3);
      aim(b);
      setDelivery(b >= 2.04);
      notes.classList.toggle('is-on', b >= 1.05 && b < 1.62);
      root.classList.toggle('is-counting', b >= 1.3 && b < 1.7);
      // Sky, building and trees drift against each other by about 12 px across the whole story
      const drift = Math.max(0, Math.min(4, b)) - 2;
      far.style.transform = `translateY(${(drift * 2.5).toFixed(1)}px)`;
      near.style.transform = `translateY(${(drift * -3.2).toFixed(1)}px)`;
    };

    root.classList.add('is-live');
    let onScreen = true;
    let queued = false;
    const onScroll = () => {
      if (queued || !onScreen) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        render();
      });
    };
    const remeasure = () => {
      measure();
      lastB = NaN;
      onScroll();
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', remeasure);
    new ResizeObserver(remeasure).observe(head);
    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        root.classList.toggle('is-paused', !onScreen);
        delivery.forEach((one) => (onScreen ? one.play() : one.pause()));
        if (onScreen) render();
      },
      { rootMargin: '10% 0px' },
    ).observe(root);
    render();

    reduce.addEventListener('change', () => {
      if (reduce.matches) location.reload();
    });
  });
</script>
