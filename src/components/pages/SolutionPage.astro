---
// A solution page asks one question beside a photograph of the work it is about, shows the real system answering it
// in a film, gives one number or statement the site already makes, and asks for a demo. Each solution wears the
// colour that feature has in the product (`tone` in solutions.ts, tokens in global.css).
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import DemoFilm from '../DemoFilm.astro';
import SilverWave from '../SilverWave.astro';
import SolutionIcon from '../SolutionIcon.astro';
import { solutions, sectionOf } from '../../content/solutions';
import { solutionSeo } from '../../content/seo';
import { t, href, type Locale, type SolutionKey } from '../../i18n';

interface Props {
  lang: Locale;
  solution: SolutionKey;
}

const { lang, solution } = Astro.props;
const d = t(lang);
const p = d.solutionPage;
const s = solutions[solution];
const name = s.name[lang];
// The film's chapters are the three steps of "What you are about to see"
const spots = s.see.map((x) => ({ label: x.title }));
// At the foot, the other pages of the same section
const section = sectionOf(solution);
const others = section.keys.filter((k) => k !== solution);

// Search title and description: from seo.ts where the language has one, otherwise the page's own name and lines
const seo = solutionSeo[solution]?.[lang];
const metaTitle = seo?.title ?? `${name} | Tyll`;
const metaDescription = seo?.description ?? `${s.headline[lang]} ${s.intro[lang]}`;

// One word or phrase of the question in the solution's colour
const headline = s.headline[lang];
const mark = s.mark[lang];
const at = headline.indexOf(mark);
const [before, marked, after] = at < 0 ? [headline, '', ''] : [headline.slice(0, at), mark, headline.slice(at + mark.length)];

// The number or statement after the film. Never new text: a homepage number, a line of the hotel story or a FAQ answer.
const why = d.home.why;
const pr = s.proof;
const number = pr?.kind === 'number' ? why.cards[pr.card] : undefined;
const faqItem = pr?.kind === 'faq' ? d.faq.groups.flatMap((g) => g.items).find((i) => i.id === pr.id) : undefined;
const say =
  pr?.kind === 'story'
    ? { ask: d.home.tour.steps[pr.step].headline, answer: d.home.tour.steps[pr.step].problem }
    : faqItem
      ? { ask: faqItem.q, answer: faqItem.a.replace(/\{(?:home|book):([^}]+)\}/g, '$1') }
      : undefined;
---

<Base lang={lang} page={solution} title={metaTitle} description={metaDescription}>
  <section class="sol" data-accent={s.tone} aria-labelledby="sol-title">
    <SilverWave phase={0.2} class="sol__wave" />
    <div class="wrap sol__head">
      <div class="sol__copy">
        <p class="sol__name"><span class="sol__chip"><SolutionIcon name={s.icon} class="sol__icon" /></span>{name}</p>
        <h1 id="sol-title" class="display">{before}{marked && <span class="sol__mark">{marked}</span>}{after}</h1>
        <p class="sol__intro">{s.intro[lang]}</p>
        <div class="sol__actions">
          <a class="btn btn--solid btn--lg sol__book" href={href('book', lang)} data-track="book_demo_click" data-track-from={`${solution}-hero`}>
            {d.cta.book}
          </a>
        </div>
      </div>
      <div class="sol__photo">
        <Picture
          src={s.pagePhoto}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 900px) 92vw, 560px"
          alt=""
          loading="eager"
          decoding="async"
          style={`object-position: ${s.pagePhotoFocus}`}
        />
      </div>
    </div>
    <div class="wrap sol__film" id="film">
      <DemoFilm lang={lang} solutionKey={solution} name={name} spots={spots}>
        <section class="see" aria-labelledby="see-title">
          <h2 id="see-title" class="see__title">{p.seeTitle}</h2>
          <ol class="see__list" role="list" style={`--n:${s.see.length}`}>
            {
              s.see.map((item, i) => (
                <li class="see__item">
                  <span class="see__num" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3>{item.title[lang]}</h3>
                    <p>{item.text[lang]}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>
      </DemoFilm>
      {(s.note || p.demoEnglish) && <p class="sol__note">{[s.note?.[lang], p.demoEnglish].filter(Boolean).join(' ')}</p>}
      {
        (s.more.length > 0 || s.rows?.length) && (
          <section class:list={['more', s.more.length > 1 && 'more--two']} aria-labelledby="more-title">
            <h2 id="more-title" class="more__title">{p.moreTitle.replace('{name}', name)}</h2>
            {s.more.length > 0 && (
              <div class="more__groups">
                {s.more.map((g) => (
                  <div class="more__group">
                    {g.title && <h3>{g.title[lang]}</h3>}
                    {g.lead && <p class="more__lead">{g.lead[lang]}</p>}
                    <ul role="list">
                      {g.points.map((pt) => (
                        <li>{pt[lang]}</li>
                      ))}
                    </ul>
                    {g.foot && <p class="more__foot">{g.foot[lang]}</p>}
                    {g.next && <p class="more__next">{g.next[lang]}</p>}
                  </div>
                ))}
              </div>
            )}
            {s.rows?.length && (
              <div class="rows" data-rows>
                {s.rows.map((r) => (
                  <div class="xrow" id={r.id} data-row>
                    <h3 class="xrow__h">
                      <button type="button" class="xrow__head" aria-expanded="false" aria-controls={`${r.id}-panel`}>
                        <span class="xrow__icon">
                          <SolutionIcon name={r.icon} />
                        </span>
                        <span class="xrow__text">
                          <span class="xrow__name">{r.name[lang]}</span>
                          <span class="xrow__line">{r.line[lang]}</span>
                        </span>
                        <svg class="xrow__chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                      </button>
                    </h3>
                    <div class="xrow__panel" id={`${r.id}-panel`} role="region" aria-label={r.name[lang]} hidden>
                      <div class:list={['xrow__body', r.film && 'xrow__body--film']}>
                        <div>
                          <ul role="list">
                            {r.points.map((pt) => (
                              <li>{pt[lang]}</li>
                            ))}
                          </ul>
                          {r.next && <p class="more__next">{r.next[lang]}</p>}
                        </div>
                        {r.film && (
                          <video
                            class="xrow__clip"
                            muted
                            loop
                            playsinline
                            controls
                            preload="none"
                            aria-label={r.name[lang]}
                            data-desk={`/media/film/${lang}/${r.film}-desk.mp4`}
                            data-phone={`/media/film/${lang}/${r.film}-phone.mp4`}
                            data-desk-poster={`/media/film/${lang}/${r.film}-desk.jpg`}
                            data-phone-poster={`/media/film/${lang}/${r.film}-phone.jpg`}
                          />
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>
        )
      }
      {
        s.soon && (
          <section class="soon" aria-label={s.soon.lead[lang]}>
            <p class="soon__lead">{s.soon.lead[lang]}</p>
            <ul role="list">
              {s.soon.items.map((x) => (
                <li>{x[lang]}</li>
              ))}
            </ul>
          </section>
        )
      }
      {
        solution === 'waste' && (
          <p class="why-waste">
            <a href={href('sustainability', lang)}>{p.whyWaste}</a>
          </p>
        )
      }
    </div>
  </section>

  {
    (number || say) && (
      <section class="proof" data-accent={s.tone} aria-labelledby="proof-title">
        <div class="wrap proof__grid">
          {number && (
            <>
              <div class="proof__lead">
                {number.label && <p class="proof__label">{number.label}</p>}
                <p class="proof__figure" aria-hidden="true">
                  <span dir="ltr">{number.figure}</span>
                </p>
              </div>
              <div class="proof__body">
                <h2 id="proof-title" class="proof__say">
                  <span class="visually-hidden">{number.figure} </span>
                  {number.title}
                </h2>
                <p class="proof__text">{number.text}</p>
                <p class="proof__source">
                  {number.sourceUrl ? (
                    <>
                      {why.source}:{' '}
                      <a href={number.sourceUrl} target="_blank" rel="noopener">
                        {number.sourceName}
                        <span class="visually-hidden"> {d.cta.newTab}</span>
                      </a>
                    </>
                  ) : (
                    number.sourceName
                  )}
                </p>
              </div>
            </>
          )}
          {say && (
            <>
              <div class="proof__lead">
                <h2 id="proof-title" class="proof__ask">{say.ask}</h2>
              </div>
              <div class="proof__body">
                <p class="proof__say">{say.answer}</p>
              </div>
            </>
          )}
        </div>
      </section>
    )
  }

  <section class="close on-dark" data-dark aria-labelledby="sol-final">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap close__inner">
      <h2 id="sol-final" class="display">{d.home.invite.title}</h2>
      <a class="btn btn--solid btn--lg sol__book" href={href('book', lang)} data-track="book_demo_click" data-track-from={`${solution}-final`}>
        {d.cta.book}
      </a>
    </div>
  </section>

  <nav class="wrap others" aria-label={p.inSection.replace('{name}', section.name[lang])}>
    <p class="others__head"><a href={href('solutions', lang, `#${section.id}`)}>{p.inSection.replace('{name}', section.name[lang])}</a></p>
    <ul>
      {others.map((k) => <li><a href={href(k, lang)}>{solutions[k].name[lang]}</a></li>)}
      <li><a class="others__all" href={href('solutions', lang)}>{d.cta.allSolutions}</a></li>
    </ul>
  </nav>
</Base>

<style>
  .sol {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + var(--page-top));
    padding-bottom: var(--section-y);
  }

  .sol__head,
  .sol__film {
    position: relative;
    z-index: 1;
  }

  /* The question at the start, a photograph of the work at the end */
  .sol__head {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  /* A faint still wave behind the question, fading out before the film */
  .sol :global(.sol__wave) {
    height: 62%;
    top: 0;
    opacity: 0.4;
    -webkit-mask-image: linear-gradient(180deg, var(--black) 40%, transparent 100%);
    mask-image: linear-gradient(180deg, var(--black) 40%, transparent 100%);
  }

  /* The solution's name in its own colour, its icon on a faint square of it */
  .sol__name {
    display: inline-flex;
    gap: 0.7rem;
    align-items: center;
    max-width: none;
    margin-bottom: var(--s-3);
    color: var(--acc);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .sol__chip {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(var(--acc-rgb) / 0.16);
    border-radius: 12px;
    background: var(--acc-wash);
  }

  .sol__name :global(.sol__icon) {
    width: 20px;
    height: 20px;
  }

  .sol h1 {
    font-size: clamp(2.375rem, 1.6rem + 2.6vw, 4rem);
    line-height: 1.08;
  }

  .sol__mark {
    color: var(--acc);
  }

  .sol__intro {
    max-width: 34rem;
    margin: var(--s-3) 0 0;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.4;
  }

  .sol__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }

  .sol__book {
    min-height: 60px;
    padding-inline: 2.25rem;
    font-size: 1.1875rem;
  }

  /* The photograph, with a block of the solution's colour set a little behind it */
  .sol__photo {
    --off: clamp(0.75rem, 0.4rem + 1vw, 1.25rem);
    position: relative;
    margin-block-end: var(--off);
    margin-inline-end: var(--off);
  }

  .sol__photo::before {
    position: absolute;
    inset-block: var(--off) calc(var(--off) * -1);
    inset-inline: var(--off) calc(var(--off) * -1);
    border-radius: var(--radius-lg);
    background: var(--acc-soft);
    content: '';
  }

  .sol__photo :global(picture) {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--cloud);
    box-shadow: var(--shadow-2);
  }

  .sol__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: var(--photo-grade);
  }

  .sol__film {
    margin-top: var(--band-y);
  }

  /* What you are about to see: what comes in, what Tyll shows, what you do with it. One row on the tinted block,
     above the screen and as wide as it, so their edges line up. */
  .see {
    position: relative;
    max-width: var(--film-w, 68rem);
    margin: 0 auto var(--s-4);
  }

  .see__title {
    margin: 0 0 var(--s-3);
    color: var(--acc);
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0;
  }

  .see__list {
    display: grid;
    grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .see__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.875rem;
    align-items: start;
    padding: 0.25rem 1.5rem;
  }

  .see__item:first-child {
    padding-inline-start: 0;
  }

  .see__item + .see__item {
    border-inline-start: 1px solid rgb(var(--acc-rgb) / 0.2);
  }

  .see__num {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--acc);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
  }

  .see h3 {
    margin: 0;
    font-family: var(--font);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .see p {
    max-width: none;
    margin: 0.25rem 0 0;
    color: var(--steel);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .sol__note {
    max-width: none;
    margin-top: var(--s-3);
    color: var(--text-3);
    font-size: var(--fs-small);
    text-align: center;
  }

  /* The demo's other features for this product: a short list under the film, as wide as it, its bullets in the
     solution's colour; two groups side by side where a page has two */
  .more {
    max-width: var(--film-w, 68rem);
    margin: var(--intro-gap) auto 0;
    padding-top: var(--s-4);
    border-top: 1px solid rgb(var(--acc-rgb) / 0.2);
  }

  .more__title {
    margin: 0 0 var(--s-3);
    color: var(--acc);
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0;
  }

  .more__groups {
    display: grid;
    gap: var(--s-4) clamp(2rem, 1rem + 3vw, 4rem);
  }

  .more--two .more__groups {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .more h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .more ul {
    display: grid;
    gap: 0.55rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more:not(.more--two) ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .more li {
    position: relative;
    padding-inline-start: 1.1rem;
    color: var(--graphite);
    font-size: 0.9688rem;
    line-height: 1.5;
  }

  .more li::before {
    position: absolute;
    top: 0.62em;
    inset-inline-start: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--acc);
    content: '';
  }

  .more__lead,
  .more__foot {
    max-width: none;
    margin: 0 0 0.6rem;
    color: var(--steel);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .more__foot {
    margin: 0.8rem 0 0;
  }

  .more__next {
    max-width: none;
    margin: 0.6rem 0 0;
    color: var(--steel);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* Coming next: checks still being built, small and muted like the In development line, no buttons */
  .soon {
    max-width: var(--film-w, 68rem);
    margin: var(--s-4) auto 0;
    color: var(--steel);
    font-size: 0.9063rem;
    line-height: 1.5;
  }

  .soon__lead {
    max-width: none;
    margin: 0 0 0.4rem;
    font-weight: 600;
  }

  .soon ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .soon li {
    padding-inline-start: 1rem;
    text-indent: -1rem;
  }

  .soon li::before {
    content: '– ';
  }

  .why-waste {
    max-width: var(--film-w, 68rem);
    margin: var(--s-4) auto 0;
  }

  .why-waste a {
    color: var(--acc);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* One number or statement the site already makes, on a light grey band: the number or the question at the start,
     what it means at the end */
  .proof {
    padding-block: var(--band-y);
    background: var(--page-deep);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-3) clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .proof__lead {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  .proof__label {
    margin: 0;
    padding: 0.3rem 0.75rem 0.35rem;
    border: 1px solid rgb(var(--acc-rgb) / 0.4);
    border-radius: var(--pill);
    color: var(--acc);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
  }

  .proof__figure {
    max-width: none;
    margin: 0;
    color: var(--acc);
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 2.5rem + 8vw, 9.5rem);
    font-weight: 300;
    line-height: 0.95;
    white-space: nowrap;
  }

  /* the question, under a short rule of the solution's colour */
  .proof__ask {
    margin: 0;
    padding-top: var(--s-3);
    border-top: 2px solid var(--acc);
    color: var(--acc);
    font-family: var(--font);
    font-size: var(--fs-lead);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .proof__say {
    max-width: 24ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 300;
    line-height: 1.15;
  }

  .proof__text {
    max-width: 34rem;
    margin: var(--s-2) 0 0;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.45;
  }

  .proof__source {
    max-width: 34rem;
    margin: var(--s-3) 0 0;
    color: var(--steel);
    font-size: var(--fs-caption);
    line-height: 1.45;
  }

  .proof__source a {
    display: inline-block;
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .proof__source a:hover {
    text-decoration-thickness: 2px;
  }

  .close {
    position: relative;
    overflow: hidden;
    padding-block: var(--band-y);
    background: var(--night-1);
    color: var(--text-1);
  }

  .close__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .close h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem);
  }

  /* The other four pages of the section and All solutions: one row on desktop, three columns on tablets, two on phones */
  .others__head {
    max-width: none;
    margin: 0;
    padding-top: var(--intro-gap);
    font-size: var(--fs-small);
    font-weight: 600;
    text-align: center;
  }

  .others__head a {
    min-height: 0;
    color: var(--steel);
    font-size: inherit;
  }

  .others ul {
    display: grid;
    grid-template-columns: repeat(5, auto);
    justify-content: center;
    justify-items: center;
    gap: 0.5rem var(--s-4);
    margin: 0;
    padding: var(--s-2) 0 var(--intro-gap);
    list-style: none;
    text-align: center;
  }

  @media (max-width: 1100px) {
    .others ul {
      grid-template-columns: repeat(3, minmax(0, 14rem));
    }
  }

  @media (max-width: 760px) {
    .others ul {
      grid-template-columns: repeat(2, minmax(0, 14rem));
    }

    .soon ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .others a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-size: var(--fs-body);
    text-decoration: none;
  }

  .others a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .others__all {
    color: var(--steel);
  }

  /* Tablets and phones: the question, then the photograph under it */
  @media (max-width: 900px) {
    .sol__head {
      grid-template-columns: minmax(0, 1fr);
    }

    .sol h1 {
      max-width: 20ch;
    }

    .sol__photo :global(img) {
      aspect-ratio: 3 / 2;
    }

    .proof__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .proof__say {
      max-width: 28ch;
    }
  }

  @media (max-width: 820px) {
    .more--two .more__groups,
    .more:not(.more--two) ul {
      grid-template-columns: minmax(0, 1fr);
    }

    .see__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .see__item,
    .see__item:first-child {
      padding: 0.9rem 0;
    }

    .see__item:first-child {
      padding-top: 0;
    }

    .see__item + .see__item {
      border-inline-start: 0;
      border-top: 1px solid rgb(var(--acc-rgb) / 0.2);
    }
  }

  @media (max-width: 640px) {
    .sol__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  /* "Also in …": each feature this page took in is a collapsed row; one open at a time */
  .rows {
    margin-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .more__groups + .rows {
    margin-top: var(--s-5);
  }

  .xrow {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .xrow__h {
    margin: 0;
    font: inherit;
  }

  .xrow__head {
    display: flex;
    gap: 1rem;
    align-items: center;
    width: 100%;
    min-height: 64px;
    padding: 0.9rem 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .xrow__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(var(--acc-rgb) / 0.16);
    border-radius: 11px;
    background: var(--acc-wash);
    color: var(--acc);
  }

  .xrow__icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .xrow__text {
    flex: 1;
    min-width: 0;
  }

  .xrow__name {
    display: block;
    font-weight: 600;
  }

  .xrow__line {
    display: block;
    margin-top: 0.1rem;
    color: var(--steel);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .xrow__chev {
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--steel);
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .xrow__head[aria-expanded='true'] .xrow__chev {
    transform: rotate(180deg);
  }

  .xrow__body {
    display: grid;
    gap: var(--s-3) var(--s-5);
    padding: 0 0 var(--s-4) calc(40px + 1rem);
  }

