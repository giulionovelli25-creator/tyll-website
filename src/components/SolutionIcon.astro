---
// Quiet line icons, one per solution page (24px grid, 1.5px stroke, currentColor). Each draws what its page is about.
import type { Solution } from '../content/solutions';

interface Props {
  name: Solution['icon'];
  class?: string;
}

const { name, class: className } = Astro.props;
const paths: Record<Solution['icon'], string> = {
  // A bin
  waste: 'M4.5 6.5h15 M9.5 6.5V4h5v2.5 M6.5 6.5l1 14h9l1-14 M10 10.5v6 M14 10.5v6',
  // A crate seen from above
  stock: 'M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9Z M3.5 7.5 12 12l8.5-4.5 M12 12v9',
  // A rising line over a baseline
  forecast: 'M3.5 20.5h17 M4.5 16l5-5 3.5 3.5 6.5-7 M15 7.5h4.5V12',
  // Bars with a trend
  revenue: 'M4 20.5h16 M6.5 20.5V14 M11 20.5V10 M15.5 20.5v-8 M20 6l-5.5 3.5L11 7 5 11',
  // A receipt edge
  finance: 'M6 3.5h12v17l-2-1.3-2 1.3-2-1.3-2 1.3-2-1.3-2 1.3v-17Z M9 8h6 M9 11.5h6 M9 15h3.5',
  // A glass with a level in it
  pour: 'M7 3.5h10l-1 7a4 4 0 0 1-8 0l-1-7Z M7.6 8h8.8 M12 14.5v6 M8.5 20.5h7',
  // A calendar page with a clock hand: what expires when
  expiry: 'M4.5 5.5h15v15h-15Z M4.5 9.5h15 M8.5 3.5v4 M15.5 3.5v4 M12 12.5v3l2 1.5',
  // A clipboard with two ticked lines: a count
  takes: 'M9 3.5h6v3H9Z M9 5H5.5v15.5h13V5H15 M8 11l1.5 1.5L12.5 9.5 M8 16l1.5 1.5 3-3 M14.5 11h2 M14.5 16h2',
  // A clock inside a turning arrow: orders that go out by themselves every morning
  auto: 'M19.5 12a7.5 7.5 0 1 1-2.2-5.3 M19.5 3.5V7H16 M12 8v4l2.5 1.5',
  // A document with a tick: an order approved
  orders: 'M6 3.5h8l4 4v13H6Z M14 3.5v4h4 M9 14l2 2 4-4',
  // A delivery van: who supplies the hotel
  suppliers: 'M3 6.5h11v10H3Z M14 9.5h4l2.5 3.5v3.5H14 M5.5 18.5a1.75 1.75 0 1 0 3.5 0a1.75 1.75 0 1 0-3.5 0 M15.5 18.5a1.75 1.75 0 1 0 3.5 0a1.75 1.75 0 1 0-3.5 0',
  // Two papers side by side: the delivery note against the invoice
  deliveries: 'M3.5 4.5h7v15h-7Z M13.5 4.5h7v15h-7Z M5.5 9h3 M5.5 12h3 M5.5 15h3 M15.5 9h3 M15.5 12h3 M15.5 15h3',
  // A banknote: cash in the drawer
  cash: 'M3 7h18v10H3Z M12 9.5a2.5 2.5 0 1 1 0 5a2.5 2.5 0 0 1 0-5Z M6 10v4 M18 10v4',
  // An arrow turning back round a coin: money brought back
  cases: 'M4.5 12a7.5 7.5 0 1 0 2.2-5.3 M4 3.5v3.5h3.5 M14 9.5h-2.5a1.5 1.5 0 0 0 0 3h1a1.5 1.5 0 0 1 0 3H10 M12 8v1.5 M12 15.5V17',
  // A page with a small bar chart: a report
  reports: 'M5 3.5h14v17H5Z M8.5 16.5v-3 M12 16.5v-6 M15.5 16.5v-4.5',
};
---

<svg class={className} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]}></path>
</svg>
