---
// One line icon from the site's set (Lucide, `src/config/icons.ts`): 24 px grid, 1.5 px stroke, currentColor.
import { icons, type IconName } from '../config/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[name]} />
