---
// The first screen (10 Nov 2026, the owner: a picture behind the words instead of the receipt field, "it looks nicer";
// then this one, the owner's pick): the sunny "after" still from the hotel film's first outdoor version (a hotel with
// green awnings on a cobbled tram square, a terrace full, cyclists passing; source assets/video/city/H4-1920.jpg, copies
// in public/media/hero/ made with sharp: 1920 and 1280 wide, and an upright 9:16 crop around the hotel's entrance for
// screens narrower than 9:10) behind a centred headline, one line, Book a demo and Watch it work, in white. A dark
// shade over the photograph, deepest behind the words, keeps them readable; the header sits on it in white. No motion,
// so nothing changes under reduced motion. The receipt-field version is kept outside the repo.
import { href } from '../../i18n/routes';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section class="hero on-dark" data-hero data-dark aria-labelledby="hero-title">
  <picture class="hero__photo">
    <source media="(max-aspect-ratio: 9/10)" srcset="/media/hero/square-portrait-456.webp 456w, /media/hero/square-portrait.webp 608w" sizes="100vw" width="608" height="1080" />
    <img src="/media/hero/square-1920.webp" srcset="/media/hero/square-1280.webp 1280w, /media/hero/square-1920.webp 1920w" sizes="100vw" alt="" width="1920" height="1080" decoding="async" />
  </picture>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <div class="hero__text" data-hero-text>
      <h1 id="hero-title" class="display">
        {
          d.hero.title.split(/(?<=\.)\s+/).map((line) => (
            <span class="hero__line">
              {line}{' '}
            </span>
          ))
        }
      </h1>
      <p class="hero__sub">{d.hero.sub}</p>
      <div class="hero__actions">
        <a class="btn btn--solid btn--lg hero__book" href={href('book', lang)} data-track="book_demo_click" data-track-from="hero">
          {d.cta.book}
        </a>
        <a class="hero__watch" href={`${href('stock', lang)}#film`} data-track="watch_film_click" data-track-from="hero">
          {d.hero.watch}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--s-4)) var(--s-5);
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark);
    isolation: isolate;
  }

  .hero__photo,
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* An even shade over the whole photograph, deeper behind the words and at the top under the header */
  .hero__shade {
    background:
      radial-gradient(ellipse 62% 48% at 50% 50%, rgb(var(--night-rgb) / 0.42), transparent 75%),
      linear-gradient(to bottom, rgb(var(--night-rgb) / 0.35), transparent 30%),
      rgb(var(--night-rgb) / 0.48);
  }

  /* Upright screens: the sunlit stone sits right behind the words, so the shade is a little deeper there */
  @media (max-aspect-ratio: 9/10) {
    .hero__shade {
      background:
        radial-gradient(ellipse 90% 40% at 50% 48%, rgb(var(--night-rgb) / 0.5), transparent 80%),
        linear-gradient(to bottom, rgb(var(--night-rgb) / 0.35), transparent 30%),
        rgb(var(--night-rgb) / 0.56);
    }
  }

  .hero__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .hero h1 {
    margin: 0;
    color: var(--on-dark);
    font-size: clamp(2.5rem, 1.5rem + 3.2vw, 4.25rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.005em;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgb(var(--night-rgb) / 0.35);
  }

  .hero__line {
    display: block;
  }

  .hero__sub {
    max-width: 40rem;
    margin: var(--s-4) auto 0;
    color: rgb(var(--on-dark-rgb) / 0.9);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
    text-shadow: 0 1px 16px rgb(var(--night-rgb) / 0.45);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    align-items: center;
    justify-content: center;
    margin-top: var(--s-5);
  }

  .hero__watch {
    color: var(--on-dark);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .hero__watch:hover {
    color: rgb(var(--on-dark-rgb) / 0.8);
  }
</style>
