---
// "How Tyll helps" as a three-step story: numbered tabs, one sentence per step, and the demo screen that shows it.
// Tabs follow the ARIA tabs pattern (click, tap, arrow keys, Home/End). Nothing advances on its own.
// Without JavaScript all three steps are listed one after another, so no text is ever hidden.
import { Picture } from 'astro:assets';
import type { Solution } from '../content/solutions';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  solution: Solution;
}

const { lang, solution } = Astro.props;
const p = t(lang).solutionPage;
const id = `steps-${solution.key}`;
const steps = solution.steps.map((st, i) => ({
  n: String(i + 1).padStart(2, '0'),
  label: st.label[lang],
  text: solution.helps[lang][i],
  frame: solution.frames[st.frame],
}));
---

<div class="steps" data-steps id={id}>
  <div class="steps__tabs" role="tablist" aria-label={p.helps} hidden>
    {
      steps.map((st, i) => (
        <button
          type="button"
          role="tab"
          class="steps__tab"
          id={`${id}-tab-${i}`}
          aria-controls={`${id}-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="steps__n">{st.n}</span>
          <span class="steps__name">{st.label}</span>
        </button>
      ))
    }
  </div>

  <div class="steps__panels">
    {
      steps.map((st, i) => (
        <div class:list={['steps__panel', i === 0 && 'is-active']} role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`}>
          <div class="steps__copy">
            <h3 class="steps__heading">
              <span class="steps__n">{st.n}</span>
              {st.label}
            </h3>
            <p class="steps__text">{st.text}</p>
          </div>
          <figure class="steps__screen">
            <div class="steps__chrome" aria-hidden="true" dir="ltr">
              <span class="steps__dots"><i></i><i></i><i></i></span>
              <span class="steps__url">demo.tyll.ai</span>
            </div>
            <div class="steps__frame" dir="ltr">
              <Picture
                src={st.frame.img}
                alt={st.frame.alt[lang]}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                widths={[720, 1080, 1440]}
                sizes="(max-width: 960px) calc(100vw - 32px), 760px"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        </div>
      ))
    }
  </div>
</div>

<style>
  .steps {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }

  /* The numbered steps: a quiet row, the selected one in ink with a line beneath */
  .steps__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--silver);
  }

  .steps__tabs[hidden] {
    display: none;
  }

  .steps__tab {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.4rem 0.25rem 1.1rem;
    border: 0;
    background: none;
    color: var(--steel);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: color 0.3s var(--ease);
  }

  .steps__tab::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }

  :global([dir='rtl']) .steps__tab::after {
    transform-origin: right;
  }

  .steps__tab:hover {
    color: var(--graphite);
  }

  .steps__tab[aria-selected='true'] {
    color: var(--ink);
  }

  .steps__tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  .steps__tab:focus-visible {
    outline-offset: -2px;
  }

  .steps__n {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .steps__name {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 450;
    letter-spacing: -0.015em;
  }

  /* Without JavaScript the steps simply follow each other */
  .steps__panels {
    display: grid;
    gap: 3.5rem;
  }

  .steps__panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 3vw, 4.5rem);
  }

  .steps__heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .steps__heading .steps__n {
    color: var(--steel);
  }

  .steps__text {
    max-width: 30rem;
    margin-top: 1rem;
    color: var(--graphite);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  /* With JavaScript: the steps top left, the sentence right under them, the screen on the right.
     All three panels share one place, so changing step never moves the page. */
  .steps.is-ready {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    column-gap: clamp(2rem, 1rem + 3vw, 4.5rem);
  }

  .steps.is-ready .steps__tabs {
    grid-area: 1 / 1;
    z-index: 1;
    align-self: start;
    display: flex;
    flex-direction: column;
    border-bottom: 0;
  }

  .steps.is-ready .steps__tab {
    padding: 0.95rem 0 0.95rem 1.25rem;
    padding-inline: 1.25rem 0;
    border-inline-start: 1px solid var(--silver);
  }

  .steps.is-ready .steps__tab::after {
    inset: 0 auto 0 -1px;
    inset-inline: -1px auto;
    width: 2px;
    height: auto;
    transform: scaleY(0);
    transform-origin: top;
  }

  .steps.is-ready .steps__tab[aria-selected='true']::after {
    transform: scaleY(1);
  }

  .steps.is-ready .steps__panels {
    grid-area: 1 / 1 / 2 / 3;
    grid-template-areas: 'stack';
    gap: 0;
  }

  .steps.is-ready .steps__panel {
    column-gap: clamp(2rem, 1rem + 3vw, 4.5rem);
    align-items: start;
  }

  /* --tabs-h is the measured height of the step list above */
  .steps.is-ready .steps__copy {
    padding-top: calc(var(--tabs-h, 12.5rem) + clamp(1.75rem, 1rem + 2vw, 3rem));
  }

  .steps.is-ready .steps__panel {
    grid-area: stack;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease),
      visibility 0s linear 0.5s;
  }

  .steps.is-ready .steps__panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease),
      visibility 0s;
  }

  /* The tab already names the step; the heading stays for screen readers and the page outline */
  .steps.is-ready .steps__heading {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .steps.is-ready .steps__text {
    margin-top: 0;
    color: var(--ink);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 380;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  /* The demo screen, whole, in the same quiet browser frame as the walkthrough */
  .steps__screen {
    margin: 0;
    border-radius: 14px;
    box-shadow: 0 40px 80px -44px rgba(20, 22, 26, 0.4);
  }

  .steps__chrome {
    display: flex;
    align-items: center;
    height: 34px;
    padding: 0 0.85rem;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    background: linear-gradient(180deg, #fbfbfc, #f3f4f6);
  }

  .steps__dots {
    display: flex;
    gap: 6px;
  }

  .steps__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--silver);
  }

  .steps__url {
    margin-inline: auto;
    padding: 0.15rem 0.85rem;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--steel);
    font-size: 0.75rem;
    transform: translateX(-22px);
  }

  .steps__frame {
    aspect-ratio: 1440 / 1240;
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 14px 14px;
    background: var(--mist);
    overflow: hidden;
  }

  .steps__frame :global(picture),
  .steps__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .steps__frame :global(img) {
    object-fit: contain;
  }

  @media (max-width: 860px) {
    .steps__panel,
    .steps.is-ready .steps__panel {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 1.5rem;
    }

    /* Phones: the three steps as one row above the sentence and the screen */
    .steps.is-ready {
      display: block;
    }

    .steps.is-ready .steps__tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--silver);
    }

    .steps.is-ready .steps__tab {
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.4rem 0.25rem 0.9rem;
      border-inline-start: 0;
    }

    .steps.is-ready .steps__tab::after {
      inset: auto 0 -1px;
      width: auto;
      height: 2px;
      transform: scaleX(0);
      transform-origin: left;
    }

    :global([dir='rtl']) .steps.is-ready .steps__tab::after {
      transform-origin: right;
    }

    .steps.is-ready .steps__tab[aria-selected='true']::after {
      transform: scaleX(1);
    }

    .steps.is-ready .steps__panels {
      padding-top: 1.75rem;
    }

    .steps.is-ready .steps__copy {
      padding-top: 0;
    }

    .steps.is-ready .steps__text {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .steps.is-ready .steps__panel,
    .steps.is-ready .steps__panel.is-active,
    .steps__tab::after {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-steps]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((tab, j) => {
        const on = i === j;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[j].classList.toggle('is-active', on);
        // Screens in steps not shown stay out of the reading order
        if (on) panels[j].removeAttribute('inert');
        else panels[j].setAttribute('inert', '');
      });
      if (focus) tabs[i].focus();
    };
    list.hidden = false;
    root.classList.add('is-ready');
    new ResizeObserver(() => root.style.setProperty('--tabs-h', `${list.offsetHeight}px`)).observe(list);
    select(0);
    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));
    list.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const rtl = document.documentElement.dir === 'rtl';
      const next = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[e.key];
      if (next) select((i + next + tabs.length) % tabs.length, true);
      else if (e.key === 'Home') select(0, true);
      else if (e.key === 'End') select(tabs.length - 1, true);
      else return;
      e.preventDefault();
    });
    // Load every step's screen once the section is near, so switching is instant
    new IntersectionObserver(
      ([entry], io) => {
        if (!entry.isIntersecting) return;
        root.querySelectorAll('img[loading="lazy"]').forEach((img) => ((img as HTMLImageElement).loading = 'eager'));
        io.disconnect();
      },
      { rootMargin: '400px' },
    ).observe(root);
  });
</script>
