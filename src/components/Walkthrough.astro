---
// A short product walkthrough: numbered steps beside large, real demo screens shown in full (never cropped).
// Advances on its own while in view; visitors can pick a step or pause. With reduced motion nothing advances
// by itself. Any screen opens in a viewer that shows the whole capture, with zoom and previous/next.
import { Picture, getImage } from 'astro:assets';
import type { Frame } from '../content/solutions';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  frames: Frame[];
  note: string;
}

const { lang, frames, note } = Astro.props;
const s = t(lang).solutionPage;
// Full-resolution versions for the viewer, loaded only when it opens
const full = await Promise.all(frames.map((f) => getImage({ src: f.img, width: f.img.width, format: 'webp', quality: 85 })));
---

<div class="walk" data-walk>
  <ol class="walk__steps">
    {
      frames.map((f, i) => (
        <li>
          <button type="button" class="walk__step" aria-current={i === 0 ? 'step' : undefined}>
            <span class="walk__n">{i + 1}</span>
            <span>
              <span class="walk__title">{f.title[lang]}</span>
              <span class="walk__text">{f.text[lang]}</span>
            </span>
            <span class="walk__bar" aria-hidden="true" />
          </button>
        </li>
      ))
    }
  </ol>

  <div class="walk__screen">
    <!-- The demo itself is English and left-to-right, so its browser frame stays left-to-right in every language -->
    <div class="walk__chrome" aria-hidden="true" dir="ltr">
      <span class="walk__dots"><i></i><i></i><i></i></span>
      <span class="walk__url">
        <svg viewBox="0 0 12 12"><path d="M3.5 5.5V4a2.5 2.5 0 0 1 5 0v1.5M3 5.5h6v4.5H3z" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" /></svg>
        demo.tyll.ai
      </span>
    </div>
    <div class="walk__frame" dir="ltr">
      {
        frames.map((f, i) => (
          <button
            type="button"
            class:list={['walk__slide', f.phone && 'walk__slide--phone', i === 0 && 'is-active']}
            data-slide={i}
            data-full={full[i].src}
            data-title={`${i + 1}. ${f.title[lang]}`}
            data-alt={f.alt[lang]}
            data-phone={f.phone ? '' : undefined}
            aria-hidden={i === 0 ? undefined : 'true'}
            tabindex={i === 0 ? undefined : -1}
          >
            <Picture
              src={f.img}
              alt={f.alt[lang]}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={f.phone ? [390, 780] : [720, 1080, 1440, 2160]}
              sizes={f.phone ? '320px' : '(max-width: 960px) calc(100vw - 32px), 820px'}
              loading="lazy"
              decoding="async"
            />
            <span class="walk__zoom">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 2.5h-4v4M9.5 2.5h4v4M6.5 13.5h-4v-4M9.5 13.5h4v-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span class="visually-hidden">{s.enlarge}</span>
            </span>
          </button>
        ))
      }
    </div>
    <div class="walk__controls">
      <p class="walk__note">{note}</p>
      <button type="button" class="walk__toggle" aria-pressed="false" data-pause={s.pause} data-play={s.play} hidden>
        <span class="visually-hidden">{s.pause}</span>
        <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.25v10H4.5zM9.25 3h2.25v10H9.25z" fill="currentColor" /></svg>
        <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor" /></svg>
      </button>
    </div>
  </div>

  <dialog class="viewer" aria-label={s.viewer}>
    <div class="viewer__bar">
      <p class="viewer__title" aria-live="polite"></p>
      <div class="viewer__tools">
        <button type="button" class="viewer__btn" data-viewer="prev" aria-label={s.prev}>
          <svg class="flip-rtl" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="viewer__btn" data-viewer="next" aria-label={s.next}>
          <svg class="flip-rtl" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="viewer__btn viewer__zoom" data-viewer="zoom" aria-pressed="false" data-in={s.zoomIn} data-out={s.zoomOut}>
          {s.zoomIn}
        </button>
        <button type="button" class="viewer__btn" data-viewer="close" aria-label={s.close}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
      </div>
    </div>
    <div class="viewer__stage">
      <img class="viewer__img" alt="" decoding="async" />
    </div>
  </dialog>
</div>

<style>
  .walk {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: start;
  }

  .walk__steps {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .walk__step {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0.8rem;
    width: 100%;
    padding: 0.95rem 1rem 1.05rem;
    border: 0;
    border-radius: 14px;
    background: transparent;
    color: var(--steel);
    font: inherit;
    text-align: start;
    cursor: pointer;
    overflow: hidden;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .walk__step:hover {
    color: var(--ink);
  }

  .walk__step[aria-current] {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--line);
  }

  .walk__n {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--silver);
    border-radius: 50%;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  [aria-current] .walk__n {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .walk__title {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .walk__text {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .walk__step:not([aria-current]) .walk__text {
    display: none;
  }

  .walk__bar {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0;
    height: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  :global([dir='rtl']) .walk__bar {
    transform-origin: right;
  }

  [data-walk].is-playing [aria-current] .walk__bar {
    animation: walk-progress var(--frame-ms, 5000ms) linear forwards;
  }

  @keyframes walk-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* A quiet browser frame. The screen area matches the captures (1440 × 1240), and images are
     contained, never cropped: every screen is shown whole on every width. */
  .walk__chrome {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 38px;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    background: linear-gradient(180deg, #fbfbfc, #f3f4f6);
  }

  .walk__dots {
    display: flex;
    gap: 6px;
  }

  .walk__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--silver);
  }

  .walk__url {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-inline: auto;
    padding: 0.2rem 0.9rem;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--steel);
    font-size: 0.75rem;
    transform: translateX(-24px);
  }

  .walk__url svg {
    width: 11px;
    height: 11px;
  }

  .walk__frame {
    position: relative;
    aspect-ratio: 1440 / 1240;
    border: 1px solid var(--line);
    border-radius: 0 0 14px 14px;
    background: var(--mist);
    box-shadow: 0 40px 80px -40px rgba(20, 22, 26, 0.35);
    overflow: hidden;
  }

  .walk__slide {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    opacity: 0;
    cursor: zoom-in;
    transition: opacity 0.6s var(--ease);
  }

  .walk__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .walk__slide :global(picture),
  .walk__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .walk__slide :global(img) {
    object-fit: contain;
  }

  .walk__zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(20, 22, 26, 0.72);
    color: var(--paper);
    opacity: 0.85;
    transition: opacity 0.2s var(--ease);
  }

  .walk__slide:hover .walk__zoom,
  .walk__slide:focus-visible .walk__zoom {
    opacity: 1;
  }

  .walk__zoom svg {
    width: 15px;
    height: 15px;
  }

  /* A phone screen stands on a silver ground */
  .walk__slide--phone {
    background:
      radial-gradient(70% 70% at 50% 40%, var(--paper), transparent),
      url('/media/tyll-waves.webp') center / cover,
      var(--mist);
  }

  /* Positioned, so the height is definite and the whole phone screen fits the frame at any width */
  .walk__slide--phone :global(picture) {
    position: absolute;
    inset: 4% 0;
    display: flex;
    justify-content: center;
    width: 100%;
    height: auto;
  }

  .walk__slide--phone :global(img) {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 22px;
    box-shadow:
      0 0 0 1px var(--line),
      0 30px 60px -30px rgba(20, 22, 26, 0.45);
  }

  .walk__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .walk__note {
    color: var(--steel);
    font-size: 0.8125rem;
  }

  .walk__toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--silver);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .walk__toggle svg {
    width: 13px;
    height: 13px;
  }

  .walk__toggle .i-play,
  .walk__toggle[aria-pressed='true'] .i-pause {
    display: none;
  }

  .walk__toggle[aria-pressed='true'] .i-play {
    display: block;
  }

  /* The viewer */
  .viewer {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(14, 15, 17, 0.96);
    color: var(--on-dark);
  }

  .viewer::backdrop {
    background: rgba(14, 15, 17, 0.6);
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .viewer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem max(16px, 2vw);
    border-bottom: 1px solid rgba(244, 245, 247, 0.1);
  }

  .viewer__title {
    overflow: hidden;
    font-size: 0.9375rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .viewer__tools {
    display: flex;
    flex: none;
    gap: 0.4rem;
  }

  .viewer__btn {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.6rem;
    border: 1px solid rgba(244, 245, 247, 0.22);
    border-radius: 999px;
    background: transparent;
    color: var(--on-dark);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .viewer__btn:hover {
    border-color: var(--on-dark);
  }

  .viewer__btn svg {
    width: 15px;
    height: 15px;
  }

  .viewer__stage {
    display: grid;
    place-items: center;
    overflow: auto;
    padding: max(12px, 2vw);
    overscroll-behavior: contain;
  }

  /* Fit: the whole screen is visible. Zoomed: actual size, scroll to move around */
  .viewer__img {
    max-width: 100%;
    max-height: calc(100dvh - 64px - 2 * max(12px, 2vw));
    border-radius: 8px;
    background: var(--paper);
    cursor: zoom-in;
  }

  .viewer.is-zoomed .viewer__stage {
    place-items: start;
  }

  .viewer.is-zoomed .viewer__img {
    max-width: none;
    max-height: none;
    width: min(1440px, 200vw);
    cursor: zoom-out;
  }

  .viewer.is-zoomed .viewer__img.is-phone {
    width: 390px;
  }

  @media (max-width: 960px) {
    .walk {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Screen first on narrow layouts, the numbered steps underneath */
    .walk__screen {
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .viewer__zoom {
      display: none;
    }
  }
</style>

<script>
  const FRAME_MS = 5000;
  document.querySelectorAll<HTMLElement>('[data-walk]').forEach((walk) => {
    const steps = [...walk.querySelectorAll<HTMLButtonElement>('.walk__step')];
    const slides = [...walk.querySelectorAll<HTMLButtonElement>('[data-slide]')];
    const toggle = walk.querySelector<HTMLButtonElement>('.walk__toggle')!;
    const label = toggle.querySelector('.visually-hidden')!;
    walk.style.setProperty('--frame-ms', `${FRAME_MS}ms`);

    let index = 0;
    let timer = 0;
    let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let visible = false;

    const eager = (i: number) => slides[i]?.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
    const show = (i: number) => {
      index = (i + steps.length) % steps.length;
      steps.forEach((s, k) => (k === index ? s.setAttribute('aria-current', 'step') : s.removeAttribute('aria-current')));
      slides.forEach((sl, k) => {
        const on = k === index;
        sl.classList.toggle('is-active', on);
        if (on) {
          sl.removeAttribute('aria-hidden');
          sl.removeAttribute('tabindex');
        } else {
          sl.setAttribute('aria-hidden', 'true');
          sl.tabIndex = -1;
        }
      });
      eager(index);
      eager(index + 1); // the next screen loads before it is needed
    };
    const schedule = () => {
      clearTimeout(timer);
      walk.classList.remove('is-playing');
      if (paused || !visible || viewer.open) return;
      void walk.offsetWidth; // restart the progress bar
      walk.classList.add('is-playing');
      timer = window.setTimeout(() => {
        show(index + 1);
        schedule();
      }, FRAME_MS);
    };
    const syncToggle = () => {
      toggle.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? toggle.dataset.play! : toggle.dataset.pause!;
    };

    steps.forEach((s, i) =>
      s.addEventListener('click', () => {
        show(i);
        schedule();
      }),
    );
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      paused = !paused;
      syncToggle();
      schedule();
    });
    // Hovering with a mouse holds the current screen while it is being read
    walk.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(timer);
      walk.classList.remove('is-playing');
    });
    walk.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && schedule());

    // ── The viewer ──
    const viewer = walk.querySelector<HTMLDialogElement>('.viewer')!;
    const vImg = viewer.querySelector<HTMLImageElement>('.viewer__img')!;
    const vTitle = viewer.querySelector<HTMLElement>('.viewer__title')!;
    const vZoom = viewer.querySelector<HTMLButtonElement>('[data-viewer="zoom"]')!;
    let opener: HTMLElement | null = null;
    const setZoom = (on: boolean) => {
      viewer.classList.toggle('is-zoomed', on);
      vZoom.setAttribute('aria-pressed', String(on));
      vZoom.textContent = on ? vZoom.dataset.out! : vZoom.dataset.in!;
    };
    const load = (i: number) => {
      show(i);
      const sl = slides[index];
      vImg.src = sl.dataset.full!;
      vImg.alt = sl.dataset.alt!;
      vImg.classList.toggle('is-phone', sl.hasAttribute('data-phone'));
      vTitle.textContent = `${sl.dataset.title} · ${index + 1} / ${slides.length}`;
      setZoom(false);
    };
    slides.forEach((sl, i) =>
      sl.addEventListener('click', () => {
        opener = sl;
        clearTimeout(timer);
        walk.classList.remove('is-playing');
        load(i);
        viewer.showModal();
        viewer.querySelector<HTMLElement>('[data-viewer="close"]')!.focus();
      }),
    );
    viewer.addEventListener('click', (e) => {
      const action = (e.target as Element).closest<HTMLElement>('[data-viewer]')?.dataset.viewer;
      if (action === 'close') viewer.close();
      else if (action === 'prev') load(index - 1);
      else if (action === 'next') load(index + 1);
      else if (action === 'zoom') setZoom(!viewer.classList.contains('is-zoomed'));
      else if (e.target === vImg) setZoom(!viewer.classList.contains('is-zoomed'));
    });
    viewer.addEventListener('keydown', (e) => {
      // In right-to-left pages the next screen is to the left
      const rtl = document.documentElement.dir === 'rtl';
      if (e.key === 'ArrowLeft') load(index + (rtl ? 1 : -1));
      if (e.key === 'ArrowRight') load(index + (rtl ? -1 : 1));
    });
    // Closing returns focus to the screen that was opened, which now shows the last viewed step
    viewer.addEventListener('close', () => {
      (slides[index] ?? opener)?.focus({ preventScroll: true });
      schedule();
    });

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        if (visible) eager(index);
        schedule();
      },
      { threshold: 0.35 },
    ).observe(walk.querySelector('.walk__frame')!);
    syncToggle();
  });
</script>
