---
// Homepage chapter 2: hotel systems → Tyll → investigate.
// 01 Quiet chips on the left show the hotel's existing systems, each with one fact.
// 02 Fine silver paths lead into the Tyll overview in the centre, the largest and brightest element: what needs
//    attention across departments. Its three items are tabs.
// 03 The selected item opens on the right like an investigation: status, the evidence from the systems it came
//    from, who is responsible. "Review the evidence" opens the underlying records and lights up their sources.
// A short introduction (about 2.5 s) plays once when the section comes into view; any click or key press takes over
// at once, and Replay runs it again. Without JavaScript, or with reduced motion, everything is shown at once.
// All data is fictional and matches the simulated Tyll demo.
import Logo from '../Logo.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = t(lang).home.problem;
const f = p.frags;
const v = p.view;
const fwd = lang === 'ar' ? '←' : '→';

// The items in the Tyll overview, and which systems each one comes from
const rows = [
  { id: 'issue', marks: ['pos', 'stock'], title: v.issue, team: '', status: v.status, amber: true },
  { id: 'room', marks: ['pms'], title: v.tasks[0].title, team: v.tasks[0].team, status: v.tasks[0].status, amber: false },
  { id: 'invoice', marks: ['finance'], title: v.tasks[1].title, team: v.tasks[1].team, status: v.tasks[1].status, amber: false },
];
---

<section class="story" id="story" aria-labelledby="story-title" data-story>
  <div class="wrap">
    <header class="story__head">
      <h2 id="story-title">{p.title}</h2>
      <div class="story__intro">
        <p>{p.text}</p>
        <p class="story__note">{p.note}</p>
      </div>
    </header>

    <div class="flow" data-flow data-stage="done" data-active="issue">
      <svg class="flow__paths" aria-hidden="true"></svg>

      <!-- 01 The hotel's systems -->
      <div class="flow__col flow__col--systems">
        <p class="flow__caption">
          <span class="flow__kicker"><span class="flow__n">01</span>{p.beforeLabel}</span>
          <span class="flow__msg">{p.before}</span>
        </p>
        <ul class="systems" aria-label={p.before}>
          <li class="sys" data-src="pos" data-feeds="issue" style="--i:0">
            <span class="sys__name"><i class="mark mark--pos" aria-hidden="true"></i>{f.pos.sys}</span>
            <span class="sys__fact">{f.pos.flag}</span>
          </li>
          <li class="sys" data-src="stock" data-feeds="issue" style="--i:1">
            <span class="sys__name"><i class="mark mark--stock" aria-hidden="true"></i>{f.stock.sys}</span>
            <span class="sys__fact">{f.stock.flag}</span>
          </li>
          <li class="sys" data-src="pms" data-feeds="room" style="--i:2">
            <span class="sys__name"><i class="mark mark--pms" aria-hidden="true"></i>{f.pms.sys}</span>
            <span class="sys__fact">{f.pms.line}</span>
          </li>
          <li class="sys" data-src="finance" data-feeds="invoice" style="--i:3">
            <span class="sys__name"><i class="mark mark--finance" aria-hidden="true"></i>{f.finance.sys}</span>
            <span class="sys__fact">{f.finance.rows[0][0]} {f.finance.rows[0][1]} · {f.finance.rows[1][0]} {f.finance.rows[1][1]}</span>
          </li>
        </ul>
      </div>

      <!-- 02 Tyll: the important things from every department, in one overview -->
      <div class="flow__col flow__col--tyll">
        <p class="flow__caption flow__caption--after">
          <span class="flow__kicker"><span class="flow__n">02</span><Logo mark label="" class="flow__tick" />{p.afterLabel}</span>
          <span class="flow__msg">{p.after}</span>
        </p>
        <div class="tyll">
          <div class="tyll__bar">
            <Logo mark label="" class="tyll__mark" />
            <span>Tyll</span>
            <span class="tyll__place">{v.place}</span>
          </div>
          <p class="tyll__heading" id="flow-attention">{v.attention} <span>{rows.length}</span></p>
          <div class="tyll__rows" role="tablist" aria-labelledby="flow-attention" aria-orientation="vertical">
            {
              rows.map((r, i) => (
                <button
                  type="button"
                  role="tab"
                  class:list={['row', r.amber && 'row--amber']}
                  id={`flow-tab-${r.id}`}
                  data-row={r.id}
                  aria-controls={`flow-panel-${r.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  style={`--i:${i}`}
                >
                  <span class="row__marks" aria-hidden="true">
                    {r.marks.map((m) => (
                      <i class={`mark mark--${m}`} />
                    ))}
                  </span>
                  <span class="row__title">{r.title}</span>
                  <span class="row__meta">
                    {r.team && <span class="row__team">{r.team}</span>}
                    <span class:list={['row__status', r.amber && 'row__status--amber']}>{r.status}</span>
                  </span>
                  <span class="row__open" aria-hidden="true">{fwd}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- 03 Investigate: the selected item, its evidence and the next step -->
      <div class="flow__col flow__col--next">
        <p class="flow__caption flow__caption--next">
          <span class="flow__kicker"><span class="flow__n">03</span>{p.investigateLabel}</span>
          <span class="flow__msg">{p.investigate}</span>
        </p>

        <article class="next" id="flow-panel-issue" role="tabpanel" aria-labelledby="flow-tab-issue" data-panel="issue">
          <span class="chip chip--amber">{v.status}</span>
          <h3>{v.issue}</h3>
          <p class="next__line">{v.issueLine}</p>
          <ul class="evidence">
            <li data-evidence="stock">
              <span class="src"><i class="mark mark--stock" aria-hidden="true"></i>{f.stock.sys}</span>
              <span>{v.evidence[0]}</span>
              <div class="record" data-record>
                <span class="record__title">{f.stock.title}</span>
                <span class="record__data">
                  <span>{f.stock.head[1]} <b>{f.stock.vals[1]}</b></span>
                  <span>{f.stock.head[2]} <b>{f.stock.vals[2]}</b></span>
                  <span class="chip chip--amber">{f.stock.flag}</span>
                </span>
              </div>
            </li>
            <li data-evidence="pos">
              <span class="src"><i class="mark mark--pos" aria-hidden="true"></i>{f.pos.sys}</span>
              <span>{v.evidence[1]}</span>
              <div class="record" data-record>
                <span class="record__title">{f.pos.title}</span>
                <span class="record__data">
                  <s>{f.pos.rows[0][0]}</s><s>{f.pos.rows[0][1]}</s>
                  <span class="chip chip--amber">{f.pos.flag}</span>
                </span>
              </div>
            </li>
          </ul>
          <div class="next__foot">
            <p class="next__owner"><span>{v.owner}</span>{v.ownerName}</p>
            <button type="button" class="next__action" data-review aria-expanded="true" data-open={`${v.next} ${fwd}`} data-close={p.hideEvidence} hidden>
              {v.next} {fwd}
            </button>
          </div>
          <p class="next__caution">{v.caution}</p>
        </article>

        <article class="next" id="flow-panel-room" role="tabpanel" aria-labelledby="flow-tab-room" data-panel="room" hidden>
          <span class="chip">{v.tasks[0].status}</span>
          <h3>{v.tasks[0].title}</h3>
          <p class="next__line"><span class="chip">{v.tasks[0].team}</span></p>
          <div class="record record--open">
            <span class="src"><i class="mark mark--pms" aria-hidden="true"></i>{f.pms.sys}</span>
            <span class="record__title">{f.pms.title}</span>
            <span class="record__data"><span class="chip">{f.pms.status}</span><span>{f.pms.line}</span></span>
          </div>
        </article>

        <article class="next" id="flow-panel-invoice" role="tabpanel" aria-labelledby="flow-tab-invoice" data-panel="invoice" hidden>
          <span class="chip">{v.tasks[1].status}</span>
          <h3>{v.tasks[1].title}</h3>
          <p class="next__line"><span class="chip">{v.tasks[1].team}</span></p>
          <div class="record record--open">
            <span class="src"><i class="mark mark--finance" aria-hidden="true"></i>{f.finance.sys}</span>
            <span class="record__title">{f.finance.title}</span>
            <span class="record__data">
              <span>{f.finance.rows[0][0]} <b>{f.finance.rows[0][1]}</b></span>
              <span>{f.finance.rows[1][0]} <b>{f.finance.rows[1][1]}</b></span>
              <span class="chip">{f.finance.flag}</span>
            </span>
          </div>
        </article>
      </div>

      <button type="button" class="flow__replay" data-replay hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8a4.8 4.8 0 1 0 1.5-3.5M3 2.6v2.6h2.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {p.replay}
      </button>
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: var(--section-y);
    background: var(--paper);
  }

  .story__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 1rem + 4vw, 6rem);
    align-items: end;
  }

  .story__head h2 {
    max-width: 13ch;
    font-size: var(--fs-h2);
  }

  .story__intro > p:first-child {
    max-width: 34rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .story__note {
    max-width: 30rem;
    margin-top: 1rem;
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /* ── The stage ── */
  .flow {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.25fr) minmax(0, 1fr);
    column-gap: clamp(2.5rem, 0.5rem + 4.5vw, 5.5rem);
    align-items: start;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding: clamp(2rem, 1.25rem + 2.5vw, 3.5rem) clamp(1.5rem, 0.75rem + 2.5vw, 3.25rem) clamp(3.5rem, 2.5rem + 2.5vw, 4.75rem);
    border-radius: 28px;
    background:
      radial-gradient(55% 75% at 48% 52%, rgba(200, 205, 212, 0.13), transparent 70%),
      linear-gradient(160deg, #1d2025 0%, #14161a 55%, #101114 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 60px 120px -60px rgba(20, 22, 26, 0.55);
    color: var(--on-dark);
    isolation: isolate;
  }

  .flow__paths {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  /* Fine, quiet paths; the ones that lead to the selected item are a little brighter */
  .flow__paths :global(.path) {
    fill: none;
    stroke: rgba(200, 205, 212, 0.16);
    stroke-width: 1;
    stroke-linecap: round;
    transition: stroke 0.5s var(--ease);
  }

  .flow__paths :global(.path.is-lit) {
    stroke: rgba(226, 229, 233, 0.5);
  }

  .flow__paths :global(.pulse) {
    fill: none;
    stroke: url(#flow-pulse);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0;
  }

  .flow__col {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .flow__caption {
    display: grid;
    gap: 0.3rem;
    min-height: 4.25rem;
    margin: 0;
  }

  .flow__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fog);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .flow__n {
    color: rgba(244, 245, 247, 0.4);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .flow__kicker :global(.flow__tick) {
    width: 16px;
    height: auto;
    color: var(--on-dark);
  }

  .flow__msg {
    color: var(--on-dark);
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.3125rem);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .mark {
    display: inline-block;
    flex: none;
    width: 8px;
    height: 8px;
    border: 1.5px solid currentColor;
  }

  .mark--pos {
    border-radius: 2px;
  }

  .mark--stock {
    border-radius: 50%;
  }

  .mark--pms {
    transform: rotate(45deg) scale(0.9);
  }

  .mark--finance {
    border-radius: 2px 50% 50% 2px;
  }

  /* 01 Systems: quiet glass chips, one fact each */
  .systems {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sys {
    display: grid;
    gap: 0.25rem;
    padding: 0.7rem 0.85rem 0.75rem;
    border: 1px solid rgba(244, 245, 247, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.045);
    font-size: 0.875rem;
    line-height: 1.35;
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      border-color 0.5s var(--ease),
      background-color 0.5s var(--ease);
  }

  .sys.is-lit {
    border-color: rgba(244, 245, 247, 0.38);
    background: rgba(255, 255, 255, 0.09);
  }

  .sys__name {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--fog);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sys__fact {
    color: rgba(244, 245, 247, 0.88);
  }

  /* 02 The Tyll overview: the centrepiece */
  .tyll {
    border-radius: 22px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 50px 100px -40px rgba(0, 0, 0, 0.8),
      0 0 160px -30px rgba(200, 205, 212, 0.22);
    color: var(--ink);
    overflow: hidden;
  }

  .tyll__bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.3rem;
    border-bottom: 1px solid var(--line);
    font-size: 1rem;
    font-weight: 600;
  }

  .tyll :global(.tyll__mark) {
    width: 18px;
    height: auto;
  }

  .tyll__place {
    margin-inline-start: auto;
    color: var(--steel);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .tyll__heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1.15rem 1.3rem 0.7rem;
    color: var(--graphite);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .tyll__heading span {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
  }

  .tyll__rows {
    display: grid;
    gap: 0.35rem;
    padding: 0 0.8rem 1rem;
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'marks title open'
      '. meta open';
    gap: 0.4rem 0.75rem;
    align-items: center;
    width: 100%;
    padding: 0.9rem 0.95rem;
    border: 1px solid transparent;
    border-radius: 14px;
    background: transparent;
    color: var(--graphite);
    font: inherit;
    font-size: 1rem;
    text-align: start;
    cursor: pointer;
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .row:hover {
    background: var(--mist);
  }

  .row:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .row__marks {
    grid-area: marks;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    align-self: start;
    padding-top: 0.45rem;
  }

  .row__title {
    grid-area: title;
    color: var(--ink);
    font-weight: 500;
  }

  .row__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .row__open {
    grid-area: open;
    color: var(--fog);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .row:hover .row__open,
  .row[aria-selected='true'] .row__open {
    opacity: 1;
  }

  /* The selected item stands out; the others stay readable but quieter */
  .row[aria-selected='true'] {
    border-color: var(--silver);
    background: #fff;
    box-shadow: 0 10px 24px -16px rgba(20, 22, 26, 0.35);
  }

  .row--amber[aria-selected='true'] {
    border-color: #e3c98f;
    background: linear-gradient(180deg, #fffcf5, #fff);
    box-shadow: 0 0 0 4px rgba(227, 201, 143, 0.18);
  }

  .row[aria-selected='false'] .row__title {
    color: var(--graphite);
  }

  .chip,
  .row__status,
  .row__team {
    display: inline-block;
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--graphite);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .chip--amber,
  .row__status--amber {
    border-color: transparent;
    background: #fbf2df;
    color: #7a4b08;
  }

  /* 03 The investigation */
  .next {
    display: grid;
    gap: 0.6rem;
    padding: 1.25rem 1.3rem 1.2rem;
    border-radius: 20px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 40px 80px -40px rgba(0, 0, 0, 0.75);
    color: var(--ink);
  }

  .next[hidden] {
    display: none;
  }

  .next > .chip {
    justify-self: start;
  }

  .next h3 {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .next__line {
    color: var(--graphite);
    font-size: 0.9375rem;
  }

  .evidence {
    display: grid;
    gap: 0.5rem;
    margin: 0.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .evidence > li {
    display: grid;
    gap: 0.25rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--graphite);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .src {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--steel);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The underlying record, opened by "Review the evidence" */
  .record {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.35rem;
    padding: 0.6rem 0.7rem;
    border-radius: 10px;
    background: var(--mist);
    font-size: 0.8125rem;
  }

  .record--open {
    margin-top: 0.2rem;
  }

  .record__title {
    color: var(--ink);
    font-weight: 500;
  }

  .record__data {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.9rem;
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }

  .record__data b {
    color: var(--ink);
  }

  .record__data s {
    color: var(--steel);
    text-decoration-color: rgba(176, 53, 43, 0.7);
  }

  .flow.is-ready .evidence:not(.is-open) .record {
    display: none;
  }

  .next__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin-top: 0.3rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .next__owner {
    font-size: 0.875rem;
  }

  .next__owner span {
    display: block;
    color: var(--steel);
    font-size: 0.75rem;
  }

  .next__action {
    min-height: 40px;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }

  .next__action:hover {
    background: var(--graphite);
  }

  .next__action:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .next__action[hidden] {
    display: none;
  }

  .next__caution {
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .flow__replay {
    position: absolute;
    inset-inline-end: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    bottom: clamp(0.9rem, 0.6rem + 1vw, 1.4rem);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0 0.85rem;
    border: 1px solid rgba(244, 245, 247, 0.2);
    border-radius: 999px;
    background: transparent;
    color: var(--on-dark-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .flow__replay[hidden] {
    display: none;
  }

  .flow__replay:hover {
    border-color: rgba(244, 245, 247, 0.5);
    color: var(--on-dark);
  }

  .flow__replay svg {
    width: 14px;
    height: 14px;
  }

  /* ── The short introduction. data-stage: 0 → 1 systems → 2 Tyll → 3 items → done ── */
  .flow .flow__caption,
  .flow .tyll,
  .flow .next {
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
  }

  .flow[data-stage='0'] :is(.sys, .flow__col--systems .flow__caption) {
    opacity: 0;
    transform: translateY(8px);
  }

  .flow:is([data-stage='0'], [data-stage='1']) :is(.tyll, .flow__caption--after) {
    opacity: 0;
    transform: scale(0.97);
  }

  .flow:is([data-stage='0'], [data-stage='1'], [data-stage='2']) .row {
    opacity: 0;
    transform: translateY(6px);
  }

  .flow:not([data-stage='done']) :is(.next, .flow__caption--next) {
    opacity: 0;
    transform: translateX(var(--from, 14px));
  }

  :global([dir='rtl']) .flow {
    --from: -14px;
  }

  .flow .sys {
    transition-delay: calc(var(--i) * 90ms);
  }

  .flow .tyll {
    transition-delay: 0.15s;
  }

  .flow .row {
    transition-delay: calc(var(--i) * 120ms);
  }

  .flow[data-reset] *,
  .flow[data-reset] :global(*) {
    transition: none !important;
  }

  .flow[data-measure] :is(.sys, .tyll, .row, .next, .flow__caption) {
    transform: none !important;
  }

  /* A panel that is switched in by the visitor fades up gently */
  .next.is-entering {
    animation: next-in 0.45s var(--ease);
  }

  @keyframes next-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  /* Paths draw during the introduction; one faint light travels along each, once */
  .flow__paths :global(.path) {
    stroke-dasharray: var(--len) var(--len);
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 0.9s var(--ease),
      stroke 0.5s var(--ease);
    transition-delay: calc(var(--i) * 90ms), 0s;
  }

  .flow:is([data-stage='0'], [data-stage='1']) :global(.path) {
    stroke-dashoffset: var(--len);
  }

  .flow:not([data-stage='done']) :global(.path--next) {
    stroke-dashoffset: var(--len);
  }

  .flow[data-stage='2'] :global(.pulse:not(.pulse--next)) {
    animation: flow-pulse 1.2s var(--ease) both;
    animation-delay: calc(0.15s + var(--i) * 90ms);
  }

  @keyframes flow-pulse {
    0% {
      opacity: 0;
      stroke-dashoffset: 40;
    }
    20% {
      opacity: 0.8;
    }
    80% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      stroke-dashoffset: calc(var(--len) * -1);
    }
  }

  /* ── Narrow screens: 01, 02 and 03 one after another ── */
  @media (max-width: 1000px) {
    .story__head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .flow {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 3rem;
      padding-bottom: 4.75rem;
    }

    .flow__caption {
      min-height: 0;
    }

    .systems {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .flow {
      padding-inline: 1rem;
      border-radius: 22px;
    }

    .sys {
      padding: 0.6rem 0.7rem 0.65rem;
      font-size: 0.8125rem;
    }

    .tyll__bar,
    .tyll__heading {
      padding-inline: 1rem;
    }

    .tyll__rows {
      padding-inline: 0.5rem;
    }

    .row {
      padding: 0.8rem 0.75rem;
      font-size: 0.9375rem;
    }

    .flow__replay {
      inset-inline-end: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__paths :global(.pulse) {
      display: none;
    }

    .next.is-entering {
      animation: none;
    }
  }
</style>

<script>
  const flow = document.querySelector<HTMLElement>('[data-flow]');

  if (flow) {
    const svg = flow.querySelector<SVGSVGElement>('.flow__paths')!;
    const tyll = flow.querySelector<HTMLElement>('.tyll')!;
    const tabs = [...flow.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...flow.querySelectorAll<HTMLElement>('[data-panel]')];
    const sources = [...flow.querySelectorAll<HTMLElement>('[data-src]')];
    const evidence = flow.querySelector<HTMLElement>('.evidence')!;
    const review = flow.querySelector<HTMLButtonElement>('[data-review]')!;
    const replay = flow.querySelector<HTMLButtonElement>('[data-replay]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const NS = 'http://www.w3.org/2000/svg';

    // ── Paths, drawn between the real positions of the cards ──
    const draw = () => {
      flow.setAttribute('data-reset', '');
      flow.setAttribute('data-measure', '');
      const box = flow.getBoundingClientRect();
      const rel = (el: Element) => {
        const r = el.getBoundingClientRect();
        return { l: r.left - box.left, r: r.right - box.left, t: r.top - box.top, b: r.bottom - box.top, cx: r.left - box.left + r.width / 2, cy: r.top - box.top + r.height / 2 };
      };
      const t = rel(tyll);
      const panel = rel(panels.find((x) => !x.hidden) ?? panels[0]);
      const grid = rel(flow.querySelector('.systems')!);
      const cap = rel(flow.querySelector('.flow__caption--after')!);
      const capNext = rel(flow.querySelector('.flow__caption--next')!);
      const rows = Object.fromEntries(tabs.map((tab) => [tab.dataset.row!, rel(tab)]));
      flow.removeAttribute('data-measure');
      void flow.offsetWidth;
      flow.removeAttribute('data-reset');

      const rtl = document.documentElement.dir === 'rtl';
      const stacked = t.t > grid.b;
      const curve = (x1: number, y1: number, x2: number, y2: number, vertical: boolean) =>
        vertical
          ? `M ${x1} ${y1} C ${x1} ${(y1 + y2) / 2}, ${x2} ${(y1 + y2) / 2}, ${x2} ${y2}`
          : `M ${x1} ${y1} C ${(x1 + x2) / 2} ${y1}, ${(x1 + x2) / 2} ${y2}, ${x2} ${y2}`;
      const items: { d: string; feeds: string; next?: boolean }[] = [];
      const starts = sources.map((s) => { const c = rel(s); return c.cx + (c.t < grid.t + 4 ? -10 : 10); }).sort((a, b) => a - b);
      sources.forEach((s) => {
        const c = rel(s);
        const feeds = s.dataset.feeds!;
        if (stacked) {
          const x1 = c.cx + (c.t < grid.t + 4 ? -10 : 10);
          const x2 = t.cx + (starts.indexOf(x1) - (sources.length - 1) / 2) * 22;
          items.push({ d: curve(x1, grid.b + 6, x2, cap.t - 10, true), feeds });
        } else {
          items.push({ d: curve(rtl ? c.l - 6 : c.r + 6, c.cy, rtl ? t.r + 6 : t.l - 6, rows[feeds].cy, false), feeds });
        }
      });
      const from = rows[flow.dataset.active!] ?? rows.issue;
      items.push({
        d: stacked ? curve(t.cx, t.b + 6, t.cx, capNext.t - 10, true) : curve(rtl ? t.l - 6 : t.r + 6, from.cy, rtl ? panel.r + 6 : panel.l - 6, panel.t + 40, false),
        feeds: 'next',
        next: true,
      });

      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      svg.replaceChildren();
      const defs = document.createElementNS(NS, 'defs');
      defs.innerHTML =
        '<linearGradient id="flow-pulse" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset="0.6" stop-color="#fff" stop-opacity="0.8"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>';
      svg.append(defs);
      items.forEach((it, i) => {
        for (const cls of ['path', 'pulse']) {
          const el = document.createElementNS(NS, 'path');
          el.setAttribute('d', it.d);
          el.setAttribute('class', `${cls}${it.next ? ` ${cls}--next` : ''}`);
          el.dataset.feeds = it.feeds;
          svg.append(el);
          const len = Math.ceil((el as SVGPathElement).getTotalLength());
          el.style.setProperty('--len', String(len));
          el.style.setProperty('--i', String(i));
          if (cls === 'pulse') el.style.strokeDasharray = `40 ${len + 40}`;
        }
      });
      light();
    };

    // ── Selection: which item is open, which sources and paths lead to it ──
    let reviewing = false;
    const light = () => {
      const active = flow.dataset.active!;
      svg.querySelectorAll<SVGPathElement>('.path').forEach((el) => el.classList.toggle('is-lit', el.dataset.feeds === active || el.dataset.feeds === 'next'));
      sources.forEach((s) => s.classList.toggle('is-lit', s.dataset.feeds === active && (active !== 'issue' || reviewing)));
    };

    const select = (id: string, focus = false) => {
      const changed = flow.dataset.active !== id;
      flow.dataset.active = id;
      tabs.forEach((tab) => {
        const on = tab.dataset.row === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach((panel) => {
        const on = panel.dataset.panel === id;
        panel.hidden = !on;
        if (on && changed && !reduce.matches) {
          panel.classList.remove('is-entering');
          void panel.offsetWidth;
          panel.classList.add('is-entering');
        }
      });
      light();
      draw();
    };

    const setReview = (open: boolean) => {
      reviewing = open;
      evidence.classList.toggle('is-open', open);
      review.setAttribute('aria-expanded', String(open));
      review.textContent = open ? review.dataset.close! : review.dataset.open!;
      light();
    };

    // Any interaction ends the introduction and leaves the visitor in control
    let timers: number[] = [];
    const takeOver = () => {
      timers.forEach(clearTimeout);
      timers = [];
      flow.dataset.stage = 'done';
    };

    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        takeOver();
        select(tab.dataset.row!);
      }),
    );
    flow.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const step = { ArrowDown: 1, ArrowUp: -1 }[ev.key];
      let n = -1;
      if (step) n = (i + step + tabs.length) % tabs.length;
      else if (ev.key === 'Home') n = 0;
      else if (ev.key === 'End') n = tabs.length - 1;
      if (n < 0) return;
      ev.preventDefault();
      takeOver();
      select(tabs[n].dataset.row!, true);
    });
    review.hidden = false;
    review.addEventListener('click', () => {
      takeOver();
      setReview(!reviewing);
      if (reviewing) evidence.querySelector<HTMLElement>('[data-record]')?.scrollIntoView({ block: 'nearest', behavior: reduce.matches ? 'auto' : 'smooth' });
    });

    // ── The short introduction: systems, then Tyll, then its items, then the investigation opens ──
    const play = () => {
      timers.forEach(clearTimeout);
      setReview(false);
      select('issue');
      flow.setAttribute('data-reset', '');
      flow.dataset.stage = '0';
      void flow.offsetWidth;
      flow.removeAttribute('data-reset');
      timers = [
        window.setTimeout(() => (flow.dataset.stage = '1'), 60),
        window.setTimeout(() => (flow.dataset.stage = '2'), 600),
        window.setTimeout(() => (flow.dataset.stage = '3'), 1400),
        window.setTimeout(() => (flow.dataset.stage = 'done'), 2300),
      ];
    };

    flow.classList.add('is-ready');
    setReview(false);
    draw();
    document.fonts?.ready.then(draw);
    // Redraw whenever the stage changes size: window resizes, a panel switches, the evidence opens
    let lastSize = '';
    new ResizeObserver(() => {
      const size = `${flow.offsetWidth}x${flow.offsetHeight}`;
      if (size !== lastSize) {
        lastSize = size;
        draw();
      }
    }).observe(flow);

    if (!reduce.matches) {
      replay.hidden = false;
      replay.addEventListener('click', play);
      flow.dataset.stage = '0';
      new IntersectionObserver(
        ([e], io) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          if (flow.dataset.stage === '0') play();
        },
        { threshold: 0.3 },
      ).observe(flow);
      // A click before the introduction has started shows everything at once
      flow.addEventListener('pointerdown', () => flow.dataset.stage === '0' && takeOver(), { once: true });
    }
  }
</script>
