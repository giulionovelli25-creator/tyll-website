---
// Homepage section 4: the closing invitation, as calm and dark as the opening.
import Logo from '../Logo.astro';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.invite;
---

<section class="invite on-dark" data-dark aria-labelledby="invite-title">
  <div class="invite__light" aria-hidden="true"></div>
  <svg class="invite__waves" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="invite-silver" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#c8cdd4" stop-opacity="0" />
        <stop offset="0.35" stop-color="#e6e9ed" stop-opacity="0.55" />
        <stop offset="0.7" stop-color="#9299a3" stop-opacity="0.35" />
        <stop offset="1" stop-color="#c8cdd4" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g fill="none" stroke="url(#invite-silver)" stroke-width="1.1">
      <path d="M-40 520 C 260 360, 520 640, 820 300 S 1260 180, 1480 260" />
      <path d="M-40 534 C 260 338, 520 650, 820 326 S 1260 210, 1480 278" />
      <path d="M-40 548 C 260 316, 520 660, 820 352 S 1260 240, 1480 296" />
      <path d="M-40 562 C 260 294, 520 670, 820 378 S 1260 270, 1480 314" />
      <path d="M-40 576 C 260 272, 520 680, 820 404 S 1260 300, 1480 332" />
      <path d="M-40 590 C 260 250, 520 690, 820 430 S 1260 330, 1480 350" />
      <path d="M-40 604 C 260 228, 520 700, 820 456 S 1260 360, 1480 368" />
      <path d="M-40 618 C 260 206, 520 710, 820 482 S 1260 390, 1480 386" />
      <path d="M-40 632 C 260 184, 520 720, 820 508 S 1260 420, 1480 404" />
    </g>
  </svg>
  <div class="wrap invite__inner">
    <Logo mark anim="draw" label="" class="invite__mark" />
    <h2 id="invite-title">{v.title}</h2>
    <p>{v.text}</p>
    <div class="invite__actions">
      <a class="btn btn--solid btn--lg" href={href('solutions', lang)} data-open-solutions data-track="explore_solutions_click" data-track-from="final">
        {d.cta.solutions}
      </a>
      <a class="btn btn--line btn--lg" href={href('book', lang)} data-track="book_call_click" data-track-from="final">{d.cta.book}</a>
    </div>
  </div>
</section>

<style>
  .invite {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: clamp(6rem, 4rem + 8vw, 11rem);
    background: var(--ink);
    color: var(--on-dark);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* A soft pool of light behind the headline */
  .invite__light {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(45% 55% at 50% 42%, rgba(200, 205, 212, 0.13), transparent 70%),
      radial-gradient(80% 60% at 50% 120%, rgba(146, 153, 163, 0.12), transparent 70%);
    pointer-events: none;
  }

  /* The Tyll silver wave, drawn as fine flowing lines that drift very slowly */
  .invite__waves {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    width: 100%;
    height: 78%;
    opacity: 0.8;
    -webkit-mask-image: linear-gradient(0deg, #000 35%, transparent 100%);
    mask-image: linear-gradient(0deg, #000 35%, transparent 100%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .invite__waves g {
      animation: invite-drift 24s ease-in-out infinite alternate;
    }
  }

  @keyframes invite-drift {
    to {
      transform: translate(-40px, 14px);
    }
  }

  .invite__inner {
    width: 100%;
    display: grid;
    justify-items: center;
  }

  .invite :global(.invite__mark) {
    width: 44px;
    height: auto;
    margin-bottom: 2rem;
    color: var(--on-dark);
  }

  .invite h2 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem);
    letter-spacing: -0.04em;
  }

  .invite p {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--on-dark-muted);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .invite__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 640px) {
    .invite__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
