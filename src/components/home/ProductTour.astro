---
// What Tyll does, explained one question at a time beside the real screen that answers it. One answer is open; choosing
// another swaps the screen. Close-ups only frame a real capture, never edit it, and each links on to its solution page,
// where the whole screen is. On phones each answer holds its own close-up. Without JavaScript every answer is open.
// A framing is x, y, width, height as fractions of the 1440 × 1240 capture. The Purchasing framing starts below an
// item the demo should not show in marketing; see CLAUDE.md.
import { Picture } from 'astro:assets';
import { solutions } from '../../content/solutions';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const v = t(lang).home.tour;
const check = 'M2.5 8.5 6.2 12 13.5 4';

type Rect = [number, number, number, number];
const shots: { key: 'forecasting' | 'stock' | 'finance'; frame: number; wide: Rect; narrow: Rect; fade?: boolean }[] = [
  { key: 'forecasting', frame: 0, wide: [0.1799, 0.5517, 0.8187, 0.39], narrow: [0.1799, 0.5517, 0.46, 0.36], fade: true },
  { key: 'stock', frame: 1, wide: [0.1799, 0.3863, 0.5125, 0.4847], narrow: [0.1799, 0.3863, 0.5125, 0.4847] },
  { key: 'finance', frame: 2, wide: [0.1799, 0.2371, 0.8187, 0.6], narrow: [0.1799, 0.2371, 0.53, 0.21], fade: true },
];

// The real capture positioned so only the framed part shows, whatever the box's width
const crop = ([x, y, w, h]: Rect) => ({
  box: `aspect-ratio:${((w * 1440) / (h * 1240)).toFixed(4)}`,
  img: `width:${(100 / w).toFixed(3)}%;left:${((-x / w) * 100).toFixed(3)}%;top:${((-y / h) * 100).toFixed(3)}%`,
});
// How wide the part sits in the window: as large as fits with air around it
const VIEW = 1.66;
const fit = ([, , w, h]: Rect) => Math.min(0.96, ((0.9 / VIEW) * (w * 1440)) / (h * 1240)) * 100;
---

<section class="tour" aria-labelledby="tour-title" data-tour>
  <div class="wrap">
    <header class="tour__head">
      <h2 id="tour-title" class="display">{v.title}</h2>
      <p>{v.text}</p>
    </header>

    <div class="tour__body">
      <ul class="tour__list">
        {
          shots.map(({ key, frame, narrow, fade }, i) => {
            const c = crop(narrow);
            const item = v.items[key];
            const s = solutions[key];
            return (
              <li class:list={['tour__item', i === 0 && 'is-open']} data-item={i}>
                <button type="button" class="tour__q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`tour-a-${i}`}>
                  <span class="tour__name">{s.name[lang]}</span>
                  <span class="tour__question">{item.q}</span>
                </button>
                <div class="tour__a" id={`tour-a-${i}`}>
                  <div class="tour__clip">
                    <p class="tour__answer">{item.a}</p>
                    <ul class="tour__points">
                      {
                        item.points.map((point) => (
                          <li>
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                              <path d={check} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            {point}
                          </li>
                        ))
                      }
                    </ul>
                    <div class:list={['tour__inline', fade && 'is-fading']} style={c.box} dir="ltr">
                      <Picture src={s.frames[frame].img} alt={s.frames[frame].alt[lang]} formats={['avif', 'webp']} fallbackFormat="webp" widths={[1440]} sizes="900px" loading="lazy" decoding="async" style={c.img} />
                    </div>
                    <a class="tour__link" href={href(key, lang)}>
                      {s.name[lang]} <span class="flip-rtl" aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>

      <figure class="tour__window" aria-live="polite">
        <span class="tour__chrome" dir="ltr" aria-hidden="true"><i></i><i></i><i></i><b>demo.tyll.ai</b></span>
        <div class="tour__view" dir="ltr">
          {
            shots.map(({ key, frame, wide, fade }, i) => {
              const c = crop(wide);
              const f = solutions[key].frames[frame];
              return (
                <div class:list={['tour__layer', i === 0 && 'is-on']} data-layer={i}>
                  <div class:list={['tour__part', fade && 'is-fading']} style={`${c.box};width:${fit(wide).toFixed(2)}%`}>
                    <Picture src={f.img} alt={f.alt[lang]} formats={['avif', 'webp']} fallbackFormat="webp" widths={[1440, 2200]} sizes="1100px" loading="lazy" decoding="async" style={c.img} />
                  </div>
                </div>
              );
            })
          }
        </div>
      </figure>
    </div>

    <div class="tour__how">
      <h3>{v.how}</h3>
      <ol class="tour__steps">
        {
          v.steps.map((step, i) => (
            <li>
              <span class="tour__n" aria-hidden="true">{i + 1}</span>
              <b>{step.title}</b>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .tour {
    padding-block: var(--section-y);
    background: var(--paper);
    color: var(--ink);
  }

  .tour__head h2 {
    font-size: var(--fs-h2);
  }

  .tour__head p {
    margin-top: var(--s-2);
    color: var(--steel);
    font-size: var(--fs-lead);
  }

  .tour__body {
    display: grid;
    grid-template-columns: minmax(0, 21rem) minmax(0, 1fr);
    align-items: start;
    gap: var(--s-5);
    margin-top: var(--s-5);
  }

  .tour__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .tour__item {
    border-bottom: 1px solid var(--line);
  }

  .tour__q {
    display: grid;
    gap: 0.2rem;
    width: 100%;
    padding: var(--s-2) 0;
    border: 0;
    background: none;
    color: var(--text-3);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: color 0.25s var(--ease);
  }

  .tour__q:hover,
  .tour__item.is-open .tour__q {
    color: var(--ink);
  }

  .tour__name {
    color: var(--steel);
    font-size: var(--fs-caption);
  }

  .tour__question {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    letter-spacing: -0.015em;
    line-height: 1.14;
  }

  .tour__a {
    display: grid;
    grid-template-rows: 1fr;
  }

  .tour.is-enhanced .tour__a {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease);
  }

  .tour.is-enhanced .tour__item.is-open .tour__a {
    grid-template-rows: 1fr;
  }

  .tour__clip {
    min-height: 0;
    overflow: hidden;
  }

  .tour__answer {
    color: var(--steel);
  }

  .tour__points {
    display: grid;
    gap: 0.4rem;
    margin: var(--s-2) 0 0;
    padding: 0;
    font-size: 0.9375rem;
    list-style: none;
  }

  .tour__points li {
    display: flex;
    gap: 0.55rem;
  }

  .tour__points svg {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 0.25rem;
  }

  .tour__link {
    display: inline-block;
    margin: var(--s-2) 0 var(--s-3);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-underline-offset: 4px;
  }

  /* The screen beside the list: the same browser window as on the solution pages */
  .tour__window {
    position: sticky;
    top: calc(var(--header-h) + var(--s-3));
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(var(--ink-rgb) / 0.08),
      0 40px 80px -48px rgb(var(--ink-rgb) / 0.45);
  }

  .tour__chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding-inline: var(--s-2);
    border-bottom: 1px solid var(--line);
    background: var(--cloud);
  }

  .tour__chrome i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }

  .tour__chrome b {
    margin-inline: auto;
    padding-inline-end: 39px;
    color: var(--steel);
    font-size: var(--fs-caption);
    font-weight: 400;
  }

  .tour__view {
    position: relative;
    aspect-ratio: 1.66;
    background: var(--mist);
  }

  .tour__layer {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease),
      visibility 0s linear 0.45s;
  }

  .tour__layer.is-on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s var(--ease);
  }

  .tour__part,
  .tour__inline {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  .tour__part {
    box-shadow:
      0 0 0 1px rgb(var(--ink-rgb) / 0.05),
      0 18px 34px -18px rgb(var(--ink-rgb) / 0.28);
  }

  .tour__part.is-fading,
  .tour__inline.is-fading {
    -webkit-mask-image: linear-gradient(180deg, var(--black) 84%, transparent);
    mask-image: linear-gradient(180deg, var(--black) 84%, transparent);
  }

  .tour__part :global(picture),
  .tour__inline :global(picture) {
    display: contents;
  }

  .tour__part :global(img),
  .tour__inline :global(img) {
    position: absolute;
    display: block;
    max-width: none;
    height: auto;
  }

  .tour__inline {
    display: none;
    margin-top: var(--s-3);
    box-shadow: 0 0 0 1px var(--line);
  }

  .tour__how {
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .tour__how h3 {
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .tour__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3) var(--s-5);
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .tour__n {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-bottom: var(--s-1);
    border: 1px solid var(--silver);
    border-radius: 50%;
    color: var(--steel);
    font-size: var(--fs-caption);
  }

  .tour__steps b {
    display: block;
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.012em;
  }

  .tour__steps p {
    margin-top: 0.3rem;
    color: var(--steel);
    font-size: 0.9375rem;
  }

  @media (max-width: 1000px) {
    .tour__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .tour__window {
      display: none;
    }

    .tour__inline {
      display: block;
    }

    .tour__steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tour.is-enhanced .tour__a,
    .tour__layer,
    .tour__layer.is-on,
    .tour__q {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tour]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('.tour__item')];
    const layers = [...root.querySelectorAll<HTMLElement>('.tour__layer')];
    root.classList.add('is-enhanced');
    items.forEach((item, i) => {
      item.querySelector('.tour__q')!.addEventListener('click', () => {
        items.forEach((other, j) => {
          other.classList.toggle('is-open', j === i);
          other.querySelector('.tour__q')!.setAttribute('aria-expanded', String(j === i));
          // Closed answers keep their links out of the tab order
          other.querySelector<HTMLElement>('.tour__a')!.inert = j !== i;
        });
        layers.forEach((layer, j) => layer.classList.toggle('is-on', j === i));
      });
      item.querySelector<HTMLElement>('.tour__a')!.inert = i !== 0;
    });
  });
</script>
