  }

  /* The footer is night on this page (the brief's #0e1219). It keeps its own markup and styles: only the colours it
     reads are pointed at their dark counterparts, here and nowhere else. */
  :global(body:has([data-sus]) .footer) {
    --page: var(--night-1);
    --ink: var(--on-dark);
    --steel: rgb(var(--on-dark-rgb) / 0.74);
    --graphite: rgb(var(--on-dark-rgb) / 0.74);
    --line: rgb(var(--on-dark-rgb) / 0.16);
    --hair: rgb(var(--on-dark-rgb) / 0.12);
    --mist: rgb(var(--on-dark-rgb) / 0.08);
    color-scheme: dark;
  }

  /* Motion. The hero rises in and the tree fades in on load. Below it, parts wait out of view only once the script
     has armed the page, so without JavaScript nothing is hidden and every drawing shows whole. They rise in once as
     they come into view; the drawings draw themselves, the chain's line and steps arrive in order, the figures count
     up, and on the board each figure's drawing plays as the figure arrives. */
  .rise {
    animation: rise 0.9s var(--rise) both;
    animation-delay: calc(var(--i, 0) * 120ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }

  @keyframes fade {
