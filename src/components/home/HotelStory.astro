              <rect class="c-brass" x="579" y="628" width="4" height="122"></rect>
            </g>
            <path class="c-rail-line" d={`M440 586H560M440 602H560${[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => `M${440 + i * 15} 586V602`).join('')}`} {...A(0.82, 0.06)}></path>
            <g {...A(0.84, 0.06)}>
              <rect class="c-lantern" x="460" y="664" width="8" height="16" rx="2"></rect>
              <rect class="c-lantern" x="532" y="664" width="8" height="16" rx="2"></rect>
            </g>
            <g {...A(3.3, 0.2)}>
              <rect class="c-lantern-on" x="460" y="664" width="8" height="16" rx="2"></rect>
              <rect class="c-lantern-on" x="532" y="664" width="8" height="16" rx="2"></rect>
            </g>

            <!-- The last step: planters, flags, the rooftop sign, the doorman -->
            {
              [392, 608, 122, 878].map((x, i) => (
                <g {...A(3.02 + i * 0.025, 0.1, { y: 10 })}>
                  <rect class="c-planter" x={x - 9} y="744" width="18" height="12"></rect>
                  <path class="c-green" d={`M${x - 10} 744Q${x} 692 ${x + 10} 744Z`}></path>
                </g>
              ))
            }
            <path class="c-sign-rail" d="M402 240H598M416 240V246M584 240V246" {...A(3.02, 0.06)}></path>
            {
              sign.map((one, i) => (
                <text class="c-sign" x={one.x} y="234" {...A(3.04 + i * 0.03, 0.08, { y: -14 })}>
                  {one.l}
                </text>
              ))
            }
            {
              [352, 648].map((x, i) => (
                <g {...A(3.16 + i * 0.02, 0.08, { y: 10 })}>
                  <path class="c-pole" d={`M${x} 248V176`}></path>
                  <path class="c-flag" d={`M${x} 178L${x + 30} 186L${x} 194Z`}></path>
                </g>
              ))
            }
            <g {...A(3.2, 0.08, { x: -10 })}>
              <HotelPerson x={548} foot={738} h={46} role="doorman" pose="stand" />
            </g>

            <!-- Guests. These run on time, and only while the last step shows -->
            <g {...A(3.24, 0.06)}>
              <g class="loop loop--bellhop">
                <HotelPerson x={262} foot={782} h={46} role="bellhop" pose="push" flip walk />
                <path class="c-trolley" d="M214 744V778H248V744M214 744Q231 730 248 744M214 778h34M248 762h3"></path>
                <rect class="c-case" x="219" y="752" width="24" height="12" rx="1"></rect>
                <rect class="c-case-b" x="221" y="764" width="20" height="13" rx="1"></rect>
                <circle class="c-wheel" cx="218" cy="781" r="3"></circle>
                <circle class="c-wheel" cx="244" cy="781" r="3"></circle>
              </g>
              <g class="loop loop--couple">
                <HotelPerson x={636} foot={786} h={48} role="woman" walk />
                <HotelPerson x={620} foot={786} h={51} role="man" walk />
              </g>
              <g class="loop loop--guest">
                <rect class="c-case" x="462" y="760" width="11" height="17" rx="1.5"></rect>
                <path class="c-rail-line" d="M470 760L475 752"></path>
                <circle class="c-wheel" cx="465" cy="778.5" r="1.8"></circle>
                <circle class="c-wheel" cx="470" cy="778.5" r="1.8"></circle>
                <HotelPerson x={480} foot={780} h={50} role="guest" walk />
              </g>
              <g class="loop loop--taxi c-figure">
                <path d="M300 816V792Q300 786 308 785L332 783L348 766Q352 762 360 762H404Q412 762 416 766L432 783L448 786Q456 788 456 796V816Z"></path>
                <path class="c-car-glass" d="M338 783L351 769H378V783ZM383 769H404L418 783H383Z"></path>
                <circle cx="332" cy="818" r="11"></circle>
                <circle cx="424" cy="818" r="11"></circle>
              </g>
            </g>

            <!-- Foreground cypresses, moving a little against the building -->
            <g data-hs-near>
              {
                [58, 942].map((x, i) => (
                  <g {...A(3.1 + i * 0.03, 0.12, { y: 14 })}>
                    <path class="c-green-deep" d={`M${x} 590Q${x + 30} 690 ${x + 9} 770H${x - 9}Q${x - 30} 690 ${x} 590Z`}></path>
                    <path class="c-green" d={`M${x + 34} 650Q${x + 52} 716 ${x + 40} 770H${x + 28}Q${x + 16} 716 ${x + 34} 650Z`} transform={i ? 'translate(-68 0)' : undefined}></path>
                  </g>
                ))
              }
            </g>

            <!-- Step 1: the transactions, everywhere until they are checked and go in through the door -->
            {slips.map((p, i) => <g transform="translate(486 672)"><use class="tilt c-slip" href="#hs-slip" width="28" height="36" {...A(p.b, 0.14, { x: p.x, y: p.y, r: p.r, s: -0.72 + (i % 9) * 0.02, ob: p.b + 0.12, od: 0.04 })}></use></g>)}
            <g transform="translate(452 548)"><use class="tilt" href="#hs-slip-flag" width="28" height="36" {...A(0.56, 0.16, { x: -310, y: -200, r: 30, s: -0.7, ob: 0.92, od: 0.08 })}></use></g>
            <g transform="translate(520 548)"><use class="tilt" href="#hs-slip-flag" width="28" height="36" {...A(0.6, 0.16, { x: 280, y: -60, r: -24, s: -0.7, ob: 0.92, od: 0.08 })}></use></g>
          </g>

          <!-- One connected row: each system joins as its problem is solved -->
          {systems.map((s) => <path class="c-link" d={s.line} pathLength="1" {...A(s.on - 0.04, 0.2, { draw: true })}></path>)}
          <path class="c-link c-link--drop" d="M500 60V176" pathLength="1" {...A(3.06, 0.14, { draw: true })}></path>
          <path class="c-pulse loop loop--pulse" d="M120 60H500" pathLength="1"></path>
          <path class="c-pulse loop loop--pulse" d="M880 60H500" pathLength="1"></path>
        </svg>

        <!-- The four systems and the Tyll mark are HTML, so their labels stay readable at every size -->
        {
          systems.map((s) => (
            <span class="hs__card is-on" style={`left:${s.left}%;--dx:${s.dx};--dy:${s.dy};--r:${s.r}deg`} data-hs-card={s.on}>
              <i aria-hidden="true"></i>
              {s.label}
            </span>
          ))
        }
        <span class="hs__hub is-on" data-hs-hub aria-hidden="true">
          <Logo mark label="" class="hs__mark" />
        </span>
        <span class="hs__zone" data-hs-zone="1.08,1.62">{v.zones.store}</span>
        <ul class="hs__notes" data-hs-notes aria-hidden="true">
          <li class="hs__note"><i class="hs__note-ok"></i>{v.labels.counted}</li>
          <li class="hs__note"><i></i>{v.labels.romaine}</li>
          <li class="hs__note"><i></i>{v.labels.eggs}</li>
        </ul>
        <span class="hs__zone" data-hs-zone="2.04,2.9">{v.zones.bar}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hs {
    /* One screen of scrolling for each step. Text pins just below the heading; --hs-head is measured. */
    --hs-step: 100svh;
    --hs-pin: calc(var(--header-h) + var(--hs-head, 12rem));
    /* The heading and the hotel start on the same line, and the text panel ends where the hotel ends */
    --hs-top: var(--s-4);
    --hs-foot: var(--s-3);
    --hs-below: calc(100svh - var(--header-h) - var(--hs-top) - var(--hs-stage, calc(100svh - var(--header-h) - var(--hs-top) - var(--hs-foot))));
    /* Keeps the fade under the heading inside the section. Clip, unlike hidden, leaves sticky positioning working. */
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .hs__grid {
    display: grid;
    grid-template-columns: minmax(0, 36fr) minmax(0, 64fr);
    gap: var(--s-4);
    /* The text starts where the rest of the page starts, the hotel runs to the edge */
    padding-inline: max(var(--gut), calc((100vw - var(--wrap)) / 2)) var(--gut);
  }

  /* ── Text ── */
  .hs__head {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    padding-block: var(--hs-top) var(--s-2);
    background: var(--paper);
  }

  /* Text passing beneath the heading fades out rather than being cut */
  .hs__head::after {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: var(--s-2);
    background: linear-gradient(180deg, var(--paper), rgb(var(--paper-rgb) / 0));
    content: '';
    pointer-events: none;
  }

  .hs__head h2 {
    /* The tops of the capitals, not the line box, meet the top of the hotel */
    margin-top: -0.06em;
    font-size: clamp(1.875rem, 1.6rem + 0.9vw, 2.5rem);
  }

  .hs__head p {
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: var(--fs-body);
    line-height: 1.4;
  }

  .hs__steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hs__step {
    min-height: var(--hs-step);
    color: var(--text-faded);
    transition: color 0.35s var(--ease);
  }

  .hs__step > div {
    position: sticky;
    top: var(--hs-pin);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: calc(100svh - var(--hs-pin));
    padding-block: var(--s-1) var(--hs-below);
  }

  /* The last step is pinned for a full step, and leaves together with the hotel */
  /* The bar scene needs time on screen, so this step gets more scrolling while the camera is in */
  .hs__step:nth-child(3) {
    min-height: calc(var(--hs-step) * 2.2);
  }

  .hs__step:last-child {
    min-height: calc(var(--hs-step) + 100svh - var(--hs-pin));
  }

  .hs__step.is-active {
    color: var(--ink);
  }

  /* Where the reader is in the story: one line across the column, filled up to the current step */
  .hs__progress {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: auto;
    gap: 0.375rem;
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-caption);
    line-height: 1.3;
  }

  .hs__progress li {
    padding-top: 0.4rem;
    border-top: 2px solid var(--hair);
    color: var(--text-3);
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .hs__progress li span {
    margin-inline-end: 0.15rem;
    font-variant-numeric: tabular-nums;
  }

  .hs__progress li.is-done {
    border-color: var(--ink);
  }

  .hs__progress li.is-on {
    border-color: var(--ink);
    color: var(--ink);
    font-weight: 500;
  }

  .hs__label {
    display: none;
    font-size: var(--fs-small);
  }

  .hs__label span {
    color: var(--text-3);
  }

  .hs__step h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.7vw, 1.875rem);
    font-weight: 300;
  }

  /* Each step is one panel: the problem, what Tyll does about it, and the real screen */
  .hs__flip {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-top: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--hair);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  .hs__tag {
    margin-bottom: 0.15rem;
    color: var(--text-3);
    font-size: var(--fs-caption);
  }

  .hs__tag--on {
    color: inherit;
    font-weight: 500;
  }

  .hs__problem {
    padding: 0.75rem var(--s-2);
    border-bottom: 1px solid var(--hair);
    background: var(--mist);
    color: var(--steel);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .hs__fix {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .hs__fix > .hs__tag {
    padding: 0.75rem var(--s-2) 0;
  }

  .hs__step ul {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0 var(--s-2) 0.875rem;
    font-size: var(--fs-small);
    line-height: 1.4;
    list-style: none;
  }

  .hs__step ul li {
    position: relative;
    padding-inline-start: 1.3rem;
  }

  .hs__step ul li::before {
    position: absolute;
    inset-inline-start: 0;
    top: 0.35em;
    width: 0.7em;
    height: 0.38em;
    border-bottom: 1.5px solid currentColor;
    border-inline-start: 1.5px solid currentColor;
    content: '';
    transform: rotate(-45deg);
  }

  :global([dir='rtl']) .hs__step ul li::before {
    transform: rotate(45deg);
  }

  /* With the scroll running, what Tyll does appears once the problem has been read. Its place is kept, so nothing jumps. */
  .hs.is-live .hs__fix {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  .hs.is-live .is-fixed .hs__fix {
    opacity: 1;
    transform: none;
  }

  /* A close framing of the real screen, on the product's own ground */
  .hs__shot {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem var(--s-2);
    border-top: 1px solid var(--hair);
    background: var(--mist);
    color: inherit;
    text-decoration: none;
  }

  .hs__frame {
    display: block;
    overflow: hidden;
    border: 1px solid var(--hair);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  :global([dir='rtl']) .hs__frame {
    direction: ltr;
  }

  .hs__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hs__more {
    align-self: flex-start;
    border-bottom: 1px solid currentColor;
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  /* The last step ends where the others show a screen: on the same ground, with the next move */
  .hs__next {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: var(--s-3);
    padding: var(--s-2);
    border-top: 1px solid var(--hair);
    background: var(--mist);
  }

  .hs__links {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
    max-width: none;
  }

  .hs__links a {
    color: inherit;
    font-size: var(--fs-body);
    line-height: 1.4;
    text-decoration: none;
  }

  .hs__links span {
    display: inline-block;
  }

  .hs__links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Scene: held still while the text moves past it ── */
  .hs__scene {
    position: sticky;
    top: var(--header-h);
    display: grid;
    place-items: start center;
    align-self: start;
    box-sizing: border-box;
    height: calc(100svh - var(--header-h));
    padding-top: var(--hs-top);
  }

  .hs__stage {
    position: relative;
    container-type: inline-size;
    width: min(100%, calc((100svh - var(--header-h) - var(--hs-top) - var(--hs-foot)) * 1000 / 860));
    aspect-ratio: 1000 / 860;
    overflow: hidden;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 1px var(--hair);
  }

  .hs__stage svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The camera eases in over a second, whatever the speed of the scroll */
  .hs__stage [data-hs-camera] {
    transition: transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .hs__stage [data-hs-camera],
  .hs__stage [data-hs-far],
  .hs__stage [data-hs-near],
  .hs__stage .loop--taxi {
    will-change: transform;
  }

  /* Pieces that are gone by the finished hotel */
  .hs__stage [data-ob] {
    opacity: 0;
    visibility: hidden;
  }

  .tilt {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* ── The four systems: scattered until connected, then one row across the top ── */
  .hs__card {
    position: absolute;
    top: 7%;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--stone-3);
    border-radius: 3px;
    background: var(--paper);
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.2;
    white-space: nowrap;
    transform: translate(calc(-50% + var(--dx) * 1cqw), calc(-50% + var(--dy) * 1cqw)) rotate(var(--r));
    transition:
      transform 0.7s var(--ease),
      color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .hs__card i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--fog);
    transition: background-color 0.35s var(--ease);
  }

  .hs__card.is-on {
    border-color: var(--ink);
    color: var(--ink);
    transform: translate(-50%, -50%);
  }

  .hs__card.is-on i {
    background: var(--ink);
  }

  /* In the smallest scene the chips drop their dot, so the row of four still fits */
  @container (max-width: 300px) {
    .hs__card i {
      display: none;
    }

    .hs__card {
      padding: 0.1rem 0.3rem;
    }
  }

  .hs__hub {
    position: absolute;
    top: 7%;
    left: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(28px, 5%, 42px);
    aspect-ratio: 1;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
    transition:
      opacity 0.35s var(--ease),
      transform 0.35s var(--ease);
  }

  .hs__hub.is-on {
    opacity: 1;
    transform: translate(-50%, -50%);
  }

  .hs__hub :global(.hs__mark) {
    width: 56%;
    height: auto;
  }

  /* Notes that appear once the camera has settled on the storeroom, one after the other */
  .hs__notes {
    position: absolute;
    top: 15%;
    right: 4%;
    z-index: 1;
    display: grid;
    gap: 0.35rem;
    justify-items: end;
    max-width: 62%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hs__note {
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
    padding: 0.3rem 0.65rem;
    border-radius: 3px;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--hair), var(--shadow-1);
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.25;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .hs__note i {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber-500);
  }

  .hs__note i.hs__note-ok {
    background: var(--ink);
  }

  .hs__notes.is-on .hs__note {
    opacity: 1;
    transform: none;
    transition-duration: 0.45s;
  }

  .hs__notes.is-on .hs__note:nth-child(1) {
    transition-delay: 1.05s;
  }

  .hs__notes.is-on .hs__note:nth-child(2) {
    transition-delay: 1.3s;
  }

  .hs__notes.is-on .hs__note:nth-child(3) {
    transition-delay: 1.55s;
  }

  /* While the camera is in, the systems still scattered step aside */
  .hs.is-zoom .hs__card:not(.is-on) {
    opacity: 0;
  }

  .hs__card {
    transition-property: transform, color, border-color, opacity;
  }

  /* The delivery: nothing of it shows until it runs. With reduced motion the bar is simply stocked and the van absent. */
  .hs__van {
    transform: translateX(260px);
  }

  .hs__driver {
    opacity: 0;
  }

  .hs__reardoor {
    transform: scaleX(0);
    transform-origin: 880px 0;
  }

  .hs__shutter {
    transform-origin: 0 662px;
  }

  .hs__polish {
    opacity: 0;
  }

  .hs.is-live .hs__baritem {
    opacity: 0;
  }

  /* The count: each tick appears after a tap of the phone */
  .hs__tick {
    opacity: 0;
  }

  .hs.is-counting .hs__tick {
    animation: hs-tick 0.3s var(--ease) both;
    animation-delay: calc(0.5s + var(--i) * 0.42s);
  }

  @keyframes hs-tick {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .hs.is-counting .hs__counter :global(.p-arm--b) {
    animation: hs-tap 0.42s ease-in-out 0.4s 5;
  }

  @keyframes hs-tap {
    0%, 100% { transform: rotate(-70deg); }
    50% { transform: rotate(-58deg); }
  }

  .hs__zone {
    position: absolute;
    bottom: 3.5%;
    left: 50%;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8125rem;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 0.35s var(--ease);
  }

  .hs__zone.is-on {
    opacity: 1;
  }

  /* ── Colours of the drawing, all from the tokens ── */
  .c-far { fill: var(--mount); }
  .c-far-dusk { fill: var(--mount-dusk); }
  .c-tile { fill: none; stroke: rgb(var(--ink-rgb) / 0.08); stroke-width: 0.3; }
  .c-floor { fill: var(--silver-light); }
  .c-drain { fill: var(--steel); }
  .c-steel-door { fill: var(--silver); stroke: var(--steel); stroke-width: 0.4; }
