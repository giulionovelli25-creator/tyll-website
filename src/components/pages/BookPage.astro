---
// Book a Call: a split screen. The headline and the booking action on one side, a sunlit hotel on the other.
// Calendly loads only after the visitor clicks the button; once the calendar is open it takes the full width.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import lobby from '../../assets/photos/book-lobby.jpg';
import { site } from '../../config/site';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const b = d.book;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent({ en: 'Call request – Tyll', de: 'Gesprächsanfrage – Tyll', ar: 'طلب مكالمة – Tyll', it: 'Richiesta di chiamata – Tyll' }[lang])}`;
const fwd = lang === 'ar' ? '←' : '→';
---

<Base lang={lang} page="book" title={d.meta.bookTitle} description={d.meta.bookDescription}>
  <div class="wrap book">
    <div class="book__main">
      <header class="book__intro">
        <h1>{b.title}</h1>
        <p>{b.intro}</p>
      </header>

      <section aria-label={b.consentTitle}>
        {
          site.calendlyUrl ? (
            <div class="booking" data-booking data-url={site.calendlyUrl} data-state="consent">
              <div class="booking__panel booking__consent">
                <h2 class="booking__label">{b.consentTitle}</h2>
                <button type="button" class="btn btn--solid btn--lg booking__open" data-booking-open>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <rect x="3" y="4.5" width="14" height="12" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <path d="M3 8.5h14M7 2.75v3.5M13 2.75v3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                  {b.consentButton}
                  <span aria-hidden="true">{fwd}</span>
                </button>
                <p class="booking__purpose">{b.callPurpose}</p>
                <p class="book__email">
                  {b.orEmail} <a href={mailto} data-track="email_click" dir="ltr">{site.email}</a>
                </p>
                <p class="booking__privacy">
                  {b.consentText} <a href={href('privacy', lang, '#calendly')}>{b.consentPrivacy}</a>
                </p>
              </div>

              <p class="booking__panel booking__loading" role="status">
                {b.loading}
              </p>

              <div class="booking__panel booking__failed" role="alert">
                <h2>{b.failedTitle}</h2>
                <p>{b.failedText}</p>
                <div class="booking__actions">
                  <button type="button" class="btn btn--solid" data-booking-open>
                    {b.retry}
                  </button>
                  <a class="btn btn--line" href={mailto} data-track="email_click">
                    {b.emailUs}
                  </a>
                </div>
              </div>

              <div class="booking__panel booking__confirmed" role="status" tabindex="-1">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12.5l4.2 4L19 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h2>{b.confirmedTitle}</h2>
                <p>{b.confirmedText}</p>
              </div>

              <div class="booking__frame" />
            </div>
          ) : (
            <div class="booking__panel booking__unavailable">
              <h2>{b.unavailableTitle}</h2>
              <p>{b.unavailableText}</p>
              <div class="booking__actions">
                <a class="btn btn--solid btn--lg" href={mailto} data-track="email_click">
                  {b.emailUs}
                </a>
              </div>
            </div>
          )
        }
      </section>
    </div>

    <figure class="book__photo">
      <Picture
        src={lobby}
        alt={b.photoAlt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[640, 960, 1280]}
        sizes="(max-width: 900px) 100vw, 42vw"
        loading="eager"
        decoding="async"
      />
    </figure>
  </div>
</Base>

<style>
  /* Split screen: the booking side and the photograph share one calm view on desktop */
  .book {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 1rem + 5vw, 6.5rem);
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-top: calc(var(--header-h) + clamp(2rem, 1rem + 3vw, 4rem));
    padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .book__intro h1 {
    max-width: 14ch;
    font-size: var(--fs-h2);
  }

  .book__intro p {
    max-width: 32rem;
    margin-top: 1.1rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .book__photo {
    margin: 0;
    align-self: stretch;
    max-height: calc(100svh - var(--header-h) - clamp(4rem, 2rem + 5vw, 8rem));
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 50px 90px -60px rgba(60, 44, 24, 0.5);
  }

  .book__photo :global(picture),
  .book__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .book__photo :global(img) {
    min-height: 420px;
    object-fit: cover;
    object-position: 45% 60%;
  }

  /* The booking action: one clear button, the email beneath it, then the Calendly note in small type */
  .booking__consent {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .booking__label {
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .booking__open {
    gap: 0.6rem;
    margin-top: 0.85rem;
    padding-inline: 1.6rem 1.75rem;
  }

  .booking__open svg {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .booking__purpose {
    max-width: 30rem;
    margin-top: 0.9rem;
    color: var(--graphite);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .book__email {
    margin-top: 1rem;
    color: var(--steel);
    font-size: 1rem;
  }

  .book__email a {
    color: var(--ink);
    font-weight: 500;
    text-underline-offset: 3px;
  }

  .booking__privacy {
    max-width: 30rem;
    margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .booking__privacy a {
    color: var(--graphite);
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  /* Other states (loading, failed, confirmed, no booking URL) keep a quiet panel */
  .booking__loading,
  .booking__failed,
  .booking__confirmed,
  .booking__unavailable {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    max-width: 36rem;
    padding: clamp(1.5rem, 1.1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--cloud);
  }

  .booking__failed h2,
  .booking__confirmed h2,
  .booking__unavailable h2 {
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .booking__failed p,
  .booking__confirmed p,
  .booking__unavailable p {
    margin-top: 0.75rem;
    color: var(--steel);
    line-height: 1.6;
  }

  .booking__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }

  /* Exactly one state shows at a time */
  .booking > * {
    display: none;
  }

  .booking[data-state='consent'] .booking__consent,
  .booking[data-state='loading'] .booking__loading,
  .booking[data-state='loading'] .booking__frame,
  .booking[data-state='ready'] .booking__frame,
  .booking[data-state='failed'] .booking__failed,
  .booking[data-state='confirmed'] .booking__confirmed {
    display: block;
  }

  .booking__loading {
    color: var(--steel);
  }

  /* The calendar loads invisibly behind the "Loading" note and appears once Calendly reports in */
  .booking[data-state='loading'] .booking__frame {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
  }

  /* Once the calendar is open it needs the room: the photograph steps aside */
  .book:has(.booking[data-state='loading'], .booking[data-state='ready']) {
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  .book:has(.booking[data-state='loading'], .booking[data-state='ready']) .book__photo {
    display: none;
  }

  .booking__frame {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--paper);
  }

  .booking__frame :global(iframe) {
    display: block;
    width: 100%;
    min-height: 700px;
    border: 0;
  }

  .booking__confirmed svg {
    width: 36px;
    height: 36px;
    margin-bottom: 1rem;
    padding: 6px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
  }

  /* Phones and narrow windows: headline and booking first, the photograph below */
  @media (max-width: 900px) {
    .book {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      min-height: 0;
      align-items: start;
    }

    .book__photo {
      align-self: auto;
      max-height: none;
      aspect-ratio: 4 / 3;
    }

    .book__photo :global(img) {
      min-height: 0;
    }

    .booking__open {
      width: 100%;
    }
  }
</style>

<script>
  // Calendly runs in an iframe (no Calendly script on this site) and only after the visitor chooses to open it.
  // Calendly reports progress to this page with postMessage; a booking is shown as confirmed only when
  // Calendly itself says the event was scheduled.
  const track = (event: string) => document.dispatchEvent(new CustomEvent('tyll:track', { detail: { event } }));

  document.querySelectorAll<HTMLElement>('[data-booking]').forEach((root) => {
    const frame = root.querySelector<HTMLElement>('.booking__frame')!;
    const setState = (s: string) => (root.dataset.state = s);
    let timer = 0;
    let started = false;

    const open = () => {
      setState('loading');
      track('booking_calendar_opened');
      const url = new URL(root.dataset.url!);
      url.searchParams.set('embed_domain', location.host);
      url.searchParams.set('embed_type', 'Inline');
      url.searchParams.set('hide_gdpr_banner', '1');
      url.searchParams.set('primary_color', '14161a');
      frame.replaceChildren();
      const iframe = document.createElement('iframe');
      iframe.src = url.href;
      iframe.title = root.querySelector('.booking__consent h2')?.textContent ?? 'Calendly';
      iframe.allow = 'payment';
      frame.append(iframe);
      // No word from Calendly within 15 seconds means it was blocked or the network failed.
      clearTimeout(timer);
      timer = window.setTimeout(() => root.dataset.state === 'loading' && setState('failed'), 15000);
    };

    root.querySelectorAll('[data-booking-open]').forEach((b) => b.addEventListener('click', open));

    addEventListener('message', (e) => {
      if (!/^https:\/\/([a-z0-9-]+\.)?calendly\.com$/.test(e.origin)) return;
      const name: string | undefined = e.data?.event;
      if (!name?.startsWith('calendly.')) return;
      if (name === 'calendly.page_height') {
        const h = parseInt(e.data.payload?.height, 10);
        const iframe = frame.querySelector('iframe');
        if (iframe && h > 0) iframe.style.height = `${h}px`;
        return;
      }
      if (root.dataset.state === 'loading') {
        clearTimeout(timer);
        setState('ready');
      }
      if (name === 'calendly.date_and_time_selected' && !started) {
        started = true;
        track('booking_started');
      }
      if (name === 'calendly.event_scheduled') {
        track('booking_confirmed');
        setState('confirmed');
        root.querySelector<HTMLElement>('.booking__confirmed')?.focus();
        frame.replaceChildren();
      }
    });
  });
</script>
