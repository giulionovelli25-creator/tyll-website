---
// The Solutions page (round 4, 24 Nov 2026): the live site's photo tiles, three per row, one row per section (Stock and
// waste, Purchasing, Reconciliation), each section with its anchor (#stock-waste, #purchasing, #reconciliation),
// heading and one sentence. A tile is a button: it opens in place to a short muted clip of its film (loaded only then),
// three points and a link to its page; one open at a time, closed again by a second click, another tile or Escape.
// Then More in Tyll (Revenue and reports, Suppliers, the morning brief, Scan), the In development line, Also in Tyll
// (collapsed) and the closing Book a demo band.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageIntro from '../PageIntro.astro';
import SolutionIcon from '../SolutionIcon.astro';
import SilverWave from '../SilverWave.astro';
import { solutions, sections, moreKeys } from '../../content/solutions';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const see = (name: string) => d.solutionPage.seeLink.replace('{name}', name);
// More in Tyll: the two pages outside the nine, then the morning brief (How it works) and Scan (the homepage strip)
const more = [
  ...moreKeys.map((k) => ({ name: solutions[k].name[lang], text: solutions[k].menu[lang], url: href(k, lang) })),
  { name: d.solutionPage.moreInTyll.items[0][0], text: d.solutionPage.moreInTyll.items[0][1], url: href('how', lang) },
  { name: d.solutionPage.moreInTyll.items[1][0], text: d.solutionPage.moreInTyll.items[1][1], url: href('home', lang, '#scan') },
];
---

<Base lang={lang} page="solutions" title={d.meta.solutionsTitle} description={d.meta.solutionsDescription}>
  <div class="index-top">
    <SilverWave phase={0.7} />
    <PageIntro title={d.solutionPage.indexTitle} />
  </div>
  <div class="wrap index">
    {
      sections.map((sec) => (
        <section class="sec" id={sec.id} aria-labelledby={`${sec.id}-title`}>
          <div class="sec__head">
            <h2 id={`${sec.id}-title`}>{sec.name[lang]}</h2>
            <p>{sec.text[lang]}</p>
          </div>
          <ul class="tiles" role="list">
            {sec.keys.map((k) => {
              const s = solutions[k];
              const panel = `tile-${k}`;
              return (
                <li>
                  <div class="tile on-dark" data-tile data-accent={s.tone}>
                    <Picture
                      src={s.photo}
                      alt=""
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      widths={[480, 720, 1080]}
                      sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1100px) 45vw, 380px"
                      loading="lazy"
                      decoding="async"
                      style={`object-position:${s.photoFocus}`}
                    />
                    <span class="tile__shade" aria-hidden="true" />
                    <button type="button" class="tile__btn" aria-expanded="false" aria-controls={panel}>
                      <span class="tile__chip">
                        <SolutionIcon name={s.icon} />
                      </span>
                      <span class="tile__name">{s.name[lang]}</span>
                      <span class="tile__desc">{s.menu[lang]}</span>
                    </button>
                    <div class="tile__reveal">
                      <div class="tile__panel" id={panel} inert>
                        <video
                          class="tile__clip"
                          muted
                          loop
                          playsinline
                          preload="none"
                          aria-hidden="true"
                          tabindex="-1"
                          data-src={`/media/film/${lang}/${k}-desk.mp4`}
                          data-poster={`/media/film/${lang}/${k}-desk.jpg`}
                        />
                        <ul role="list">
                          {s.tilePoints.map((pt) => (
                            <li>{pt[lang]}</li>
                          ))}
                        </ul>
                        <a class="tile__link" href={href(k, lang)}>
                          {see(s.name[lang])}
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <section class="more-in" id="more-in-tyll" aria-labelledby="more-in-title">
      <h2 id="more-in-title">{d.solutionPage.moreInTyll.title}</h2>
      <ul role="list">
        {
          more.map((m) => (
            <li>
              <a href={m.url}>
                <span class="more-in__name">{m.name}</span>
                <span class="more-in__text">{m.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <p class="index__soon">{d.home.parts.soon}</p>
    <details class="also">
      <summary>{d.solutionPage.also.title}</summary>
      <ul class="also__list" role="list">
        {
          d.solutionPage.also.items.map(([name, text]) => (
            <li>
              <h3>{name}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ul>
    </details>
  </div>

  <section class="close on-dark" data-dark aria-labelledby="index-final">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap close__inner">
      <h2 id="index-final" class="display">{d.home.invite.title}</h2>
      <a class="btn btn--solid btn--lg" href={href('book', lang)} data-track="book_demo_click" data-track-from="solutions-final">{d.cta.book}</a>
    </div>
  </section>
</Base>

<style>
  .index-top {
    position: relative;
    overflow: hidden;
  }

  .index-top > :global(*:not(.wave)) {
    position: relative;
    z-index: 1;
  }

  .index {
    padding-bottom: var(--section-y);
  }

  .sec {
    padding-bottom: var(--s-6);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .sec__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    align-items: baseline;
    margin-bottom: var(--s-3);
  }

  .sec h2 {
    margin: 0;
    font-size: var(--fs-h2);
  }

  .sec__head p {
    max-width: none;
    margin: 0;
    color: var(--steel);
    font-size: var(--fs-lead);
  }

  /* The live site's photo tiles, three per row */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A tile keeps a 4:5 shape and grows taller when it opens */
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    color: var(--on-dark);
    isolation: isolate;
  }

  /* the photo layer is clipped to the rounded corners, so the tile itself can grow past its shape when it opens */
  .tile :global(picture),
  .tile__shade {
    overflow: hidden;
    border-radius: inherit;
  }

  .tile :global(picture),
  .tile :global(img),
  .tile__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tile :global(picture),
  .tile :global(img) {
    z-index: -2;
  }

  .tile :global(img) {
    object-fit: cover;
    filter: var(--photo-grade);
    transition: transform 0.8s var(--ease);
  }

  .tile__shade {
    z-index: -1;
    background: linear-gradient(0deg, rgb(var(--shade-rgb) / 0.88) 0%, rgb(var(--shade-rgb) / 0.35) 55%, rgb(var(--shade-rgb) / 0.15) 100%);
    transition: background-color 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .tile.is-open .tile__shade {
    background-color: rgb(var(--shade-rgb) / 0.45);
  }

  .tile__btn {
    display: grid;
    gap: 0.4rem;
    width: 100%;
    padding: 1.5rem 1.5rem 1.25rem;
    border: 0;
    border-radius: var(--radius-lg);
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  /* the whole tile answers the click */
  .tile__btn::before {
    position: absolute;
    inset: 0;
    content: '';
  }

  .tile__btn:focus-visible {
    outline: 2px solid var(--on-dark);
    outline-offset: -6px;
  }

  @media (hover: hover) and (pointer: fine) {
    .tile:hover :global(img) {
      transform: scale(1.04);
    }
  }

  .tile__chip {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.5rem;
    border-radius: 12px;
    background: var(--paper);
    color: var(--acc);
  }

  .tile__chip :global(svg) {
    width: 22px;
    height: 22px;
  }

  .tile__name {
    font-size: 1.5rem;
    letter-spacing: 0;
  }

  .tile__desc {
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  /* The panel unfolds under the title: grid rows from 0 to its height, 250 ms ease-out */
  .tile__reveal {
    position: relative;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .tile.is-open .tile__reveal {
    grid-template-rows: 1fr;
  }

  .tile__panel {
    overflow: hidden;
  }

  .tile__panel ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0 1.5rem;
    list-style: none;
  }

  .tile__panel li {
    position: relative;
    padding-inline-start: 1rem;
    color: var(--on-dark);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .tile__panel li::before {
    position: absolute;
    top: 0.6em;
    inset-inline-start: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--on-dark);
    content: '';
  }

  .tile__link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: 0.75rem 1.5rem 1.25rem;
    color: var(--on-dark);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* The tile's clip: a muted loop of its film, loaded the first time the tile opens */
  .tile__clip {
    display: block;
    width: calc(100% - 3rem);
    margin: 0 1.5rem 0.9rem;
    aspect-ratio: 1440 / 900;
    border-radius: var(--radius-md);
    background: rgb(var(--shade-rgb) / 0.5);
    object-fit: cover;
  }

  /* More in Tyll: four plain links in one row, two on tablets, one on phones */
  .more-in {
    padding-bottom: var(--s-5);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .more-in h2 {
    margin: 0 0 var(--s-3);
    font-size: var(--fs-h3, 1.5rem);
  }

  .more-in ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more-in a {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s var(--ease);
  }

  .more-in a:hover {
    border-color: var(--hair);
  }

  .more-in__name {
    font-weight: 600;
  }

  .more-in__text {
    color: var(--steel);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  @media (max-width: 1000px) {
    .more-in ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .more-in ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .index__soon {
    margin: 0;
    color: var(--text-2);
    font-size: var(--fs-small);
  }

  /* Also in Tyll: collapsed by default */
  .also {
    margin-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .also summary {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    cursor: pointer;
    list-style: none;
  }

  .also summary::-webkit-details-marker {
    display: none;
  }

  .also summary::after {
    margin-inline-start: 0.75rem;
    font-family: var(--font);
    font-size: 1.25rem;
    content: '+';
  }

  .also[open] summary::after {
    content: '−';
  }

  .also__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3) var(--s-4);
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .also h3 {
    margin: 0;
    font-family: var(--font);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .also p {
    max-width: none;
    margin: 0.3rem 0 0;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .close {
    position: relative;
    overflow: hidden;
    padding-block: var(--band-y);
    background: var(--night-1);
    color: var(--text-1);
  }

  .close__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .close h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem);
  }

  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .also__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .tiles,
    .also__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .tile {
      aspect-ratio: 16 / 11;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile__reveal,
    .tile__shade,
    .tile :global(img) {
      transition: none;
    }
  }
</style>

<script>
  // One tile open at a time: a second click, another tile or Escape closes it. The panel is inert while closed, so
  // its link is never reached by Tab or a screen reader until the tile opens.
  const tiles = [...document.querySelectorAll<HTMLElement>('[data-tile]')];
  // Each tile's clip is fetched the first time it opens, plays while open (not with reduced motion) and pauses on close
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const setTile = (tile: HTMLElement, open: boolean) => {
    tile.classList.toggle('is-open', open);
    tile.querySelector('.tile__btn')!.setAttribute('aria-expanded', String(open));
    tile.querySelector<HTMLElement>('.tile__panel')!.inert = !open;
    const clip = tile.querySelector<HTMLVideoElement>('.tile__clip');
    if (!clip) return;
    if (open) {
      if (!clip.getAttribute('src')) {
        clip.poster = clip.dataset.poster!;
        clip.src = clip.dataset.src!;
      }
      if (!still.matches) clip.play().catch(() => {});
    } else if (!clip.paused) clip.pause();
  };
  tiles.forEach((tile) =>
    tile.querySelector('.tile__btn')!.addEventListener('click', () => {
      const open = !tile.classList.contains('is-open');
      tiles.forEach((x) => setTile(x, x === tile && open));
    }),
  );
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = tiles.find((x) => x.classList.contains('is-open'));
    if (!open) return;
    setTile(open, false);
    open.querySelector<HTMLElement>('.tile__btn')!.focus();
  });
</script>
