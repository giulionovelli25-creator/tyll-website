---
import Base from '../../layouts/Base.astro';
import Hero from './Hero.astro';
import Problem from './Problem.astro';
import HowItWorks from './HowItWorks.astro';
import Solutions from './Solutions.astro';
import GetStarted from './GetStarted.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<Base lang={lang} page="home" title={d.meta.homeTitle} description={d.meta.homeDescription} overHero>
  <Hero lang={lang} />
  <Problem lang={lang} />
  <HowItWorks lang={lang} />
  <Solutions lang={lang} />
  <GetStarted lang={lang} />
</Base>
