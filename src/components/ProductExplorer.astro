---
// One real demo screen at a time, explored part by part.
// The parts are tabs above the screen. Each part is a complete block of the interface (its frame is snapped to the
// gaps between cards, so nothing is cut through): on wider screens it is shown sharp and large over a soft view of
// the whole screen behind it, with the exact detail ringed and one or two sentences underneath. A part that lives on
// another demo screen brings that screen in behind it. Where the content carries on (a long list or form), the frame
// fades out and offers the whole screen. On phones the part is shown at a readable size and scrolls sideways when it
// is wider than the phone. "Whole screen" shows the complete capture; "Enlarge" opens every screen at full size.
// Nothing moves on its own. Without JavaScript the first part is framed and every explanation is listed.
// The demo is in English and left-to-right, so the screen keeps that direction in every language.
import { Picture, getImage } from 'astro:assets';
import type { Solution } from '../content/solutions';
import type { Explore, Rect } from '../content/explore';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  solution: Solution;
  explore: Explore;
  id: string;
}

const { lang, solution, explore, id } = Astro.props;
const p = t(lang).solutionPage;
const frames = solution.frames;
const spots = explore.spots;

// Desktop framing, computed here so the browser measures nothing. The view has a fixed aspect ratio; the capture is
// scaled so the part fits with a little air around it, centred on it. The result is a transform for an element as
// wide as the view and as tall as the capture at that width, plus the clip that keeps only the part visible.
const IMG = 1440 / 1240;
const VIEW = 1.66;
const MAX_ZOOM = 1.6;
const n2 = (v: number) => Math.round(v * 10000) / 100;
const cam = (r: Rect) => {
  const [x, y, w, h] = r;
  const vh = 1 / VIEW;
  const z = Math.min(MAX_ZOOM, 0.92 / w, (0.9 * vh) / (h / IMG));
  const left = 0.5 - (x + w / 2) * z;
  const top = vh / 2 - (y + h / 2) * (z / IMG);
  return `${n2(left)},${n2(top * IMG)},${Math.round(z * 1000) / 1000}`;
};
const clip = (r: Rect) => [r[1], 1 - r[0] - r[2], 1 - r[1] - r[3], r[0]].map((v) => `${n2(Math.max(0, v))}%`).join(' ');
const whole: Rect = [0, 0, 1, 1];
const wholeCam = cam(whole);

const used = [...new Set(spots.map((s) => s.frame))];
const views = spots.map((s) => ({ cam: cam(s.focus), clip: clip(s.focus), rect: s.focus.join(','), fade: n2(s.focus[1] + s.focus[3]) }));
const layers = used.map((frame) => ({ frame, first: spots.findIndex((s) => s.frame === frame) }));
const camStyle = (i: number) => {
  const [x, y, z] = views[i].cam.split(',');
  return `--x:${x}%;--y:${y}%;--z:${z};--clip:inset(${views[i].clip} round calc(14px / ${z}));--fade:${spots[i].fade ? `${views[i].fade}%` : '200%'}`;
};
const wholeStyle = (() => {
  const [x, y, z] = wholeCam.split(',');
  return `--x:${x}%;--y:${y}%;--z:${z}`;
})();
const pct = (r: Rect) => `left:${r[0] * 100}%;top:${r[1] * 100}%;width:${r[2] * 100}%;height:${r[3] * 100}%`;
// Every screen of this solution, full size, for the viewer
const full = await Promise.all(frames.map((f) => getImage({ src: f.img, width: f.img.width, format: 'webp', quality: 85 })));
// Stage names, shown once before the first part of each stage (Forecasting)
const stageStart = spots.map((s, i) => (s.stage && (i === 0 || spots[i - 1].stage?.[lang] !== s.stage[lang]) ? s.stage[lang] : null));
---

<div class:list={['ex', `ex--${explore.tone}`]} data-ex id={id} data-whole-cam={wholeCam}>
  <div class="ex__parts" role="tablist" aria-label={p.exploreParts} hidden>
    {
      spots.map((s, i) => (
        <>
          {stageStart[i] && (
            <span class="ex__stage-name" role="presentation">
              {stageStart[i]}
            </span>
          )}
          <button
            type="button"
            role="tab"
            class="ex__part"
            id={`${id}-tab-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`${id}-view`}
            tabindex={i === 0 ? 0 : -1}
            data-spot={i}
            data-frame={s.frame}
            data-cam={views[i].cam}
            data-clip={views[i].clip}
            data-rect={views[i].rect}
            data-fade={s.fade ? views[i].fade : undefined}
          >
            {s.label[lang]}
          </button>
        </>
      ))
    }
  </div>

  <figure class="ex__window" id={`${id}-view`} role="tabpanel" aria-labelledby={`${id}-tab-0`}>
    <div class="ex__chrome" dir="ltr">
      <span class="ex__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="ex__url" aria-hidden="true">
        <svg viewBox="0 0 12 12"><path d="M3.5 5.5V4a2.5 2.5 0 0 1 5 0v1.5M3 5.5h6v4.5H3z" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" /></svg>
        demo.tyll.ai
      </span>
      <span class="ex__tools">
        <button type="button" class="ex__tool" data-whole aria-pressed="false" data-on={p.closeUp} data-off={p.wholeScreen} hidden>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 2.5h-4v4M9.5 2.5h4v4M6.5 13.5h-4v-4M9.5 13.5h4v-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>{p.wholeScreen}</span>
        </button>
        <button type="button" class="ex__tool ex__tool--icon" data-enlarge aria-label={p.enlarge} hidden>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </span>
    </div>

    <div class="ex__view" dir="ltr">
      {
        layers.map((l, k) => (
          <div class:list={['ex__layer', k === 0 && 'is-on']} data-layer={l.frame} aria-hidden={k === 0 ? undefined : 'true'}>
            <div class="ex__backdrop" style={wholeStyle} aria-hidden="true">
              <Picture src={frames[l.frame].img} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={[1440, 2880]} sizes="1280px" loading="lazy" decoding="async" />
            </div>
            <div class="ex__cam" style={camStyle(l.first)}>
              <div class="ex__canvas">
                <Picture
                  src={frames[l.frame].img}
                  alt={frames[l.frame].alt[lang]}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[1440, 2880]}
                  sizes="(max-width: 900px) 1400px, 2200px"
                  loading="lazy"
                  decoding="async"
                  class="ex__img"
                />
                {spots.map(
                  (s, i) =>
                    s.frame === l.frame && (
                      <button
                        type="button"
                        class:list={['ex__mark', !s.mark && 'ex__mark--area', i === 0 && 'is-on']}
                        style={pct(s.mark ?? s.focus)}
                        data-mark={i}
                        tabindex="-1"
                        aria-hidden="true"
                      />
                    ),
                )}
              </div>
            </div>
          </div>
        ))
      }
      <button type="button" class="ex__more" data-more hidden>
        <span>{p.wholeScreen}</span>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </figure>
  <p class="ex__swipe" data-swipe hidden>{p.swipeHint}</p>

  <div class="ex__notes" aria-live="polite">
    {
      spots.map((s, i) => (
        <div class:list={['ex__note', i === 0 && 'is-on']} data-note={i}>
          <h3 class="ex__note-title">
            {s.stage && <span class="ex__note-stage">{s.stage[lang]}</span>}
            {s.label[lang]}
          </h3>
          <p>{s.text[lang]}</p>
        </div>
      ))
    }
  </div>

  <dialog class="viewer" aria-label={p.viewer}>
    <div class="viewer__bar">
      <p class="viewer__title" aria-live="polite"></p>
      <div class="viewer__tools">
        <button type="button" class="viewer__btn" data-viewer="prev" aria-label={p.prev}>
          <svg class="flip-rtl" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="viewer__btn" data-viewer="next" aria-label={p.next}>
          <svg class="flip-rtl" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="viewer__btn viewer__zoom" data-viewer="zoom" aria-pressed="false" data-in={p.zoomIn} data-out={p.zoomOut}>
          {p.zoomIn}
        </button>
        <button type="button" class="viewer__btn" data-viewer="close" aria-label={p.close}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
      </div>
    </div>
    <div class="viewer__stage">
      <img class="viewer__img" alt="" decoding="async" />
    </div>
    <ul hidden>
      {frames.map((f, i) => <li data-shot={i} data-full={full[i].src} data-title={f.title[lang]} data-alt={f.alt[lang]} data-phone={f.phone ? '' : undefined} />)}
    </ul>
  </dialog>
</div>

<style>
  .ex {
    --ring: #b7791f;
    --ex-gap: clamp(0.75rem, 0.5rem + 0.6vw, 1.125rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ex-gap);
  }

  /* Desktop: tabs, the whole screen and its explanation fit in one view. The screen keeps its proportions and is
     sized from the height left once the header, tabs, browser bar, explanation and gaps are counted (the script
     measures the tabs and the tallest explanation). It never gets narrower than 900px, where the demo text would
     become too small to read; it never gets wider than the column. */
  @media (min-width: 901px) {
    .ex {
      --ex-fit: calc(
        100svh - var(--header-h) - 1.5rem - var(--ex-tabs, 42px) - 44px - var(--ex-notes, 6.5rem) - var(--ex-gap) * 2
      );
      width: min(100%, max(900px, var(--ex-fit) * 1.66));
      margin-inline: auto;
    }

    /* The tabs keep one line where the column allows it, running on past the screen's edge rather than wrapping */
    .ex__parts {
      width: max-content;
      /* At most to the column's edge: the screen is centred, so half the spare column width is free on that side */
      max-width: calc((100% + min(1280px, 100vw - 2 * var(--gut)) - 16px) / 2);
    }
  }

  /* ── The parts to explore ── */
  .ex__parts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .ex__parts[hidden] {
    display: none;
  }

  .ex__stage-name {
    margin-inline: 0.6rem 0.1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0.6;
  }

  .ex__stage-name:first-child {
    margin-inline-start: 0;
  }

  .ex__part {
    min-height: 40px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--ex-line);
    border-radius: var(--pill);
    background: transparent;
    color: var(--ex-muted);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }

  .ex__part:hover {
    border-color: var(--ex-text);
    color: var(--ex-text);
  }

  .ex__part[aria-selected='true'] {
    border-color: var(--ex-on-bg);
    background: var(--ex-on-bg);
    color: var(--ex-on-text);
  }

  /* ── The browser window ── */
  .ex__window {
    margin: 0;
    border-radius: 16px;
    background: #fff;
    box-shadow:
      0 0 0 1px var(--ex-frame),
      0 60px 120px -60px rgba(0, 0, 0, 0.55),
      0 24px 48px -32px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .ex__chrome {
    position: relative;
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 0.6rem 0 1rem;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, #fbfbfc, #f2f3f5);
  }

  .ex__dots {
    display: flex;
    gap: 6px;
  }

  .ex__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--silver);
  }

  .ex__url {
    position: absolute;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.9rem;
    border-radius: var(--pill);
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
    color: var(--steel);
    font-size: 0.75rem;
    transform: translateX(-50%);
  }

  .ex__url svg {
    width: 11px;
    height: 11px;
  }

  .ex__tools {
    display: flex;
    gap: 0.35rem;
    margin-left: auto;
  }

  .ex__tool {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 32px;
    padding: 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    background: #fff;
    color: var(--graphite);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .ex__tool[hidden] {
    display: none;
  }

  .ex__tool:hover {
    border-color: var(--steel);
    color: var(--ink);
  }

  .ex__tool--icon {
    width: 32px;
    padding: 0;
    justify-content: center;
  }

  .ex__tool svg {
    width: 14px;
    height: 14px;
  }

  /* ── The screen ── */
  .ex__view {
    position: relative;
    aspect-ratio: 1.66;
    overflow: hidden;
    background: #e9ebee;
  }

  .ex__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    filter: drop-shadow(0 18px 30px rgba(20, 22, 26, 0.14)) drop-shadow(0 2px 4px rgba(20, 22, 26, 0.06));
    transition:
      opacity 0.5s var(--ease),
      visibility 0s linear 0.5s;
  }

  .ex__layer.is-on {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.5s var(--ease),
      visibility 0s;
  }

  /* The whole screen, softly, so the part in front keeps its context */
  .ex__backdrop,
  .ex__cam {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 1440 / 1240;
    transform-origin: 0 0;
    transform: translate(var(--x), var(--y)) scale(var(--z));
  }

  .ex__backdrop {
    opacity: 0.55;
    filter: blur(2px) saturate(0.8);
    transition: opacity 0.6s var(--ease);
  }

  .ex__backdrop :global(picture),
  .ex__backdrop :global(img),
  .ex__canvas :global(picture),
  .ex__canvas :global(.ex__img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The part itself: sharp and complete, lifted slightly from the screen behind it */
  .ex__cam {
    clip-path: var(--clip);
    -webkit-mask-image: linear-gradient(180deg, #000 calc(var(--fade) - 4%), transparent var(--fade));
    mask-image: linear-gradient(180deg, #000 calc(var(--fade) - 4%), transparent var(--fade));
    transition:
      transform 0.85s var(--ease),
      clip-path 0.85s var(--ease);
  }

  .ex__canvas {
    position: absolute;
    inset: 0;
  }

  .ex.is-whole .ex__backdrop {
    opacity: 0;
  }

  /* The exact detail: a fine amber ring */
  .ex__mark {
    position: absolute;
    padding: 0;
    border: 0;
    border-radius: calc(10px / var(--z));
    background: transparent;
    cursor: pointer;
    transition:
      box-shadow 0.5s var(--ease),
      opacity 0.4s var(--ease);
  }

  .ex__mark:hover {
    box-shadow: 0 0 0 calc(1.5px / var(--z)) rgba(183, 121, 31, 0.55);
  }

  .ex__mark.is-on {
    box-shadow:
      0 0 0 calc(2px / var(--z)) var(--ring),
      0 0 0 calc(7px / var(--z)) rgba(183, 121, 31, 0.16);
    cursor: default;
  }

  .ex__mark--area.is-on {
    box-shadow: none;
  }

  /* Where the content carries on below the frame */
  .ex__more {
    position: absolute;
    left: 50%;
    bottom: 4%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 34px;
    padding: 0 0.95rem;
    border: 0;
    border-radius: var(--pill);
    background: var(--ink);
    color: #fff;
    font: inherit;
    font-size: 0.8125rem;
    box-shadow: 0 10px 24px -10px rgba(20, 22, 26, 0.5);
    cursor: pointer;
    transform: translateX(-50%);
  }

  .ex__more[hidden] {
    display: none;
  }

  .ex__more svg {
    width: 14px;
    height: 14px;
  }

  .ex__swipe {
    margin-top: -0.25rem;
    color: var(--ex-muted);
    font-size: 0.8125rem;
  }

  .ex__swipe[hidden] {
    display: none;
  }

  /* ── The explanation under the screen ── */
  .ex__notes {
    display: grid;
  }

  .ex__note {
    padding: 0.25rem 0 0;
  }

  .ex__note + .ex__note {
    margin-top: 1.25rem;
  }

  .ex.is-ready .ex__note {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease),
      visibility 0s linear 0.4s;
  }

  .ex.is-ready .ex__note.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.45s var(--ease) 0.1s,
      transform 0.45s var(--ease) 0.1s,
      visibility 0s;
  }

  .ex__note-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    color: var(--ex-text);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 450;
    letter-spacing: -0.015em;
  }

  .ex__note-stage {
    color: var(--ex-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .ex__note p {
    max-width: 46rem;
    margin-top: 0.4rem;
    color: var(--ex-muted);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  /* ── Tones: charcoal or light stone behind the product ── */
  .ex--dark {
    --ex-text: var(--on-dark);
    --ex-muted: rgba(244, 245, 247, 0.74);
    --ex-line: rgba(244, 245, 247, 0.24);
    --ex-on-bg: var(--on-dark);
    --ex-on-text: var(--ink);
    --ex-frame: rgba(255, 255, 255, 0.08);
  }

  .ex--light {
    --ex-text: var(--ink);
    --ex-muted: var(--graphite);
    --ex-line: var(--silver);
    --ex-on-bg: var(--ink);
    --ex-on-text: #fff;
    --ex-frame: rgba(20, 22, 26, 0.08);
  }

  /* ── Viewer ── */
  .viewer {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(14, 15, 17, 0.96);
    color: var(--on-dark);
  }

  .viewer::backdrop {
    background: rgba(14, 15, 17, 0.6);
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .viewer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem max(16px, 2vw);
    border-bottom: 1px solid rgba(244, 245, 247, 0.1);
  }

  .viewer__title {
    overflow: hidden;
    font-size: 0.9375rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .viewer__tools {
    display: flex;
    flex: none;
    gap: 0.4rem;
  }

  .viewer__btn {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.6rem;
    border: 1px solid rgba(244, 245, 247, 0.22);
    border-radius: 999px;
    background: transparent;
    color: var(--on-dark);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .viewer__btn:hover {
    border-color: var(--on-dark);
  }

  .viewer__btn svg {
    width: 15px;
    height: 15px;
  }

  .viewer__stage {
    display: grid;
    place-items: center;
    overflow: auto;
    padding: max(12px, 2vw);
    overscroll-behavior: contain;
  }

  .viewer__img {
    max-width: 100%;
    max-height: calc(100dvh - 64px - 2 * max(12px, 2vw));
    border-radius: 8px;
    background: var(--paper);
    cursor: zoom-in;
  }

  .viewer.is-zoomed .viewer__stage {
    place-items: start;
  }

  .viewer.is-zoomed .viewer__img {
    max-width: none;
    max-height: none;
    width: min(1440px, 200vw);
    cursor: zoom-out;
  }

  .viewer.is-zoomed .viewer__img.is-phone {
    width: 390px;
  }

  /* ── Phones: the part at a readable size, scrolling sideways when it is wider than the phone ── */
  @media (max-width: 900px) {
    .ex__view {
      aspect-ratio: auto;
      padding: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
    }

    .ex__layer {
      position: relative;
      inset: auto;
      display: none;
      filter: none;
    }

    /* While part of the screen is still to the right, its edge fades so the sideways scroll is obvious */
    .ex__view.is-more {
      -webkit-mask-image: linear-gradient(90deg, #000 82%, rgba(0, 0, 0, 0.25) 100%);
      mask-image: linear-gradient(90deg, #000 82%, rgba(0, 0, 0, 0.25) 100%);
    }

    .ex__layer.is-on {
      display: block;
    }

    .ex__backdrop {
      display: none;
    }

    .ex__cam {
      position: relative;
      width: var(--cw, 100%);
      height: var(--ch, auto);
      aspect-ratio: auto;
      overflow: hidden;
      border-radius: 10px;
      transform: none;
      clip-path: none;
      box-shadow: 0 6px 16px -8px rgba(20, 22, 26, 0.25);
      transition: none;
    }

    .ex__canvas {
      inset: auto;
      left: var(--cl, 0);
      top: var(--ct, 0);
      width: var(--iw, 100%);
      aspect-ratio: 1440 / 1240;
    }

    .ex__mark {
      border-radius: 6px;
    }

    .ex__mark.is-on {
      box-shadow:
        0 0 0 2px var(--ring),
        0 0 0 6px rgba(183, 121, 31, 0.16);
    }

    .ex__more {
      position: sticky;
      left: 50%;
      bottom: auto;
      display: flex;
      width: max-content;
      margin: -46px 0 10px;
      transform: translateX(-50%);
    }

    .ex__parts {
      flex-wrap: nowrap;
      margin-inline: calc(var(--gut) * -1);
      padding-inline: var(--gut);
      padding-bottom: 0.25rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .ex__parts::-webkit-scrollbar {
      display: none;
    }

    .ex__part {
      flex: none;
      font-size: 0.875rem;
    }

    .ex__stage-name {
      flex: none;
    }

    .ex__url {
      display: none;
    }

    .ex__tool span {
      display: none;
    }

    .ex__tool {
      width: 32px;
      padding: 0;
      justify-content: center;
    }

    .ex__window {
      border-radius: 12px;
    }
  }

  @media (max-width: 560px) {
    .viewer__zoom {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ex__cam,
    .ex__backdrop,
    .ex__layer,
    .ex__layer.is-on,
    .ex.is-ready .ex__note,
    .ex.is-ready .ex__note.is-on {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ex]').forEach((ex) => {
    const list = ex.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = [...ex.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = ex.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const view = ex.querySelector<HTMLElement>('.ex__view')!;
    const notes = [...ex.querySelectorAll<HTMLElement>('[data-note]')];
    const layers = [...ex.querySelectorAll<HTMLElement>('[data-layer]')];
    const marks = [...ex.querySelectorAll<HTMLElement>('[data-mark]')];
    const wholeBtn = ex.querySelector<HTMLButtonElement>('[data-whole]')!;
    const wholeLabel = wholeBtn.querySelector('span')!;
    const more = ex.querySelector<HTMLButtonElement>('[data-more]')!;
    const swipe = ex.querySelector<HTMLElement>('[data-swipe]')!;
    const enlarge = ex.querySelector<HTMLButtonElement>('[data-enlarge]')!;
    const phone = matchMedia("(max-width: 900px)");
    let active = 0;
    let whole = false;

    const layerOf = (frame: string) => layers.find((l) => l.dataset.layer === frame)!;

    // Desktop: the camera transform and the clip that keeps only the part
    const frameDesktop = (camEl: HTMLElement, tab: HTMLElement) => {
      const [x, y, z] = (whole ? ex.dataset.wholeCam! : tab.dataset.cam!).split(',');
      camEl.style.setProperty('--x', `${x}%`);
      camEl.style.setProperty('--y', `${y}%`);
      camEl.style.setProperty('--z', z);
      camEl.style.setProperty('--clip', whole ? 'inset(0% 0% 0% 0% round 0px)' : `inset(${tab.dataset.clip} round calc(14px / ${z}))`);
      camEl.style.setProperty('--fade', !whole && tab.dataset.fade ? `${tab.dataset.fade}%` : '200%');
    };

    // Phones: a box exactly the size of the part at a readable scale; wider parts scroll sideways
    const framePhone = (camEl: HTMLElement, tab: HTMLElement) => {
      const [x, y, w, h] = whole ? [0, 0, 1, 1] : tab.dataset.rect!.split(',').map(Number);
      const room = view.clientWidth - 24;
      const s = whole ? room / 1440 : Math.min(1, Math.max(room / (w * 1440), 0.8));
      camEl.style.setProperty('--cw', `${Math.round(w * 1440 * s)}px`);
      camEl.style.setProperty('--ch', `${Math.round(h * 1240 * s)}px`);
      camEl.style.setProperty('--iw', `${Math.round(1440 * s)}px`);
      camEl.style.setProperty('--cl', `${Math.round(-x * 1440 * s)}px`);
      camEl.style.setProperty('--ct', `${Math.round(-y * 1240 * s)}px`);
      camEl.style.setProperty('--z', '1');
      camEl.style.setProperty('--fade', !whole && tab.dataset.fade ? '100%' : '200%');
      view.scrollLeft = 0;
      swipe.hidden = w * 1440 * s <= room + 1;
      edge();
    };
    const edge = () => view.classList.toggle('is-more', phone.matches && view.scrollLeft + view.clientWidth < view.scrollWidth - 4);
    view.addEventListener('scroll', edge, { passive: true });

    const render = () => {
      const tab = tabs[active];
      const layer = layerOf(tab.dataset.frame!);
      const camEl = layer.querySelector<HTMLElement>('.ex__cam')!;
      layers.forEach((l) => {
        const on = l === layer;
        l.classList.toggle('is-on', on);
        l.setAttribute('aria-hidden', String(!on));
      });
      if (phone.matches) framePhone(camEl, tab);
      else {
        frameDesktop(camEl, tab);
        swipe.hidden = true;
        view.classList.remove('is-more');
      }
      more.hidden = whole || !tab.dataset.fade;
      ex.classList.toggle('is-whole', whole);
      wholeBtn.setAttribute('aria-pressed', String(whole));
      wholeLabel.textContent = whole ? wholeBtn.dataset.on! : wholeBtn.dataset.off!;
    };

    const select = (i: number, focus = false) => {
      active = i;
      whole = false;
      tabs.forEach((tab, j) => {
        const on = i === j;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        notes[j].classList.toggle('is-on', on);
      });
      marks.forEach((m) => m.classList.toggle('is-on', m.dataset.mark === String(i)));
      panel.setAttribute('aria-labelledby', tabs[i].id);
      render();
      if (focus) {
        tabs[i].focus();
        tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));
    list.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const rtl = document.documentElement.dir === 'rtl';
      const step = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1, ArrowDown: 1, ArrowUp: -1 }[e.key];
      if (step) select((i + step + tabs.length) % tabs.length, true);
      else if (e.key === 'Home') select(0, true);
      else if (e.key === 'End') select(tabs.length - 1, true);
      else return;
      e.preventDefault();
    });
    // The ringed parts can be chosen on the screen itself
    marks.forEach((m) => m.addEventListener('click', () => select(Number(m.dataset.mark))));
    const toggleWhole = () => {
      whole = !whole;
      render();
    };
    wholeBtn.addEventListener('click', toggleWhole);
    more.addEventListener('click', toggleWhole);
    phone.addEventListener('change', render);
    let lastWidth = 0;
    new ResizeObserver(() => {
      if (!phone.matches || view.clientWidth === lastWidth) return;
      lastWidth = view.clientWidth;
      render();
    }).observe(view);
    // The tabs and the tallest explanation decide how much height the screen can have (see the desktop sizing)
    const notesBox = ex.querySelector<HTMLElement>('.ex__notes')!;
    // Measured on the next frame and set only when a value changes, so a resize never feeds back into itself
    let fitFrame = 0;
    const setVar = (name: string, value: string) => ex.style.getPropertyValue(name) !== value && ex.style.setProperty(name, value);
    const fit = () => {
      cancelAnimationFrame(fitFrame);
      fitFrame = requestAnimationFrame(() => {
        setVar('--ex-tabs', `${Math.ceil(list.offsetHeight)}px`);
        setVar('--ex-notes', `${Math.ceil(notesBox.offsetHeight)}px`);
      });
    };
    const fitObserver = new ResizeObserver(fit);
    fitObserver.observe(list);
    fitObserver.observe(notesBox);

    // ── Viewer: every screen of this solution at full size ──
    const viewer = ex.querySelector<HTMLDialogElement>('.viewer')!;
    const vImg = viewer.querySelector<HTMLImageElement>('.viewer__img')!;
    const vTitle = viewer.querySelector<HTMLElement>('.viewer__title')!;
    const vZoom = viewer.querySelector<HTMLButtonElement>('[data-viewer="zoom"]')!;
    const shots = [...viewer.querySelectorAll<HTMLElement>('[data-shot]')];
    let shown = 0;
    const setZoom = (on: boolean) => {
      viewer.classList.toggle('is-zoomed', on);
      vZoom.setAttribute('aria-pressed', String(on));
      vZoom.textContent = on ? vZoom.dataset.out! : vZoom.dataset.in!;
    };
    const load = (i: number) => {
      shown = (i + shots.length) % shots.length;
      const s = shots[shown];
      vImg.src = s.dataset.full!;
      vImg.alt = s.dataset.alt!;
      vImg.classList.toggle('is-phone', s.hasAttribute('data-phone'));
      vTitle.textContent = `${s.dataset.title} · ${shown + 1} / ${shots.length}`;
      setZoom(false);
    };
    enlarge.addEventListener('click', () => {
      load(Number(tabs[active].dataset.frame));
      viewer.showModal();
      viewer.querySelector<HTMLElement>('[data-viewer="close"]')!.focus();
    });
    viewer.addEventListener('click', (e) => {
      const action = (e.target as Element).closest<HTMLElement>('[data-viewer]')?.dataset.viewer;
      if (action === 'close') viewer.close();
      else if (action === 'prev') load(shown - 1);
      else if (action === 'next') load(shown + 1);
      else if (action === 'zoom' || e.target === vImg) setZoom(!viewer.classList.contains('is-zoomed'));
    });
    viewer.addEventListener('keydown', (e) => {
      const rtl = document.documentElement.dir === 'rtl';
      if (e.key === 'ArrowLeft') load(shown + (rtl ? 1 : -1));
      if (e.key === 'ArrowRight') load(shown + (rtl ? -1 : 1));
    });
    viewer.addEventListener('close', () => enlarge.focus({ preventScroll: true }));

    list.hidden = false;
    wholeBtn.hidden = false;
    enlarge.hidden = false;
    ex.classList.add('is-ready');
    select(0);
  });
</script>
