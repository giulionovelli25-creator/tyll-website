{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/en/", "permanent": false },
    { "source": "/index.html", "destination": "/en/", "permanent": true },
    { "source": "/de.html", "destination": "/de/", "permanent": true },
    { "source": "/ar.html", "destination": "/en/", "permanent": true },
    { "source": "/fr.html", "destination": "/en/", "permanent": true },
    { "source": "/book.html", "destination": "/en/book-a-call/", "permanent": true },
    { "source": "/faq.html", "destination": "/en/faq/", "permanent": true },
    { "source": "/security.html", "destination": "/en/#solutions", "permanent": true },
    { "source": "/reviews.html", "destination": "/en/", "permanent": true },
    { "source": "/impressum.html", "destination": "/de/impressum/", "permanent": true },
    { "source": "/datenschutz.html", "destination": "/de/datenschutz/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(media|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
