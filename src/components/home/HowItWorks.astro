---
import { Picture } from 'astro:assets';
import Logo from '../Logo.astro';
import { site } from '../../config/site';
import { t, type Locale } from '../../i18n';
import s1 from '../../assets/demo/story-1-alert.png';
import s2 from '../../assets/demo/story-2-case.png';
import s3 from '../../assets/demo/story-3-records.png';
import s4 from '../../assets/demo/story-4-assign.png';
import s5 from '../../assets/demo/story-5-assigned.png';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const h = d.how;
const shots = [s1, s2, s3, s4, s5];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="how" id="how" aria-labelledby="how-title">
  <div class="how__waves" aria-hidden="true"></div>
  <div class="wrap">
    <header class="how__head">
      <h2 id="how-title">{h.title}</h2>
      <p>{h.intro}</p>
    </header>

    <ol class="steps" data-check-group="steps" data-check-gap="420" data-check-duration="850">
      {
        h.steps.map((s, i) => (
          <li class="step" data-check-step>
            <div class="step__top">
              <span class="step__num">{pad(i + 1)}</span>
              <Logo mark anim="draw" label="" class="step__tick" />
            </div>
            <h3>{s.name}</h3>
            <p class="step__text">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="story" data-story>
      <div class="story__intro">
        <h3>{h.demoTitle}</h3>
        <p>{h.demoIntro}</p>
      </div>

      <div class="story__body">
        <ol class="story__steps">
          {
            h.demoFrames.map((f, i) => (
              <li>
                <button type="button" class="story__step" aria-current={i === 0 ? 'step' : undefined} data-index={i}>
                  <span class="story__n">{i + 1}</span>
                  <span>
                    <span class="story__title">{f.title}</span>
                    <span class="story__text">{f.text}</span>
                  </span>
                  <span class="story__bar" aria-hidden="true" />
                </button>
              </li>
            ))
          }
        </ol>

        <div class="story__screen">
          <div class="story__frame">
            {
              shots.map((img, i) => (
                <Picture
                  src={img}
                  alt={h.demoFrames[i].alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[720, 1080, 1440, 2160]}
                  sizes="(max-width: 960px) calc(100vw - 32px), 780px"
                  loading="lazy"
                  decoding="async"
                  class:list={['story__img', i === 0 && 'is-active']}
                  data-frame={i}
                  aria-hidden={i === 0 ? undefined : 'true'}
                />
              ))
            }
          </div>
          <div class="story__controls">
            <p class="story__note">{h.demoNote}</p>
            <button type="button" class="story__toggle" aria-pressed="false" data-pause={h.pause} data-play={h.play} hidden>
              <span class="visually-hidden">{h.pause}</span>
              <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.25v10H4.5zM9.25 3h2.25v10H9.25z" fill="currentColor" /></svg>
              <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor" /></svg>
            </button>
          </div>
        </div>
      </div>

      {
        site.demoUrl && (
          <div class="story__cta">
            <a class="btn btn--solid" href={site.demoUrl} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from="how">
              {d.cta.tryDemo}<span class="visually-hidden"> {d.cta.newTab}</span>
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .how {
    position: relative;
    padding-block: var(--section-y);
    background: linear-gradient(180deg, var(--mist) 0%, var(--cloud) 100%);
    overflow: hidden;
    isolation: isolate;
  }

  /* The flowing silver waves from the brand assets, kept faint so text stays crisp */
  .how__waves {
    position: absolute;
    inset: -10% -20% auto auto;
    z-index: -1;
    width: min(1100px, 90vw);
    aspect-ratio: 1040 / 667;
    background: url('/media/tyll-waves.webp') center / cover no-repeat;
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(200deg, #000 30%, transparent 80%);
    mask-image: linear-gradient(200deg, #000 30%, transparent 80%);
    pointer-events: none;
  }

  .how__head {
    max-width: 44rem;
  }

  .how__head h2 {
    font-size: var(--fs-h2);
  }

  .how__head p {
    margin-top: 1.25rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
    border-radius: var(--radius-lg);
    background: var(--line);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .step {
    padding: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    background: var(--paper);
  }

  .step__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .step__num {
    color: var(--steel);
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
  }

  .step :global(.step__tick) {
    width: 26px;
    height: auto;
    color: var(--ink);
  }

  .step h3 {
    font-size: 1.375rem;
    font-weight: 450;
    letter-spacing: -0.02em;
  }

  .step__text {
    margin-top: 0.6rem;
    color: var(--steel);
    font-size: 0.9875rem;
    line-height: 1.5;
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
  }

  /* Before a step's checkmark has drawn, its explanation waits */
  [data-armed] .step:not(.is-in) .step__text {
    opacity: 0;
    transform: translateY(6px);
  }

  .story {
    margin-top: clamp(4rem, 3rem + 4vw, 6.5rem);
  }

  .story__intro h3 {
    font-size: clamp(1.5rem, 1.25rem + 0.9vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .story__intro p {
    max-width: 40rem;
    margin-top: 0.75rem;
    color: var(--steel);
  }

  .story__body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: start;
    margin-top: 2rem;
  }

  .story__steps {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .story__step {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0.75rem;
    width: 100%;
    padding: 0.9rem 1rem 1rem;
    border: 0;
    border-radius: 14px;
    background: transparent;
    color: var(--steel);
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .story__step:hover {
    color: var(--ink);
  }

  .story__step[aria-current] {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--line);
  }

  .story__n {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--silver);
    border-radius: 50%;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  [aria-current] .story__n {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .story__title {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .story__text {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .story__step:not([aria-current]) .story__text {
    display: none;
  }

  /* Time left on the current frame while the demonstration plays */
  .story__bar {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0;
    height: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  [data-story].is-playing [aria-current] .story__bar {
    animation: story-progress var(--frame-ms, 4500ms) linear forwards;
  }

  @keyframes story-progress {
    to {
      transform: scaleX(1);
    }
  }

  .story__frame {
    position: relative;
    aspect-ratio: 2384 / 1800;
    border-radius: 16px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px var(--line),
      0 30px 60px -30px rgba(20, 22, 26, 0.28);
    overflow: hidden;
  }

  .story__frame :global(picture),
  .story__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .story__frame :global(img) {
    object-fit: cover;
    object-position: top left;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .story__frame :global(img.is-active) {
    opacity: 1;
  }

  .story__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .story__note {
    color: var(--steel);
    font-size: 0.8125rem;
  }

  .story__toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--silver);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .story__toggle svg {
    width: 13px;
    height: 13px;
  }

  .story__toggle .i-play,
  .story__toggle[aria-pressed='true'] .i-pause {
    display: none;
  }

  .story__toggle[aria-pressed='true'] .i-play {
    display: block;
  }

  .story__cta {
    margin-top: 2.5rem;
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .story__body {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Screen first on narrow layouts, the numbered captions underneath */
    .story__screen {
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .step__top {
      margin-bottom: 1.25rem;
    }
  }
</style>

<script>
  // Five real demo screens, advancing on their own while in view. Viewers can pick a step or pause;
  // with reduced motion nothing advances by itself.
  const FRAME_MS = 4500;
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((story) => {
    const steps = [...story.querySelectorAll<HTMLButtonElement>('.story__step')];
    const imgs = [...story.querySelectorAll<HTMLImageElement>('img[data-frame]')];
    const toggle = story.querySelector<HTMLButtonElement>('.story__toggle')!;
    const label = toggle.querySelector('.visually-hidden')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    story.style.setProperty('--frame-ms', `${FRAME_MS}ms`);

    let index = 0;
    let timer = 0;
    let paused = reduce;
    let visible = false;

    const show = (i: number) => {
      index = (i + steps.length) % steps.length;
      steps.forEach((s, k) => (k === index ? s.setAttribute('aria-current', 'step') : s.removeAttribute('aria-current')));
      imgs.forEach((img, k) => {
        img.classList.toggle('is-active', k === index);
        if (k === index) img.removeAttribute('aria-hidden');
        else img.setAttribute('aria-hidden', 'true');
        if (k === index) img.loading = 'eager';
      });
      // The next screen starts loading before it is needed
      if (imgs[index + 1]) imgs[index + 1].loading = 'eager';
    };
    const playing = () => !paused && visible;
    const schedule = () => {
      clearTimeout(timer);
      story.classList.remove('is-playing');
      if (!playing()) return;
      void story.offsetWidth; // restart the progress bar
      story.classList.add('is-playing');
      timer = window.setTimeout(() => {
        show(index + 1);
        schedule();
      }, FRAME_MS);
    };
    const syncToggle = () => {
      toggle.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? toggle.dataset.play! : toggle.dataset.pause!;
    };

    steps.forEach((s, i) =>
      s.addEventListener('click', () => {
        show(i);
        schedule();
      }),
    );
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      paused = !paused;
      syncToggle();
      schedule();
    });
    // Stop while someone is reading closely: hovering the demonstration with a mouse holds the current screen
    story.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(timer);
      story.classList.remove('is-playing');
    });
    story.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && schedule());

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        schedule();
      },
      { threshold: 0.4 },
    ).observe(story.querySelector('.story__frame')!);
    syncToggle();
  });
</script>
