---
// Shared frame for the Legal Notice and Privacy pages: title, the "incomplete" notice listing required
// details that are still missing, and readable long-form text styles.
import { legal, legalMissing } from '../../config/legal';
import { t, intlLocale, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  title: string;
  /** List the page's sections under "On this page" (used on the long privacy policy). */
  toc?: boolean;
}

const { lang, title, toc = false } = Astro.props;
// The contents list is read from the rendered sections, so it always matches the sections that are actually shown.
const body = await Astro.slots.render('default');
const sections = toc
  ? [...body.matchAll(/<h2 id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map(([, id, html]) => ({
      id,
      html: html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim(),
    }))
  : [];
const onThisPage = { en: 'On this page', de: 'Auf dieser Seite', ar: 'في هذه الصفحة', it: 'In questa pagina' }[lang];
const d = t(lang).legalPage;
const missing = legalMissing();
const updated = new Intl.DateTimeFormat(intlLocale[lang], { dateStyle: 'long' }).format(new Date(legal.updated));
---

<div class="legal-page">
  <!-- A quiet pearl band with a fine silver line holds the title -->
  <header class="legal__band">
    <div class="wrap legal__band-inner">
      <h1>{title}</h1>
      <p class="legal__meta">{d.updated}: {updated}. {d.review}</p>
    </div>
  </header>

  <div class:list={['wrap', 'legal', sections.length > 0 && 'legal--toc']}>
    <article class="legal__main">
      {
        missing.length > 0 && (
          <aside class="legal__missing" role="note">
            <h2>{d.incompleteTitle}</h2>
            <p>{d.incompleteText}</p>
            <ul>
              {missing.map((m) => (
                <li>{m[lang]}</li>
              ))}
            </ul>
          </aside>
        )
      }
      <div class="legal__body" set:html={body} />
    </article>

    {
      sections.length > 0 && (
        <nav class="legal__toc" aria-labelledby="legal-toc-title" data-toc>
          <h2 id="legal-toc-title">{onThisPage}</h2>
          <ol>
            {sections.map((x) => (
              <li>
                <a href={`#${x.id}`} set:html={x.html} />
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>
</div>

<style>
  .legal__band {
    padding-top: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 5.5rem));
    padding-bottom: clamp(2.25rem, 1.5rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(60% 120% at 85% 0%, rgba(200, 205, 212, 0.28), transparent 70%),
      linear-gradient(180deg, #f6f5f2 0%, #fbfbfa 100%);
  }

  .legal__band-inner {
    position: relative;
  }

  /* A short silver rule above the title, the one decorative note on these pages */
  .legal__band-inner::before {
    content: '';
    display: block;
    width: 48px;
    height: 2px;
    margin-bottom: 1.5rem;
    border-radius: 2px;
    background: linear-gradient(90deg, #a3a9b2, #e2e5e9);
  }

  h1 {
    font-size: var(--fs-h2);
  }

  .legal__meta {
    margin-top: 0.9rem;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  .legal {
    display: grid;
    grid-template-columns: minmax(0, 46rem);
    gap: 2.5rem clamp(3rem, 1rem + 5vw, 7rem);
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-bottom: var(--section-y);
  }

  .legal--toc {
    grid-template-columns: minmax(0, 46rem) minmax(0, 16rem);
  }

  .legal__main {
    min-width: 0;
  }

  .legal__missing {
    margin-top: 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid #e3c98f;
    border-radius: var(--radius-sm);
    background: #fbf5e7;
    color: #5c430e;
    font-size: 0.9375rem;
  }

  .legal__missing h2 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .legal__missing p {
    margin-top: 0.4rem;
  }

  .legal__missing ul {
    margin: 0.6rem 0 0;
    padding-inline-start: 1.2rem;
  }

  /* On wide screens the contents list sits beside the text and stays in view; the current section is marked */
  .legal__toc {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    align-self: start;
    padding-inline-start: 1.25rem;
    border-inline-start: 1px solid var(--line);
    font-size: 0.875rem;
  }

  .legal__toc h2 {
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .legal__toc ol {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .legal__toc li {
    padding-block: 0.3rem;
  }

  .legal__toc a {
    position: relative;
    display: block;
    color: var(--steel);
    line-height: 1.4;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .legal__toc a::before {
    content: '';
    position: absolute;
    inset-block: 0.1em;
    inset-inline-start: calc(-1.25rem - 1px);
    width: 2px;
    border-radius: 2px;
    background: var(--ink);
    opacity: 0;
    transition: opacity 0.2s var(--ease);
  }

  .legal__toc a:hover,
  .legal__toc a.is-current {
    color: var(--ink);
  }

  .legal__toc a.is-current::before {
    opacity: 1;
  }

  @media (max-width: 1099px) {
    .legal,
    .legal--toc {
      grid-template-columns: minmax(0, 46rem);
    }

    .legal__toc {
      position: static;
      order: -1;
      padding: 1.25rem 0;
      border-inline-start: 0;
      border-block: 1px solid var(--line);
    }

    .legal__toc ol {
      columns: 2 15rem;
      column-gap: 2.5rem;
    }

    .legal__toc li {
      break-inside: avoid;
    }

    .legal__toc a::before {
      display: none;
    }
  }

  .legal__body :global(h2[id]) {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .legal__body {
    margin-top: 2rem;
    color: var(--graphite);
    line-height: 1.7;
  }

  .legal__body :global(h2) {
    margin-top: 2.75rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.375rem;
    font-weight: 450;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .legal__body :global(h3) {
    margin-top: 1.75rem;
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .legal__body :global(p),
  .legal__body :global(ul),
  .legal__body :global(address) {
    margin-top: 0.85rem;
  }

  .legal__body :global(address) {
    font-style: normal;
  }

  .legal__body :global(ul) {
    padding-inline-start: 1.2rem;
  }

  .legal__body :global(li + li) {
    margin-top: 0.35rem;
  }

  .legal__body :global(a) {
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .legal__body :global(.missing) {
    padding: 0.05em 0.35em;
    border-radius: 4px;
    background: #fbf0d6;
    color: #6b4d0f;
    font-size: 0.9375em;
  }
</style>

<script>
  // Marks the section being read in the contents list
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = new Map([...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [a.hash.slice(1), a]));
    const seen = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id)));
        const first = [...links.keys()].find((id) => seen.has(id));
        if (first) links.forEach((a, id) => a.classList.toggle('is-current', id === first));
      },
      { rootMargin: '-15% 0px -70% 0px' },
    );
    links.forEach((_, id) => {
      const h = document.getElementById(id);
      if (h) io.observe(h);
    });
  }
</script>
