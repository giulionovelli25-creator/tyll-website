---
// The solutions overview: what is on sale as large photo tiles, what is coming below them, smaller and quieter. Reached from "All solutions" in the menu and from every
// "Explore Solutions" button; the Solutions dropdown in the header stays the quick way to one solution.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageIntro from '../PageIntro.astro';
import SolutionIcon from '../SolutionIcon.astro';
import { solutions } from '../../content/solutions';
import { t, href, type Locale, type SolutionKey } from '../../i18n';
import { available, comingSoon } from '../../config/products';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<Base lang={lang} page="solutions" title={d.meta.solutionsTitle} description={d.meta.solutionsDescription}>
  <PageIntro title={d.solutionPage.indexTitle} intro={d.solutionPage.indexIntro} />
  <section class="wrap tiles-wrap" aria-label={d.nav.solutions}>
    {
      ([[available, false], [comingSoon, true]] as [readonly SolutionKey[], boolean][]).map(([keys, soon]) => (
        <Fragment>
          <h2 class="tiles__label">{soon ? d.cta.comingSoon : d.home.now.label}</h2>
          <ul class:list={['tiles', soon && 'tiles--soon']}>
            {keys.map((k) => {
              const s = solutions[k];
              return (
                <li>
                  <a class="tile on-dark" href={href(k, lang)}>
                    <Picture
                      src={s.photo}
                      alt=""
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      widths={[480, 720, 1080]}
                      sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1100px) 45vw, 380px"
                      loading="lazy"
                      decoding="async"
                      style={`object-position:${s.photoFocus}`}
                    />
                    <span class="tile__shade" aria-hidden="true" />
                    {soon && <span class="badge-soon tile__soon">{d.cta.comingSoon}</span>}
                    <span class="tile__body">
                      <SolutionIcon name={s.icon} />
                      <span class="tile__name">{s.name[lang]}</span>
                      <span class="tile__desc">{s.menu[lang]}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </Fragment>
      ))
    }
    <p class="tiles__faq"><a href={href('faq', lang)}>{d.nav.faq}</a></p>
  </section>
</Base>

<style>
  /* Products in development carry the badge in the photo's top corner */
  .tile__soon {
    position: absolute;
    top: 1rem;
    inset-inline-start: 1rem;
    z-index: 2;
  }

  .tiles-wrap {
    padding-bottom: var(--section-y);
  }

  .tiles__label {
    font-family: var(--font);
    margin: var(--s-5) 0 var(--s-2);
    color: var(--text-2);
    font-size: var(--fs-small);
    font-weight: 400;
    letter-spacing: 0;
  }

  .tiles__label:first-child {
    margin-top: 0;
  }

  .tiles--soon .tile {
    aspect-ratio: 16 / 11;
  }

  .tiles--soon .tile :global(img) {
    filter: saturate(0.5) brightness(0.86);
  }

  .tiles--soon .tile__name {
    font-size: 1.25rem;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--on-dark);
    text-decoration: none;
    isolation: isolate;
  }

  .tile :global(picture),
  .tile :global(img),
  .tile__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tile :global(picture),
  .tile :global(img) {
    z-index: -2;
  }

  .tile :global(img) {
    object-fit: cover;
    filter: var(--photo-grade);
    transition: transform 0.8s var(--ease);
  }

  .tile:hover :global(img) {
    transform: scale(1.04);
  }

  .tile__shade {
    z-index: -1;
    background: linear-gradient(0deg, rgb(var(--shade-rgb) / 0.88) 0%, rgb(var(--shade-rgb) / 0.35) 55%, rgb(var(--shade-rgb) / 0.15) 100%);
  }

  .tile__body {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.4rem;
    padding: 1.5rem;
  }

  .tile__body :global(svg) {
    width: 24px;
    height: 24px;
    margin-bottom: 0.4rem;
    opacity: 0.8;
  }

  .tile__name {
    font-size: 1.5rem;
    letter-spacing: 0;
  }

  .tile__desc {
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .tiles__faq {
    margin-top: 2rem;
  }

  .tiles__faq a {
    font-weight: 400;
    text-underline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }

    .tile {
      aspect-ratio: 16 / 11;
    }
  }
</style>
