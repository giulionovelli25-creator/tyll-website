---
// Directly under the hero: everything Tyll does, grouped into three parts that fit one laptop screen. Each links to the
// solution page that leads that part.
import { Picture } from 'astro:assets';
import { solutions } from '../../content/solutions';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.now;
const parts = (['stock', 'forecasting', 'revenue'] as const).map((key, i) => ({ key, ...v.cards[i] }));
---

<section class="now" aria-labelledby="now-title">
  <div class="wrap">
    <header class="now__head">
      <h2 id="now-title" class="display">{v.title}</h2>
    </header>
    <ul class="now__cards">
      {
        parts.map(({ key, title, text }) => (
          <li>
            <a class="card" href={href(key, lang)}>
              <span class="card__photo">
                <Picture
                  src={solutions[key].photo}
                  alt=""
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[480, 720, 960]}
                  sizes="(max-width: 860px) calc(100vw - 32px), 400px"
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${solutions[key].photoFocus}`}
                />
              </span>
              <span class="card__body">
                <h3 class="card__title">{title}</h3>
                <p class="card__text">{text}</p>
                <span class="card__more">
                  {v.more}
                  <span class="card__arrow flip-rtl" aria-hidden="true">→</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .now {
    padding-block: clamp(2rem, 6svh, 4.5rem);
    background: var(--page);
    color: var(--text-1);
  }

  .now__label {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--text-2);
    font-size: var(--fs-small);
  }

  .now__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-1);
    box-shadow: 0 0 0 4px var(--hair);
  }

  .now h2 {
    margin-top: var(--s-2);
    font-size: var(--fs-h2);
  }

  .now__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
    margin: clamp(1.25rem, 3.5svh, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  /* A layered surface on a raised panel */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--hair);
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--text-1);
    text-decoration: none;
    box-shadow: var(--edge), var(--shadow-2);
    transition:
      transform 0.45s var(--ease),
      border-color 0.3s var(--ease),
      box-shadow 0.45s var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--hair-strong);
    box-shadow: var(--edge), var(--shadow-3);
  }

  .card__photo {
    display: block;
    overflow: hidden;
    height: clamp(7.5rem, 26svh, 15rem);
    background: var(--mist);
  }

  .card__photo :global(picture),
  .card__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card__photo :global(img) {
    object-fit: cover;
    filter: var(--photo-grade);
    transition: transform 0.8s var(--ease);
  }

  .card:hover .card__photo :global(img) {
    transform: scale(1.04);
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--s-3);
  }

  .card__title {
    font-size: var(--fs-h3);
    font-weight: 400;
    letter-spacing: 0;
  }

  .card__text {
    margin-top: var(--s-1);
    color: var(--text-2);
    line-height: 1.55;
  }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--s-3);
    color: var(--text-1);
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .card__arrow {
    display: inline-block;
    transition: transform 0.35s var(--ease);
  }

  .card:hover .card__arrow {
    transform: translateX(4px);
  }

  :global([dir='rtl']) .card:hover .card__arrow {
    transform: scaleX(-1) translateX(4px);
  }

  @media (max-width: 860px) {
    .now__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .card__photo {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__arrow,
    .card__photo :global(img) {
      transition: none;
    }
  }
</style>
