# Copy to .env and fill in. Anything left empty is hidden or disabled on the site, never shown as a broken link.

# Public address of this site (canonical URLs, sitemap, social previews).
PUBLIC_SITE_URL=https://tyll.ai

# Public interactive demo. Defaults to https://demo.tyll.ai when left empty; set http://localhost:3210 in your
# own .env to use the local demo while developing (localhost is ignored in production builds).
PUBLIC_DEMO_URL=

# Calendly event to embed on the Book a Call page. Defaults to the owner-approved event when left empty.
PUBLIC_CALENDLY_URL=

# Official social accounts only.
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/tyll.ai/
PUBLIC_INSTAGRAM_URL=
PUBLIC_TIKTOK_URL=

# WhatsApp number for the FAQ page's "WhatsApp us" button, international format, for example +41 79 000 00 00.
# Left empty, the button links to the placeholder https://wa.me/[WHATSAPP NUMBER], so set it before going live.
PUBLIC_WHATSAPP_NUMBER=

# Analytics, loaded only after the visitor accepts analytics cookies.
# Provider: plausible | ga4 (leave empty for none). ID: Plausible domain or GA4 measurement ID.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_ID=

# Meta Pixel ID, loaded only after the visitor accepts marketing cookies.
PUBLIC_META_PIXEL_ID=

# Search indexing: only a production deployment is indexable. On Railway, set DEPLOY_ENV=production on the live
# service only (it is read at build time). Previews, staging and local builds stay noindex.
# DEPLOY_ENV=

# Form service that receives the free report requests, for example https://formspree.io/f/xxxxxxx. Requests then arrive
# by email without the visitor doing anything. Left empty, the owner's Formspree form is used.
PUBLIC_REPORT_ENDPOINT=
