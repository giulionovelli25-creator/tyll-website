---
import Logo from './Logo.astro';
import { site } from '../config/site';
import { demoHref } from '../config/demo';
import { solutions } from '../content/solutions';
import { t, href, pages, locales, solutionKeys, type Locale, type PageKey } from '../i18n';

interface Props {
  lang: Locale;
  page: PageKey;
}

const { lang, page } = Astro.props;
const d = t(lang);
const home = href('home', lang);
const year = new Date().getFullYear();
// "Book a Demo →": the arrow is set apart so it can move on hover
const [, bookText = d.cta.book, bookArrow = ''] = d.cta.book.match(/^(.*?)\s*([→←])$/) ?? [];
// The social accounts that are set, in this order, each with its monochrome mark (Simple Icons, CC0)
const icons = {
  instagram: 'M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077',
  tiktok: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z',
  linkedin: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
};
const socials = [
  { key: 'linkedin', name: 'LinkedIn', url: site.social.linkedin, icon: icons.linkedin },
  { key: 'instagram', name: 'Instagram', url: site.social.instagram, icon: icons.instagram },
  { key: 'tiktok', name: 'TikTok', url: site.social.tiktok, icon: icons.tiktok },
].filter((x) => x.url);
---

<footer class="footer">
  <div class="wrap footer__top">
    <div class="footer__brand">
      <a href={home} class="footer__logo" aria-label="Tyll home">
        <Logo label="Tyll" />
      </a>
      {
        socials.length > 0 && (
          <div class="footer__follow">
            <p>{d.footer.follow}</p>
            <ul>
              {socials.map((x) => (
                <li>
                  <a href={x.url} target="_blank" rel="noopener" data-track={`${x.key}_click`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                      <path fill="currentColor" d={x.icon} />
                    </svg>
                    <span class="visually-hidden">
                      {x.name} {d.cta.newTab}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <nav class="footer__cols" aria-label="Footer">
      <div>
        <h2>{d.footer.solutions}</h2>
        <ul>
          {solutionKeys.map((k) => <li><a href={href(k, lang)}>{solutions[k].name[lang]}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>{d.footer.contact}</h2>
        <ul>
          <li>
            <a class="footer__book" href={href('book', lang)} data-track="book_demo_click" data-track-from="footer">
              <span class="footer__book-text">{bookText}</span>{bookArrow && <span class="footer__arrow" aria-hidden="true">{bookArrow}</span>}
            </a>
          </li>
          {
            site.demoUrl && (
              <li>
                <a href={demoHref(lang)} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from="footer">
                  {d.cta.demo.replace(/\s+([→←])$/, '\u00a0$1')}<span class="visually-hidden"> {d.cta.newTab}</span>
                </a>
              </li>
            )
          }
          <li><a href={href('faq', lang)}>{d.nav.faqShort}</a></li>
          <li><a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a></li>
        </ul>
      </div>
      <div>
        <h2>{d.footer.company}</h2>
        <ul>
          <li><a href={href('legal', lang)}>{d.footer.legal}</a></li>
          <li><a href={href('privacy', lang)}>{d.footer.privacy}</a></li>
          <li><button type="button" class="footer__linkbtn" data-consent-open>{d.footer.cookies}</button></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="wrap footer__base">
    <p>© {year} {d.footer.rights}. {d.footer.demoNote}</p>
    <div class="footer__lang" role="group" aria-label={d.nav.language}>
      {
        locales.map((l) => (
          <a href={pages[page][l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} data-track="language_changed" data-track-to={l}>
            {t(l).langName}
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hair);
    border-top: 1px solid var(--line);
    background: var(--page);
    color: var(--ink);
    /* While the cookie banner is showing, the footer gets room so nothing sits under the banner */
    padding-block: var(--band-y) calc(var(--s-4) + var(--consent-space, 0px));
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--s-5);
    padding-bottom: var(--intro-gap);
  }

  .footer__logo {
    display: inline-block;
    border-radius: 6px;
  }

  .footer__logo :global(.logo) {
    height: 34px;
    width: auto;
  }

  .footer__brand p {
    margin-top: 1.25rem;
    max-width: 28ch;
    color: var(--graphite);
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .footer__phrase {
    white-space: nowrap;
  }

  .footer__brand {
    display: grid;
    align-content: start;
    justify-items: start;
  }

  /* Follow Tyll: the three accounts as icons (monochrome marks from Simple Icons, CC0), 10 Nov 2026 */
  .footer__follow {
    margin-top: 1.5rem;
  }

  .footer__follow p {
    margin: 0 0 0.6rem;
    color: var(--steel);
    font-family: var(--font);
    font-size: var(--fs-small);
  }

  .footer .footer__follow ul {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__follow a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .footer__follow a:hover {
    border-color: var(--ink);
    background: var(--mist);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer h2 {
    font-family: var(--font);
    margin-bottom: 1rem;
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 400;
    letter-spacing: 0;
  }

  .footer ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    color: var(--ink);
    font-size: 0.9375rem;
    text-decoration: none;
    opacity: 0.86;
  }

  .footer__linkbtn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    text-align: start;
    opacity: 0.86;
    cursor: pointer;
  }

  .footer__linkbtn:hover,
  .footer a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* The one call to action in the footer: full ink, a little heavier, its arrow moving on hover */
  .footer a.footer__book {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-weight: 400;
    opacity: 1;
  }

  /* Only the words are underlined on hover, so the arrow moves cleanly */
  .footer a.footer__book:hover {
    text-decoration: none;
  }

  .footer__book:hover .footer__book-text {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer__arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }

  .footer__book:hover .footer__arrow,
  .footer__book:focus-visible .footer__arrow {
    transform: translateX(4px);
  }

  :global([dir='rtl']) .footer__book:hover .footer__arrow,
  :global([dir='rtl']) .footer__book:focus-visible .footer__arrow {
    transform: translateX(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__arrow {
      transition: none;
    }
  }

  .footer__base {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  /* The rule above the last row is as wide as the page's column, not the column plus its gutters */
  .footer__base::before {
    position: absolute;
    top: 0;
    inset-inline: var(--gut);
    border-top: 1px solid var(--hair);
    content: '';
  }

  .footer__lang {
    display: flex;
    gap: 1.25rem;
  }

  .footer__lang a {
    font-size: var(--fs-small);
  }

  .footer__lang a[hreflang='ar'] {
    font-family: 'Tyll Arabic Label', 'Tyll Arabic', var(--font);
    letter-spacing: 0;
  }

  .footer__lang a:not([aria-current]) {
    opacity: 0.6;
  }

  @media (max-width: 820px) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Taller tap targets on phones and tablets, in about the same height: the space moves into the links */
    .footer ul {
      gap: 0;
    }

    .footer li > a,
    .footer a.footer__book,
    .footer__linkbtn,
    .footer__lang a {
      display: inline-flex;
      align-items: center;
      min-height: 2.25rem;
    }
  }

  /* Phones: two columns. The long Solutions list takes the first; Contact and Company share the second, so no group
     is left alone on a row beside an empty half. */
  @media (max-width: 520px) {
    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .footer__cols > :first-child {
      grid-row: span 2;
    }
  }
</style>
