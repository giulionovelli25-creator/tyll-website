---
// Homepage section 2: information scattered across hotel systems comes together in one place when the
// visitor asks to see it. An illustration of the idea, with fictional items from the demo hotel.
import Logo from '../Logo.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = t(lang).home.problem;

// Scattered positions (offset from the stage's centre, in % of the stage) and a slight tilt.
// Wide stages use the first set, narrow (phone) stages the second.
const scatter = [
  { x: -31, y: 6, r: -4, mx: -12, my: 2, mr: -3 },
  { x: 30, y: 2, r: 3, mx: 14, my: 17, mr: 3 },
  { x: -35, y: 50, r: 2, mx: -10, my: 34, mr: 2 },
  { x: 32, y: 44, r: -3, mx: 12, my: 51, mr: -3 },
  { x: -5, y: 74, r: -2, mx: -9, my: 68, mr: -2 },
  { x: 4, y: 24, r: 4, mx: 10, my: 84, mr: 3 },
];
---

<section class="connect" aria-labelledby="connect-title">
  <div class="wrap">
    <header class="connect__head">
      <h2 id="connect-title">{p.title}</h2>
      <p>{p.text}</p>
    </header>

    <div class="stage" data-connect data-state="scattered">
      <div class="ws" aria-hidden="true">
        <div class="ws__bar">
          <Logo mark label="" class="ws__mark" />
          <span>{p.workspace}</span>
        </div>
      </div>

      <ul class="frags" aria-label={p.before} data-check-manual>
        {
          p.systems.map((s, i) => (
            <li
              class="frag"
              style={`--i:${i};--sx:${scatter[i].x};--sy:${scatter[i].y};--sr:${scatter[i].r}deg;--mx:${scatter[i].mx};--my:${scatter[i].my};--mr:${scatter[i].mr}deg`}
            >
              <Logo mark anim="draw" label="" class="frag__tick" />
              <span class="frag__sys">{s.name}</span>
              <span class="frag__line">{s.line}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="connect__foot">
      <p class="connect__caption" aria-live="polite">
        <span class="cap-before">{p.before}</span>
        <span class="cap-after">{p.after}</span>
      </p>
      <button type="button" class="btn btn--solid" data-connect-toggle data-show={p.show} data-replay={p.replay}>
        {p.show}
      </button>
    </div>
    <p class="connect__note">{p.note}</p>
  </div>
</section>

<style>
  .connect {
    padding-block: var(--section-y);
    background: var(--paper);
  }

  .connect__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
  }

  .connect__head h2 {
    max-width: 14ch;
    font-size: var(--fs-h2);
  }

  .connect__head p {
    max-width: 32rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  /* The stage is a size container, so positions can be expressed in stage units (cqw / cqh) */
  .stage {
    position: relative;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    aspect-ratio: 1200 / 600;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(255, 255, 255, 0.9), transparent 70%),
      url('/media/tyll-waves.webp') center / cover,
      var(--mist);
    container-type: size;
    overflow: hidden;
    isolation: isolate;
  }

  .frags {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .frag {
    --w: min(340px, 36cqw);
    --x: calc(var(--sx) * 1cqw);
    --y: calc(var(--sy) * 1cqh + 4cqh);
    --r: var(--sr);
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--w);
    display: grid;
    grid-template-columns: 0 auto;
    column-gap: 0;
    align-items: baseline;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    box-shadow: 0 18px 40px -24px rgba(20, 22, 26, 0.35);
    transform: translate(calc(-50% + var(--x)), var(--y)) rotate(var(--r));
    transition:
      transform 0.9s var(--ease) calc(var(--i) * 70ms),
      box-shadow 0.6s var(--ease),
      border-color 0.6s var(--ease),
      grid-template-columns 0.5s var(--ease),
      column-gap 0.5s var(--ease);
    animation: drift 7s ease-in-out calc(var(--i) * -1.1s) infinite alternate;
  }

  @keyframes drift {
    to {
      translate: 0 6px;
    }
  }

  .frag__sys {
    grid-column: 2;
    color: var(--steel);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .frag__line {
    grid-column: 2;
    margin-top: 0.15rem;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .frag :global(.frag__tick) {
    grid-row: 1 / span 2;
    align-self: center;
    width: 18px;
    height: auto;
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  /* The connected workspace that the fragments settle into */
  .ws {
    position: absolute;
    left: 50%;
    top: 6cqh;
    width: calc(min(340px, 36cqw) + 48px);
    height: 88cqh;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 40px 80px -40px rgba(20, 22, 26, 0.45);
    opacity: 0;
    transform: translateX(-50%) scale(0.96);
    transition:
      opacity 0.6s var(--ease),
      transform 0.8s var(--ease);
  }

  .ws__bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .ws :global(.ws__mark) {
    width: 18px;
    height: auto;
  }

  /* Connected: rows in one list */
  [data-state='connected'] .frag {
    --x: 0px;
    --y: calc(6cqh + 58px + var(--i) * min(13.2cqh, 76px));
    --r: 0deg;
    grid-template-columns: 18px auto;
    column-gap: 0.85rem;
    border-color: transparent;
    box-shadow: none;
    background: transparent;
    animation: none;
  }

  [data-state='connected'] .frag :global(.frag__tick) {
    opacity: 1;
  }

  [data-state='connected'] .ws {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  .connect__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1.75rem;
  }

  .connect__caption {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    letter-spacing: -0.02em;
  }

  .cap-after,
  [data-connected] .cap-before {
    display: none;
  }

  [data-connected] .cap-after {
    display: inline;
  }

  .connect__note {
    margin-top: 1rem;
    color: var(--steel);
    font-size: 0.8125rem;
  }

  /* Phones: a taller stage and a narrower scatter */
  @container (max-width: 620px) {
    .frag {
      --w: 78cqw;
      --x: calc(var(--mx) * 1cqw);
      --y: calc(var(--my) * 1cqh);
      --r: var(--mr);
      padding: 0.7rem 0.85rem;
    }

    .ws {
      width: calc(78cqw + 24px);
      top: 3cqh;
      height: 94cqh;
    }

    [data-state='connected'] .frag {
      --y: calc(3cqh + 52px + var(--i) * 13.6cqh);
    }
  }

  @media (max-width: 860px) {
    .connect__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 620px) {
    .stage {
      aspect-ratio: 390 / 640;
    }

    .connect__foot .btn {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frag,
    .ws {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { drawCheck, hideCheck } from '../../scripts/checkmark';

  document.querySelectorAll<HTMLElement>('[data-connect]').forEach((stage) => {
    const section = stage.closest('section')!;
    const button = section.querySelector<HTMLButtonElement>('[data-connect-toggle]')!;
    const ticks = [...stage.querySelectorAll<SVGSVGElement>('.frag__tick')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    ticks.forEach(hideCheck);

    const connect = () => {
      stage.dataset.state = 'connected';
      section.toggleAttribute('data-connected', true);
      button.textContent = button.dataset.replay!;
      // Once the fragments have landed, each row is ticked off in turn
      ticks.forEach((svg, i) => setTimeout(() => drawCheck(svg, 650), reduce ? 0 : 900 + i * 160));
      document.dispatchEvent(new CustomEvent('tyll:track', { detail: { event: 'connect_story_played' } }));
    };
    const scatter = () => {
      stage.dataset.state = 'scattered';
      section.toggleAttribute('data-connected', false);
      button.textContent = button.dataset.show!;
      ticks.forEach(hideCheck);
    };

    button.addEventListener('click', () => {
      if (stage.dataset.state === 'connected') {
        // Replay: fall apart, then come together again
        scatter();
        setTimeout(connect, reduce ? 0 : 1100);
      } else connect();
    });
  });
</script>
