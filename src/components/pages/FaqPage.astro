---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import lounge from '../../assets/photos/faq-lounge.jpg';
import PageIntro from '../PageIntro.astro';
import SilverWave from '../SilverWave.astro';
import { site } from '../../config/site';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const f = d.faq;

// A fact the owner has not supplied yet stands in the copy in [SQUARE BRACKETS] and is shown exactly as written.
const PLACEHOLDER = /(\[[^\]]+\])/;
const pieces = (a: string) =>
  a
    .split(PLACEHOLDER)
    .filter(Boolean)
    .map((text) => ({ text, placeholder: PLACEHOLDER.test(text) }));

// Every answer ends with one link: Book a demo, or See how it works.
const links = {
  book: { href: href('book', lang), label: d.cta.book, track: 'book_demo_click' },
  how: { href: href('how', lang), label: d.teaser.link, track: undefined },
};

// Until the owner gives a number (PUBLIC_WHATSAPP_NUMBER), the link keeps its placeholder.
const whatsapp = `https://wa.me/${site.whatsapp ? site.whatsapp.replace(/\D/g, '') : '[WHATSAPP NUMBER]'}`;

// FAQPage structured data, built from the questions and answers shown on the page, in this page's language.
// An answer that still has a placeholder is left out until it is filled in.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: f.groups
    .flatMap((g) => g.items)
    .filter((i) => !PLACEHOLDER.test(i.a))
    .map((i) => ({
      '@type': 'Question',
      name: i.q,
      acceptedAnswer: { '@type': 'Answer', text: i.a },
    })),
};
---

<Base lang={lang} page="faq" title={d.meta.faqTitle} description={d.meta.faqDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <!-- Without JavaScript the questions cannot be opened, so every answer is shown. -->
  <noscript slot="head">
    <style is:inline>
      .faq__panel {
        grid-template-rows: 1fr !important;
        visibility: visible !important;
      }
      .faq__q {
        cursor: default !important;
      }
      .faq__q::after {
        display: none !important;
      }
    </style>
  </noscript>

  <div class="faq-top">
    <SilverWave phase={0.7} />
    <PageIntro title={f.title} intro={f.intro} />
  </div>

  <section class="wrap faq" aria-label={f.title}>
    <div class="faq__list">
      {
        f.groups.map((g, gi) => (
          <section class="faq__group" aria-labelledby={`faq-${g.id}`}>
            <h2 id={`faq-${g.id}`} class="faq__group-title">
              {g.title}
            </h2>
            <div class="faq__items">
              {g.items.map((i, ii) => {
                const open = gi === 0 && ii === 0;
                const link = links[i.link];
                return (
                  <div id={i.id} class:list={['faq__item', open && 'is-open']}>
                    <h3 class="faq__h">
                      <button type="button" class="faq__q" id={`q-${i.id}`} aria-expanded={open ? 'true' : 'false'} aria-controls={`a-${i.id}`}>
                        <span>{i.q}</span>
                      </button>
                    </h3>
                    <div class="faq__panel" id={`a-${i.id}`}>
                      <div class="faq__panel-inner">
                        <p class="faq__answer">
                          {pieces(i.a).map((p) => (p.placeholder ? <bdi dir="ltr">{p.text}</bdi> : p.text))}{' '}
                          <a class="faq__link" href={link.href} data-track={link.track} data-track-from={link.track && 'faq-answer'}>
                            {link.label}
                          </a>
                        </p>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>

    <aside class="faq__side" aria-labelledby="faq-more">
      <Picture
        src={lounge}
        alt=""
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 760]}
        sizes="(max-width: 860px) calc(100vw - 32px), 380px"
        loading="lazy"
        decoding="async"
        class="faq__photo"
      />
      <div class="faq__more">
        <h2 id="faq-more">{f.more}</h2>
        <p>{f.moreText}</p>
        <div class="faq__actions">
          <a class="btn btn--solid" href={href('book', lang)} data-track="book_demo_click" data-track-from="faq">{d.cta.book}</a>
          <a class="btn btn--line" href={whatsapp} target="_blank" rel="noopener" data-track="whatsapp_click">
            <svg class="faq__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
              <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
            </svg>
            {f.whatsapp}
            <span class="visually-hidden"> {d.cta.newTab}</span>
          </a>
          <a class="btn btn--line" href={`mailto:${site.email}`} data-track="email_click">{site.email}</a>
        </div>
      </div>
    </aside>
  </section>

  <section class="faq-final" aria-labelledby="faq-final-title">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap faq-final__inner">
      <h2 id="faq-final-title">{f.final}</h2>
      <a class="btn btn--lg faq-final__book" href={href('book', lang)} data-track="book_demo_click" data-track-from="faq-final">{d.cta.book}</a>
    </div>
  </section>
</Base>

<style>
  /* The title sits on the same still silver wave as the Solutions and How it works pages */
  .faq-top {
    position: relative;
    overflow: hidden;
  }

  .faq-top > :global(*:not(.wave)) {
    position: relative;
    z-index: 1;
  }

  .faq {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 3rem 5rem;
    align-items: start;
    padding-bottom: var(--section-y);
  }

  .faq__list {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.75rem);
  }

  /* Group headings: small caps in the grey of the site's other labels */
  .faq__group-title {
    margin-bottom: 0.85rem;
    color: var(--steel);
    font-family: var(--font);
    font-size: 1.1875rem;
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  /* Arabic has no capitals: small caps would only shrink the letters (Chrome draws them at about 70%), so the
     heading is plain text there. */
  :global(html[lang='ar']) .faq__group-title {
    font-variant-caps: normal;
    font-size: 1rem;
    line-height: 1.4;
  }

  .faq__items {
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .faq__h {
    font-size: 1.1875rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    padding: 1.4rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
    cursor: pointer;
  }

  .faq__q::after {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    margin-inline-end: 3px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-3px) rotate(45deg);
    transition: transform 0.35s var(--ease);
  }

  .faq__item.is-open .faq__q::after {
    transform: translateY(3px) rotate(-135deg);
  }

  /* The answer opens by growing its grid row from nothing to its own height; while closed it is hidden from
     the keyboard and from screen readers too. */
  .faq__panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.35s var(--ease),
      visibility 0s linear 0.35s;
  }

  .faq__item.is-open .faq__panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 0.35s var(--ease),
      visibility 0s;
  }

  .faq__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .faq__answer {
    max-width: 40rem;
    padding-bottom: 1.5rem;
    color: var(--graphite);
    line-height: 1.65;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .faq__item.is-open .faq__answer {
    opacity: 1;
  }

  .faq__link {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    white-space: nowrap;
  }

  .faq__link:hover {
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__panel,
    .faq__item.is-open .faq__panel,
    .faq__answer,
    .faq__q::after {
      transition: none;
    }
  }

  /* Contact card: stays in view beside the questions on desktop, follows them on phones */
  .faq__side {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--cloud);
    overflow: hidden;
  }

  .faq__side :global(.faq__photo) {
    filter: var(--photo-grade);
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    object-fit: cover;
    object-position: 55% 55%;
  }

  .faq__more {
    padding: 1.75rem 2rem 2rem;
  }

  .faq__more h2 {
    font-size: var(--fs-h3);
    font-weight: 400;
  }

  .faq__more p {
    margin-top: 0.75rem;
    color: var(--steel);
  }

  .faq__actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .faq__icon {
    flex: none;
  }

  /* On a short desktop window the photo gives way so the whole card still fits under the header */
  @media (min-width: 861px) and (max-height: 760px) {
    .faq__side :global(.faq__photo) {
      aspect-ratio: 16 / 6;
    }
  }

  @media (min-width: 861px) and (max-height: 620px) {
    .faq__side {
      position: static;
    }
  }

  /* Closing band: the dark band with the moving wave, as on How it works and the solution pages */
  .faq-final {
    position: relative;
    overflow: hidden;
    padding-block: var(--band-y);
    background: var(--night-1);
    color: var(--on-dark);
  }

  .faq-final__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: center;
    justify-content: space-between;
  }

  .faq-final h2 {
    max-width: 22ch;
    margin: 0;
    color: var(--on-dark);
    font-size: var(--fs-h2);
  }

  .faq-final__book,
  .faq-final__book:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .faq-final__book:hover {
    background: var(--mist);
  }

  /* The dark band meets the footer directly, with no rule between them */
  :global(main:has(.faq) + .footer) {
    border-top: 0;
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }

    .faq__side {
      position: static;
    }
  }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('.faq__item')];
  const counted = new Set<string>();

  // Opening a question is counted (once per question per page view), if statistics are allowed.
  const setOpen = (item: HTMLElement, open: boolean) => {
    item.classList.toggle('is-open', open);
    item.querySelector('.faq__q')?.setAttribute('aria-expanded', String(open));
    if (!open || counted.has(item.id)) return;
    counted.add(item.id);
    document.dispatchEvent(new CustomEvent('tyll:track', { detail: { event: 'faq_opened', question: item.id } }));
  };

  items.forEach((item) => {
    item.querySelector('.faq__q')?.addEventListener('click', () => setOpen(item, !item.classList.contains('is-open')));
  });

  // A link to /faq/#question opens that answer.
  const fromHash = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLElement && el.classList.contains('faq__item')) setOpen(el, true);
  };
  fromHash();
  addEventListener('hashchange', fromHash);
</script>
