---
// Homepage section 4: the closing invitation, as calm and dark as the opening.
import Logo from '../Logo.astro';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.invite;

// The silver wave: one ribbon of fine lines that moves as a single formation, like a slow ocean swell or silver
// fabric. Every line follows the same shape and the same travelling motion; the lines are only offset from each
// other, like threads in one ribbon. The shape dips beneath the buttons and rises in a long arc to the right (a
// quiet echo of the Tyll check). The motion repeats every 16 seconds, so the loop never restarts visibly.
// The first frame is drawn here for visitors without JavaScript or with reduced motion; the script animates it.
import { ribbon } from '../../scripts/wave';

const frame = ribbon(0);
---

<section class="invite on-dark" data-dark aria-labelledby="invite-title">
  <div class="invite__light" aria-hidden="true"></div>
  <svg class="invite__waves" viewBox="0 0 1440 800" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="invite-silver" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#c8cdd4" stop-opacity="0" />
        <stop offset="0.22" stop-color="#c8cdd4" stop-opacity="0.35" />
        <stop offset="0.42" stop-color="#eef0f3" stop-opacity="0.85" />
        <stop offset="0.7" stop-color="#a3a9b2" stop-opacity="0.45" />
        <stop offset="1" stop-color="#c8cdd4" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g fill="none" stroke="url(#invite-silver)" stroke-width="1">
      {frame.map((l) => <path d={l.d} opacity={l.opacity} vector-effect="non-scaling-stroke" />)}
    </g>
  </svg>
  <div class="wrap invite__inner">
    <Logo mark anim="draw" label="" class="invite__mark" />
    <h2 id="invite-title">{v.title}</h2>
    <p>{v.text}</p>
    <div class="invite__actions">
      <a class="btn btn--solid btn--lg" href={href('solutions', lang)} data-track="explore_solutions_click" data-track-from="final">
        {d.cta.solutions}
      </a>
      <a class="btn btn--line btn--lg" href={href('book', lang)} data-track="book_call_click" data-track-from="final">{d.cta.book}</a>
    </div>
  </div>
</section>

<style>
  .invite {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: clamp(6rem, 4rem + 8vw, 11rem);
    background: var(--ink);
    color: var(--on-dark);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* A soft pool of light behind the headline */
  .invite__light {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(45% 55% at 50% 42%, rgba(200, 205, 212, 0.13), transparent 70%),
      radial-gradient(80% 60% at 50% 120%, rgba(146, 153, 163, 0.12), transparent 70%);
    pointer-events: none;
  }

  /* The Tyll silver wave, flowing slowly. Its brightest lines pass beneath the buttons; around the paragraph
     the lines fade almost away so the text stays easy to read. */
  .invite__waves {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0.85;
    -webkit-mask-image:
      radial-gradient(34% 9% at 50% 59%, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.18) 55%, #000 100%),
      linear-gradient(0deg, #000 55%, transparent 92%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(34% 9% at 50% 59%, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.18) 55%, #000 100%),
      linear-gradient(0deg, #000 55%, transparent 92%);
    mask-composite: intersect;
    pointer-events: none;
  }

  .invite__inner {
    width: 100%;
    display: grid;
    justify-items: center;
  }

  .invite :global(.invite__mark) {
    width: 44px;
    height: auto;
    margin-bottom: 2rem;
    color: var(--on-dark);
  }

  .invite h2 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem);
    letter-spacing: -0.04em;
  }

  .invite p {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: rgba(244, 245, 247, 0.82);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .invite__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 640px) {
    .invite__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  import { ribbon, PERIOD } from '../../scripts/wave';

  // Redraw the ribbon about 30 times a second, only while it is on screen and only when motion is welcome
  const svg = document.querySelector<SVGSVGElement>('.invite__waves');
  if (svg) {
    const paths = [...svg.querySelectorAll('path')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let raf = 0;
    let last = 0;
    let t = 0;
    const draw = (now: number) => {
      raf = requestAnimationFrame(draw);
      if (now - last < 33) return;
      t = (t + Math.min(now - last, 100) / 1000) % PERIOD;
      last = now;
      ribbon(t / PERIOD).forEach((l, i) => paths[i]?.setAttribute('d', l.d));
    };
    const sync = () => {
      cancelAnimationFrame(raf);
      if (visible && !reduce.matches) {
        last = performance.now();
        raf = requestAnimationFrame(draw);
      }
    };
    new IntersectionObserver(([e]) => ((visible = e.isIntersecting), sync())).observe(svg);
    reduce.addEventListener('change', sync);
  }
</script>
