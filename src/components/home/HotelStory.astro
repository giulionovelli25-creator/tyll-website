---
// "Three places your hotel loses money": one continuous film of a hotel, played by scrolling, full screen under the
// header. Down plays it forward, up plays it backward, and nothing moves without scrolling. The film alternates holds
// (the camera still on a scene: the tired hotel, the chef's stock check, the bartender's glass inventory, the thriving
// hotel) and moves (the camera walking between them). Each hold is a scroll plateau of 1.25 screens on which the frame
// barely advances; only then does its text rise in, over a soft gradient at the bottom, and its callouts appear over
// the objects they name. During a move there is only the film and the four quiet tabs.
//
// The frames are drawn on a canvas by `src/scripts/film.ts`, from `public/hotel-walkthrough/desktop/` (1920 x 1080)
// or `mobile/` (1080 x 1920, for tall screens). `src/content/walkthrough.json` holds the film's frame sets, the four
// holds in film seconds, the portrait crop's track, and the callouts in fractions of the landscape frame.
// `video-brief.md` records how the film was made. Reduced motion: one still per hold, crossfading, no scrubbing.
// Without JavaScript: the first hold's picture and the four texts one after another. The film reads left to right,
// so in Arabic too the text stays bottom left, clear of the entrance.
import Logo from '../Logo.astro';
import SolutionIcon from '../SolutionIcon.astro';
import { solutions } from '../../content/solutions';
import walkthrough from '../../content/walkthrough.json';
import { t, href, type Locale } from '../../i18n';
import type { SolutionKey } from '../../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.tour;
const film = walkthrough;
const last = v.steps.length - 1;
const pagesOf = [href('finance', lang), href('stock', lang), href('forecasting', lang)];
// A callout's words and icon: one of the three parts (part0 to part2) or one of the products
const partIcons = [solutions.finance.icon, solutions.stock.icon, solutions.forecasting.icon];
const words = (key: string) => (key.startsWith('part') ? v.steps[Number(key.slice(4))].label : solutions[key as SolutionKey].name[lang]);
const icon = (key: string) => (key.startsWith('part') ? partIcons[Number(key.slice(4))] : solutions[key as SolutionKey].icon);
const hubbed = film.callouts.filter((c) => c.hub);
const still = (i: number, cut: 'desktop' | 'mobile') => `${film.base}/hold-${i + 1}-${cut}.webp`;
---

<section
  class="hs"
  aria-labelledby="hs-title"
  data-hs
  data-hold="0"
  style={`--focus-desk:${film.desk.focus * 100}%;--focus-phone:${film.phone.focus * 100}%`}
>
  <div class="hs__pin" data-hs-pin>
    <div class="hs__stage" dir="ltr" data-hs-stage>
      <!-- Each hold's picture (the first is also the poster under the film; the others stay hidden, so they never load,
           unless reduced motion shows them), the canvas the film is drawn on, and the video that takes over if the
           frames cannot load -->
      {
        v.steps.map((_, i) => (
          <picture class:list={['hs__still', i === 0 && 'is-on']} data-hs-still={i} hidden={i > 0}>
            <source media="(max-aspect-ratio: 9/10)" srcset={still(i, 'mobile')} type="image/webp" />
            <img src={still(i, 'desktop')} alt="" width={film.desk.size[0]} height={film.desk.size[1]} loading="lazy" decoding="async" />
          </picture>
        ))
      }
      <canvas class="hs__film" aria-hidden="true" data-hs-film></canvas>
      <video class="hs__film" muted playsinline preload="none" hidden aria-hidden="true" data-hs-mp4></video>
      <div class="hs__shade" aria-hidden="true"></div>

      <!-- The callouts, each over the object it names during its hold; for the result, lines up to the Tyll mark -->
      <div class="hs__spots" aria-hidden="true">
        <svg class="hs__links" data-hs-links>
          {hubbed.map((c) => <line data-hs-link={film.callouts.indexOf(c)} />)}
        </svg>
        <span class="hs__hub" data-hs-hub>
          <Logo mark label="" />
        </span>
        {
          film.callouts.map((c) => (
            <div class="hs__spot" data-hs-spot={c.hold} data-x={c.x} data-y={c.y} data-side={c.side} data-side-desk={c.side} data-phone={c.phone ? JSON.stringify(c.phone) : undefined}>
              <span class="hs__dot" />
              <span class="hs__line" />
              <span class="hs__card">
                <SolutionIcon name={icon(c.label)} />
                {words(c.label)}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <ol class="hs__tabs" aria-label={v.title}>
      {
        v.steps.map((step, i) => (
          <li>
            <button class="hs__go" type="button" data-hs-go={i} aria-current={i === 0 ? 'step' : undefined}>
              <span class="hs__n">{i + 1}</span>
              <span class="hs__l">{step.label}</span>
            </button>
          </li>
        ))
      }
    </ol>

    <!-- Plays the film forward by itself, the texts arriving as they would; any scroll takes back control. Shown by
         the script, never under reduced motion. -->
    <button class="hs__play" type="button" data-hs-play data-play={v.play} data-pause={v.pause} aria-pressed="false" hidden>{v.play}</button>

    <div class="hs__copy">
      {
        v.steps.map((step, i) => (
          <div class:list={['hs__hold', i === 0 && 'is-on']} data-hs-hold={i}>
            <p class="visually-hidden">{v.stepOf.replace('{n}', String(i + 1)).replace('{t}', String(v.steps.length))}</p>
            {i === 0 ? (
              <h2 id="hs-title" class="hs__h display">
                {v.title}
              </h2>
            ) : (
              <h3 class="hs__h display">{i === last ? step.headline : step.label}</h3>
            )}
            {i < last && <p class="hs__q display">{step.headline}</p>}
            {step.problem && (
              <p class="hs__problem">
                <span class="visually-hidden">{v.before}: </span>
                {step.problem}
              </p>
            )}
            <p class="hs__with">{v.after}</p>
            <ul class="hs__points">
              {step.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            {i < last ? (
              <a class="hs__more" href={pagesOf[i]}>
                {v.more} <span class="flip-rtl" aria-hidden="true">→</span>
              </a>
            ) : (
              <a class="btn btn--solid btn--lg hs__cta" href={href('book', lang)} data-track="book_demo_click" data-track-from="hotel">
                {d.cta.book}
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hs {
    --focus: var(--focus-desk);
    --hs-fade: 0.3s ease;
    position: relative;
    background: var(--black);
    color: var(--on-dark);
  }

  /* Pinned under the header for the whole film: the run is set by the script from the holds and moves */
  .hs.is-live,
  .hs.is-still {
    height: calc(var(--hs-run, 800svh) + 100svh - var(--header-h));
  }

  .hs.is-live .hs__pin,
  .hs.is-still .hs__pin {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    overflow: hidden;
  }

  /* The picture fills the screen edge to edge: no column, no fade, no mask */
  .hs__stage {
    position: relative;
    height: calc(100svh - var(--header-h));
    overflow: hidden;
    background: var(--black);
  }

  .hs.is-live .hs__stage,
  .hs.is-still .hs__stage {
    position: absolute;
    inset: 0;
    height: auto;
  }

  .hs__still {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .hs__still img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus) 50%;
  }

  .hs__still.is-on {
    opacity: 1;
  }

  /* Live: only the first hold's picture, as the poster under the film; the others never load */
  .hs.is-live .hs__still:not([data-hs-still='0']) {
    display: none;
  }

  .hs.is-live .hs__still[data-hs-still='0'] {
    opacity: 1;
    transition: none;
  }

  .hs__film {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  video.hs__film {
    object-fit: cover;
    object-position: var(--focus) 50%;
  }

  .hs:not(.is-live) .hs__film {
    display: none;
  }

  /* The one overlay on the film: a gradient at the bottom while a hold's text is up */
  .hs__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(var(--black-rgb) / 0.58) 0%, rgb(var(--black-rgb) / 0.4) 16%, rgb(var(--black-rgb) / 0) 52%);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--hs-fade);
  }

  .hs.is-hold .hs__shade {
    opacity: 1;
  }

  /* Tabs: four quiet names top left, the current one full strength */
  .hs__tabs {
    display: none;
  }

  .hs.is-live .hs__tabs,
  .hs.is-still .hs__tabs {
    position: absolute;
    top: clamp(12px, 2.6vh, 28px);
    left: clamp(20px, 4.5vw, 64px);
    right: 20px;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Play: a small grey text link top right of the film */
  .hs__play {
    display: none;
  }

  .hs.is-live .hs__play:not([hidden]) {
    position: absolute;
    top: clamp(12px, 2.6vh, 28px);
    inset-inline-end: clamp(20px, 4.5vw, 64px);
    z-index: 4;
    display: inline-block;
    min-width: 24px;
    min-height: 24px;
    padding: 6px 0 5px;
    border: 0;
    border-bottom: 1px solid rgb(var(--on-dark-rgb) / 0.6);
    background: none;
    color: var(--on-dark);
    font: 500 0.8125rem/1.2 var(--font);
    text-shadow:
      0 1px 2px rgb(var(--black-rgb) / 0.55),
      0 0 14px rgb(var(--black-rgb) / 0.4);
    opacity: 0.6;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .hs__play:hover,
  .hs__play:focus-visible,
  .hs__play[aria-pressed='true'] {
    opacity: 1;
  }

  .hs__play:focus-visible {
    outline: 2px solid var(--on-dark);
    outline-offset: 3px;
  }

  .hs__go {
    display: inline-flex;
    justify-content: center;
    min-width: 24px; /* a comfortable target even when a tab shows only its number */
    gap: 8px;
    align-items: baseline;
    padding: 6px 0 5px;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--on-dark);
    font: 500 0.8125rem/1.2 var(--font);
    letter-spacing: 0.01em;
    text-shadow:
      0 1px 2px rgb(var(--black-rgb) / 0.55),
      0 0 14px rgb(var(--black-rgb) / 0.4);
    opacity: 0.6;
    cursor: pointer;
    transition: opacity var(--hs-fade);
  }

  .hs__go:hover,
  .hs__go[aria-current='step'] {
    opacity: 1;
  }

  .hs__go[aria-current='step'] {
    border-bottom-color: currentColor;
  }

  .hs__go:focus-visible {
    outline: 2px solid var(--on-dark);
    outline-offset: 4px;
    opacity: 1;
  }

  /* The text: one block per hold, bottom left, rising 20 px into place while its hold is on screen */
  .hs__copy {
    padding: var(--s-6) clamp(20px, 4.5vw, 64px);
  }

  .hs.is-live .hs__copy,
  .hs.is-still .hs__copy {
    position: absolute;
    left: clamp(20px, 4.5vw, 64px);
    bottom: clamp(28px, 7vh, 72px);
    z-index: 2;
    width: min(560px, calc(100% - 40px));
    padding: 0;
  }

  .hs__hold + .hs__hold {
    margin-top: var(--s-6);
  }

  .hs.is-live .hs__hold,
  .hs.is-still .hs__hold {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    margin: 0;
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition:
      opacity var(--hs-fade),
      transform var(--hs-fade);
  }

  .hs.is-live .hs__hold.is-on,
  .hs.is-still .hs__hold.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hs__hold {
    max-width: 560px;
    text-align: start;
    text-shadow: 0 1px 14px rgb(var(--black-rgb) / 0.35);
  }

  .hs__h {
    max-width: 16ch;
    margin: 0 0 12px;
    color: var(--on-dark);
    font-size: clamp(2.25rem, 1.55rem + 1.7vw, 3.25rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.06;
    text-wrap: balance;
  }

  .hs__q {
    margin: 0 0 10px;
    color: var(--on-dark);
    font-size: clamp(1.25rem, 1.1rem + 0.45vw, 1.625rem);
    font-weight: 300;
    line-height: 1.2;
  }

  .hs__problem {
    margin: 0 0 16px;
    color: rgb(var(--on-dark-rgb) / 0.88);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .hs__with {
    margin: 0 0 6px;
    color: rgb(var(--on-dark-rgb) / 0.75);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .hs__points {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .hs__points li {
    display: flex;
    gap: 10px;
  }

  .hs__points li::before {
    content: '✓';
    opacity: 0.85;
  }

  .hs__more {
    display: inline-block;
    margin-top: 14px;
    color: var(--on-dark);
    font-size: 0.9375rem;
    text-underline-offset: 4px;
  }

  .hs__cta {
    margin-top: 20px;
    border-color: var(--paper);
    background: var(--paper);
    color: var(--ink);
    text-shadow: none;
  }

  .hs__cta:hover {
    border-color: var(--silver-light);
    background: var(--silver-light);
    color: var(--ink);
  }

  /* Callouts: a dot on the object, a short line and a white card; placed in pixels by the script */
  .hs__spots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hs:not(.is-live):not(.is-still) .hs__spots {
    display: none;
  }

  .hs__spot {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transform: translate(var(--sx, -999px), var(--sy, -999px));
    transition: opacity var(--hs-fade);
  }

  .hs__spot.is-on {
    opacity: 1;
  }

  .hs__dot {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 0 0 6px rgb(var(--on-dark-rgb) / 0.28);
  }

  .hs__line {
    position: absolute;
    top: 0;
    width: 34px;
    height: 1px;
    background: var(--paper);
  }

  .hs__card {
    position: absolute;
    top: 0;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: var(--shadow-2);
    color: var(--ink);
    font: 600 0.875rem/1 var(--font);
    white-space: nowrap;
    transform: translateY(-50%);
  }

  .hs__card :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .hs__spot[data-side='end'] .hs__line {
    left: 6px;
  }

  .hs__spot[data-side='end'] .hs__card {
    left: 40px;
  }

  .hs__spot[data-side='start'] .hs__line {
    right: 6px;
  }

  .hs__spot[data-side='start'] .hs__card {
    right: 40px;
  }

  .hs__spot[data-side='up'] .hs__line {
    bottom: 6px;
    left: 0;
    width: 1px;
    height: 34px;
  }

  .hs__spot[data-side='up'] .hs__card {
    top: -40px;
    left: 0;
    transform: translate(-50%, -100%);
  }

  /* The result: lines from the three callouts up to the Tyll mark */
  .hs__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .hs__links line {
    stroke: var(--paper);
    stroke-width: 1.25;
    stroke-opacity: 0.85;
  }

  .hs__hub {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: var(--paper);
    box-shadow: var(--shadow-2);
    color: var(--ink);
    opacity: 0;
    transform: translate(calc(var(--hx, -999px) - 50%), calc(var(--hy, -999px) - 50%));
    transition: opacity 0.4s ease;
  }

  .hs__hub :global(svg) {
    width: 38px;
    height: auto;
  }

  .hs.is-result .hs__links,
  .hs.is-result .hs__hub {
    opacity: 1;
  }

  /* Tall screens: the portrait frames, the text bottom centre, the tabs as numbers with the current name */
  @media (max-aspect-ratio: 9/10) {
    .hs {
      --focus: var(--focus-phone);
    }

    .hs.is-live .hs__copy,
    .hs.is-still .hs__copy {
      right: 20px;
      bottom: 22px;
      left: 20px;
      width: auto;
      margin: 0 auto;
    }

    .hs__hold {
      margin-inline: auto;
      text-align: center;
    }

    .hs__h {
      max-width: none;
      font-size: 2rem;
    }

    .hs__q {
      font-size: 1.3125rem;
    }

    .hs__problem {
      font-size: 0.9375rem;
    }

    /* The list centred as a block, its lines still aligned with each other; the link below it on its own line */
    .hs__points {
      display: table;
      margin-inline: auto;
      font-size: 0.875rem;
      text-align: start;
    }

    .hs.is-live .hs__tabs,
    .hs.is-still .hs__tabs {
      gap: 4px 16px;
    }

    .hs__go:not([aria-current='step']) .hs__l {
      display: none;
    }

    .hs__card {
      padding: 6px 11px 6px 8px;
      font-size: 0.75rem;
    }

    .hs__card :global(svg) {
      width: 15px;
      height: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs__hold,
    .hs__spot,
    .hs__shade,
    .hs__links,
    .hs__hub {
      transition-duration: 0.01s;
    }
  }
</style>

<script>
  import walkthrough from '../../content/walkthrough.json';
  import { createFilm, cover, portraitQuery } from '../../scripts/film';

  const root = document.querySelector<HTMLElement>('[data-hs]');
  if (root) {
    const pin = root.querySelector<HTMLElement>('[data-hs-pin]')!;
    const stage = root.querySelector<HTMLElement>('[data-hs-stage]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-hs-film]')!;
    const video = root.querySelector<HTMLVideoElement>('[data-hs-mp4]')!;
    const holds = [...root.querySelectorAll<HTMLElement>('[data-hs-hold]')];
    const goes = [...root.querySelectorAll<HTMLButtonElement>('[data-hs-go]')];
    const stills = [...root.querySelectorAll<HTMLElement>('[data-hs-still]')];
    const spots = [...root.querySelectorAll<HTMLElement>('[data-hs-spot]')];
    const svg = root.querySelector<SVGSVGElement>('[data-hs-links]')!;
    const links = [...root.querySelectorAll<SVGLineElement>('[data-hs-link]')];
    const hub = root.querySelector<HTMLElement>('[data-hs-hub]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The frame set is chosen once per visit, like the film's own (src/scripts/film.ts)
    const portrait = matchMedia(portraitQuery).matches;
    const film = walkthrough;
    const set = portrait ? film.phone : film.desk;
    const last = film.holds.length - 1;
    const player = reduce ? null : createFilm(root, canvas, video, film);
    root.classList.add(reduce ? 'is-still' : 'is-live');
    if (reduce) stills.forEach((s) => (s.hidden = false));

    // In screens of the pinned frame: each hold's plateau, each move between two holds (longer for a longer walk, so
    // the camera keeps one pace), and where on a plateau the text comes in and goes, so it has gone before the camera
    // moves on
    // Phones get a shorter run (holds just over the 1.2-screen minimum, quicker moves): eight screens of film is a lot of thumb
    const HOLD = portrait ? 1.22 : 1.25;
    const MOVE_PER_SECOND = portrait ? 0.08 : 0.12;
    const MOVE_MIN = portrait ? 0.6 : 0.9;
    const IN = 0.06;
    const OUT = 0.12;
    let screen = 1;
    let headerH = 72;
    let keys: number[] = []; // plateau i runs from keys[2i] to keys[2i + 1], in pixels of scroll

    const offset = () => headerH - root.getBoundingClientRect().top;
    // Film time at a scroll offset: the plateaus barely advance, the moves carry the walk
    const timeAt = (y: number) => {
      if (y <= keys[0]) return film.holds[0].from;
      for (let k = 0; k < keys.length - 1; k++) {
        if (y <= keys[k + 1]) {
          const from = k % 2 === 0 ? film.holds[k / 2].from : film.holds[(k - 1) / 2].to;
          const to = k % 2 === 0 ? film.holds[k / 2].to : film.holds[(k + 1) / 2].from;
          return from + (to - from) * ((y - keys[k]) / (keys[k + 1] - keys[k] || 1));
        }
      }
      return film.holds[last].to;
    };
    const holdAt = (y: number) => {
      for (let i = 0; i <= last; i++) {
        const from = i === 0 ? -Infinity : keys[2 * i] + IN * screen;
        const to = i === last ? Infinity : keys[2 * i + 1] - OUT * screen;
        if (y >= from && y <= to) return i;
      }
      return -1;
    };
    const zoneAt = (y: number) => {
      for (let i = 0; i < last; i++) if (y < (keys[2 * i + 1] + keys[2 * i + 2]) / 2) return i;
      return last;
    };

    // Where the portrait cut sits across the landscape film at a film time (its centre, from 0 to 1)
    const trackAt = (t: number) => {
      const track = film.portraitCrop.track;
      if (t <= track[0][0]) return track[0][1];
      for (let k = 0; k < track.length - 1; k++) {
        const [t0, c0] = track[k];
        const [t1, c1] = track[k + 1];
        if (t <= t1) return c0 + (c1 - c0) * ((t - t0) / (t1 - t0 || 1));
      }
      return track[track.length - 1][1];
    };
    // A point of the picture during a hold (x, y from 0 to 1 of the landscape frame) to pixels of the stage, through the
    // same cover crop the film is drawn with. On tall screens the point is taken through the portrait cut's window at
    // that hold (its track), and a callout may name another point there (phone), still in landscape fractions.
    const toStage = (x: number, y: number, hold: number, phone?: { x: number; y: number } | null) => {
      const [fw, fh] = set.size;
      let fx = x;
      let fy = y;
      if (portrait) {
        const h = film.holds[hold];
        const centre = trackAt((h.from + h.to) / 2);
        fx = ((phone?.x ?? x) - (centre - film.portraitCrop.width / 2)) / film.portraitCrop.width;
        fy = phone?.y ?? y;
      }
      const { sx, sy, scale } = cover(stage.clientWidth, stage.clientHeight, fw, fh, set.focus);
      return [(fx * fw - sx) * scale, (fy * fh - sy) * scale];
    };
    const place = () => {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      const at = spots.map((spot) => {
        const phone = spot.dataset.phone ? JSON.parse(spot.dataset.phone) : undefined;
        spot.dataset.side = (portrait && phone?.side) || spot.dataset.sideDesk;
        const [x, y] = toStage(Number(spot.dataset.x), Number(spot.dataset.y), Number(spot.dataset.hsSpot), phone);
        spot.style.setProperty('--sx', `${x}px`);
        spot.style.setProperty('--sy', `${y}px`);
        spot.hidden = x < 12 || y < 12 || x > w - 12 || y > h - 12; // off the cropped picture: left out
        return [x, y];
      });
      const [hx, hy] = toStage(film.hub.x, film.hub.y, last, film.hub.phone);
      hub.style.setProperty('--hx', `${hx}px`);
      hub.style.setProperty('--hy', `${hy}px`);
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      for (const line of links) {
        const [x, y] = at[Number(line.dataset.hsLink)];
        line.setAttribute('x1', String(x));
        line.setAttribute('y1', String(y));
        line.setAttribute('x2', String(hx));
        line.setAttribute('y2', String(hy));
      }
    };

    const measure = () => {
      headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;
      screen = pin.offsetHeight || innerHeight;
      keys = [];
      let y = 0;
      film.holds.forEach((hold, i) => {
        keys.push(y);
        y += HOLD * screen;
        keys.push(y);
        if (i < last) y += Math.max(MOVE_MIN, MOVE_PER_SECOND * (film.holds[i + 1].from - hold.to)) * screen;
      });
      root.style.setProperty('--hs-run', `${y}px`);
      root.dataset.hsKeys = keys.map(Math.round).join(','); // read by the browser tests
      place();
    };

    let shownHold = -2;
    let shownZone = -1;
    const render = () => {
      const y = offset();
      const zone = zoneAt(y);
      const hold = reduce ? zone : holdAt(y);
      const time = timeAt(y);
      root.dataset.hold = hold < 0 ? 'move' : String(hold);
      root.dataset.hsT = time.toFixed(2); // read by the browser tests
      root.classList.toggle('is-hold', hold >= 0);
      root.classList.toggle('is-result', hold === last);
      if (hold !== shownHold) {
        holds.forEach((el, i) => {
          el.classList.toggle('is-on', i === hold);
          el.inert = i !== hold;
        });
        spots.forEach((spot) => spot.classList.toggle('is-on', Number(spot.dataset.hsSpot) === hold));
        shownHold = hold;
      }
      if (zone !== shownZone) {
        goes.forEach((go, i) => (i === zone ? go.setAttribute('aria-current', 'step') : go.removeAttribute('aria-current')));
        if (reduce) stills.forEach((s, i) => s.classList.toggle('is-on', i === zone));
        shownZone = zone;
      }
      player?.seek(time);
    };

    // A tab takes the reader to its hold, a little into the plateau so the text is already up
    goes.forEach((go, i) =>
      go.addEventListener('click', () => {
        const top = scrollY + root.getBoundingClientRect().top - headerH + keys[2 * i] + (i === 0 ? 0 : 0.25 * screen);
        scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
      }),
    );

    // Play: walks the film forward at its own pace (one film second a second through the moves, about four and a half
    // seconds on each hold so its text can be read), by scrolling the page, so the texts arrive exactly as they would.
    // Any wheel, touch or key takes control back; the link resets at the end.
    const play = root.querySelector<HTMLButtonElement>('[data-hs-play]')!;
    let playing = 0;
    const DWELL = 4.5;
    const stopPlay = () => {
      if (!playing) return;
      cancelAnimationFrame(playing);
      playing = 0;
      play.textContent = play.dataset.play!;
      play.setAttribute('aria-pressed', 'false');
    };
    const speedAt = (y: number) => {
      for (let k = 0; k < keys.length - 1; k++) {
        if (y < keys[k + 1]) {
          const len = keys[k + 1] - keys[k];
          if (k % 2 === 0) return len / DWELL; // a hold
          const seconds = film.holds[(k + 1) / 2].from - film.holds[(k - 1) / 2].to; // a move, at the film's own pace
          return len / Math.max(0.5, seconds);
        }
      }
      return (HOLD * screen) / DWELL;
    };
    if (player) {
      play.hidden = false;
      play.addEventListener('click', () => {
        if (playing) return stopPlay();
        const top0 = scrollY + root.getBoundingClientRect().top - headerH;
        const end = keys[keys.length - 1];
        let y = Math.max(0, offset());
        if (y >= end - 2) y = 0;
        play.textContent = play.dataset.pause!;
        play.setAttribute('aria-pressed', 'true');
        let last = performance.now();
        const step = (now: number) => {
          const dt = Math.min(0.1, (now - last) / 1000);
          last = now;
          y = Math.min(end, y + speedAt(y) * dt);
          scrollTo({ top: top0 + y, behavior: 'instant' });
          if (y >= end) return stopPlay();
          playing = requestAnimationFrame(step);
        };
        playing = requestAnimationFrame(step);
      });
      for (const type of ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const)
        addEventListener(
          type,
          (e) => {
            if (playing && e.target !== play) stopPlay();
          },
          { passive: true },
        );
      goes.forEach((go) => go.addEventListener('click', stopPlay));
    }

    let queued = 0;
    const onScroll = () => {
      if (!queued) queued = requestAnimationFrame(() => ((queued = 0), render()));
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', () => {
      measure();
      render();
    });
    new ResizeObserver(() => {
      place();
    }).observe(stage);
    measure();
    render();
  }
</script>
