---
// One sourced finding, said in a single breath: the figure counts up and reads straight into the statement beside it.
// Industry research, never a Tyll result. It leads into "Works with your existing systems" just below.
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const w = t(lang).home.why;
// The figure counts up when it first comes into view; the suffix (the "+") stays where it is
const [, count = w.figure, suffix = ''] = w.figure.match(/^(\d+)(.*)$/) ?? [];
---

<section class="why" aria-labelledby="why-title">
  <div class="wrap why__inner">
    <p class="why__number" aria-hidden="true"><bdi dir="ltr"><span data-count={count}>{count}</span>{suffix}</bdi></p>
    <div class="why__copy">
      <h2 id="why-title"><span class="visually-hidden">{w.figure} </span>{w.title}</h2>
      <p class="why__text">{w.text}</p>
      <p class="why__source">
        {w.source}:{' '}
        <a href={w.sourceUrl} target="_blank" rel="noopener">{w.sourceName}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .why {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    background: linear-gradient(180deg, #ffffff 0%, #f6f7f8 100%);
  }

  .why__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem clamp(2.5rem, 1rem + 6vw, 7rem);
  }

  /* The number is the section: very large, fine-lined, fading from ink into the night blue of the story above */
  .why__number {
    margin: 0;
    background: linear-gradient(135deg, #14161a 25%, #2d4a78 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: clamp(7rem, 4rem + 13vw, 15rem);
    font-weight: 200;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .why__copy {
    max-width: 34rem;
  }

  .why h2 {
    font-size: var(--fs-h2);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .why__text {
    margin-top: 1rem;
    color: var(--graphite);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .why__source {
    margin-top: 1rem;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  .why__source a {
    color: var(--steel);
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .why__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  // Counts the figure up from 1 the first time it comes into view (about 0.9 s, easing out), once per visit.
  // While counting, the number keeps the width of its final value, so the "+" beside it never moves.
  // With reduced motion, or without JavaScript, the final figure simply shows.
  const el = document.querySelector<HTMLElement>('.why__number [data-count]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const target = Number(el.dataset.count);
    // Measured with the final value in place (and again when counting starts, once the web font has loaded)
    const hold = () => {
      el.removeAttribute('style');
      el.textContent = String(target);
      const width = el.getBoundingClientRect().width;
      Object.assign(el.style, { display: 'inline-block', width: `${width}px`, textAlign: 'right' });
    };
    hold();
    el.textContent = '1';
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        hold();
        el.textContent = '1';
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / 900);
          const eased = 1 - (1 - p) ** 3;
          el.textContent = String(Math.max(1, Math.round(1 + eased * (target - 1))));
          if (p < 1) requestAnimationFrame(step);
          else el.removeAttribute('style');
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.6 },
    );
    io.observe(el);
  }
</script>
