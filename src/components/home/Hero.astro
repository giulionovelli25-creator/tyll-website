---
import { getImage } from 'astro:assets';
import poster from '../../assets/hero-film.jpg';
import posterPhone from '../../assets/hero-film-phone.jpg';
import { site } from '../../config/site';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
// "Try the demo" opens the public demo; without one configured, the report button stands alone
const demo = site.demoUrl;

// Upright screens get their own cut of the film, each scene framed on its subject, and the poster to match
const UPRIGHT = '(max-width: 820px) and (orientation: portrait)';
const stills = async (src: typeof poster, widths: number[]) => ({
  avif: await getImage({ src, widths, format: 'avif' }),
  webp: await getImage({ src, widths, format: 'webp' }),
});
const wide = await stills(poster, [828, 1280, 1920, 2000]);
const upright = await stills(posterPhone, [540, 720]);
const fallback = await getImage({ src: poster, widths: [1280, 1920], format: 'jpg' });
---

<section class="hero on-dark" data-hero aria-labelledby="hero-title">
  <div class="hero__media" data-dark>
    <picture>
      <source media={UPRIGHT} type="image/avif" srcset={upright.avif.srcSet.attribute} sizes="100vw" />
      <source media={UPRIGHT} type="image/webp" srcset={upright.webp.srcSet.attribute} sizes="100vw" />
      <source type="image/avif" srcset={wide.avif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={wide.webp.srcSet.attribute} sizes="100vw" />
      <img src={fallback.src} srcset={fallback.srcSet.attribute} sizes="100vw" alt={d.hero.videoLabel} loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <!-- No poster attribute: the still image above already shows until the video is actually playing -->
    <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
      <!-- One continuous film with dissolves and no black frames: the reception bell, the kitchen, the lobby (Pexels License; see docs/hero-video-brief.md) -->
      <source src="/media/hero-film-phone.webm" type="video/webm" media={UPRIGHT} />
      <source src="/media/hero-film-phone.mp4" type="video/mp4" media={UPRIGHT} />
      <source src="/media/hero-film-720.webm" type="video/webm" media="(max-width: 760px)" />
      <source src="/media/hero-film-720.mp4" type="video/mp4" media="(max-width: 760px)" />
      <source src="/media/hero-film-1080.webm" type="video/webm" />
      <source src="/media/hero-film-1080.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <h1 id="hero-title">
      {
        d.hero.title.split(/(?<=\.)\s+/).map((line, i) => (
          <span class="hero__line" style={`--d:${i}`}>
            {line}{' '}
          </span>
        ))
      }
    </h1>
    <p class="hero__sub">{d.hero.sub}</p>
    <div class="hero__actions">
      {
        demo && (
          <a class="btn btn--solid btn--lg" href={demo} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from="hero">
            {d.hero.try}
            <span class="visually-hidden"> {d.cta.newTab}</span>
          </a>
        )
      }
      <!-- One clear call to action; the report is the quiet second path -->
      <a class:list={demo ? 'hero__quiet' : 'btn btn--solid btn--lg'} href="#report" data-track="report_cta_click" data-track-from="hero">
        {d.hero.report}
      </a>
    </div>
  </div>

  <button class="hero__toggle" type="button" aria-pressed="false" data-pause={d.hero.pause} data-play={d.hero.play} hidden>
    <span class="visually-hidden">{d.hero.pause}</span>
    <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.25v10H4.5zM9.25 3h2.25v10H9.25z" fill="currentColor"></path></svg>
    <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor"></path></svg>
  </button>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(620px, 100svh);
    max-height: 1100px;
    overflow: hidden;
    background: var(--night-0);
    color: var(--on-dark);
    isolation: isolate;
  }

  .hero__media,
  .hero__media :global(picture),
  .hero__media :global(img),
  .hero__media video,
  .hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__media {
    z-index: -2;
  }

  .hero__media :global(img),
  .hero__media video {
    object-fit: cover;
    /* Keeps the bell, the plate and the chandelier in frame as the screen narrows */
    object-position: 52% 50%;
  }

  @media (orientation: portrait) {
    .hero__media :global(img),
    .hero__media video {
      object-position: 64% 50%;
    }
  }

  .hero__media video {
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .hero__media video.is-playing {
    opacity: 1;
  }

  /* The film is already graded dark. This adds a shade on the text side and under the header, and a deeper foot, and leaves the picture itself clear. */
  .hero__shade {
    --side: 90deg;
    z-index: -1;
    background:
      linear-gradient(0deg, rgb(var(--night-rgb) / 0.62) 0%, rgb(var(--night-rgb) / 0) 36%),
      linear-gradient(var(--side), rgb(var(--night-rgb) / 0.66) 0%, rgb(var(--night-rgb) / 0.3) 42%, rgb(var(--night-rgb) / 0) 72%),
      linear-gradient(180deg, rgb(var(--night-rgb) / 0.38) 0%, rgb(var(--night-rgb) / 0) 18%);
  }

  /* Right-to-left: the text sits on the right, so the shade does too */
  :global([dir='rtl']) .hero__shade {
    --side: 270deg;
  }

  /* Upright tablets: the upright cut of the film, centred */
  @media (max-width: 820px) and (orientation: portrait) {
    .hero__media :global(img),
    .hero__media video {
      object-position: 50% 50%;
    }

    .hero__shade {
      background:
        linear-gradient(0deg, rgb(var(--night-rgb) / 0.88) 0%, rgb(var(--night-rgb) / 0.5) 26%, rgb(var(--night-rgb) / 0) 56%),
        linear-gradient(180deg, rgb(var(--night-rgb) / 0.42) 0%, rgb(var(--night-rgb) / 0) 20%);
    }
  }

  .hero__inner {
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(4.5rem, 3rem + 8vh, 9rem);
  }

  /* The headline carries the page on its own: the editorial serif, large, with room around it */
  .hero h1 {
    font-size: var(--fs-hero);
  }

  /* One sentence per line; from tablet width up a sentence never breaks inside itself */
  .hero__line {
    display: block;
  }

  @media (min-width: 640px) {
    .hero__line {
      white-space: nowrap;
    }
  }

  /* One orchestrated entrance: the lines rise in turn, then the copy and buttons settle */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line {
      animation: hero-rise 0.9s var(--ease) both;
      animation-delay: calc(0.08s + var(--d) * 0.14s);
    }

    .hero__sub,
    .hero__actions {
      animation: hero-fade 0.9s var(--ease) both;
      animation-delay: 0.5s;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .hero__sub {
    margin-top: var(--s-2);
    color: var(--text-1);
    font-size: var(--fs-lead);
    opacity: 0.86;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-4);
  }

  .hero__quiet {
    color: var(--text-2);
    font-size: var(--fs-body);
    text-decoration: none;
    text-underline-offset: 4px;
    transition: color 0.25s var(--ease);
  }

  .hero__quiet:hover {
    color: var(--text-1);
    text-decoration: underline;
  }

  .hero__toggle {
    position: absolute;
    inset-inline-end: var(--gut);
    bottom: calc(clamp(1.5rem, 1rem + 2vh, 3rem) + var(--consent-space, 0px));
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(var(--on-dark-rgb) / 0.28);
    border-radius: 50%;
    background: rgb(var(--ink-rgb) / 0.45);
    color: var(--on-dark);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition: border-color 0.2s var(--ease);
  }

  .hero__toggle:hover {
    border-color: var(--on-dark);
  }

  .hero__toggle svg {
    width: 16px;
    height: 16px;
  }

  .hero__toggle .i-play,
  .hero__toggle[aria-pressed='true'] .i-pause {
    display: none;
  }

  .hero__toggle[aria-pressed='true'] .i-play {
    display: block;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: max(560px, 100svh);
    }

    .hero__inner {
      padding-bottom: 6.5rem;
    }

    .hero__actions :global(.btn) {
      flex: 1 1 100%;
    }

    .hero__toggle {
      bottom: 1.5rem;
    }
  }

  /* Upright phones: the film is a window at the top, framed on each subject; the words sit on the light page below */
  @media (max-width: 640px) and (orientation: portrait) {
    .hero {
      --window: min(133.33vw, 64svh);
      display: block;
      min-height: 0;
      max-height: none;
      background: var(--page);
      color: var(--ink);
    }

    .hero__media,
    .hero__shade {
      bottom: auto;
      height: var(--window);
    }

    .hero__shade {
      background:
        linear-gradient(180deg, rgb(var(--night-rgb) / 0.42) 0%, rgb(var(--night-rgb) / 0) 22%);
    }

    .hero__inner {
      --text-1: var(--ink);
      --text-2: var(--steel);
      padding-top: calc(var(--window) + var(--s-4));
      padding-bottom: var(--s-5);
    }

    .hero__inner :global(.btn--solid) {
      background: var(--ink);
      color: var(--paper);
    }

    .hero__inner :global(.btn--solid:hover) {
      background: var(--graphite);
    }

    .hero__toggle {
      top: calc(var(--window) - 44px - var(--s-2));
      bottom: auto;
    }
  }
</style>

<script>
  // The text is plain HTML and shows at once; the video only fades in over the poster once it is actually playing.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const video = hero?.querySelector('video');
  const toggle = hero?.querySelector<HTMLButtonElement>('.hero__toggle');

  if (hero && video && toggle) {
    const label = toggle.querySelector('.visually-hidden')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    // With reduced motion, or a phone's data saver on, the still image stays until the visitor presses play
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let userPaused = reduce.matches || saveData;

    const sync = () => {
      const paused = video.paused;
      toggle.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? toggle.dataset.play! : toggle.dataset.pause!;
    };
    const play = () => {
      if (video.preload === 'none') video.preload = 'auto';
      video.play().catch(() => sync());
    };

    video.addEventListener('playing', () => video.classList.add('is-playing'));
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) video.pause();
      else play();
      document.dispatchEvent(new CustomEvent('tyll:track', { detail: { event: userPaused ? 'video_pause' : 'video_play' } }));
    });

    // Play only while the hero is on screen, and not at all with reduced motion unless asked.
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !userPaused) play();
      else if (!e.isIntersecting && !video.paused) video.pause();
    }).observe(hero);
    sync();
  }
</script>
