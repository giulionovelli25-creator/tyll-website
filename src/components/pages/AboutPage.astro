---
// About us (round 5, 25 Nov 2026, the owner: "where the tool comes from, our story; nice and interactive like every
// other page"). In the site's own frame, as on How it works: the title beside a photograph on the light silver wave,
// then the story in four steps along a line that draws itself as you scroll (each step lighting as the line reaches
// it; vertical on phones), how we work in four short points (with the way to the Security page), the three cities we
// work in (moved here from Sustainability, each with one sourced fact), a quiet line for investors, and the dark close.
// Nothing moves under reduced motion; without JavaScript everything shows. Copy: src/content/about.ts.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SilverWave from '../SilverWave.astro';
import SolutionIcon from '../SolutionIcon.astro';
import { about, type CityId } from '../../content/about';
import { t, href, type Locale } from '../../i18n';
import { site } from '../../config/site';
import heroPhoto from '../../assets/photos/reconciliation-reception.jpg';
import berlin from '../../assets/photos/sus-berlin.jpg';
import zurich from '../../assets/photos/sus-zurich.jpg';
import dubai from '../../assets/photos/sus-dubai.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const c = about[lang];
const tab = d.cta.newTab;
const cityPhoto: Record<CityId, { src: typeof berlin; focus: string }> = {
  berlin: { src: berlin, focus: '50% 40%' },
  zurich: { src: zurich, focus: '50% 62%' },
  dubai: { src: dubai, focus: '50% 55%' },
};
---

<Base lang={lang} page="about" title={c.metaTitle} description={c.metaDescription}>
  <div class="ab-top">
    <SilverWave phase={0.55} />
    <div class="wrap ab-top__grid">
      <header>
        <h1>{c.title}</h1>
        <p class="ab-top__text">{c.text}</p>
        <a class="btn btn--solid btn--lg" href={href('book', lang)} data-track="book_demo_click" data-track-from="about">{d.cta.book}</a>
      </header>
      <div class="ab-top__photo">
        <Picture src={heroPhoto} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 720, 960, 1280]} sizes="(max-width: 900px) 90vw, 560px" loading="eager" decoding="async" />
      </div>
    </div>
  </div>

  <!-- Where Tyll comes from, told as a short editorial piece: the minutes, the story around one pull line, the route -->
  <section class="story on-dark" data-dark aria-labelledby="story-title" data-story>
    <div class="wrap">
      <h2 id="story-title" class="display">{c.story.title}</h2>
      <div class="story__grid">
        <p class="story__figure" data-reveal>
          <span class="story__num" dir="ltr">
            <span class="visually-hidden">{c.story.figure}</span>
            <span aria-hidden="true" data-count>{c.story.figure}</span>
          </span>
          <span class="story__caption">{c.story.caption}</span>
        </p>
        <div class="story__words">
          <p class="story__text" data-reveal>{c.story.before}</p>
          <p class="story__pull display" data-reveal>{c.story.pull}</p>
          <p class="story__text" data-reveal>{c.story.after}</p>
        </div>
      </div>
      <ol class="route" role="list" data-route>
        {
          c.story.route.map((r, i) => (
            <li class="route__stop" style={`--i:${i}`}>
              <span class="route__dot" aria-hidden="true" />
              <span class="route__city">{r.city}</span>
              <span class="route__note">{r.note}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="ways" aria-labelledby="ways-title">
    <div class="wrap">
      <h2 id="ways-title" class="display">{c.ways.title}</h2>
      <ul class="ways__list" role="list">
        {
          c.ways.items.map((w) => (
            <li class="way">
              <span class="way__icon">
                <SolutionIcon name={w.icon} />
              </span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
      <a class="ways__more" href={href('security', lang)}>{c.ways.security}</a>
    </div>
  </section>

  <section class="cities" aria-labelledby="cities-title">
    <div class="wrap">
      <h2 id="cities-title" class="display">{c.cities.title}</h2>
      <ul class="cities__list" role="list">
        {
          c.cities.cards.map((card) => (
            <li class="city" id={`city-${card.id}`}>
              <Picture class="city__photo" src={cityPhoto[card.id].src} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 800, 1200]} sizes="(max-width: 900px) 92vw, 30vw" loading="lazy" decoding="async" style={`object-position: ${cityPhoto[card.id].focus}`} />
              <div class="city__body">
                <h3 class="city__place">{card.place}</h3>
                <p class="city__line">{card.line}</p>
                <p class="city__fact">{card.fact}</p>
                <p class="city__source">
                  <a href={card.source.url} target="_blank" rel="noopener">
                    {card.source.name}
                    <span class="visually-hidden"> {tab}</span>
                  </a>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="investors">
        {c.investors.text} <a href={`mailto:${site.email}?subject=${encodeURIComponent(d.home.investors.subject)}`} data-track="investor_email_click">{c.investors.link}</a>
      </p>
    </div>
  </section>

  <section class="close on-dark" data-dark aria-labelledby="ab-final">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap close__inner">
      <h2 id="ab-final" class="display">{d.home.invite.title}</h2>
      <a class="btn btn--solid btn--lg" href={href('book', lang)} data-track="book_demo_click" data-track-from="about-final">{d.cta.book}</a>
    </div>
  </section>
</Base>

<style>
  /* The title beside one photograph, on the light silver wave (as on How it works) */
  .ab-top {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--header-h) + var(--page-top)) var(--intro-gap);
  }

  .ab-top > :global(*:not(.wave)) {
    position: relative;
    z-index: 1;
  }

  .ab-top__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-5);
    align-items: center;
  }

  .ab-top h1 {
    max-width: 18ch;
    margin: 0;
    font-size: var(--fs-display);
    line-height: 1.08;
    text-wrap: balance;
  }

  .ab-top__text {
    max-width: 34rem;
    margin: 1.1rem 0 var(--s-3);
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .ab-top__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    object-fit: cover;
    filter: var(--photo-grade);
    box-shadow: var(--shadow-2);
  }

  /* The story: the minutes as one large figure beside the words, one pull line between two short paragraphs, then
     the route. Things rise in once as they come into view ([data-reveal] gets .is-in from the script); without the
     script, or under reduced motion, everything simply shows. */
  .story {
    padding-block: var(--section-y);
    background: var(--night-1);
    color: rgb(var(--on-dark-rgb));
  }

  .story h2 {
    margin: 0;
    color: rgb(var(--on-dark-rgb));
    font-size: var(--fs-h2);
  }

  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-4) var(--s-6);
    align-items: start;
    margin-top: var(--s-5);
  }

  .story__figure {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .story__num {
    color: rgb(var(--on-dark-rgb));
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 2.5rem + 7vw, 9.5rem);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 0.9;
  }

  :global([dir='rtl']) .story__num {
    text-align: right;
  }

  .story__caption {
    max-width: 18ch;
    color: var(--silver);
    font-size: var(--fs-lead);
    line-height: 1.4;
  }

  .story__words {
    display: grid;
    gap: var(--s-3);
  }

  .story__text {
    max-width: 36rem;
    margin: 0;
    color: rgb(var(--on-dark-rgb) / 0.82);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  .story__pull {
    max-width: 22ch;
    margin: 0;
    padding-inline-start: var(--s-3);
    border-inline-start: 1px solid var(--silver-deep);
    color: rgb(var(--on-dark-rgb));
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem);
    line-height: 1.15;
  }

  /* The route: three places on one line, drawn from the start edge, each stop arriving as the line reaches it */
  .route {
    --p: 1;
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin: var(--s-6) 0 0;
    padding: var(--s-4) 0 0;
    list-style: none;
  }

  .route::before,
  .route::after {
    position: absolute;
    top: 7px;
    inset-inline-start: 0;
    height: 1px;
    content: '';
  }

  .route::before {
    inset-inline-end: 0;
    background: rgb(var(--on-dark-rgb) / 0.16);
  }

  .route::after {
    width: calc(var(--p) * 100%);
    background: var(--silver-light);
  }

  .route__stop {
    position: relative;
    display: grid;
    gap: 0.35rem;
  }

  .route__dot {
    position: absolute;
    top: calc(-1 * var(--s-4));
    inset-inline-start: 0;
    width: 15px;
    height: 15px;
    border: 1.5px solid var(--silver-light);
    border-radius: 50%;
    background: var(--night-1);
  }

  .route__city {
    color: rgb(var(--on-dark-rgb));
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    font-weight: 300;
    line-height: 1.1;
  }

  .route__note {
    color: rgb(var(--on-dark-rgb) / 0.7);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* hidden at once; only the arrival is animated */
    .story[data-anim] [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
    }

    .story[data-anim] [data-reveal].is-in {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.7s var(--ease),
        transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .story[data-anim] .route {
      --p: 0;
    }

    .story[data-anim] .route__stop {
      opacity: 0;
      transform: translateY(12px);
    }

    .story[data-anim] .route.is-in {
      --p: 1;
      transition: --p 1.2s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .story[data-anim] .route.is-in .route__stop {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.5s var(--ease) calc(0.25s + var(--i) * 0.35s),
        transform 0.6s cubic-bezier(0.23, 1, 0.32, 1) calc(0.25s + var(--i) * 0.35s);
    }
  }

  /* How we work: four short points with their icons */
  .ways {
    padding-block: var(--section-y) var(--band-y);
  }

  .ways h2,
  .cities h2 {
    margin: 0;
    font-size: var(--fs-h2);
  }

  .ways__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .way__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--s-2);
    border-radius: 12px;
    background: var(--ink);
    color: var(--paper);
  }

  .way__icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .way h3 {
    margin: 0;
    font-family: var(--font);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .way p {
    margin: 0.4rem 0 0;
    color: var(--text-2);
  }

  .ways__more,
  .investors a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--s-3);
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--sand-600);
    text-underline-offset: 4px;
  }

  .ways__more:hover,
  .investors a:hover {
    text-decoration-color: currentColor;
  }

  /* The cities: three wide photo cards, each with one sourced fact */
  .cities {
    padding-block: var(--band-y) var(--section-y);
  }

  .cities__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .city {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--sand-300);
    border-radius: var(--radius-lg);
    background: var(--paper);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .city:hover {
    box-shadow: var(--shadow-2);
    transform: translateY(-3px);
  }

  .city :global(.city__photo),
  .city :global(.city__photo img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: var(--photo-grade);
  }

  .city__body {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-3);
  }

  .city__place {
    margin: 0;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    font-weight: 300;
  }

  .city__line {
    margin: 0;
  }

  .city__fact {
    margin: 0;
    padding-top: var(--s-2);
    border-top: 1px solid var(--line);
    color: var(--graphite);
    font-size: var(--fs-small);
  }

  .city__source {
    margin: 0;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  .city__source a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--sand-600);
    text-underline-offset: 3px;
  }

  .investors {
    margin: var(--s-4) 0 0;
    color: var(--text-2);
  }

  .close {
    position: relative;
    overflow: hidden;
    padding-block: var(--band-y);
    background: var(--night-1);
    color: var(--text-1);
  }

  .close__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .close h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem);
  }

  @media (max-width: 1023px) {
    .ways__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .ab-top__grid,
    .cities__list {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Tablets and phones: the figure over the words, the route down the start edge */
    .story__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .route {
      grid-template-columns: minmax(0, 1fr);
      padding: 0;
      padding-inline-start: var(--s-4);
    }

    .route::before,
    .route::after {
      top: 0;
      bottom: 0;
      inset-inline: 7px auto;
      width: 1px;
      height: auto;
    }

    .route::after {
      height: calc(var(--p) * 100%);
    }

    .route__dot {
      top: 0.55rem;
      inset-inline-start: calc(-1 * var(--s-4));
    }
  }

  @media (max-width: 560px) {
    .ways__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .city {
      transition: none;
    }

    .city:hover {
      transform: none;
    }
  }
</style>

<script>
  // The story: its parts rise in once as they come into view; the figure counts up to 45–60 (only its aria-hidden copy
  // changes); the route draws and its stops arrive one after another. Nothing under reduced motion, and a reader
  // who lands with the section already on screen sees it as it is.
  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches && story.getBoundingClientRect().top > innerHeight * 0.6) {
    // the route's line is drawn by animating --p, which needs the property registered
    if ('registerProperty' in CSS) {
      try {
        CSS.registerProperty({ name: '--p', syntax: '<number>', inherits: true, initialValue: '1' });
      } catch {}
    }
    story.dataset.anim = '';
    const NUM = /\d+/g;
    const count = (el: HTMLElement) => {
      const final = el.textContent ?? '';
      const start = performance.now();
      const step = (now: number) => {
        const k = Math.min((now - start) / 1200, 1);
        const e = 1 - Math.pow(1 - k, 3);
        el.textContent = final.replace(NUM, (m) => String(Math.round(+m * e)));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          const c = el.querySelector<HTMLElement>('[data-count]');
          if (c) count(c);
          io.unobserve(el);
        }
      },
      { threshold: 0.35 },
    );
    story.querySelectorAll<HTMLElement>('[data-reveal], [data-route]').forEach((el, i) => {
      el.style.transitionDelay = el.matches('[data-reveal]') ? `${(i % 4) * 0.12}s` : '';
      io.observe(el);
    });
  }
</script>
