      opacity: 0;
    }
  }

  .reveal {
    transition:
      opacity 0.7s var(--rise) calc(var(--i, 0) * 80ms),
      translate 0.7s var(--rise) calc(var(--i, 0) * 80ms);
  }

  :global(.sus.is-armed) .reveal:not(.is-in) {
    opacity: 0;
    translate: 0 24px;
  }

  /* the drawings: each line draws itself, then its pale fill comes in */
  :global(.sus.is-armed) .art path {
    stroke-dasharray: 1;
    transition:
      stroke-dashoffset 0.9s var(--rise) calc(0.05s + var(--i, 0) * 80ms + var(--n, 0) * 40ms),
      fill-opacity 0.4s var(--ease) calc(0.45s + var(--i, 0) * 80ms + var(--n, 0) * 40ms);
  }

  :global(.sus.is-armed) .reveal:not(.is-in) .art path {
    stroke-dashoffset: 1;
  }

  :global(.sus.is-armed) .reveal:not(.is-in) .art .ink {
    fill-opacity: 0;
  }

