    }

    .app__user-name {
      display: none;
    }

    /* The other issues stay, as single lines */
    .row {
      padding: 0.55rem 0.7rem;
    }

    .row__tags {
      display: none;
    }

    .row--on > .pill {
      display: none;
    }

    .d__ev {
      grid-template-columns: minmax(0, 1fr);
    }

    .app__detail {
