---
// A solution page asks one question, shows the real system answering it in a film, and asks for a demo.
import Base from '../../layouts/Base.astro';
import DemoFilm from '../DemoFilm.astro';
import HowItWorks from '../HowItWorks.astro';
import SilverWave from '../SilverWave.astro';
import { solutions } from '../../content/solutions';
import { explore } from '../../content/explore';
import { demoLink } from '../../config/demo';
import { t, href, solutionKeys, type Locale, type SolutionKey } from '../../i18n';

interface Props {
  lang: Locale;
  solution: SolutionKey;
}

const { lang, solution } = Astro.props;
const d = t(lang);
const p = d.solutionPage;
const s = solutions[solution];
const ex = explore[solution];
const name = s.name[lang];
const demo = demoLink(solution, lang);
const others = solutionKeys.filter((k) => k !== solution);
---

<Base lang={lang} page={solution} title={`${name} | Tyll`} description={`${s.headline[lang]} ${s.intro[lang]}`}>
  <section class="sol" aria-labelledby="sol-title">
    <SilverWave phase={0.2} class="sol__wave" />
    <div class="wrap sol__head">
      <p class="sol__name">{name}</p>
      <h1 id="sol-title" class="display">{s.headline[lang]}</h1>
      <p class="sol__intro">{s.intro[lang]}</p>
      <div class="sol__actions">
        <a class="btn btn--solid btn--lg sol__book" href={href('book', lang)} data-track="book_demo_click" data-track-from={`${solution}-hero`}>
          {d.cta.book}
        </a>
        {
          demo && (
            <a class="btn btn--line btn--lg" href={demo} target="_blank" rel="noopener" data-track="explore_demo_click" data-track-from={`${solution}-hero`}>
              {t(lang).hero.try}
              <span class="visually-hidden"> {d.cta.newTab}</span>
            </a>
          )
        }
      </div>
    </div>
    <div class="wrap sol__film">
      <DemoFilm lang={lang} solutionKey={solution} name={name} spots={ex.spots} />
      {(s.note || p.demoEnglish) && <p class="sol__note">{[s.note?.[lang], p.demoEnglish].filter(Boolean).join(' ')}</p>}
    </div>
  </section>

  <HowItWorks lang={lang} />

  <section class="close on-dark" data-dark aria-labelledby="sol-final">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap close__inner">
      <h2 id="sol-final" class="display">{d.home.invite.title}</h2>
      <a class="btn btn--solid btn--lg sol__book" href={href('book', lang)} data-track="book_demo_click" data-track-from={`${solution}-final`}>
        {d.cta.book}
      </a>
    </div>
  </section>

  <nav class="wrap others" aria-label={p.others}>
    <ul>
      {others.map((k) => <li><a href={href(k, lang)}>{solutions[k].name[lang]}</a></li>)}
      <li><a class="others__all" href={href('solutions', lang)}>{d.cta.allSolutions}</a></li>
    </ul>
  </nav>
</Base>

<style>
  .sol {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + clamp(1.5rem, 0.5rem + 4vh, 3.5rem));
    padding-bottom: var(--section-y);
  }

  .sol__head,
  .sol__film {
    position: relative;
    z-index: 1;
  }

  .sol__head {
    text-align: center;
  }

  /* A faint still wave behind the question, fading out before the film */
  .sol :global(.sol__wave) {
    height: 62%;
    top: 0;
    opacity: 0.4;
    -webkit-mask-image: linear-gradient(180deg, var(--black) 40%, transparent 100%);
    mask-image: linear-gradient(180deg, var(--black) 40%, transparent 100%);
  }

  .sol__name {
    max-width: none;
    margin-bottom: var(--s-2);
    color: var(--text-3);
    font-size: var(--fs-small);
  }

  .sol h1 {
    max-width: 18ch;
    margin-inline: auto;
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4.5rem);
    line-height: 1.08;
  }

  .sol__intro {
    max-width: 42ch;
    margin: var(--s-3) auto 0;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.4;
  }

  .sol__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }

  .sol__book {
    min-height: 60px;
    padding-inline: 2.25rem;
    font-size: 1.1875rem;
  }

  .sol__film {
    margin-top: var(--s-6);
  }

  .sol__note {
    max-width: none;
    margin-top: var(--s-3);
    color: var(--text-3);
    font-size: var(--fs-small);
    text-align: center;
  }

  .close {
    position: relative;
    overflow: hidden;
    padding-block: var(--s-8);
    background: var(--night-1);
    color: var(--text-1);
  }

  .close__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .close h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem);
  }

  .others ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem var(--s-4);
    margin: 0;
    padding-block: var(--s-5);
    list-style: none;
  }

  .others a {
    color: var(--ink);
    font-size: var(--fs-body);
    text-decoration: none;
  }

  .others a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .others__all {
    color: var(--steel);
  }

  @media (max-width: 640px) {
    .sol__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

