---
// The Sustainability page (round 5, 25 Nov 2026; trimmed and animated 26 Nov 2026, the owner):
// 1. Hero: the photograph fills the screen under the header, the headline and its line in the lower third over a dark
//    gradient (white text, AA contrast), rising into place once in 600 ms.
// 2. The world's numbers: three short stats on a dark band (UNEP), with five plates under "about one fifth".
// 4. What hotels got back from cutting food waste: industry research, said at the top; the 21% waste cut on its own,
//    then the return on the hotels' own programs as three figures side by side (no line: not a sequence).
// 6. Where Tyll helps: three cards, each with its solution page's film, loaded only when it scrolls into view.
// 7. The dark closing band.
// One motion for the page: parts rise in as they come into view and their figures count up; the real figures are
// always in the HTML (only aria-hidden copies count). Nothing moves under reduced motion; without JavaScript
// everything shows. The calculator was removed and the cities moved to About us (26 Nov 2026). Copy:
// src/content/sustainability.ts. No figure here is a Tyll result.
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SilverWave from '../SilverWave.astro';
import { sustainability } from '../../content/sustainability';
import { solutions } from '../../content/solutions';
import { t, href, type Locale } from '../../i18n';
import heroPhoto from '../../assets/photos/sales-buffet.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const c = sustainability[lang];
const tab = d.cta.newTab;
const fwd = lang === 'ar' ? '←' : '→';
const act = c.act.items.map((it) => ({ ...it, s: solutions[it.page] }));
---

<Base lang={lang} page="sustainability" title={c.metaTitle} description={c.metaDescription} overHero>
  <section class="hero on-dark" data-dark aria-labelledby="sus-title">
    <Picture class="hero__photo" src={heroPhoto} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" decoding="async" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <h1 id="sus-title" class="display">{c.title}</h1>
      <p class="hero__text">{c.text}</p>
    </div>
  </section>

  <!-- The world's numbers: three short stats on a dark band, counting up as they come into view; under the middle
       one (about one fifth), five plates, the last of them going in the bin -->
  <section class="world on-dark" data-dark aria-labelledby="sus-world" data-anim-scope>
    <div class="wrap">
      <h2 id="sus-world" class="display">{c.world.title}</h2>
      <ul class="world__stats" role="list">
        {
          c.world.stats.map((st, i) => (
            <li class="world__stat" style={`--d:${i}`} data-reveal>
              <p class="world__figure" dir="ltr">
                <span class="visually-hidden">{st.figure}</span>
                <span aria-hidden="true" data-count>{st.figure}</span>
              </p>
              <p class="world__text">{st.text}</p>
              {i === 1 && (
                <svg class="plates" viewBox="0 0 400 72" aria-hidden="true">
                  {[0, 1, 2, 3, 4].map((k) => (
                    <g class:list={['plate', k === 4 && 'plate--bin']} transform={`translate(${40 + k * 80} 36)`}>
                      <circle r="30" />
                      <circle class="plate__well" r="19" />
                    </g>
                  ))}
                </svg>
              )}
            </li>
          ))
        }
      </ul>
      <p class="source world__source">
        <a href={c.world.source.url} target="_blank" rel="noopener">
          {c.world.source.name}
          <span class="visually-hidden"> {tab}</span>
        </a>
      </p>
    </div>
  </section>


  <!-- What hotels got back: industry research, not Tyll's. The waste cut stands alone; the return on the hotels' own
       programs sits beside it as three figures, with nothing joining them, since they are not steps in a sequence. -->
  <section class="back" aria-labelledby="sus-back" data-anim-scope>
    <div class="wrap">
      <h2 id="sus-back" class="display sus__title">{c.back.title}</h2>
      <p class="back__sub">{c.back.sub}</p>
      <div class="back__lead" data-reveal>
        <p class="back__figure back__figure--lead" dir="ltr">
          <span class="visually-hidden">{c.back.lead.figure}</span>
          <span aria-hidden="true" data-count>{c.back.lead.figure}</span>
        </p>
        <p class="back__text">{c.back.lead.text}</p>
      </div>
      <div class="back__returns">
        <h3 class="back__label">{c.back.returnsLabel}</h3>
        <ul class="back__list" role="list">
          {
            c.back.returns.map((r, i) => (
              <li style={`--d:${i}`} data-reveal>
                <p class="back__figure" dir="ltr">
                  <span class="visually-hidden">{r.figure}</span>
                  <span aria-hidden="true" data-count>{r.figure}</span>
                </p>
                <p class="back__text">{r.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="source back__source">
        <a href={c.back.source.url} target="_blank" rel="noopener">
          {c.back.source.name}
          <span class="visually-hidden"> {tab}</span>
        </a>
      </p>
    </div>
  </section>

  <section class="act" aria-labelledby="sus-act" data-anim-scope>
    <div class="wrap">
      <h2 id="sus-act" class="display sus__title">{c.act.title}</h2>
      <ul class="act__list" role="list">
        {
          act.map((it, i) => (
            <li style={`--d:${i}`} data-reveal>
              <a class="act__card" href={href(it.page, lang)} data-accent={it.s.tone}>
                <video
                  class="act__clip"
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"
                  tabindex="-1"
                  poster={`/media/film/${lang}/${it.page}-desk.jpg`}
                  data-src={`/media/film/${lang}/${it.page}-desk.mp4`}
                  data-clip
                />
                <span class="act__name">
                  {it.s.name[lang]} <span class="act__go" aria-hidden="true">{fwd}</span>
                </span>
                <span class="act__text">{it.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="act__offer">{c.act.offer}</p>
    </div>
  </section>

  <section class="close on-dark" data-dark aria-labelledby="sus-final">
    <SilverWave phase={0.4} move tone="dark" />
    <div class="wrap close__inner">
      <h2 id="sus-final" class="display">{c.close.title}</h2>
      <div class="close__actions">
        <a class="btn btn--line btn--lg" href={href('waste', lang)}>{c.close.waste}</a>
        <a class="btn btn--solid btn--lg" href={href('book', lang)} data-track="book_demo_click" data-track-from="sustainability-final">{d.cta.book}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* 1. The hero fills the screen under the header; the words sit in its lower third */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--s-5)) clamp(3rem, 12svh, 8rem);
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark);
  }

  .hero :global(.hero__photo),
  .hero :global(.hero__photo img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    filter: var(--photo-grade);
  }

  /* Light at the top so the photograph reads, deep behind the words */
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(var(--shade-rgb) / 0.45) 0%, rgb(var(--shade-rgb) / 0) 22%),
      linear-gradient(to top, rgb(var(--shade-rgb) / 0.9) 0%, rgb(var(--shade-rgb) / 0.72) 32%, rgb(var(--shade-rgb) / 0.12) 68%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* Rises into place once, fully visible throughout: it moves, it never fades */
  @media (prefers-reduced-motion: no-preference) {
    .hero__inner {
      animation: sus-rise 600ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }
  }

  @keyframes sus-rise {
    from {
      transform: translateY(18px);
    }
  }

  .hero h1 {
    max-width: 16ch;
    color: rgb(var(--on-dark-rgb));
    font-size: clamp(2.5rem, 1.7rem + 3.4vw, 4.75rem);
    line-height: 1.04;
    text-shadow: 0 1px 18px rgb(var(--night-rgb) / 0.5);
  }

  .hero__text {
    max-width: 34rem;
    margin: var(--s-3) 0 0;
    color: rgb(var(--on-dark-rgb) / 0.92);
    font-size: var(--fs-lead);
    line-height: 1.5;
    text-shadow: 0 1px 14px rgb(var(--night-rgb) / 0.5);
  }

  .sus__title {
    max-width: 30ch;
    margin: 0;
    font-size: var(--fs-h2);
  }

  .source {
    max-width: none;
    margin: 0;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  .source a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--sand-600);
    text-underline-offset: 3px;
  }

  .source a:hover {
    color: var(--ink);
  }

  /* 2. The world's numbers: three stats on the dark band. Large serif figures, one short line each. */
  .world {
    padding-block: var(--section-y);
    background: var(--night-1);
    color: rgb(var(--on-dark-rgb));
  }

  .world h2 {
    margin: 0;
    color: rgb(var(--on-dark-rgb));
    font-size: var(--fs-h2);
  }

  .world__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .world__stat {
    padding-top: var(--s-3);
    border-top: 1px solid rgb(var(--on-dark-rgb) / 0.2);
  }

  .world__figure {
    margin: 0;
    color: rgb(var(--on-dark-rgb));
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 2rem + 4vw, 6rem);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 300;
    line-height: 1;
  }

  :global([dir='rtl']) .world__figure {
    text-align: right;
  }

  .world__text {
    max-width: 26ch;
    margin: var(--s-2) 0 0;
    color: rgb(var(--on-dark-rgb) / 0.8);
    font-size: var(--fs-lead);
    line-height: 1.45;
  }

  .world__source {
    margin-top: var(--s-4);
    color: rgb(var(--on-dark-rgb) / 0.7);
  }

  .world__source a {
    text-decoration-color: rgb(var(--on-dark-rgb) / 0.35);
  }

  .world__source a:hover {
    color: rgb(var(--on-dark-rgb));
  }

  /* Five plates seen from above, silver rims; the fifth turns to a dashed outline and drops, as if cleared away */
  .plates {
    display: block;
    width: min(100%, 15rem);
    height: auto;
    margin-top: var(--s-3);
    overflow: visible;
    fill: none;
    stroke: var(--silver);
    stroke-width: 1.5;
  }

  .plates :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .plate .plate__well {
    stroke: rgb(var(--on-dark-rgb) / 0.35);
  }

  .plate--bin {
    stroke-dasharray: 3 5;
    opacity: 0.45;
    translate: 0 10px;
  }

  /* One moment of motion for the whole page: things rise in once as they come into view, side by side ones one after
     another (--d), and their figures count up. Hidden at once and only the arrival is animated. Set by the script
     only, never under reduced motion, so without it everything simply shows. */
  @media (prefers-reduced-motion: no-preference) {
    [data-anim-scope][data-anim] [data-reveal] {
      opacity: 0;
      transform: translateY(28px);
    }

    [data-anim-scope][data-anim] [data-reveal].is-in {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.7s var(--ease) calc(var(--d, 0) * 0.12s),
        transform 0.8s cubic-bezier(0.23, 1, 0.32, 1) calc(var(--d, 0) * 0.12s);
    }

    [data-anim-scope][data-anim] .plate--bin {
      stroke-dasharray: none;
      opacity: 1;
      translate: 0 0;
    }

    [data-anim-scope][data-anim] .is-in .plate--bin {
      stroke-dasharray: 3 5;
      opacity: 0.45;
      translate: 0 10px;
      transition:
        opacity 0.6s var(--ease) 0.9s,
        translate 0.6s cubic-bezier(0.23, 1, 0.32, 1) 0.9s;
    }
  }

  /* 4. What hotels got back: the waste cut on its own, then the return on their programs, three figures side by side */
  .back {
    padding-block: var(--band-y);
  }

  .back__sub {
    max-width: 46rem;
    margin: var(--s-2) 0 0;
    color: var(--ink);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .back__lead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem var(--s-4);
    margin-top: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--line);
  }

  .back__figure {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.8rem + 2vw, 3.75rem);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 300;
    line-height: 1;
  }

  .back__figure--lead {
    font-size: clamp(3.5rem, 2.2rem + 4.4vw, 6.5rem);
  }

  .back__text {
    margin: 0.5rem 0 0;
    color: var(--graphite);
    line-height: 1.45;
  }

  .back__lead .back__text {
    max-width: 26ch;
    margin: 0;
    font-size: var(--fs-lead);
  }

  .back__returns {
    margin-top: var(--s-4);
  }

  .back__label {
    margin: 0;
    color: var(--ink);
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .back__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .back__list .back__text {
    max-width: 24ch;
  }

  :global([dir='rtl']) .back__figure {
    text-align: right;
  }

  .back__source {
    margin-top: var(--s-4);
  }

  /* 6. Where Tyll helps: three cards with the solution pages' films */
  .act {
    padding-block: 0 var(--band-y);
  }

  .act__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .act__card {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding-bottom: var(--s-2);
    color: var(--ink);
    text-decoration: none;
  }

  .act__clip {
    width: 100%;
    aspect-ratio: 16 / 10;
    margin-bottom: 0.5rem;
    border: 1px solid var(--sand-300);
    border-radius: var(--radius-md);
    background: var(--page-deep);
    object-fit: cover;
    object-position: 0 0;
  }

  .act__name {
    color: var(--acc);
    font-weight: 600;
  }

  .act__go {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  .act__card:hover .act__go {
    transform: translateX(3px);
  }

  :global([dir='rtl']) .act__card:hover .act__go {
    transform: translateX(-3px);
  }

  .act__text {
    color: var(--graphite);
  }

  .act__offer {
    max-width: 60ch;
    margin: var(--s-4) 0 0;
    color: var(--ink);
  }

  /* 7. The dark close */
  .close {
    position: relative;
    overflow: hidden;
    padding-block: var(--band-y);
    background: var(--night-1);
    color: var(--text-1);
  }

  .close__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    text-align: center;
  }

  .close h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem);
  }

  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    justify-content: center;
  }

  @media (max-width: 900px) {
    .act__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .world__stats {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }

    /* Phones and tablets: the waste cut full width, then the three returns stacked */
    .back__list {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }
  }

  @media (max-width: 600px) {
    .close__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .act__go {
      transition: none;
    }
  }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // The page's one motion (26 Nov 2026, the owner: "animate this page"): in each [data-anim-scope] section, the
  // [data-reveal] parts rise in once as they come into view, and the figures inside them count up (only the
  // aria-hidden copy changes; decimals and separators kept: 1.05, 1,05, 8–10%, ~7:1). A section already on screen
  // when the page opens just shows. Nothing under reduced motion.
  const NUM = /\d+(?:[.,]\d+)?/g;
  const count = (el: HTMLElement) => {
    const final = el.textContent ?? '';
    if (!/\d/.test(final)) return;
    const start = performance.now();
    const step = (now: number) => {
      const k = Math.min((now - start) / 1100, 1);
      const e = 1 - Math.pow(1 - k, 3);
      el.textContent = final.replace(NUM, (m) => {
        const sep = m.includes(',') ? ',' : '.';
        const dec = (m.split(/[.,]/)[1] ?? '').length;
        return (parseFloat(m.replace(',', '.')) * e).toFixed(dec).replace('.', sep);
      });
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (!still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          el.querySelectorAll<HTMLElement>('[data-count]').forEach(count);
          io.unobserve(el);
        }
      },
      { threshold: 0.3, rootMargin: '0px 0px -6% 0px' },
    );
    for (const scope of document.querySelectorAll<HTMLElement>('[data-anim-scope]')) {
      if (scope.getBoundingClientRect().top < innerHeight * 0.85) continue;
      scope.dataset.anim = '';
      scope.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => io.observe(el));
    }
  }

  // 6. Each card's film loads only when it comes into view, and pauses when it leaves. Reduced motion keeps the poster.
  const clips = [...document.querySelectorAll<HTMLVideoElement>('[data-clip]')];
  if (clips.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (!v.src && v.dataset.src) v.src = v.dataset.src;
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.35 },
    );
    clips.forEach((v) => io.observe(v));
  }
</script>
