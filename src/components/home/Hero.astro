---
import { Picture } from 'astro:assets';
import poster from '../../assets/hero-reception.jpg';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section class="hero on-dark" data-hero aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      src={poster}
      alt={d.hero.videoLabel}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[828, 1280, 1920, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <!-- No poster attribute: the still image above already shows until the video is actually playing -->
    <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
      <source src="/media/hero-reception.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <h1 id="hero-title">
      {d.hero.title.split(/(?<=\.)\s+/).map((line) => <span>{line} </span>)}
    </h1>
    <div class="hero__body">
      {d.hero.body.map((p) => <p>{p}</p>)}
    </div>
    <div class="hero__actions">
      <a class="btn btn--solid btn--lg" href={href('book', lang)} data-track="book_call_click" data-track-from="hero">{d.cta.book}</a>
      <a class="btn btn--line btn--lg" href={href('solutions', lang)} data-open-solutions data-track="explore_solutions_click" data-track-from="hero">
        {d.cta.solutions}
      </a>
    </div>
  </div>

  <button class="hero__toggle" type="button" aria-pressed="false" data-pause={d.hero.pause} data-play={d.hero.play} hidden>
    <span class="visually-hidden">{d.hero.pause}</span>
    <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.25v10H4.5zM9.25 3h2.25v10H9.25z" fill="currentColor"></path></svg>
    <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor"></path></svg>
  </button>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(620px, 100svh);
    max-height: 1100px;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark);
    isolation: isolate;
  }

  .hero__media,
  .hero__media :global(picture),
  .hero__media :global(img),
  .hero__media video,
  .hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__media {
    z-index: -2;
  }

  .hero__media :global(img),
  .hero__media video {
    object-fit: cover;
    /* Keeps the receptionist in frame as the screen narrows */
    object-position: 66% 50%;
  }

  .hero__media video {
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .hero__media video.is-playing {
    opacity: 1;
  }

  .hero__shade {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(14, 15, 17, 0.72) 0%, rgba(14, 15, 17, 0.38) 45%, rgba(14, 15, 17, 0) 75%),
      linear-gradient(0deg, rgba(14, 15, 17, 0.78) 0%, rgba(14, 15, 17, 0.2) 45%, rgba(14, 15, 17, 0.35) 100%);
  }

  .hero__inner {
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(3.5rem, 2rem + 6vh, 7rem);
  }

  /* The headline carries the page: large, light and tightly set */
  .hero h1 {
    font-size: clamp(3.1rem, 1.4rem + 6.4vw, 7.75rem);
    font-weight: 380;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  /* One sentence per line where there is room */
  .hero h1 span {
    display: block;
  }

  .hero__body {
    max-width: 36rem;
    margin-top: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
    color: rgba(244, 245, 247, 0.84);
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem);
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
  }

  .hero__toggle {
    position: absolute;
    right: var(--gut);
    bottom: calc(clamp(1.5rem, 1rem + 2vh, 3rem) + var(--consent-space, 0px));
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(244, 245, 247, 0.28);
    border-radius: 50%;
    background: rgba(20, 22, 26, 0.45);
    color: var(--on-dark);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition: border-color 0.2s var(--ease);
  }

  .hero__toggle:hover {
    border-color: var(--on-dark);
  }

  .hero__toggle svg {
    width: 16px;
    height: 16px;
  }

  .hero__toggle .i-play,
  .hero__toggle[aria-pressed='true'] .i-pause {
    display: none;
  }

  .hero__toggle[aria-pressed='true'] .i-play {
    display: block;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: max(560px, 100svh);
    }

    .hero__shade {
      background: linear-gradient(0deg, rgba(14, 15, 17, 0.9) 0%, rgba(14, 15, 17, 0.55) 50%, rgba(14, 15, 17, 0.3) 100%);
    }

    .hero__inner {
      padding-bottom: 6.5rem;
    }

    .hero__actions :global(.btn) {
      flex: 1 1 100%;
    }

    .hero__toggle {
      bottom: 1.5rem;
    }
  }
</style>

<script>
  // The text is plain HTML and shows at once; the video only fades in over the poster once it is actually playing.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const video = hero?.querySelector('video');
  const toggle = hero?.querySelector<HTMLButtonElement>('.hero__toggle');

  if (hero && video && toggle) {
    const label = toggle.querySelector('.visually-hidden')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    // With reduced motion, or a phone's data saver on, the still image stays until the visitor presses play
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let userPaused = reduce.matches || saveData;

    const sync = () => {
      const paused = video.paused;
      toggle.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? toggle.dataset.play! : toggle.dataset.pause!;
    };
    const play = () => {
      if (video.preload === 'none') video.preload = 'auto';
      video.play().catch(() => sync());
    };

    video.addEventListener('playing', () => video.classList.add('is-playing'));
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) video.pause();
      else play();
      document.dispatchEvent(new CustomEvent('tyll:track', { detail: { event: userPaused ? 'video_pause' : 'video_play' } }));
    });

    // Play only while the hero is on screen, and not at all with reduced motion unless asked.
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !userPaused) play();
      else if (!e.isIntersecting && !video.paused) video.pause();
    }).observe(hero);
    sync();
  }
</script>
