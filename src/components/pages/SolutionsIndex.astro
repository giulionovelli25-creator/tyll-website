---
// The solutions overview: the three parts of Tyll, each with its products shown as the real screen from its film, and what is in development in one quiet line. Reached from "All solutions" in the menu and from every
// "Explore Solutions" button; the Solutions dropdown in the header stays the quick way to one solution.
import Base from '../../layouts/Base.astro';
import PageIntro from '../PageIntro.astro';
import SolutionIcon from '../SolutionIcon.astro';
import { solutions } from '../../content/solutions';
import SilverWave from '../SilverWave.astro';
import { t, href, type Locale } from '../../i18n';
import { isComingSoon } from '../../config/products';
import { parts } from '../../config/parts';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<Base lang={lang} page="solutions" title={d.meta.solutionsTitle} description={d.meta.solutionsDescription}>
  <div class="index-top">
    <SilverWave phase={0.7} />
    <PageIntro title={d.solutionPage.indexTitle} />
  </div>
  <section class="wrap tiles-wrap" aria-label={d.nav.solutions}>
    {
      parts.map((keys, i) => (
        <section class="part" aria-labelledby={`part-${i}`}>
          <header class="part__head">
            <h2 id={`part-${i}`} class="part__name">{d.home.parts.cards[i].title}</h2>
            <p class="part__line">{d.home.parts.cards[i].text}</p>
          </header>
          <ul class="tiles">
            {keys.map((k) => {
              const s = solutions[k];
              const soon = isComingSoon(k);
              return (
                <li>
                  <a class="tile" href={href(k, lang)}>
                    <span class="tile__screen" dir="ltr">
                      <img src={`/media/film/${lang}/${k}-desk.jpg`} alt="" width="1360" height="860" loading="lazy" decoding="async" />
                    </span>
                    {soon && <span class="badge-soon tile__soon">{d.cta.comingSoon}</span>}
                    <span class="tile__body">
                      <span class="tile__name">
                        <SolutionIcon name={s.icon} />
                        {s.name[lang]}
                        <span class="tile__arrow flip-rtl" aria-hidden="true">→</span>
                      </span>
                      <span class="tile__desc">{s.menu[lang]}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
    <p class="tiles__soonline">{d.home.parts.soon}</p>
  </section>
</Base>

<style>
  .index-top {
    position: relative;
    overflow: hidden;
  }

  .index-top > :global(*:not(.wave)) {
    position: relative;
    z-index: 1;
  }

  /* Products in development carry the badge in the photo's top corner */
  .tile__soon {
    position: absolute;
    top: 1rem;
    inset-inline-start: 1rem;
    z-index: 2;
  }

  .tiles-wrap {
    padding-bottom: var(--section-y);
  }

  .tiles__soonline {
    margin-top: var(--s-4);
    color: var(--text-2);
    font-size: var(--fs-small);
  }

  .part {
    padding-block: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .part:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .part__head {
    margin-bottom: var(--s-3);
  }

  .part__name {
    margin: 0 0 0.35rem;
    font-size: var(--fs-h3);
  }

  .part__line {
    margin: 0;
    color: var(--text-2);
  }

  /* From laptop width each part is one row: its name and line beside its products */
  @media (min-width: 1101px) {
    .part {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      gap: var(--s-4);
      align-items: start;
    }

    .part__head {
      margin: 0;
      padding-top: 0.25rem;
    }
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each product is shown by its real screen (the first frame of its film), on the product's own ground */
  .tile {
    position: relative;
    display: grid;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .tile:hover,
  .tile:focus-visible {
    border-color: var(--hair-strong);
    box-shadow: var(--shadow-2);
  }

  .tile__screen {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--mist);
  }

  /* A close framing of the screen: past the demo's side menu, its title and key numbers at a readable size. The demo is
     left to right in every language. The whole screen plays in the film on the product's page. */
  .tile__screen img {
    display: block;
    width: 190%;
    max-width: none;
    height: auto;
    margin-left: -17.5%;
    transform-origin: 0 0;
    transition: transform 0.8s var(--ease);
  }

  .tile:hover .tile__screen img {
    transform: scale(1.03);
  }

  .tile__body {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 1rem 1.25rem 1.25rem;
  }

  .tile__name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1875rem;
    letter-spacing: 0;
  }

  .tile__name :global(svg) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--steel);
  }

  .tile__arrow {
    margin-inline-start: auto;
    color: var(--steel);
    transition: color 0.25s var(--ease);
  }

  .tile:hover .tile__arrow {
    color: var(--ink);
  }

  .tile__desc {
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .tiles__faq {
    margin-top: 2rem;
  }

  .tiles__faq a {
    font-weight: 400;
    text-underline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
