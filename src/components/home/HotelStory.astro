---
// "Three places your hotel loses money": a photograph-quality render of a hotel fills the right of the screen and stays
// there while the four steps scroll past on the left. The scroll drives the camera, and every move lands with the text
// it belongs to:
//   Revenue and Reconciliation  the hotel at dusk, its three callouts, the first one lit
//   → the camera pushes in to the entrance doors and, as they fill the frame, the kitchen fades in
//   Stock and Waste             the pass at dinner service, one marker on the plates
//   → back out through the doors to the whole hotel, across to the service entrance, in to the storeroom
//   Purchasing                  the dry store, markers on the count and the shelves
//   → back out to the whole hotel, now a little later (a dusk tint over the same photograph)
//   The result                  every callout lit and joined by fine lines to the Tyll mark above the roof
// `b` runs from 0 to 4 across the four steps and comes from the text's position, so scrolling back undoes everything.
// Only transforms and opacity change, over eased ranges of `b`, and nothing moves on its own. Under reduced motion the
// camera does not move: the photographs still change and the text still follows. Without JavaScript the finished hotel
// stands with every callout, and the four steps follow one another. The scene reads left to right, also in Arabic.
import { Picture } from 'astro:assets';
import Logo from '../Logo.astro';
import SolutionIcon from '../SolutionIcon.astro';
import hotel from '../../assets/story/hotel-dusk.jpg';
import sceneKitchen from '../../assets/story/scene-kitchen.jpg';
import sceneStore from '../../assets/story/scene-stock.jpg';
import { solutions } from '../../content/solutions';
import { t, href, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
const v = d.home.tour;
const pagesOf = [href('finance', lang), href('stock', lang), href('forecasting', lang)];

// Every hotspot in one place, in percentages of its photograph. The exterior: where the first three steps point on the
// façade (the entrance, the kitchen windows at the left of the ground floor, the service entrance at the right), the two
// points the camera pushes in to, and where the Tyll mark sits above the roof. Each scene: what its markers point at.
const exterior = {
  spots: [
    { x: 53.5, y: 64, side: 'start', icon: solutions.finance.icon },
    { x: 42, y: 80, side: 'end', icon: solutions.stock.icon },
    { x: 78, y: 77, side: 'up', icon: solutions.forecasting.icon },
  ],
  doors: { x: 53.5, y: 80 },
  service: { x: 78, y: 78 },
  hub: { x: 58, y: 7 },
};
const scenes = [
  { step: 1, photo: sceneKitchen, markers: [{ x: 71, y: 72, side: 'up', label: v.steps[1].label, icon: solutions.stock.icon }] },
  {
    step: 2,
    photo: sceneStore,
    markers: [
      { x: 38, y: 55, side: 'end', label: v.steps[2].label, icon: solutions.forecasting.icon },
      { x: 76, y: 30, side: 'up', label: v.zones.store, icon: solutions.stock.icon },
    ],
  },
];
---

<section
  class="hs"
  aria-labelledby="hs-title"
  data-hs
  style={`--hs-ratio:${hotel.width / hotel.height};--hub-x:${exterior.hub.x}%;--hub-y:${exterior.hub.y}%`}
  data-doors={`${exterior.doors.x} ${exterior.doors.y}`}
  data-service={`${exterior.service.x} ${exterior.service.y}`}
>
  <div class="hs__grid">
    <div class="hs__text">
      <header class="hs__head" data-hs-head>
        <ol class="hs__progress" aria-label={v.title}>
          {
            v.steps.map((step, i) => (
              <li>
                <button class="hs__go" type="button" data-hs-go={i} aria-current={i === 0 ? 'step' : undefined}>
                  <span>{i + 1}</span> {step.label}
                </button>
              </li>
            ))
          }
        </ol>
        <h2 id="hs-title" class="display">{v.title}</h2>
      </header>
      <ol class="hs__steps" data-hs-steps>
        {
          v.steps.map((step, i) => (
            <li class:list={['hs__step', i === 0 && 'is-active']} data-hs-step={i} data-label={step.label}>
              <div>
                <p class="visually-hidden">{v.stepOf.replace('{n}', String(i + 1)).replace('{t}', String(v.steps.length))}</p>
                <h3 class="display">{step.headline}</h3>
                {step.problem && (
                  <div class="hs__problem">
                    <p class="hs__tag">{v.before}</p>
                    <p>{step.problem}</p>
                  </div>
                )}
                <div class="hs__fix">
                  <p class="hs__tag hs__tag--on">{v.after}</p>
                  <ul>
                    {step.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                  {i < v.steps.length - 1 && (
                    <a class="hs__more" href={pagesOf[i]}>
                      {v.more} <span class="flip-rtl" aria-hidden="true">→</span>
                    </a>
                  )}
                  {i === v.steps.length - 1 && (
                    <a class="btn btn--solid btn--lg hs__cta" href={href('book', lang)} data-track="book_demo_click" data-track-from="hotel">
                      {d.cta.book}
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="hs__scene">
      <div class="hs__stage" dir="ltr" data-hs-stage>
        <!-- The hotel; for the result the same photograph a little later in the evening, by two tints that move with it -->
        <div class="hs__layer hs__layer--hotel" data-hs-hotel>
          <Picture class="hs__img" src={hotel} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[768, 1152, 1536]} sizes="(max-width: 1000px) 100vw, 60vw" loading="eager" decoding="async" />
          <span class="hs__late hs__late--sky" aria-hidden="true" />
          <span class="hs__late hs__late--windows" aria-hidden="true" />
        </div>

        <!-- The two rooms, each with its own markers on the things the text talks about -->
        {
          scenes.map(({ step, photo, markers }) => (
            <div class="hs__layer hs__layer--view" data-hs-view={step} style={`--ratio:${photo.width / photo.height}`}>
              <Picture class="hs__img" src={photo} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[768, 1152, 1536]} sizes="(max-width: 1000px) 100vw, 60vw" loading="lazy" decoding="async" />
              <div class="hs__marks" data-hs-marks>
                {markers.map(({ x, y, side, label, icon }) => (
                  <div class="hs__spot is-on" data-side={side} style={`--x:${x}%;--y:${y}%`}>
                    <span class="hs__dot" aria-hidden="true" />
                    <span class="hs__line" aria-hidden="true" />
                    <span class="hs__card">
                      <SolutionIcon name={icon} />
                      {label}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }

        <!-- The callouts on the façade, the glow on the entrance and, for the result, the lines up to the Tyll mark -->
        <div class="hs__spots" data-hs-spots>
          <span class="hs__glow" aria-hidden="true" data-hs-glow />
          <svg class="hs__links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {exterior.spots.map(({ x, y }) => <line x1={x} y1={y} x2={exterior.hub.x} y2={exterior.hub.y} pathLength="1" />)}
          </svg>
          <span class="hs__hub" aria-hidden="true">
            <Logo mark label="" />
          </span>
          {
            exterior.spots.map(({ x, y, side, icon }, i) => (
              <div class="hs__spot" data-hs-spot={i} data-side={side} style={`--x:${x}%;--y:${y}%`}>
                <span class="hs__dot" aria-hidden="true" />
                <span class="hs__line" aria-hidden="true" />
                <span class="hs__card">
                  <SolutionIcon name={icon} />
                  {v.steps[i].label}
                </span>
              </div>
            ))
          }
        </div>

        <!-- On phones the callouts become pills along the bottom of the frame -->
        <ul class="hs__pills" aria-hidden="true" data-hs-pills>
          {
            exterior.spots.map(({ icon }, i) => (
              <li class="hs__pill" data-hs-pill={i}>
                <SolutionIcon name={icon} />
                {v.steps[i].label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hs {
    /* One screen of scrolling for each step. The text pins just below the heading; --hs-head is measured. */
    --hs-step: 100svh;
    --hs-pin: calc(var(--header-h) + var(--hs-head, 12rem));
    --hs-ease: 0.3s var(--ease);
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .hs__grid {
    display: grid;
    grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    gap: var(--s-5);
    /* The text starts where the rest of the page starts; the hotel runs to the edge */
    padding-inline: max(var(--gut), calc((100vw - var(--wrap)) / 2)) 0;
  }

  /* ── Text ── */
  .hs__head {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    padding-block: var(--s-4) var(--s-2);
    background: var(--paper);
  }

  /* Text passing beneath the heading fades out rather than being cut */
  .hs__head::after {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: var(--s-3);
    background: linear-gradient(180deg, var(--paper), rgb(var(--paper-rgb) / 0));
    content: '';
    pointer-events: none;
  }

  /* Where the reader is: the four steps in a row, the current one underlined; each is a button that takes you there */
  .hs__progress {
    display: flex;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .hs__progress::-webkit-scrollbar {
    display: none;
  }

  .hs__go {
    padding: 0 0 0.55rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--text-3);
    font: inherit;
    font-size: var(--fs-small);
    line-height: 1.3;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--hs-ease),
      border-color var(--hs-ease);
  }

  .hs__go span {
    margin-inline-end: 0.15rem;
    font-variant-numeric: tabular-nums;
  }

  .hs__go:hover {
    color: var(--ink);
  }

  .hs__go[aria-current] {
    border-color: var(--ink);
    color: var(--ink);
    font-weight: 500;
  }

  .hs__go:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .hs__head h2 {
    margin-top: var(--s-3);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 3rem);
  }

  .hs__steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hs__step {
    min-height: var(--hs-step);
    color: var(--ink);
  }

  /* The last step stays pinned for a whole screen, so the result is read before the hotel lets go */
  .hs__step:last-child {
    min-height: calc(var(--hs-step) + 100svh - var(--hs-pin));
  }

  /* The text of a step arrives with the camera (--arrive is set by the script); other steps wait, faded */
  .hs__step > div {
    position: sticky;
    top: var(--hs-pin);
    padding-block: var(--s-2) var(--s-4);
  }

  .hs.is-live .hs__step > div {
    opacity: var(--arrive, 1);
  }

  .hs__step h3 {
    font-size: clamp(1.5rem, 1.25rem + 0.8vw, 2rem);
    font-weight: 300;
  }

  .hs__tag {
    margin-bottom: 0.3rem;
    color: var(--text-3);
    font-size: var(--fs-small);
  }

  .hs__tag--on {
    color: inherit;
    font-weight: 500;
  }

  .hs__problem {
    margin-top: var(--s-3);
    font-size: 1.125rem;
    line-height: 1.45;
  }

  /* What Tyll does about it, as one quiet card */
  .hs__fix {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: var(--s-3);
    padding: var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--sand-50);
    box-shadow: var(--shadow-1);
  }

  .hs__fix ul {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    margin: 0.25rem 0 0;
    padding: 0;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.4;
    list-style: none;
  }

  .hs__fix li {
    position: relative;
    padding-inline-start: 1.4rem;
  }

  .hs__fix li::before {
    position: absolute;
    inset-inline-start: 0.1rem;
    top: 0.4em;
    width: 0.65em;
    height: 0.35em;
    border-bottom: 1.5px solid currentColor;
    border-inline-start: 1.5px solid currentColor;
    content: '';
    transform: rotate(-45deg);
  }

  :global([dir='rtl']) .hs__fix li::before {
    transform: rotate(45deg);
  }

  .hs__more {
    margin-top: var(--s-3);
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-size: 1.0625rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .hs__cta {
    margin-top: var(--s-3);
  }

  /* ── Scene: a fixed frame the camera moves inside ── */
  .hs__scene {
    position: sticky;
    top: var(--header-h);
    align-self: start;
    height: calc(100svh - var(--header-h));
    min-width: 0;
  }

  .hs__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hs__layer {
    position: absolute;
    inset: 0;
    will-change: transform, opacity;
  }

  /* The page fades into the photographs along their left edge and their top; the callouts stay crisp */
  .hs__layer {
    -webkit-mask-image: linear-gradient(90deg, transparent 0, var(--black) 24%), linear-gradient(180deg, transparent 0, var(--black) 12%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0, var(--black) 24%), linear-gradient(180deg, transparent 0, var(--black) 12%);
    mask-composite: intersect;
  }

  /* In Arabic the photograph sits on the left, so it fades on its right, towards the text */
  :global([dir='rtl']) .hs__layer {
    -webkit-mask-image: linear-gradient(270deg, transparent 0, var(--black) 24%), linear-gradient(180deg, transparent 0, var(--black) 12%);
    mask-image: linear-gradient(270deg, transparent 0, var(--black) 24%), linear-gradient(180deg, transparent 0, var(--black) 12%);
  }

  .hs__stage :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hs__stage :global(.hs__img) {
    display: block;
    width: 100%;
    height: 100%;
    /* The script places the callouts on the same crop: keep this position in step with `measure()` */
    object-fit: cover;
    object-position: 70% 100%;
  }

  /* Later in the evening: the sky deepens and the lit floors warm up, over the same photograph */
  .hs__late {
    position: absolute;
    inset: 0;
    opacity: var(--late, 0);
  }

  .hs__late--sky {
    background: linear-gradient(180deg, rgb(58 48 104 / 0.55) 0%, rgb(58 48 104 / 0.18) 34%, rgb(58 48 104 / 0) 52%);
    mix-blend-mode: multiply;
  }

  .hs__late--windows {
    background: radial-gradient(62% 42% at 56% 70%, rgb(var(--amber-glow-rgb) / 0.42), rgb(var(--amber-glow-rgb) / 0) 72%);
    mix-blend-mode: screen;
  }

  .hs__layer--view :global(.hs__img) {
    object-position: 50% 50%;
  }

  /* The camera: the hotel scales about the point the script chooses (--px, --py in the stage), so that point holds still */
  .hs__layer--hotel {
    transform: translate(calc((1 - var(--s, 1)) * var(--px, 0px)), calc((1 - var(--s, 1)) * var(--py, 0px))) scale(var(--s, 1));
    transform-origin: 0 0;
  }

  /* A room: it fades in as the camera arrives and drifts a little while it is read */
  .hs__layer--view {
    opacity: 0;
    transform-origin: 50% 50%;
  }

  .hs__layer--view[data-hs-view='1'] {
    opacity: var(--o1, 0);
    transform: scale(var(--push1, 1));
  }

  .hs__layer--view[data-hs-view='2'] {
    opacity: var(--o2, 0);
    transform: scale(var(--push2, 1));
  }

  /* Each photograph's own frame inside the stage (the script measures the crop), carrying its markers */
  .hs__marks,
  .hs__spots {
    position: absolute;
    left: var(--img-x, 0);
    top: var(--img-y, 0);
    width: var(--img-w, 100%);
    height: var(--img-h, 100%);
    pointer-events: none;
  }

  .hs__marks {
    opacity: var(--marks, 0);
  }

  .hs__spots {
    opacity: var(--spots, 1);
  }

  /* The result: a warm light on the entrance, and the systems joined to Tyll */
  .hs__glow {
    position: absolute;
    left: 53.5%;
    top: 80%;
    width: 34%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(var(--amber-glow-rgb) / 0.55), rgb(var(--amber-glow-rgb) / 0) 72%);
    opacity: var(--glow, 0);
    transform: translate(-50%, -50%);
    mix-blend-mode: screen;
  }

  .hs__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Each line is one unit long (pathLength) and draws itself as --links rises; hidden entirely before that */
  .hs__links line {
    stroke: rgb(var(--paper-rgb) / 0.9);
    stroke-width: 1;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc((1 - var(--links, 0)) * 1px);
    opacity: min(1, calc(var(--links, 0) * 4));
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 1px rgb(var(--ink-rgb) / 0.5));
  }

  .hs__hub {
    position: absolute;
    left: var(--hub-x);
    top: var(--hub-y);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-2);
    opacity: var(--links, 0);
    transform: translate(-50%, -50%) scale(calc(0.85 + 0.15 * var(--links, 0)));
  }

  .hs__hub :global(svg) {
    width: 20px;
    height: 20px;
  }

  .hs:not(.is-live) .hs__glow,
  .hs:not(.is-live) .hs__hub {
    opacity: 1;
  }

  .hs:not(.is-live) .hs__links line {
    stroke-dashoffset: 0;
  }

  /* Callouts pinned to a point in a photograph */
  .hs__spot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
  }

  .hs__dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 2px solid var(--paper);
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 1px rgb(var(--ink-rgb) / 0.2);
    transform: translate(-50%, -50%);
  }

  .hs__line {
    position: absolute;
    background: rgb(var(--paper-rgb) / 0.85);
    box-shadow: 0 0 0 0.5px rgb(var(--ink-rgb) / 0.35);
  }

  .hs__card {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    box-shadow: var(--shadow-1);
    opacity: 0.78;
    transition:
      opacity var(--hs-ease),
      color var(--hs-ease),
      box-shadow var(--hs-ease);
  }

  .hs__card :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
  }

  .hs__spot[data-side='start'] .hs__line {
    right: 6px;
    top: -0.5px;
    width: 56px;
    height: 1px;
  }

  .hs__spot[data-side='start'] .hs__card {
    right: 62px;
    top: 0;
    transform: translateY(-50%);
  }

  .hs__spot[data-side='end'] .hs__line {
    left: 6px;
    top: -0.5px;
    width: 56px;
    height: 1px;
  }

  .hs__spot[data-side='end'] .hs__card {
    left: 62px;
    top: 0;
    transform: translateY(-50%);
  }

  .hs__spot[data-side='up'] .hs__line {
    left: -0.5px;
    bottom: 6px;
    width: 1px;
    height: 48px;
  }

  .hs__spot[data-side='up'] .hs__card {
    left: 0;
    bottom: 54px;
    transform: translateX(-50%);
  }

  .hs__spot.is-on .hs__card,
  .hs:not(.is-live) .hs__card {
    color: var(--ink);
    opacity: 1;
    box-shadow: var(--shadow-2);
  }

  .hs__spot.is-on .hs__dot {
    box-shadow: 0 0 0 4px rgb(var(--ink-rgb) / 0.14);
  }

  /* Phones: pills along the bottom of the frame instead of the pinned callouts */
  .hs__pills {
    position: absolute;
    inset: auto var(--s-2) var(--s-2);
    display: none;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    opacity: var(--spots, 1);
  }

  .hs__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    color: var(--steel);
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.2;
    box-shadow: var(--shadow-1);
    opacity: 0.8;
  }

  .hs__pill :global(svg) {
    width: 14px;
    height: 14px;
  }

  .hs__pill.is-on,
  .hs:not(.is-live) .hs__pill {
    color: var(--ink);
    opacity: 1;
  }

  /* ── Tablets and phones: the heading and the steps, the frame pinned at the top (4:3), the text beneath ── */
  @media (max-width: 1000px) {
    .hs {
      --hs-step: 75svh;
      --hs-pin: calc(var(--header-h) + var(--hs-frame, 60vw) + 1rem);
    }

    .hs__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-inline: var(--gut);
    }

    .hs__text {
      display: contents;
    }

    .hs__head {
      position: static;
      display: flex;
      flex-direction: column-reverse;
      order: 1;
      padding-block: var(--s-5) var(--s-3);
    }

    .hs__head::after {
      display: none;
    }

    .hs__head h2 {
      margin: 0 0 var(--s-3);
    }

    .hs__scene {
      order: 2;
      z-index: 1;
      height: auto;
      aspect-ratio: 4 / 3;
      max-height: calc(100svh - var(--header-h) - 8rem);
    }

    .hs__stage {
      border-radius: var(--radius-md);
    }

    .hs__layer,
    :global([dir='rtl']) .hs__layer {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hs__steps {
      order: 3;
    }

    .hs__step:last-child {
      min-height: 0;
      padding-bottom: var(--s-5);
    }

    .hs__step > div {
      position: static;
      padding-block: var(--s-3) var(--s-2);
    }
  }

  @media (max-width: 700px) {
    .hs__spots .hs__spot {
      display: none;
    }

    .hs__pills {
      display: flex;
    }

    .hs__card {
      padding: 0.45rem 0.7rem;
      font-size: var(--fs-caption);
    }

    .hs__hub {
      width: 36px;
      height: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs__go,
    .hs__card {
      transition: none;
    }
  }
</style>

<script>
  // The position of the text decides everything: `b` runs from 0 to 4 across the four steps. From it come the step
  // being read, the camera (scale and the point it holds still), which photograph shows, the callouts and the lines.
  const root = document.querySelector<HTMLElement>('[data-hs]');
  if (root) {
    const head = root.querySelector<HTMLElement>('[data-hs-head]')!;
    const scene = root.querySelector<HTMLElement>('.hs__scene')!;
    const stage = root.querySelector<HTMLElement>('[data-hs-stage]')!;
    const stepsBox = root.querySelector<HTMLElement>('[data-hs-steps]')!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-hs-step]')];
    const firstText = steps[0].firstElementChild as HTMLElement;
    const goes = [...root.querySelectorAll<HTMLButtonElement>('[data-hs-go]')];
    const spots = [...root.querySelectorAll<HTMLElement>('[data-hs-spot]')];
    const pills = [...root.querySelectorAll<HTMLElement>('[data-hs-pill]')];
    const views = [...root.querySelectorAll<HTMLElement>('[data-hs-view]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = matchMedia('(max-width: 1000px)');
    const ratio = parseFloat(getComputedStyle(root).getPropertyValue('--hs-ratio')) || 1.5;
    const last = steps.length - 1;
    const point = (name: string) => (root.dataset[name] ?? '50 50').split(' ').map(Number) as [number, number];
    const doors = point('doors');
    const service = point('service');

    const clamp01 = (n: number) => Math.max(0, Math.min(1, n));
    const smooth = (n: number) => n * n * (3 - 2 * n);
    const seg = (b: number, from: number, to: number) => smooth(clamp01((b - from) / (to - from)));
    const lerp = (a: number, c: number, k: number) => a + (c - a) * k;

    // A step's text pins at `pin`; on phones it passes beneath the pinned frame instead. The step counts as the current
    // one once its text is on its way up.
    let pin = 0;
    let stepH = 1;
    let tops: number[] = [];
    let heights: number[] = [];
    let lead = 0.12;
    let img = { x: 0, y: 0, w: 1, h: 1 };
    const cover = (r: number, px: number, py: number) => {
      const sw = stage.clientWidth || 1;
      const sh = stage.clientHeight || 1;
      const w = sw / sh > r ? sw : sh * r;
      const h = sw / sh > r ? sw / r : sh;
      return { x: (sw - w) * px, y: (sh - h) * py, w, h };
    };
    const frame = (el: HTMLElement, f: { x: number; y: number; w: number; h: number }) => {
      el.style.setProperty('--img-x', `${f.x}px`);
      el.style.setProperty('--img-y', `${f.y}px`);
      el.style.setProperty('--img-w', `${f.w}px`);
      el.style.setProperty('--img-h', `${f.h}px`);
    };
    const measure = () => {
      root.style.setProperty('--hs-head', `${head.offsetHeight}px`);
      root.style.setProperty('--hs-frame', `${scene.offsetHeight}px`);
      const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;
      pin = narrow.matches ? headerH + scene.offsetHeight + 16 : parseFloat(getComputedStyle(firstText).top) || headerH;
      stepH = steps[0].offsetHeight || 1;
      const start = stepsBox.getBoundingClientRect().top;
      tops = steps.map((step) => step.getBoundingClientRect().top - start);
      heights = steps.map((step) => step.offsetHeight);
      lead = Math.max(0.08, Math.min(0.2, (firstText.offsetHeight * 0.35) / stepH));
      root.dataset.hsPin = String(pin);
      root.dataset.hsLead = lead.toFixed(3);
      // Each photograph's frame inside the stage, as object-fit: cover crops it (the hotel at 70% 100%, rooms centred)
      img = cover(ratio, 0.7, 1);
      frame(stage, img);
      views.forEach((view) => frame(view, cover(parseFloat(view.style.getPropertyValue('--ratio')) || 1.5, 0.5, 0.5)));
    };
    const position = () => {
      // Steps can differ in length, so each one counts as 1 however long it is. The last runs on at the normal rate.
      const y = pin - stepsBox.getBoundingClientRect().top;
      if (y <= 0) return y / stepH + lead;
      let i = last;
      while (i > 0 && y < tops[i]) i--;
      return i + (y - tops[i]) / (i === last ? stepH : heights[i]) + lead;
    };

    // The choreography, in units of `b`. Each move is eased over its range.
    const ZOOM = () => (narrow.matches ? 1.9 : 2.4);
    const render = (b: number) => {
      const active = Math.max(0, Math.min(last, Math.floor(b)));
      steps.forEach((step, i) => {
        step.classList.toggle('is-active', i === active);
        // The words of a step arrive with its camera move; the others wait, faded
        const arrive = i !== active ? 0.45 : i === 0 ? 1 : 0.45 + 0.55 * seg(b, i - 0.1, i + 0.15);
        step.style.setProperty('--arrive', arrive.toFixed(3));
      });
      goes.forEach((go, i) => (i === active ? go.setAttribute('aria-current', 'step') : go.removeAttribute('aria-current')));
      const lit = (i: number) => i === active || active === last;
      spots.forEach((spot, i) => spot.classList.toggle('is-on', lit(i)));
      pills.forEach((pill, i) => pill.classList.toggle('is-on', lit(i)));
      root.dataset.hsB = b.toFixed(2);

      // Camera: in to the doors (0.72–1.0), out again (1.68–1.86), across to the service entrance while at rest
      // (1.86–1.9), in (1.9–2.1), out for good (2.72–3.1)
      const k1 = clamp01(seg(b, 0.72, 1.0) - seg(b, 1.68, 1.86));
      const k2 = clamp01(seg(b, 1.9, 2.1) - seg(b, 2.72, 3.1));
      const k = reduce.matches ? 0 : clamp01(k1 + k2);
      const w = seg(b, 1.86, 1.9);
      const fx = lerp(doors[0], service[0], w);
      const fy = lerp(doors[1], service[1], w);
      const set = (name: string, value: string) => stage.style.setProperty(name, value);
      set('--s', (1 + (ZOOM() - 1) * k).toFixed(4));
      set('--px', `${(img.x + (img.w * fx) / 100).toFixed(1)}px`);
      set('--py', `${(img.y + (img.h * fy) / 100).toFixed(1)}px`);

      // The rooms: the kitchen as the doors fill the frame, the storeroom as the service entrance does
      const o1 = clamp01(seg(b, 0.9, 1.05) - seg(b, 1.65, 1.78));
      const o2 = clamp01(seg(b, 2.02, 2.14) - seg(b, 2.7, 2.85));
      set('--o1', o1.toFixed(3));
      set('--o2', o2.toFixed(3));
      const drift = (from: number) => (reduce.matches ? 1 : 1 + 0.06 * clamp01((b - from) / 0.85));
      set('--push1', drift(0.95).toFixed(4));
      set('--push2', drift(2.0).toFixed(4));
      views[0]?.style.setProperty('--marks', (seg(b, 1.08, 1.2) * (1 - seg(b, 1.6, 1.68))).toFixed(3));
      views[1]?.style.setProperty('--marks', (seg(b, 2.14, 2.26) * (1 - seg(b, 2.65, 2.72))).toFixed(3));

      // The façade's callouts hide while the camera is inside; the result lights everything and joins it to Tyll
      set('--spots', clamp01(1 - seg(b, 0.6, 0.85) + seg(b, 3.05, 3.3)).toFixed(3));
      set('--late', seg(b, 3.0, 3.35).toFixed(3));
      set('--links', seg(b, 3.25, 3.65).toFixed(3));
      set('--glow', seg(b, 3.3, 3.7).toFixed(3));
    };

    let ticking = false;
    const follow = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        render(position());
      });
    };

    // The progress buttons take the reader to a step
    goes.forEach((go, i) => {
      go.addEventListener('click', () => {
        const top = stepsBox.getBoundingClientRect().top + scrollY + tops[i] - pin + 2;
        scrollTo({ top, behavior: reduce.matches ? 'instant' : 'smooth' });
      });
    });

    root.classList.add('is-live');
    measure();
    render(position());
    addEventListener('scroll', follow, { passive: true });
    addEventListener('resize', () => {
      measure();
      render(position());
    });
    document.fonts?.ready.then(() => {
      measure();
      render(position());
    });
  }
</script>
