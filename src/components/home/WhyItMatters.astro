---
// "Why it matters, in two numbers": two sourced findings on one panel, read as a pair. 10+ counts up as the systems
// a hotel runs appear as a row of plain tags; then $7 counts up beside a photograph of a chef weighing and logging
// kitchen waste, the second only after
// the first, so the eye is led across both. Industry research, never a Tyll result. Under the panel, the same systems
// are drawn joined to Tyll. The page's HTML is the final frame, so without JavaScript or with reduced motion both
// numbers are simply there. The system names only illustrate.
import { Picture } from 'astro:assets';
import SystemsDiagram from './SystemsDiagram.astro';
import waste from '../../assets/photos/why-waste.jpg';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const w = t(lang).home.why;
const parts = (figure: string) => {
  const [, before = '', count = figure, after = ''] = figure.match(/^(\D*)(\d+)(.*)$/) ?? [];
  return { before, count, after };
};
const one = parts(w.figure);
const two = parts(w.second.figure);
---

<section class="why" aria-labelledby="why-title" data-why>
  <div class="wrap">
    <h2 id="why-title" class="display why__title">{w.heading}</h2>
    <div class="why__panel">
      <article class="stat" data-stat>
        <div class="stat__top">
          <p class="stat__number" aria-hidden="true"><bdi dir="ltr"><span data-count={one.count}>{one.count}</span>{one.after}</bdi></p>
          <ul class="tags" aria-hidden="true">
            {w.systems.map((name, i) => <li style={`--i:${i}`}>{name}</li>)}
            <li class="tags__more" style="--i:10">+</li>
          </ul>
        </div>
        <h3 class="display stat__title"><span class="visually-hidden">{w.figure} </span>{w.title}</h3>
        <p class="stat__text">{w.text}</p>
        <p class="stat__source">
          {w.source}:{' '}
          <a href={w.sourceUrl} target="_blank" rel="noopener">{w.sourceName}</a>
        </p>
      </article>

      <article class="stat stat--money" data-stat>
        <div class="stat__photo" aria-hidden="true">
          <Picture src={waste} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 720, 1080, 1402]} sizes="(max-width: 960px) 100vw, 28vw" loading="lazy" decoding="async" />
        </div>
        <div class="stat__body">
          <p class="stat__number" aria-hidden="true"><bdi dir="ltr">{two.before}<span data-count={two.count}>{two.count}</span>{two.after}</bdi></p>
          <h3 class="display stat__title"><span class="visually-hidden">{w.second.figure} </span>{w.second.title}</h3>
          <p class="stat__text">{w.second.text}</p>
          <p class="stat__source">
            {w.source}:{' '}
            <a href={w.second.sourceUrl} target="_blank" rel="noopener">{w.second.sourceName}</a>
          </p>
        </div>
      </article>
    </div>

    <div class="why__systems">
      <SystemsDiagram systems={w.systems} label={`${w.figure} ${w.title}`} />
    </div>
  </div>
</section>

<style>
  .why {
    padding-block: var(--section-y);
    background: var(--page);
    color: var(--text-1);
  }

  .why__title {
    font-size: var(--fs-h2);
    text-align: center;
  }

  /* One panel, so the two read as one thought: two equal columns and a fine line between them */
  .why__panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--s-5);
    border: 1px solid var(--sand-300);
    border-radius: var(--radius-lg);
    background: var(--sand-50);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }

  .stat {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--s-5);
  }

  .stat + .stat {
    border-inline-start: 1px solid var(--sand-300);
  }

  .stat__top {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 9.5rem;
  }

  .stat__number {
    flex: none;
    max-width: none;
    margin: 0;
    color: var(--text-1);
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 4.4vw, 7.5rem);
    letter-spacing: 0;
    line-height: 0.95;
  }

  /* Two lines kept for each title, so the sentences under the two numbers start level */
  .stat__title {
    min-height: 2.28em;
    margin-top: var(--s-3);
    font-size: clamp(1.625rem, 1.4rem + 0.7vw, 2.125rem);
    letter-spacing: 0;
    line-height: 1.14;
  }

  .stat__text {
    margin-top: var(--s-2);
    color: var(--text-2);
  }

  .stat__source {
    margin-top: auto;
    padding-top: var(--s-3);
    color: var(--text-3);
    font-size: var(--fs-caption);
  }

  .stat__source a {
    text-underline-offset: 3px;
  }

  .stat__source a:hover {
    color: var(--text-1);
  }

  /* The systems as plain tags of one height, in neat rows */
  .tags {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-content: center;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    display: inline-flex;
    align-items: center;
    height: 2.125rem;
    padding: 0 0.9rem;
    border: 1px solid var(--sand-400);
    border-radius: 999px;
    background: var(--paper);
    color: var(--graphite);
    font-size: var(--fs-small);
    line-height: 1;
    white-space: nowrap;
    transition:
      opacity 0.3s var(--ease),
      transform 0.45s var(--ease);
    transition-delay: calc(var(--i) * 60ms);
  }

  .tags .tags__more {
    justify-content: center;
    width: 2.125rem;
    padding: 0;
    color: var(--steel);
  }

  .stat.is-waiting .tags li {
    opacity: 0;
    transform: translateY(6px);
    transition: none;
  }

  /* The photograph on the right of the card, running to its edge, the card's own colour fading into it */
  .stat--money {
    position: relative;
  }

  .stat__photo {
    position: absolute;
    inset: 0 0 0 auto;
    width: 46%;
    pointer-events: none;
  }

  .stat__photo :global(picture),
  .stat__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .stat__photo :global(img) {
    object-fit: cover;
    object-position: 72% 50%;
  }

  .stat__photo::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--sand-50) 0%, rgb(251 251 250 / 0) 46%);
    content: '';
  }

  .stat__body {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    max-width: 58%;
  }

  .stat__body .stat__number {
    display: flex;
    align-items: center;
    min-height: 9.5rem;
  }

  @media (max-width: 960px) {
    .why__panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .stat {
      padding: var(--s-4) var(--s-3);
    }

    .stat + .stat {
      border-inline-start: 0;
      border-top: 1px solid var(--sand-300);
    }

    .stat__top {
      min-height: 0;
    }

    .stat__title {
      min-height: 0;
    }

    /* On one column the photograph sits above the number, full width */
    .stat__photo {
      position: relative;
      inset: auto;
      width: calc(100% + 2 * var(--s-3));
      height: 15rem;
      margin: calc(-1 * var(--s-4)) calc(-1 * var(--s-3)) var(--s-3);
    }

    .stat__photo::after {
      background: linear-gradient(180deg, rgb(251 251 250 / 0) 55%, var(--sand-50) 100%);
    }

    .stat__body {
      max-width: none;
    }

    .stat__body .stat__number {
      min-height: 0;
    }
  }

  /* On a phone each number gets the full width, with its tags beneath it */
  @media (max-width: 560px) {
    .stat__top {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
    }

    .tags {
      flex: none;
      width: 100%;
    }
  }

  /* The systems joined to Tyll, a little narrower than the panel and with room to breathe above it */
  .why__systems {
    max-width: 1080px;
    margin: var(--s-7) auto 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .tags li {
      transition: none;
    }
  }
</style>

<script>
  // Both numbers play once: the first when it comes into view, the second after it and when it is in view too. While
  // counting, a number keeps the width of its final value, so nothing beside it moves.
  const root = document.querySelector<HTMLElement>('[data-why]');
  if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const [first, second] = [...root.querySelectorAll<HTMLElement>('[data-stat]')];

    const prepare = (stat: HTMLElement) => {
      stat.classList.add('is-waiting');
      const el = stat.querySelector<HTMLElement>('[data-count]')!;
      el.textContent = '1';
    };

    const play = (stat: HTMLElement, ms: number) => {
      const el = stat.querySelector<HTMLElement>('[data-count]')!;
      const target = Number(el.dataset.count);
      el.textContent = String(target);
      Object.assign(el.style, { display: 'inline-block', width: `${el.getBoundingClientRect().width}px`, textAlign: 'right' });
      el.textContent = '1';
      stat.classList.remove('is-waiting');
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / ms);
        el.textContent = String(Math.max(1, Math.round(1 + (1 - (1 - p) ** 2) * (target - 1))));
        if (p < 1) requestAnimationFrame(step);
        else el.removeAttribute('style');
      };
      requestAnimationFrame(step);
    };

    prepare(first);
    prepare(second);

    let firstDone = false;
    let secondSeen = false;
    const playSecond = () => {
      if (firstDone && secondSeen) {
        play(second, 1200);
        secondSeen = false;
        firstDone = false;
      }
    };

    const seeFirst = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        seeFirst.disconnect();
        play(first, 1000);
        setTimeout(() => {
          firstDone = true;
          playSecond();
        }, 1300);
      },
      { threshold: 0.35 },
    );
    seeFirst.observe(first);

    const seeSecond = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        seeSecond.disconnect();
        secondSeen = true;
        playSecond();
      },
      { threshold: 0.35 },
    );
    seeSecond.observe(second);
  }
</script>
