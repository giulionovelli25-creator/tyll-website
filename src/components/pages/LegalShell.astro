---
// Shared frame for the Legal Notice and Privacy pages: title, the "incomplete" notice listing required
// details that are still missing, and readable long-form text styles.
import { legal, legalMissing } from '../../config/legal';
import { t, intlLocale, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  title: string;
  /** List the page's sections under "On this page" (used on the long privacy policy). */
  toc?: boolean;
}

const { lang, title, toc = false } = Astro.props;
// The contents list is read from the rendered sections, so it always matches the sections that are actually shown.
const body = await Astro.slots.render('default');
const sections = toc
  ? [...body.matchAll(/<h2 id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map(([, id, html]) => ({
      id,
      html: html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim(),
    }))
  : [];
const onThisPage = { en: 'On this page', de: 'Auf dieser Seite', ar: 'في هذه الصفحة', it: 'In questa pagina' }[lang];
const d = t(lang).legalPage;
const missing = legalMissing();
const updated = new Intl.DateTimeFormat(intlLocale[lang], { dateStyle: 'long' }).format(new Date(legal.updated));
---

<article class="wrap legal">
  <header>
    <h1>{title}</h1>
    <p class="legal__meta">{d.updated}: {updated}. {d.review}</p>
  </header>

  {
    missing.length > 0 && (
      <aside class="legal__missing" role="note">
        <h2>{d.incompleteTitle}</h2>
        <p>{d.incompleteText}</p>
        <ul>
          {missing.map((m) => (
            <li>{m[lang]}</li>
          ))}
        </ul>
      </aside>
    )
  }

  {
    sections.length > 0 && (
      <nav class="legal__toc" aria-labelledby="legal-toc-title">
        <h2 id="legal-toc-title">{onThisPage}</h2>
        <ol>
          {sections.map((x) => (
            <li>
              <a href={`#${x.id}`} set:html={x.html} />
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <div class="legal__body" set:html={body} />
</article>

<style>
  .legal {
    max-width: calc(46rem + var(--gut) * 2);
    margin-inline: 0;
    padding-top: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 6rem));
    padding-bottom: var(--section-y);
  }

  @media (min-width: 1100px) {
    .legal {
      margin-inline-start: max(0px, calc((100vw - var(--wrap)) / 2 - var(--gut)));
    }
  }

  h1 {
    font-size: var(--fs-h2);
  }

  .legal__meta {
    margin-top: 1rem;
    color: var(--steel);
    font-size: var(--fs-small);
  }

  .legal__missing {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid #e3c98f;
    border-radius: var(--radius-sm);
    background: #fbf5e7;
    color: #5c430e;
    font-size: 0.9375rem;
  }

  .legal__missing h2 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .legal__missing p {
    margin-top: 0.4rem;
  }

  .legal__missing ul {
    margin: 0.6rem 0 0;
    padding-inline-start: 1.2rem;
  }

  .legal__toc {
    margin-top: 2.5rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .legal__toc h2 {
    color: var(--steel);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .legal__toc ol {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    columns: 2 16rem;
    column-gap: 2.5rem;
  }

  .legal__toc li {
    break-inside: avoid;
    padding-block: 0.2rem;
  }

  .legal__toc a {
    color: var(--graphite);
    text-decoration: none;
  }

  .legal__toc a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal__body :global(h2[id]) {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .legal__body {
    margin-top: 2.5rem;
    color: var(--graphite);
    line-height: 1.7;
  }

  .legal__body :global(h2) {
    margin-top: 2.75rem;
    color: var(--ink);
    font-size: 1.375rem;
    font-weight: 450;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .legal__body :global(h3) {
    margin-top: 1.75rem;
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .legal__body :global(p),
  .legal__body :global(ul),
  .legal__body :global(address) {
    margin-top: 0.85rem;
  }

  .legal__body :global(address) {
    font-style: normal;
  }

  .legal__body :global(ul) {
    padding-inline-start: 1.2rem;
  }

  .legal__body :global(li + li) {
    margin-top: 0.35rem;
  }

  .legal__body :global(a) {
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .legal__body :global(.missing) {
    padding: 0.05em 0.35em;
    border-radius: 4px;
    background: #fbf0d6;
    color: #6b4d0f;
    font-size: 0.9375em;
  }
</style>
