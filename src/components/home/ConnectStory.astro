---
// Homepage chapter 2: "Before Tyll → With Tyll", driven by scroll.
// Four fragments from different hotel systems sit scattered across a silver stage. As the visitor scrolls,
// the two related ones (a POS order and a stock difference) are linked, everything moves together, and the
// scene settles into one Tyll view: one coherent stock issue with its evidence, owner and next step, and the
// other matters listed as separate tasks. Scrolling back reverses it.
// Without JavaScript or with reduced motion, both states are shown as two still pictures.
import Logo from '../Logo.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = t(lang).home.problem;
const f = p.frags;
const v = p.view;
---

<section class="story" id="story" aria-labelledby="story-title" data-story>
  <div class="wrap story__grid">
    <header class="story__head">
      <h2 id="story-title">{p.title}</h2>
      <p>{p.text}</p>
      <p class="story__note">{p.note}</p>
    </header>

    <div class="story__track">
      <div class="story__sticky">
        <div class="scene">
          <!-- The two stage messages; they cross over as the scene changes -->
          <div class="labels">
            <p class="label label--before">
              <span class="label__kicker">{p.beforeLabel}</span>
              <span class="label__msg">{p.before}</span>
            </p>
            <p class="label label--after" data-check-manual>
              <span class="label__kicker">
                <Logo mark anim="draw" label="" class="label__tick" />
                {p.afterLabel}
              </span>
              <span class="label__msg">{p.after}</span>
            </p>
          </div>

          <div class="stage">
            <div class="stage__waves stage__waves--a" aria-hidden="true"></div>
            <div class="stage__waves stage__waves--b" aria-hidden="true"></div>

            <!-- Before: fragments from five systems -->
            <ul class="frags" aria-label={p.before}>
              <li class="frag frag--pos" data-frag="issue">
                <span class="frag__sys"><i aria-hidden="true"></i>{f.pos.sys}</span>
                <span class="frag__title">{f.pos.title}</span>
                <span class="frag__row frag__row--struck" data-anchor="pos"><span>{f.pos.rows[0][0]}</span><span>{f.pos.rows[0][1]}</span></span>
                <span class="frag__flag">{f.pos.flag}</span>
              </li>
              <li class="frag frag--stock" data-frag="issue">
                <span class="frag__sys"><i aria-hidden="true"></i>{f.stock.sys}</span>
                <span class="frag__title">{f.stock.title}</span>
                <span class="frag__table" data-anchor="stock">
                  <span>{f.stock.head[0]}</span><span>{f.stock.head[1]}</span><span>{f.stock.head[2]}</span>
                  <span></span><b>{f.stock.vals[1]}</b><b>{f.stock.vals[2]}</b>
                </span>
                <span class="frag__flag frag__flag--amber">{f.stock.flag}</span>
              </li>
              <li class="frag frag--pms" data-frag="task-0">
                <span class="frag__sys"><i aria-hidden="true"></i>{f.pms.sys}</span>
                <span class="frag__title">{f.pms.title}</span>
                <span class="frag__line"><span class="frag__chip">{f.pms.status}</span>{f.pms.line}</span>
              </li>
              <li class="frag frag--finance" data-frag="task-1">
                <span class="frag__sys"><i aria-hidden="true"></i>{f.finance.sys}</span>
                <span class="frag__title">{f.finance.title}</span>
                <span class="frag__row"><span>{f.finance.rows[0][0]}</span><b>{f.finance.rows[0][1]}</b></span>
                <span class="frag__row"><span>{f.finance.rows[1][0]}</span><b>{f.finance.rows[1][1]}</b></span>
                <span class="frag__flag">{f.finance.flag}</span>
              </li>
            </ul>

            <!-- The two related fragments are the same story: drawn as a quiet link once scrolling starts -->
            <svg class="link" aria-hidden="true"><path d=""></path><circle r="3"></circle><circle r="3"></circle></svg>

            <!-- With Tyll: one view, one coherent issue, separate tasks -->
            <div class="view" aria-label={p.after}>
              <div class="view__bar">
                <Logo mark label="" class="view__mark" />
                <span>Tyll</span>
                <span class="view__place">{v.place}</span>
              </div>
              <div class="view__body">
                <p class="view__heading">{v.attention} <span>{v.tasks.length + 1}</span></p>
                <article class="issue" data-target="issue">
                  <span class="issue__status">{v.status}</span>
                  <h3>{v.issue}</h3>
                  <p class="issue__line">{v.issueLine}</p>
                  <ul class="issue__evidence">
                    {
                      v.evidence.map((e) => (
                        <li>
                          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.4 6.6 11.3 12.5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                          {e}
                        </li>
                      ))
                    }
                  </ul>
                  <div class="issue__foot">
                    <p class="issue__owner"><span>{v.owner}</span>{v.ownerName}</p>
                    <span class="issue__next">{v.next} {lang === 'ar' ? '←' : '→'}</span>
                  </div>
                  <p class="issue__caution">{v.caution}</p>
                </article>
                <ul class="tasks">
                  {
                    v.tasks.map((task, i) => (
                      <li class="task" data-target={`task-${i}`}>
                        <span class="task__title">{task.title}</span>
                        <span class="task__team">{task.team}</span>
                        <span class="task__status">{task.status}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    background: var(--paper);
  }

  /* ── Static layout (no JavaScript, or reduced motion): two pictures, before and after ── */
  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.62fr);
    gap: 0 clamp(2rem, 1rem + 3vw, 4.5rem);
    padding-block: var(--section-y);
  }

  .story__head h2 {
    max-width: 12ch;
    font-size: var(--fs-h2);
  }

  .story__head > p:not(.story__note) {
    max-width: 30rem;
    margin-top: 1.25rem;
    color: var(--steel);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .story__note {
    max-width: 24rem;
    margin-top: 2rem;
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .scene {
    display: grid;
    gap: 1.5rem;
  }

  .labels {
    display: grid;
    gap: 1.5rem;
  }

  .label__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--graphite);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .label__kicker :global(.label__tick) {
    width: 18px;
    height: auto;
    color: var(--ink);
  }

  .label__msg {
    display: block;
    margin-top: 0.4rem;
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .stage {
    position: relative;
    border-radius: 26px;
    background:
      radial-gradient(90% 70% at 50% 45%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.5) 55%, transparent 80%),
      linear-gradient(180deg, #f6f7f9 0%, #eceef1 100%);
    box-shadow:
      inset 0 0 0 1px rgba(20, 22, 26, 0.05),
      0 50px 90px -60px rgba(20, 22, 26, 0.35);
    overflow: hidden;
    isolation: isolate;
  }

  /* Two layers of the Tyll waves: slightly apart at first, drawn together as the scene connects */
  .stage__waves {
    position: absolute;
    inset: -12%;
    z-index: -1;
    background: url('/media/tyll-waves.webp') center / cover no-repeat;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .stage__waves--a {
    opacity: 0.85;
    transform: translate(-3%, -2%) scale(1.06);
  }

  .stage__waves--b {
    opacity: 0.45;
    transform: translate(4%, 3%) scale(1.12) rotate(180deg);
    mix-blend-mode: multiply;
  }

  .frags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 1.5rem;
    list-style: none;
  }

  /* An interface fragment: system badge, title, a little real data */
  .frag {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid rgba(20, 22, 26, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow:
      0 1px 2px rgba(20, 22, 26, 0.06),
      0 22px 40px -26px rgba(20, 22, 26, 0.4);
    font-size: 0.875rem;
    line-height: 1.35;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  /* The two fragments that belong to the same story, while they are being linked */
  .frag.is-related {
    border-color: #e3c98f;
    box-shadow:
      0 0 0 3px rgba(227, 201, 143, 0.25),
      0 22px 40px -26px rgba(20, 22, 26, 0.4);
  }

  .frag {
    transition:
      border-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .frag__sys {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--steel);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Each system keeps a different quiet marker shape */
  .frag__sys i {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--graphite);
  }

  .frag--pos .frag__sys i {
    border-radius: 2px;
  }

  .frag--stock .frag__sys i {
    border-radius: 50%;
  }

  .frag--pms .frag__sys i {
    transform: rotate(45deg);
  }

  .frag--finance .frag__sys i {
    border-radius: 2px 50% 50% 2px;
  }

  .frag__title {
    font-weight: 500;
    color: var(--ink);
  }

  .frag__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }

  .frag__row--struck span {
    text-decoration: line-through;
    text-decoration-color: rgba(176, 53, 43, 0.7);
    color: var(--steel);
  }

  .frag__table {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0.15rem 1rem;
    color: var(--steel);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .frag__table b {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-align: end;
  }

  .frag__flag {
    justify-self: start;
    margin-top: 0.15rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--mist);
    color: var(--graphite);
    font-size: 0.75rem;
  }

  .frag--pos .frag__flag,
  .frag__flag--amber {
    background: #fbf2df;
    color: #7a4b08;
  }

  .frag__line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--graphite);
  }

  .frag__chip {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 0.75rem;
  }

  .link {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    overflow: visible;
    pointer-events: none;
  }

  .link path {
    fill: none;
    stroke: var(--graphite);
    stroke-width: 1.25;
  }

  .link circle {
    fill: var(--paper);
    stroke: var(--graphite);
    stroke-width: 1.5;
  }

  /* The Tyll view */
  .view {
    margin: 0 1.5rem 1.5rem;
    border: 1px solid rgba(20, 22, 26, 0.08);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow:
      0 1px 2px rgba(20, 22, 26, 0.05),
      0 60px 100px -50px rgba(20, 22, 26, 0.45);
    overflow: hidden;
  }

  .view__bar {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .view :global(.view__mark) {
    width: 16px;
    height: auto;
  }

  .view__place {
    margin-inline-start: auto;
    color: var(--steel);
    font-weight: 400;
    font-size: 0.8125rem;
  }

  .view__body {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 1.1rem 1.15rem;
  }

  .view__heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--graphite);
  }

  .view__heading span {
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.6875rem;
  }

  /* The one issue, with evidence, owner and next step */
  .issue {
    display: grid;
    gap: 0.45rem;
    padding: 1rem 1.1rem 1.05rem;
    border: 1px solid #e3c98f;
    border-radius: 14px;
    background: linear-gradient(180deg, #fffcf5 0%, #ffffff 70%);
  }

  .issue__status {
    justify-self: start;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: #fbf2df;
    color: #7a4b08;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .issue h3 {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .issue__line {
    color: var(--graphite);
    font-size: 0.875rem;
  }

  .issue__evidence {
    display: grid;
    gap: 0.3rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--graphite);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .issue__evidence li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 0.5rem;
  }

  .issue__evidence svg {
    width: 16px;
    height: 16px;
    color: #1b7a50;
  }

  .issue__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin-top: 0.35rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
  }

  .issue__owner {
    font-size: 0.8125rem;
  }

  .issue__owner span {
    display: block;
    color: var(--steel);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .issue__next {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .issue__caution {
    color: var(--steel);
    font-size: 0.75rem;
  }

  .tasks {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .task {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.8125rem;
  }

  .task + .task {
    border-top: 1px solid var(--line);
  }

  .task__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .task__team {
    color: var(--steel);
    font-size: 0.75rem;
  }

  .task__status {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--graphite);
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  /* Still pictures: Before label, fragments, With label, the Tyll view, in reading order */
  .story:not(.is-scrolly) .labels,
  .story:not(.is-scrolly) .stage {
    display: contents;
  }

  .story:not(.is-scrolly) .label--before {
    order: 1;
  }

  .story:not(.is-scrolly) .frags {
    order: 2;
    border-radius: 22px;
    background: linear-gradient(180deg, #f6f7f9 0%, #eceef1 100%);
  }

  .story:not(.is-scrolly) .label--after {
    order: 3;
    margin-top: 1rem;
  }

  .story:not(.is-scrolly) .view {
    order: 4;
    margin: 0;
  }

  .story:not(.is-scrolly) .stage__waves,
  .story:not(.is-scrolly) .link {
    display: none;
  }

  /* ── Scroll-driven layout (JavaScript, motion allowed) ── */
  .story.is-scrolly .story__grid {
    padding-block: 0;
    align-items: start;
  }

  .story.is-scrolly .story__head {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .story.is-scrolly .story__track {
    height: 290svh;
  }

  .story.is-scrolly .story__sticky {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    padding-block: clamp(1.25rem, 3vh, 2.5rem);
  }

  .story.is-scrolly .scene {
    width: 100%;
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr);
    gap: clamp(1rem, 2.4vh, 1.75rem);
  }

  .story.is-scrolly .labels {
    display: grid;
    grid-template-areas: 'label';
  }

  .story.is-scrolly .label {
    grid-area: label;
    will-change: opacity, transform;
  }

  .story.is-scrolly .stage {
    min-height: 0;
  }

  .story.is-scrolly .frags {
    display: block;
    padding: 0;
  }

  .story.is-scrolly .frag {
    position: absolute;
    width: min(290px, 42%);
  }

  /* Scattered positions across the stage */
  .story.is-scrolly .frag--pos {
    left: 6%;
    top: 12%;
    rotate: -2.5deg;
  }

  .story.is-scrolly .frag--stock {
    left: 54%;
    top: 8%;
    rotate: 2deg;
  }

  .story.is-scrolly .frag--pms {
    left: 52%;
    top: 58%;
    rotate: -1.5deg;
  }

  .story.is-scrolly .frag--finance {
    left: 9%;
    top: 55%;
    rotate: 1.5deg;
  }

  .story.is-scrolly .link {
    display: block;
  }

  .story.is-scrolly .view {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(560px, calc(100% - 2.5rem));
    margin: 0;
    translate: -50% -50%;
    scale: var(--fit, 1);
    will-change: opacity, transform;
  }

  /* Phones and narrow windows: the head scrolls past normally and only the scene is pinned */
  @media (max-width: 960px) {
    .story__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .story.is-scrolly .story__head {
      position: static;
      height: auto;
      padding-top: var(--section-y);
    }

    .story.is-scrolly .story__track {
      height: 260svh;
    }

    .story.is-scrolly .frag {
      width: min(320px, 80%);
      font-size: 0.8125rem;
    }

    .story.is-scrolly .frag--pos {
      left: 3%;
      top: 4%;
    }

    .story.is-scrolly .frag--stock {
      left: auto;
      right: 3%;
      top: 27%;
    }

    .story.is-scrolly .frag--pms {
      left: 5%;
      top: 54%;
    }

    .story.is-scrolly .frag--finance {
      left: auto;
      right: 4%;
      top: 74%;
    }

    .issue__caution {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .task {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.15rem 0.75rem;
    }

    .task__title {
      grid-column: 1 / -1;
      white-space: normal;
    }
  }

  @media (max-width: 960px) and (min-width: 600px) {
    .story.is-scrolly .frag {
      width: min(320px, 46%);
    }
  }
</style>

<script>
  import { drawCheck, hideCheck } from '../../scripts/checkmark';

  const section = document.querySelector<HTMLElement>('[data-story]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  if (section && !reduce.matches) {
    section.classList.add('is-scrolly');
    const track = section.querySelector<HTMLElement>('.story__track')!;
    const stage = section.querySelector<HTMLElement>('.stage')!;
    const view = section.querySelector<HTMLElement>('.view')!;
    const before = section.querySelector<HTMLElement>('.label--before')!;
    const after = section.querySelector<HTMLElement>('.label--after')!;
    const tick = section.querySelector<SVGSVGElement>('.label__tick')!;
    const wavesA = section.querySelector<HTMLElement>('.stage__waves--a')!;
    const wavesB = section.querySelector<HTMLElement>('.stage__waves--b')!;
    const link = section.querySelector<SVGSVGElement>('.link')!;
    const linkPath = link.querySelector('path')!;
    const [dotA, dotB] = [...link.querySelectorAll('circle')];
    const frags = [...section.querySelectorAll<HTMLElement>('[data-frag]')];
    const related = frags.filter((el) => el.dataset.frag === 'issue');
    const issueExtras = [...section.querySelectorAll<HTMLElement>('.issue__evidence, .issue__foot, .issue__caution')];
    hideCheck(tick);

    const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
    const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    const mix = (a: number, b: number, t: number) => a + (b - a) * t;

    // Where each fragment starts and where it lands in the Tyll view, measured in stage coordinates
    type Move = { el: HTMLElement; dx: number; dy: number; sx: number; rot: number; target: HTMLElement };
    let moves: Move[] = [];
    let linkLen = 0;
    const measure = () => {
      const saved = frags.map((el) => [el.style.transform, el.style.rotate]);
      frags.forEach((el) => {
        el.style.transform = 'none';
        el.style.rotate = '';
      });
      const savedView = [view.style.opacity, view.style.transform];
      view.style.transform = 'none';
      // Fit the finished view inside the stage
      const sr = stage.getBoundingClientRect();
      view.style.setProperty('--fit', '1');
      const natural = view.getBoundingClientRect();
      const fit = Math.min(1, (sr.height - 24) / natural.height, (sr.width - 24) / natural.width);
      view.style.setProperty('--fit', String(fit));
      moves = frags.map((el) => {
        const target = section.querySelector<HTMLElement>(`[data-target="${el.dataset.frag}"]`)!;
        const a = el.getBoundingClientRect();
        const b = target.getBoundingClientRect();
        const rot = parseFloat(getComputedStyle(el).rotate) || 0;
        return { el, target, rot, dx: b.left + b.width / 2 - (a.left + a.width / 2), dy: b.top + b.height / 2 - (a.top + a.height / 2), sx: Math.min(1.2, b.width / a.width) };
      });
      // The link between the POS row and the stock table
      const pa = section.querySelector<HTMLElement>('[data-anchor="pos"]')!.getBoundingClientRect();
      const pb = section.querySelector<HTMLElement>('[data-anchor="stock"]')!.getBoundingClientRect();
      const x1 = pa.right - sr.left + 6, y1 = pa.top + pa.height / 2 - sr.top;
      const x2 = pb.left - sr.left - 6, y2 = pb.top + pb.height / 2 - sr.top;
      const narrow = pb.left < pa.right;
      const d = narrow
        ? `M ${pa.left + pa.width * 0.7 - sr.left} ${pa.bottom - sr.top + 4} C ${pa.left + pa.width * 0.7 - sr.left} ${(pa.bottom + pb.top) / 2 - sr.top}, ${pb.left + pb.width * 0.3 - sr.left} ${(pa.bottom + pb.top) / 2 - sr.top}, ${pb.left + pb.width * 0.3 - sr.left} ${pb.top - sr.top - 4}`
        : `M ${x1} ${y1} C ${(x1 + x2) / 2} ${y1}, ${(x1 + x2) / 2} ${y2}, ${x2} ${y2}`;
      linkPath.setAttribute('d', d);
      linkLen = linkPath.getTotalLength();
      linkPath.style.strokeDasharray = `${linkLen}`;
      const start = linkPath.getPointAtLength(0), end = linkPath.getPointAtLength(linkLen);
      dotA.setAttribute('cx', String(start.x)); dotA.setAttribute('cy', String(start.y));
      dotB.setAttribute('cx', String(end.x)); dotB.setAttribute('cy', String(end.y));
      frags.forEach((el, i) => ([el.style.transform, el.style.rotate] = saved[i]));
      [view.style.opacity, view.style.transform] = savedView;
    };

    let ticked = false;
    const render = () => {
      // Progress through the pinned stretch: 0 when the scene pins under the header, 1 when it lets go
      const r = track.getBoundingClientRect();
      const hh = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;
      const p = clamp((hh - r.top) / Math.max(1, r.height - (innerHeight - hh)));

      // 1. The related fragments are linked
      const lt = seg(p, 0.08, 0.26);
      const lf = 1 - seg(p, 0.36, 0.46);
      related.forEach((el) => el.classList.toggle('is-related', p > 0.1 && p < 0.5));
      linkPath.style.strokeDashoffset = String(linkLen * (1 - lt));
      link.style.opacity = String(Math.min(lt * 2, 1) * lf);

      // 2. Everything moves together and lands in the Tyll view
      const m = ease(seg(p, 0.28, 0.62));
      const fade = 1 - seg(p, 0.54, 0.66);
      moves.forEach(({ el, dx, dy, sx, rot, target }) => {
        el.style.transform = `translate(${dx * m}px, ${dy * m}px) scale(${mix(1, sx, m)})`;
        el.style.rotate = `${rot * (1 - m)}deg`;
        el.style.opacity = String(fade);
        target.style.opacity = String(seg(p, 0.54, 0.66));
      });
      const vt = seg(p, 0.4, 0.58);
      view.style.opacity = String(vt);
      view.style.transform = `translateY(${mix(18, 0, ease(vt))}px)`;
      issueExtras.forEach((el, i) => (el.style.opacity = String(seg(p, 0.64 + i * 0.03, 0.74 + i * 0.03))));

      // 3. The stage messages cross over
      const bt = seg(p, 0.46, 0.56);
      before.style.opacity = String(1 - bt);
      before.style.transform = `translateY(${-10 * bt}px)`;
      const at = seg(p, 0.52, 0.62);
      after.style.opacity = String(at);
      after.style.transform = `translateY(${10 * (1 - at)}px)`;
      if (p > 0.64 && !ticked) {
        ticked = true;
        drawCheck(tick, 700);
      } else if (p < 0.54 && ticked) {
        ticked = false;
        hideCheck(tick);
      }

      // The two wave layers drift into one
      const w = ease(seg(p, 0.15, 0.65));
      wavesA.style.transform = `translate(${mix(-3, 0, w)}%, ${mix(-2, 0, w)}%) scale(${mix(1.06, 1, w)})`;
      wavesB.style.transform = `translate(${mix(4, 0, w)}%, ${mix(3, 0, w)}%) scale(${mix(1.12, 1, w)}) rotate(180deg)`;
      wavesB.style.opacity = String(mix(0.45, 0.15, w));
    };

    let frame = 0;
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(() => ((frame = 0), render()));
    };
    const remeasure = () => {
      measure();
      render();
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', remeasure);
    document.fonts?.ready.then(remeasure);
    remeasure();

    // If the visitor switches to reduced motion, fall back to the still pictures
    reduce.addEventListener('change', (e) => e.matches && location.reload());
  }
</script>
