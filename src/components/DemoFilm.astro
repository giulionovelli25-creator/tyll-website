---
// A short film of the real demo doing the job, recorded from the demo itself. It plays by itself while on screen, and
// the chapter beside it says what is happening. A chapter can be chosen to jump to that moment. Phones get their own
// recording of the demo's phone layout, and each language its own recording.
// It is shown as a screen, not as a page of the demo: in a browser frame (a phone frame on phones) that hangs out of
// a block tinted in the solution's own colour. Whatever the page puts in the slot sits on that block, above the screen.
import film from '../content/film.json';
import { site } from '../config/site';
import type { Spot } from '../content/explore';
import { t, type Locale } from '../i18n';
import type { SolutionKey } from '../i18n/routes';

interface Props {
  lang: Locale;
  solutionKey: SolutionKey;
  name: string;
  spots: Spot[];
}

const { lang, solutionKey, name, spots } = Astro.props;
const d = t(lang);
const { desk, phone } = (film as Record<Locale, typeof film.en>)[lang][solutionKey];
const base = `/media/film/${lang}/${solutionKey}`;
const PHONE = '(max-width: 700px)';
// the address shown in the frame is the demo's real one
const host = site.demoUrl ? new URL(site.demoUrl).host : '';
---

<div class="film" data-film data-desk={JSON.stringify(desk)} data-phone={JSON.stringify(phone)} data-phone-poster={`${base}-phone.jpg`} data-media={PHONE}>
  <div class="film__stage">
    <slot />
    <figure class="film__frame">
      <div class="film__chrome" dir="ltr" aria-hidden="true">
        <span class="film__dots"><i></i><i></i><i></i></span>
        {host && <span class="film__url">{host}</span>}
      </div>
      <div class="film__screen" dir="ltr">
        <video muted loop playsinline controls preload="none" poster={`${base}-desk.jpg`} aria-label={name}>
          <source src={`${base}-phone.mp4`} type="video/mp4" media={PHONE} />
          <source src={`${base}-desk.mp4`} type="video/mp4" />
        </video>
      </div>
    </figure>
  </div>
  <div class="film__bar-row">
    <ol class="film__chapters">
      {
        spots.map((s, i) => (
          <li class:list={['film__chapter', i === 0 && 'is-on']} data-chapter={i}>
            <button type="button" aria-current={i === 0 ? 'step' : undefined}>
              <span class="film__bar" aria-hidden="true"><i></i></span>
              <span class="film__label">{s.label[lang]}</span>
            </button>
            <p class="film__text">{s.text[lang]}</p>
          </li>
        ))
      }
    </ol>
    <button class="film__toggle" type="button" aria-pressed="false" data-pause={d.hero.pause} data-play={d.hero.play} hidden>
      <span class="visually-hidden">{d.hero.pause}</span>
      <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.25v10H4.5zM9.25 3h2.25v10H9.25z" fill="currentColor"></path></svg>
      <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor"></path></svg>
    </button>
  </div>
</div>

<style>
  .film {
    --film-w: 68rem;
    --hang: clamp(2.5rem, 1rem + 6vw, 6rem);
    display: grid;
    gap: var(--s-3);
  }

  /* The tinted block, as wide as the page's column. The screen is narrower and hangs out of its lower edge. */
  .film__stage {
    position: relative;
    padding: clamp(1.5rem, 0.75rem + 2.4vw, 3rem) clamp(1rem, 0.25rem + 3vw, 3.5rem) 0;
  }

  .film__stage::before {
    position: absolute;
    inset: 0 0 var(--hang);
    border: 1px solid rgb(var(--acc-rgb) / 0.12);
    border-radius: var(--radius-lg);
    background: var(--acc-wash);
    content: '';
  }

  .film__frame {
    position: relative;
    max-width: var(--film-w);
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid rgb(var(--ink-rgb) / 0.14);
    border-radius: var(--radius-md);
    background: var(--paper);
    box-shadow: var(--shadow-3);
  }

  /* the browser's bar: three dots and the demo's address */
  .film__chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--sand-100);
  }

  .film__dots {
    display: flex;
    gap: 0.4rem;
  }

  .film__dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--sand-600);
  }

  .film__url {
    min-width: min(18rem, 46vw);
    padding: 0.2rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    background: var(--paper);
    color: var(--steel);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
  }

  .film__screen {
    background: var(--mist);
  }

  .film video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1360 / 860;
  }

  /* the caption below is placed against the whole row (chapters and the pause button), so it centres under the film */
  .film__bar-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--s-2);
    width: 100%;
    max-width: var(--film-w);
    margin-inline: auto;
  }

  .film__chapters {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0 0 3.25rem;
    list-style: none;
  }

  .film__chapter button {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    min-height: 44px;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: var(--text-3);
    font: inherit;
    font-size: var(--fs-small);
    text-align: start;
    cursor: pointer;
    transition: color 0.25s var(--ease);
  }

  .film__chapter.is-on button,
  .film__chapter button:hover {
    color: var(--ink);
  }

  .film__chapter.is-on .film__label {
    font-weight: 600;
  }

  .film__bar {
    display: block;
    height: 3px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--hair);
  }

  .film__bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--acc);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  :global([dir='rtl']) .film__bar i {
    transform-origin: right;
  }

  /* The current chapter's one line sits under the whole row. Without JavaScript each stays under its own label. */
  .film__text {
    margin-top: 0.25rem;
    font-size: var(--fs-small);
    line-height: 1.35;
  }

  .film.is-ready .film__text {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    margin: 0;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    max-width: none;
    text-align: center;
  }

  .film.is-ready .film__chapter:not(.is-on) .film__text {
    display: none;
  }

  .film__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--hair);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .film__toggle[hidden] {
    display: none;
  }

  .film__toggle svg {
    width: 14px;
    height: 14px;
  }

  .film__toggle .i-play,
  .film__toggle[aria-pressed='true'] .i-pause {
    display: none;
  }

  .film__toggle[aria-pressed='true'] .i-play {
    display: block;
  }

  /* Phones: the upright recording in a phone's frame, small enough that its words stay on screen */
  @media (max-width: 700px) {
    .film {
      --hang: 5rem;
    }

    .film__frame {
      width: fit-content;
      border: 6px solid var(--ink);
      border-radius: 2rem;
    }

    .film__chrome {
      display: none;
    }

    .film video {
      aspect-ratio: 390 / 760;
      width: auto;
      max-height: 62svh;
    }

    .film__chapters {
      padding-bottom: 4rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-film]').forEach((film) => {
    const video = film.querySelector('video')!;
    const toggle = film.querySelector<HTMLButtonElement>('.film__toggle')!;
    const label = toggle.querySelector('.visually-hidden')!;
    const chapters = [...film.querySelectorAll<HTMLElement>('[data-chapter]')];
    const small = matchMedia(film.dataset.media!);
    const timing = () => JSON.parse(small.matches ? film.dataset.phone! : film.dataset.desk!) as { marks: number[]; dur: number };
    // With reduced motion the film waits to be played
    let userPaused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let onScreen = false;

    video.controls = false;
    if (small.matches) video.poster = film.dataset.phonePoster!;
    film.classList.add('is-ready');
    toggle.hidden = false;

    const sync = () => {
      toggle.setAttribute('aria-pressed', String(video.paused));
      label.textContent = video.paused ? toggle.dataset.play! : toggle.dataset.pause!;
    };
    const play = () => {
      if (video.preload === 'none') video.preload = 'auto';
      video.play().catch(sync);
    };
    const paint = () => {
      const { marks, dur } = timing();
      const now = video.currentTime;
      let active = 0;
      marks.forEach((m, i) => {
        if (now >= m) active = i;
      });
      chapters.forEach((c, i) => {
        const on = i === active;
        c.classList.toggle('is-on', on);
        const end = marks[i + 1] ?? dur;
        const part = now >= end ? 1 : now <= marks[i] ? 0 : (now - marks[i]) / (end - marks[i]);
        c.querySelector<HTMLElement>('.film__bar i')!.style.setProperty('--p', String(i < active ? 1 : part));
        const button = c.querySelector('button')!;
        if (on) button.setAttribute('aria-current', 'step');
        else button.removeAttribute('aria-current');
      });
    };
    const tick = () => {
      paint();
      if (!video.paused) requestAnimationFrame(tick);
    };

    video.addEventListener('play', () => {
      sync();
      requestAnimationFrame(tick);
    });
    video.addEventListener('pause', sync);
    video.addEventListener('seeked', paint);
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) video.pause();
      else play();
    });
    chapters.forEach((c, i) =>
      c.querySelector('button')!.addEventListener('click', () => {
        if (video.preload === 'none') video.preload = 'auto';
        video.currentTime = timing().marks[i] + 0.05;
        userPaused = false;
        play();
        paint();
      }),
    );

    new IntersectionObserver(
      ([e]) => {
        onScreen = e.isIntersecting;
        if (onScreen && !userPaused) play();
        else if (!onScreen && !video.paused) video.pause();
      },
      { threshold: 0.35 },
    ).observe(video);
    sync();
  });
</script>
